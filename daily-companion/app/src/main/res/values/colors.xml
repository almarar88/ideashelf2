<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      خلفية شاشة البدء هي لون الأيقونة نفسه، فينمو الحرف من الأيقونة إلى
      الشاشة بلا قفزة لون بينهما.
    -->
    <color name="splash_bg">#FF0A6CFF</color>
    <color name="ic_launcher_background">#FF0A6CFF</color>

    <!--
      خلفية النافذة بعد شاشة البدء وقبل أن يرسم Compose أول إطار. تساوي
      خلفية التطبيق لا لون العلامة: وميض أزرق في كل فتح أسوأ من لا شيء.
    -->
    <color name="window_bg">#FFF2F2F5</color>

    <!-- ألوان الودجة: المشغّل لا يرث سمة التطبيق، فتُعرَّف هنا صراحةً. -->
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_ink">#FF1A1A1C</color>
    <color name="widget_muted">#FF5E5E66</color>
    <color name="widget_separator">#14000000</color>
    <color name="widget_accent">#FF0A6CFF</color>
</resources>
