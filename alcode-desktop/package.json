{
  "name": "alcode-ai-desktop",
  "productName": "Alcode Ai",
  "version": "1.2.0",
  "description": "رفيقك اليومي على ويندوز — مساعد يفهم أمرك وينفّذه على جهازك فعلًا",
  "main": "dist-electron/main.js",
  "author": "Alcode",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "pack:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.alcode.ai.desktop",
    "productName": "Alcode Ai",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.png",
      "artifactName": "AlcodeAi-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alcode Ai",
      "artifactName": "AlcodeAi-Setup-${version}.${ext}",
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    }
  }
}