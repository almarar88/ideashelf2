local function ambient(folder: Folder, center: Vector3, size: number, decor: string)
	local cfg = AMBIENT[decor]
	if not cfg then
		return
	end
	local emitterPart = part(folder, "Ambient", Vector3.new(size * 0.9, 1, size * 0.9), CFrame.new(center + Vector3.new(0, cfg.Up and 2 or 45, 0)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	emitterPart.Transparency = 1
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	local pe = Instance.new("ParticleEmitter")
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	pe.Color = ColorSequence.new(cfg.Color)
	pe.Size = NumberSequence.new(cfg.Size)
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(6, 10)
	pe.Rate = cfg.Rate
	pe.Speed = NumberRange.new(cfg.Speed * 0.5, cfg.Speed)
	pe.Acceleration = cfg.Acc
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.RotSpeed = NumberRange.new(-60, 60)
	pe.LightEmission = 0.6
	pe.Parent = emitterPart
end

local function portalParticles(field: BasePart, color: Color3)
	local attach = Instance.new("Attachment")
	attach.Parent = field
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	pe.Size = NumberSequence.new(0.5, 0)
	pe.Transparency = NumberSequence.new(0.2, 1)
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Rate = 25
	pe.Speed = NumberRange.new(2, 5)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.LightEmission = 1
	pe.Parent = attach
end

-- كشك سوق للاعب
local function buildBooth(parent: Instance, pos: Vector3, rot: number, index: number): Model
	local model = Instance.new("Model")
	model.Name = "Booth" .. index
	model:SetAttribute("BoothId", index)
	model:SetAttribute("Owner", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("Listings", 0)
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	local base = part(model, "Base", Vector3.new(12, 1, 10), cf * CFrame.new(0, 0.5, 0), Color3.fromRGB(130, 90, 55), Enum.Material.WoodPlanks)
	part(model, "Counter", Vector3.new(10, 3, 2.2), cf * CFrame.new(0, 2.5, -3), Color3.fromRGB(160, 110, 65), Enum.Material.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "Pole", Vector3.new(0.6, 10, 0.6), cf * CFrame.new(sx * 5.5, 5.5, 3.5), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
		part(model, "Pole", Vector3.new(0.6, 10, 0.6), cf * CFrame.new(sx * 5.5, 5.5, -4), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	end
	local hue = (index * 0.13) % 1
	local roof = part(model, "Roof", Vector3.new(13, 0.6, 11), cf * CFrame.new(0, 10.6, 0) * CFrame.Angles(0.1, 0, 0), Color3.fromHSV(hue, 0.7, 0.95), Enum.Material.Fabric)
	roof.CanCollide = false
	for i = 0, 5 do
		local stripe = part(model, "Stripe", Vector3.new(1.3, 0.7, 11.2), cf * CFrame.new(-5.4 + i * 2.2, 10.65, 0) * CFrame.Angles(0.1, 0, 0), Color3.new(1, 1, 1), Enum.Material.Fabric)
		stripe.CanCollide = false
	end
	local sign = part(model, "Sign", Vector3.new(9, 2.4, 0.4), cf * CFrame.new(0, 8.2, -5.5), Color3.fromRGB(245, 230, 200), Enum.Material.Wood)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = "كشك " .. index
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	local bb = billboard(sign, "كشك فارغ\nاضغط للحجز", UDim2.fromScale(12, 4), Color3.new(1, 1, 1), 3)
	bb.Name = "BoothSign"
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

local function buildAuctionHouse(parent: Instance, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "AuctionHouse"
	model:SetAttribute("Machine", "Market")
	local base = part(model, "Floor", Vector3.new(30, 1, 24), CFrame.new(pos + Vector3.new(0, 0.5, 0)), Color3.fromRGB(230, 220, 200), Enum.Material.Marble)
	part(model, "Back", Vector3.new(30, 14, 1.5), CFrame.new(pos + Vector3.new(0, 7.5, 11)), Color3.fromRGB(200, 90, 70), Enum.Material.Brick)
	for _, sx in ipairs({ -1, 1 }) do
		part(model, "Wall", Vector3.new(1.5, 14, 24), CFrame.new(pos + Vector3.new(sx * 14.5, 7.5, 0)), Color3.fromRGB(200, 90, 70), Enum.Material.Brick)
		part(model, "Column", Vector3.new(2.5, 14, 2.5), CFrame.new(pos + Vector3.new(sx * 12, 7.5, -11)), Color3.fromRGB(245, 235, 220), Enum.Material.Marble, "cyl").CFrame = CFrame.new(pos + Vector3.new(sx * 12, 7, -11)) * CFrame.Angles(0, 0, math.pi / 2)
	end
	local dome = part(model, "Dome", Vector3.new(30, 14, 26), CFrame.new(pos + Vector3.new(0, 14, 0)), Color3.fromRGB(60, 140, 200), Enum.Material.Metal, "ball")
	dome.CanCollide = false
	local spire = part(model, "Spire", Vector3.new(2, 8, 2), CFrame.new(pos + Vector3.new(0, 24, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, "cone")
	spire.CanCollide = false
	local desk = part(model, "Desk", Vector3.new(14, 3.5, 3), CFrame.new(pos + Vector3.new(0, 2.5, 4)), Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح السوق"
	prompt.ObjectText = "السوق العالمي"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = desk
	billboard(spire, "🏪 السوق العالمي\nبيع واشترِ الحيوانات بالجواهر 💠", UDim2.fromScale(20, 5), Color3.fromRGB(255, 220, 120), 6)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Range = 40
	light.Brightness = 1.5
	light.Parent = base
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

local function buildPad(parent: Instance, pos: Vector3, kind: string, text: string, color: Color3): Model
	local model = Instance.new("Model")
	model.Name = kind .. "Pad"
	model:SetAttribute("Machine", kind)
	local base = part(model, "Base", Vector3.new(1, 8, 8), CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 40, 60), Enum.Material.Metal, "cyl")
	local ring = part(model, "Ring", Vector3.new(0.4, 7, 7), CFrame.new(pos + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, "cyl")
	ring.CanCollide = false
	local beam = part(model, "Beam", Vector3.new(1.2, 10, 1.2), CFrame.new(pos + Vector3.new(0, 5.5, 0)), color, Enum.Material.Neon)
	beam.Transparency = 0.6
	beam.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = text
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	billboard(beam, text, UDim2.fromScale(12, 3), color, 6)
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

function MapBuilder.BossPosition(zoneIndex: number): Vector3
	local layout = MapBuilder.Zones[zoneIndex] or MapBuilder.Zones[1]
	local half = ISLAND / 2
	return layout.Center + Vector3.new(-half * 0.66, 0, half * 0.64)
end

function MapBuilder.Build()
	setupLighting()
	local existing = Workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	local rng = Random.new(2024)

	-- المناطق (3 عوالم)
	local offsets = { [1] = Vector3.new(0, 0, 0), [2] = Config.Map.World2Offset, [3] = Config.Map.World3Offset }
	for i, zone in ipairs(Zones.List) do
		local start = Zones.WorldStart[zone.World] or 1
		local center = offsets[zone.World] + Vector3.new(0, 0, (i - start) * SPACING)
		local layout = buildIsland(zone, center, ISLAND, map, rng)
		ambient(layout.Folder, center, ISLAND, zone.Decor)
		MapBuilder.Zones[i] = layout
		buildPad(layout.Folder, center + Vector3.new(-40, 0, -ISLAND / 2 * 0.78), "Zones", "🗺️ منصة التنقل", Color3.fromRGB(80, 200, 255))
		local prevZone = Zones.List[i - 1]
		if prevZone and prevZone.World == zone.World then
			local prev = MapBuilder.Zones[i - 1]
			layout.Gate = buildBridgeAndGate(prev, zone, prev.Folder)
		end
	end

	-- بوابات العوالم
	local w2s, w3s = Zones.WorldStart[2], Zones.WorldStart[3]
	local void = MapBuilder.Zones[w2s - 1]
	local hub = MapBuilder.Zones[w2s]
	MapBuilder.World2Portal = buildPortal(void.Folder, void.Center + Vector3.new(0, 0, ISLAND / 2 - 8), Color3.fromRGB(0, 255, 255), "🌐 Tech World\nيتطلب ريبيرث + 💰 " .. Format.Number(Zones.List[w2s].Cost))
	MapBuilder.World2Portal:SetAttribute("Portal", "World2")
	portalParticles(MapBuilder.World2Portal, Color3.fromRGB(0, 255, 255))
	MapBuilder.World1Portal = buildPortal(hub.Folder, hub.Center + Vector3.new(0, 0, -ISLAND / 2 + 30), Color3.fromRGB(120, 200, 255), "🏠 العودة للعالم الأول")
	MapBuilder.World1Portal:SetAttribute("Portal", "World1")
	portalParticles(MapBuilder.World1Portal, Color3.fromRGB(120, 200, 255))
	local quantum = MapBuilder.Zones[w3s - 1]
	local enchanted = MapBuilder.Zones[w3s]
	MapBuilder.Portals.World3 = buildPortal(quantum.Folder, quantum.Center + Vector3.new(0, 0, ISLAND / 2 - 8), Color3.fromRGB(255, 120, 255), "✨ Mythic Realm\nيتطلب 3 ريبيرث + 💰 " .. Format.Number(Zones.List[w3s].Cost))
	portalParticles(MapBuilder.Portals.World3, Color3.fromRGB(255, 120, 255))
	MapBuilder.Portals.BackWorld2 = buildPortal(enchanted.Folder, enchanted.Center + Vector3.new(0, 0, -ISLAND / 2 + 30), Color3.fromRGB(0, 255, 255), "🌐 العودة للعالم الثاني")
	portalParticles(MapBuilder.Portals.BackWorld2, Color3.fromRGB(0, 255, 255))

	-- جزيرة السوق الكبير
	local marketCenter = Config.Map.MarketOffset
	local marketLayout = buildIsland(Zones.Market, marketCenter, 260, map, rng)
	ambient(marketLayout.Folder, marketCenter, 260, "market")
	MapBuilder.Zones[-1] = marketLayout
	local mf = marketLayout.Folder
	-- نقاط الصناديق في حلقة خارج الأكشاك
	marketLayout.Spots = {}
	for i = 1, 16 do
		local ang = (i - 1) / 16 * math.pi * 2
		local sp = marketCenter + Vector3.new(math.cos(ang) * 100, 0, math.sin(ang) * 100)
		if not (sp.Z < -80 and math.abs(sp.X) < 30) and not (sp.X < -50 and sp.Z > 70) then
			table.insert(marketLayout.Spots, sp)
		end
	end
	buildAuctionHouse(mf, marketCenter + Vector3.new(0, 0, 80))
	buildFountain(mf, marketCenter + Vector3.new(0, 0, 0))
	-- الأكشاك في حلقة حول النافورة
	for i = 1, Config.Market.Booths do
		local ang = (i - 1) / Config.Market.Booths * math.pi * 2
		local r = 62
		local pos = marketCenter + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
		-- الكشك يواجه النافورة
		local rot = -ang + math.pi / 2
		table.insert(MapBuilder.Booths, buildBooth(mf, pos, rot, i))
	end
	MapBuilder.Machines.PetShop = buildStall(mf, marketCenter + Vector3.new(-70, 0, 90), "PetShop", "🐾 متجر الحيوانات\nبيع حيواناتك بالجواهر", Color3.fromRGB(60, 160, 90))
	MapBuilder.Portals.MarketReturn = buildPortal(mf, marketCenter + Vector3.new(0, 0, -100), Color3.fromRGB(120, 200, 255), "🏠 العودة للبلدة")
	portalParticles(MapBuilder.Portals.MarketReturn, Color3.fromRGB(120, 200, 255))
	for _, off in ipairs({ Vector3.new(-30, 0, 40), Vector3.new(30, 0, 40), Vector3.new(-30, 0, -40), Vector3.new(30, 0, -40) }) do
		buildLamp(mf, marketCenter + off)
	end

	-- منطقة VIP
	local vipCenter = Config.Map.VIPOffset
	local vipLayout = buildIsland(Zones.VIP, vipCenter, 200, map, rng)
	MapBuilder.Zones[0] = vipLayout
	MapBuilder.VIPReturnPortal = buildPortal(vipLayout.Folder, vipCenter + Vector3.new(0, 0, -70), Color3.fromRGB(120, 200, 255), "🏠 العودة للبلدة")
	MapBuilder.VIPReturnPortal:SetAttribute("Portal", "Return")
	portalParticles(MapBuilder.VIPReturnPortal, Color3.fromRGB(120, 200, 255))
	ambient(vipLayout.Folder, vipCenter, 200, "gold")

	-- زنزانة الشق
	local dCenter = Config.Map.DungeonOffset
	local dLayout = buildIsland(Zones.Dungeon, dCenter, 220, map, rng)
	ambient(dLayout.Folder, dCenter, 220, "voidorbs")
	MapBuilder.Zones[-2] = dLayout
	dLayout.Spots = {}
	local df = dLayout.Folder
	for i = 1, 8 do
		local ang = (i / 8) * math.pi * 2
		part(df, "RiftPillar", Vector3.new(4, 26, 4), CFrame.new(dCenter + Vector3.new(math.cos(ang) * 55, 13, math.sin(ang) * 55)), Color3.fromRGB(30, 10, 50), Enum.Material.Basalt)
		local top = part(df, "RiftTop", Vector3.new(3, 3, 3), CFrame.new(dCenter + Vector3.new(math.cos(ang) * 55, 28, math.sin(ang) * 55)), Color3.fromRGB(157, 0, 255), Enum.Material.Neon, "ball")
		top.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(157, 0, 255)
		light.Range = 30
		light.Parent = top
	end
	local rift = part(df, "Rift", Vector3.new(0.5, 40, 40), CFrame.new(dCenter + Vector3.new(0, 35, 60)) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(157, 0, 255), Enum.Material.Neon, "cyl")
	rift.Transparency = 0.5
	rift.CanCollide = false
	local dStart = buildPad(df, dCenter + Vector3.new(0, 0, -30), "Dungeon", "🌀 ابدأ الزنزانة", Color3.fromRGB(157, 0, 255))
	dStart.Name = "DungeonStart"
	MapBuilder.Portals.DungeonReturn = buildPortal(df, dCenter + Vector3.new(0, 0, -85), Color3.fromRGB(120, 200, 255), "🏠 العودة للبلدة")
	portalParticles(MapBuilder.Portals.DungeonReturn, Color3.fromRGB(120, 200, 255))

	-- البلدة
	local town = MapBuilder.Zones[1]
	local tf = town.Folder
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(14, 1, 14)
	spawnLoc.CFrame = CFrame.new(town.Spawn + Vector3.new(0, 0.5, 0))
	spawnLoc.Anchored = true
	spawnLoc.Color = Color3.fromRGB(255, 255, 255)
	spawnLoc.Material = Enum.Material.Marble
	spawnLoc.TopSurface = Enum.SurfaceType.Smooth
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Parent = tf

	for i, info in ipairs(MACHINE_INFO) do
		local pos = town.Center + Vector3.new(118, 0, -118 + (i - 1) * 32)
		MapBuilder.Machines[info.Kind] = buildMachine(tf, info, pos)
	end

	MapBuilder.Specials.GiantChest = town.Center + Vector3.new(60, 0, 118)
	MapBuilder.Specials.MysteryBox = town.Center + Vector3.new(-60, 0, 118)
	MapBuilder.Specials.BossArena = town.Center + Vector3.new(-100, 0, 96)

	MapBuilder.VIPPortal = buildPortal(tf, town.Center + Vector3.new(-118, 0, -112), Color3.fromRGB(255, 215, 0), "👑 VIP Lounge")
	MapBuilder.VIPPortal:SetAttribute("Portal", "VIP")
	portalParticles(MapBuilder.VIPPortal, Color3.fromRGB(255, 215, 0))
	MapBuilder.Portals.Market = buildPortal(tf, town.Center + Vector3.new(-118, 0, -80), Color3.fromRGB(255, 140, 60), "🏪 السوق الكبير\nبيع واشترِ الحيوانات")
	portalParticles(MapBuilder.Portals.Market, Color3.fromRGB(255, 140, 60))
	MapBuilder.Portals.Dungeon = buildPortal(tf, town.Center + Vector3.new(-118, 0, -48), Color3.fromRGB(157, 0, 255), "🌀 زنزانة الشق\nموجات + زعيم")
	portalParticles(MapBuilder.Portals.Dungeon, Color3.fromRGB(157, 0, 255))
	MapBuilder.Machines.Craft = buildStall(tf, town.Center + Vector3.new(118, 0, 92), "Craft", "🔨 محطة التصنيع", Color3.fromRGB(255, 160, 60))
	MapBuilder.Machines.Cosmetic = buildStall(tf, town.Center + Vector3.new(118, 0, 124), "Cosmetic", "🎩 البيضة التجميلية", Color3.fromRGB(255, 120, 200))

	-- الأكشاك والعجلة والمذبح والنافورة
	MapBuilder.Machines.Merchant = buildStall(tf, town.Center + Vector3.new(-62, 0, -116), "Merchant", "🧳 التاجر المتجول", Color3.fromRGB(200, 60, 60))
	MapBuilder.Machines.Trade = buildStall(tf, town.Center + Vector3.new(62, 0, -116), "Trade", "🤝 ساحة التبادل", Color3.fromRGB(60, 120, 220))
	MapBuilder.Machines.Spin = buildWheel(tf, town.Center + Vector3.new(-30, 0, -124))
	MapBuilder.Machines.Rebirth = buildAltar(tf, town.Center + Vector3.new(118, 0, 60))
	buildFountain(tf, town.Center + Vector3.new(0, 0, -60))
	for _, off in ipairs({ Vector3.new(-16, 0, -80), Vector3.new(16, 0, -80), Vector3.new(-16, 0, -40), Vector3.new(16, 0, -40), Vector3.new(-40, 0, -100), Vector3.new(40, 0, -100) }) do
		buildLamp(tf, town.Center + off)
	end
	buildBench(tf, town.Center + Vector3.new(-14, 0, -60), math.pi / 2)
	buildBench(tf, town.Center + Vector3.new(14, 0, -60), -math.pi / 2)

	MapBuilder.Boards.Coins = buildBoard(tf, town.Center + Vector3.new(-72, 0, -142), "💰 أغنى اللاعبين", Color3.fromRGB(255, 200, 40))
	MapBuilder.Boards.Hatches = buildBoard(tf, town.Center + Vector3.new(-104, 0, -142), "🥚 أكثر فتحاً للبيض", Color3.fromRGB(120, 200, 255))
	MapBuilder.Boards.Rebirths = buildBoard(vipLayout.Folder, vipCenter + Vector3.new(-40, 0, -95), "🔁 أكثر ريبيرث", Color3.fromRGB(255, 140, 60))
	MapBuilder.Boards.Damage = buildBoard(vipLayout.Folder, vipCenter + Vector3.new(40, 0, -95), "⚔️ أعلى ضرر", Color3.fromRGB(255, 90, 120))

	-- أرضية الموت تحت الجزر
	local kill = part(map, "KillPlane", Vector3.new(9000, 1, 9000), CFrame.new(1200, -120, 2000), Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic)
	kill.Transparency = 1
	kill.CanCollide = false
	kill.Touched:Connect(function(hit)
		local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		end
	end)
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">MarketService</string><ProtectedString name="Source"><![CDATA[--!strict
-- السوق العالمي: عروض بيع عبر السيرفرات (MemoryStore) + صندوق بريد للبائع (DataStore) + أكشاك + بيع للتاجر
local Players = game:GetService("Players")
local MemoryStoreService = game:GetService("MemoryStoreService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local PetUtil = require(Shared.Modules.PetUtil)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local MapBuilder = require(script.Parent.MapBuilder)
local RateLimit = require(script.Parent.RateLimit)
local Hooks = require(script.Parent.Hooks)

local MarketService = {}

local listings = MemoryStoreService:GetSortedMap("PetKingdom_Market_v1")
local mailbox = DataStoreService:GetDataStore("PetKingdom_Mailbox_v1")
local TTL = Config.Market.ListingTTL

local cache: { any } = {}
local cacheTime = 0
local booths: { [number]: Player } = {}
local boothOf: { [Player]: number } = {}

local function fail(msg: string)
	return { ok = false, error = msg }
end

-- ===== قراءة العروض (مع كاش) =====
local function fetchAll(force: boolean?): { any }
	if not force and os.clock() - cacheTime < Config.Market.CacheSeconds then
		return cache
	end
	local ok, res = pcall(function()
		return listings:GetRangeAsync(Enum.SortDirection.Descending, 200)
	end)
	if ok and type(res) == "table" then
		local out = {}
		for _, item in ipairs(res) do
			local v = item.value
			if type(v) == "table" and not v.Buyer then
				v.Id = item.key
				table.insert(out, v)
			end
		end
		cache = out
		cacheTime = os.clock()
	end
	return cache
end

local function updateBoothAttr(player: Player)
	local idx = boothOf[player]
	if not idx then
		return
	end
	local p = DataService.Get(player)
	local n = 0
	if p then
		for _ in pairs(p.MyListings) do
			n += 1
		end
	end
	local booth = MapBuilder.Booths[idx]
	if booth then
		booth:SetAttribute("Listings", n)
	end
end

-- ===== صندوق البريد =====
local function pushMail(userId: number, entry: any)
	pcall(function()
		mailbox:UpdateAsync("m_" .. userId, function(old)
			old = type(old) == "table" and old or {}
			table.insert(old, entry)
			return old
		end)
	end)
end

local function reconcile(player: Player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local mailKey = "m_" .. player.UserId
	local ok, mail = pcall(mailbox.GetAsync, mailbox, mailKey)
	local processed = {}
	if ok and type(mail) == "table" then
		for _, entry in ipairs(mail) do
			if entry.Type == "Sold" then
				local listing = p.MyListings[entry.ListingId]
				if listing then
					DataService.AddGems(player, entry.Gems or 0, true)
					p.Stats.MarketSales += 1
					p.MyListings[entry.ListingId] = nil
					DataService.Notify(player, "💠 بيع " .. (listing.Name or "حيوانك") .. " مقابل " .. (entry.Gems or 0) .. " جوهرة!", Color3.fromRGB(180, 120, 255))
					Hooks.Fire(player, "MarketSale", 1)
				end
				table.insert(processed, entry.ListingId)
			end
		end
		if #processed > 0 then
			pcall(function()
				mailbox:UpdateAsync(mailKey, function(old)
					old = type(old) == "table" and old or {}
					local keep = {}
					for _, e in ipairs(old) do
						if not table.find(processed, e.ListingId) then
							table.insert(keep, e)
						end
					end
					return keep
				end)
			end)
		end
	end
	-- العروض المنتهية: إعادة الحيوان
	local now = os.time()
	for id, listing in pairs(p.MyListings) do
		if listing.Expires and now > listing.Expires + 60 then
			local okGet, value = pcall(listings.GetAsync, listings, id)
			if okGet then
				if value == nil then
					-- انتهى بدون بيع → إعادة الحيوان
					if PetService.FreeSlots(player) > 0 then
						table.insert(p.Pets, listing.Pet)
						p.MyListings[id] = nil
						DataService.Notify(player, "⏳ انتهى عرض " .. (listing.Name or "") .. " وعاد الحيوان لمخزنك", Color3.fromRGB(255, 200, 80))
					end
				elseif type(value) == "table" and value.Buyer and value.Buyer > 0 then
					DataService.AddGems(player, math.floor((value.Price or 0) * (100 - Config.Market.FeePercent) / 100), true)
					p.MyListings[id] = nil
					pcall(listings.RemoveAsync, listings, id)
				end
			end
		end
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	updateBoothAttr(player)
end

-- ===== الإجراءات =====
local function list(player: Player, payload: any)
	local p = DataService.Get(player) :: DataService.Profile
	local uid = tostring(payload.Uid)
	local price = math.floor(tonumber(payload.Price) or 0)
	if price < Config.Market.MinPrice or price > Config.Market.MaxPrice then
		return fail("السعر يجب أن يكون بين " .. Config.Market.MinPrice .. " و " .. Config.Market.MaxPrice)
	end
	local count = 0
	for _ in pairs(p.MyListings) do
		count += 1
	end
	if count >= Config.Market.MaxListings then
		return fail("الحد الأقصى " .. Config.Market.MaxListings .. " عروض")
	end
	local pet = PetService.Find(p, uid)
	if not pet or pet.Locked then
		return fail("الحيوان غير موجود أو مقفول")
	end
	local def = Pets.Get(pet.Id) :: Pets.PetDef
	local id = HttpService:GenerateGUID(false)
	local snapshot = table.clone(pet)
	snapshot.Equipped = false
	snapshot.Locked = false
	local value = {
		Seller = player.UserId,
		SellerName = player.DisplayName,
		Pet = snapshot,
		Name = PetUtil.DisplayName(pet),
		PetId = pet.Id,
		Variant = pet.Variant,
		Level = pet.Level or 1,
		Rarity = def.Rarity,
		Power = PetUtil.BasePower(pet),
		Price = price,
		Time = os.time(),
	}
	PetService.Remove(p, uid)
	local ok = pcall(listings.SetAsync, listings, id, value, TTL)
	if not ok then
		table.insert(p.Pets, pet)
		return fail("تعذر الاتصال بالسوق، حاول لاحقاً")
	end
	p.MyListings[id] = { Pet = snapshot, Name = value.Name, Price = price, Expires = os.time() + TTL, PetId = pet.Id, Variant = pet.Variant }
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	updateBoothAttr(player)
	cacheTime = 0
	DataService.Notify(player, "🏪 تم عرض " .. value.Name .. " بسعر 💠 " .. price, Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

local function buy(player: Player, payload: any)
	local p = DataService.Get(player) :: DataService.Profile
	local id = tostring(payload.Id)
	local okGet, value = pcall(listings.GetAsync, listings, id)
	if not okGet or type(value) ~= "table" then
		cacheTime = 0
		return fail("العرض لم يعد متاحاً")
	end
	if value.Seller == player.UserId then
		return fail("لا يمكنك شراء عرضك")
	end
	if value.Buyer then
		return fail("تم بيعه للتو")
	end
	if p.Gems < value.Price then
		return fail("تحتاج 💠 " .. value.Price)
	end
	if PetService.FreeSlots(player) <= 0 then
		return fail("المخزن ممتلئ")
	end
	local okClaim, claimed = pcall(function()
		return listings:UpdateAsync(id, function(old)
			if type(old) ~= "table" or old.Buyer then
				return nil
			end
			old.Buyer = player.UserId
			return old
		end, TTL)
	end)
	if not okClaim or claimed == nil then
		cacheTime = 0
		return fail("تم بيعه للتو")
	end
	if not DataService.Spend(player, "Gems", value.Price) then
		return fail("تحتاج 💠 " .. value.Price)
	end
	local pet = table.clone(value.Pet)
	pet.Uid = HttpService:GenerateGUID(false)
	pet.Equipped = false
	pet.Locked = false
	pet.Enchants = pet.Enchants or {}
	pet.Level = pet.Level or 1
	pet.XP = pet.XP or 0
	table.insert(p.Pets, pet)
	p.Index[pet.Id] = true
	pcall(listings.RemoveAsync, listings, id)
	cacheTime = 0
	local payout = math.floor(value.Price * (100 - Config.Market.FeePercent) / 100)
	local seller = Players:GetPlayerByUserId(value.Seller)
	if seller and DataService.Get(seller) then
		local sp = DataService.Get(seller) :: DataService.Profile
		DataService.AddGems(seller, payout, true)
		sp.Stats.MarketSales += 1
		sp.MyListings[id] = nil
		DataService.MarkDirty(seller)
		updateBoothAttr(seller)
		DataService.Notify(seller, "💠 " .. player.DisplayName .. " اشترى " .. value.Name .. " مقابل " .. payout .. " جوهرة!", Color3.fromRGB(180, 120, 255))
		Hooks.Fire(seller, "MarketSale", 1)
	else
		pushMail(value.Seller, { Type = "Sold", ListingId = id, Gems = payout, Buyer = player.DisplayName })
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	DataService.Notify(player, "🎉 اشتريت " .. value.Name .. "!", Color3.fromRGB(120, 255, 140))
	Remotes.Event("EventEffect"):FireClient(player, { Type = "Purchase" })
	return { ok = true }
end

local function cancel(player: Player, payload: any)
	local p = DataService.Get(player) :: DataService.Profile
	local id = tostring(payload.Id)
	local listing = p.MyListings[id]
	if not listing then
		return fail("العرض غير موجود")
	end
	if PetService.FreeSlots(player) <= 0 then
		return fail("المخزن ممتلئ")
	end
	local okClaim, claimed = pcall(function()
		return listings:UpdateAsync(id, function(old)
			if type(old) ~= "table" or old.Buyer then
				return nil
			end
			old.Buyer = -1
			return old
		end, 60)
	end)
	if okClaim and claimed ~= nil then
		pcall(listings.RemoveAsync, listings, id)
		table.insert(p.Pets, listing.Pet)
		p.MyListings[id] = nil
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		updateBoothAttr(player)
		cacheTime = 0
		return { ok = true }
	end
	-- بيع أو انتهى → التسوية
	reconcile(player)
	return { ok = true }
end

local function sellNPC(player: Player, payload: any)
	local p = DataService.Get(player) :: DataService.Profile
	local uids = type(payload.Uids) == "table" and payload.Uids or { payload.Uid }
	local total = 0
	local n = 0
	for _, uid in ipairs(uids) do
		local pet = PetService.Find(p, tostring(uid))
		if pet and not pet.Locked then
			local def = Pets.Get(pet.Id) :: Pets.PetDef
			local value = (Config.Market.NPCValue[def.Rarity] or 1) * (Config.VariantMultipliers[pet.Variant] or 1) * (1 + (pet.Level or 1) / 50)
			total += math.floor(value)
			PetService.Remove(p, pet.Uid)
			n += 1
		end
	end
	if n == 0 then
		return fail("لا يوجد حيوان صالح للبيع")
	end
	DataService.AddGems(player, total, true)
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	DataService.Notify(player, "💠 بعت " .. n .. " حيوان مقابل " .. total .. " جوهرة", Color3.fromRGB(180, 120, 255))
	return { ok = true, gems = total }
end

function MarketService.NPCValue(pet: any): number
	local def = Pets.Get(pet.Id)
	if not def then
		return 0
	end
	return math.floor((Config.Market.NPCValue[def.Rarity] or 1) * (Config.VariantMultipliers[pet.Variant] or 1) * (1 + (pet.Level or 1) / 50))
end

local function exchange(player: Player, payload: any)
	local p = DataService.Get(player) :: DataService.Profile
	local amount = math.floor(tonumber(payload.Amount) or 0)
	if amount < 1 then
		return fail("أدخل عدداً صحيحاً")
	end
	local day = math.floor(os.time() / 86400)
	if p.GemExchange.Day ~= day then
		p.GemExchange = { Day = day, Count = 0 }
	end
	if p.GemExchange.Count + amount > Config.GemExchange.DailyCap then
		return fail("السقف اليومي " .. Config.GemExchange.DailyCap .. " جوهرة (تبقى " .. (Config.GemExchange.DailyCap - p.GemExchange.Count) .. ")")
	end
	local Zones = require(Shared.Data.Zones)
	local best = 1
	for k in pairs(p.UnlockedZones) do
		local z = Zones.Get(tonumber(k) or 1)
		if z then
			best = math.max(best, z.Multiplier)
		end
	end
	local price = Config.GemExchange.CoinsPerGem * best * amount
	if not DataService.Spend(player, "Coins", price) then
		return fail("تحتاج 💰 " .. price)
	end
	p.GemExchange.Count += amount
	DataService.AddGems(player, amount, false)
	DataService.MarkDirty(player)
	DataService.Notify(player, "💠 اشتريت " .. amount .. " جوهرة", Color3.fromRGB(180, 120, 255))
	return { ok = true }
end

function MarketService.ExchangePrice(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local Zones = require(Shared.Data.Zones)
	local best = 1
	for k in pairs(p.UnlockedZones) do
		local z = Zones.Get(tonumber(k) or 1)
		if z then
			best = math.max(best, z.Multiplier)
		end
	end
	return Config.GemExchange.CoinsPerGem * best
end

local function claimBooth(player: Player, payload: any)
	local idx = math.floor(tonumber(payload.BoothId) or 0)
	local booth = MapBuilder.Booths[idx]
	if not booth then
		return fail("كشك غير موجود")
	end
	if boothOf[player] == idx then
		-- تحرير الكشك
		booths[idx] = nil
		boothOf[player] = nil
		booth:SetAttribute("Owner", 0)
		booth:SetAttribute("OwnerName", "")
		booth:SetAttribute("Listings", 0)
		return { ok = true, released = true }
	end
	if booths[idx] then
		return fail("الكشك محجوز")
	end
	if boothOf[player] then
		local old = MapBuilder.Booths[boothOf[player]]
		booths[boothOf[player]] = nil
		if old then
			old:SetAttribute("Owner", 0)
			old:SetAttribute("OwnerName", "")
			old:SetAttribute("Listings", 0)
		end
	end
	booths[idx] = player
	boothOf[player] = idx
	booth:SetAttribute("Owner", player.UserId)
	booth:SetAttribute("OwnerName", player.DisplayName)
	updateBoothAttr(player)
	DataService.Notify(player, "🏪 حجزت الكشك " .. idx .. "! اعرض حيواناتك من السوق", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function MarketService.Handle(player: Player, action: string, payload: any): any
	local p = DataService.Get(player)
	if not p then
		return fail("لم يتم تحميل البيانات")
	end
	if not RateLimit.Check(player, "Market", 6, 2) then
		return fail("ببطء!")
	end
	payload = type(payload) == "table" and payload or {}
	if action == "Browse" then
		local all = fetchAll(payload.Force == true)
		local sellerFilter = tonumber(payload.Seller)
		local out = {}
		for _, v in ipairs(all) do
			if not sellerFilter or v.Seller == sellerFilter then
				table.insert(out, { Id = v.Id, Seller = v.Seller, SellerName = v.SellerName, Name = v.Name, PetId = v.PetId, Variant = v.Variant, Level = v.Level, Rarity = v.Rarity, Power = v.Power, Price = v.Price, Time = v.Time })
			end
		end
		return { ok = true, listings = out }
	elseif action == "List" then
		return list(player, payload)
	elseif action == "Buy" then
		return buy(player, payload)
	elseif action == "Cancel" then
		return cancel(player, payload)
	elseif action == "SellNPC" then
		return sellNPC(player, payload)
	elseif action == "Booth" then
		return claimBooth(player, payload)
	elseif action == "Exchange" then
		return exchange(player, payload)
	elseif action == "Reconcile" then
		reconcile(player)
		return { ok = true }
	end
	return fail("إجراء غير معروف")
end

function MarketService.Init()
	Remotes.Function("Market").OnServerInvoke = function(player, action, payload)
		return MarketService.Handle(player, tostring(action), payload)
	end
	table.insert(DataService.Extenders, function(player, payload)
		payload.GemPrice = MarketService.ExchangePrice(player)
	end)
	DataService.Loaded:Connect(function(player)
		task.delay(3, function()
			if player.Parent == Players then
				reconcile(player)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local idx = boothOf[player]
		if idx then
			booths[idx] = nil
			boothOf[player] = nil
			local booth = MapBuilder.Booths[idx]
			if booth then
				booth:SetAttribute("Owner", 0)
				booth:SetAttribute("OwnerName", "")
				booth:SetAttribute("Listings", 0)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in ipairs(Players:GetPlayers()) do
				local p = DataService.Get(player)
				if p and next(p.MyListings) ~= nil then
					reconcile(player)
				end
			end
		end
	end)
	-- تحديث الأكشاك: prompt الحجز يُعالج من العميل عبر Remote
end

return MarketService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">MerchantService</string><ProtectedString name="Source"><![CDATA[--!strict
-- التاجر المتجول: مخزون يتغير كل ساعة، حدود شراء لكل لاعب
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MerchantStock = require(Shared.Modules.MerchantStock)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local RateLimit = require(script.Parent.RateLimit)

local MerchantService = {}

function MerchantService.Buy(player: Player, slot: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Merchant", 5) then
		return { ok = false, error = "ببطء!" }
	end
	local rotation = MerchantStock.RotationId(os.time())
	if p.Merchant.Rotation ~= rotation then
		p.Merchant = { Rotation = rotation, Bought = {} }
	end
	local stock = MerchantStock.Stock(rotation)
	local item = stock[slot]
	if not item then
		return { ok = false, error = "عنصر غير موجود" }
	end
	local k = tostring(item.PoolIndex)
	if (p.Merchant.Bought[k] or 0) >= item.Limit then
		return { ok = false, error = "وصلت لحد الشراء لهذا العنصر" }
	end
	if not DataService.Spend(player, "Diamonds", item.Cost) then
		return { ok = false, error = "تحتاج 💎 " .. item.Cost }
	end
	p.Merchant.Bought[k] = (p.Merchant.Bought[k] or 0) + 1
	if item.Type == "Potion" then
		Rewards.Grant(player, { Potion = item.Key })
	elseif item.Type == "Pet" then
		Rewards.Grant(player, { Pet = item.Key })
	elseif item.Type == "Spins" then
		Rewards.Grant(player, { Spins = tonumber(item.Key) or 1 })
	elseif item.Type == "Tokens" then
		Rewards.Grant(player, { Tokens = tonumber(item.Key) or 1 })
	end
	DataService.Notify(player, "🧳 اشتريت " .. item.Name, Color3.fromRGB(120, 255, 140))
	DataService.MarkDirty(player)
	return { ok = true }
end

function MerchantService.Init()
	Remotes.Function("Merchant").OnServerInvoke = function(player, slot)
		return MerchantService.Buy(player, math.floor(tonumber(slot) or 0))
	end
end

return MerchantService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المهام اليومية + الإنجازات + الدليل التعليمي
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local RateLimit = require(script.Parent.RateLimit)

local MissionService = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function maxZone(p: DataService.Profile): number
	local best = 1
	for k in pairs(p.UnlockedZones) do
		best = math.max(best, tonumber(k) or 1)
	end
	return best
end

local function generate(player: Player, p: DataService.Profile)
	local day = today()
	if p.Missions.Day == day and #p.Missions.List > 0 then
		return
	end
	local rng = Random.new(day * 1000 + (player.UserId % 1000))
	local pool = table.clone(Config.Missions.Pool)
	local tierIdx = math.clamp(1 + math.floor(maxZone(p) / 5) + math.min(p.Rebirths, 1), 1, 3)
	local list = {}
	for _ = 1, math.min(Config.Missions.PerDay, #pool) do
		local idx = rng:NextInteger(1, #pool)
		local m = pool[idx]
		table.remove(pool, idx)
		table.insert(list, { Type = m.Type, Name = m.Name, Target = m.Targets[tierIdx], Progress = 0, Claimed = false, Reward = m.Reward })
	end
	p.Missions = { Day = day, List = list }
	DataService.MarkDirty(player)
end

local function onHook(player: Player, kind: string, amount: number)
	local p = DataService.Get(player)
	if not p then
		return
	end
	generate(player, p)
	local changed = false
	for _, m in ipairs(p.Missions.List) do
		if m.Type == kind and not m.Claimed and m.Progress < m.Target then
			m.Progress = math.min(m.Target, m.Progress + amount)
			changed = true
		end
	end
	-- الدليل التعليمي
	local step = Config.Tutorial[p.Tutorial.Step]
	if step then
		if step.Type == kind and step.Type ~= "Zone" then
			p.Tutorial.Progress = math.min(step.Target, p.Tutorial.Progress + amount)
			changed = true
		elseif step.Type == "Zone" and kind == "Zone" then
			if amount >= step.Target then
				p.Tutorial.Progress = step.Target
				changed = true
			end
		end
	end
	if changed then
		DataService.MarkDirty(player)
	end
end

function MissionService.ClaimMission(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local m = p.Missions.List[index]
	if not m then
		return { ok = false, error = "مهمة غير موجودة" }
	end
	if m.Claimed then
		return { ok = false, error = "تم الاستلام" }
	end
	if m.Progress < m.Target then
		return { ok = false, error = "لم تكتمل بعد" }
	end
	m.Claimed = true
	Rewards.Grant(player, m.Reward)
	Hooks.Fire(player, "Mission", 1)
	DataService.Notify(player, "✅ مهمة مكتملة: " .. Rewards.Describe(m.Reward), Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function MissionService.ClaimAchievement(player: Player, id: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if p.Achievements[id] then
		return { ok = false, error = "تم الاستلام" }
	end
	for _, a in ipairs(Config.Achievements) do
		if a.Id == id then
			if (p.Stats[a.Stat] or 0) < a.Target then
				return { ok = false, error = "لم يكتمل بعد" }
			end
			p.Achievements[id] = true
			Rewards.Grant(player, a.Reward)
			DataService.Notify(player, "🏅 إنجاز: " .. a.Name .. " — " .. Rewards.Describe(a.Reward), Color3.fromRGB(255, 200, 40))
			return { ok = true }
		end
	end
	return { ok = false, error = "إنجاز غير موجود" }
end

function MissionService.ClaimTutorial(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local step = Config.Tutorial[p.Tutorial.Step]
	if not step then
		return { ok = false, error = "أكملت الدليل" }
	end
	if step.Type == "Zone" then
		if not p.UnlockedZones[tostring(step.Target)] then
			return { ok = false, error = "لم تكتمل بعد" }
		end
	elseif p.Tutorial.Progress < step.Target then
		return { ok = false, error = "لم تكتمل بعد" }
	end
	Rewards.Grant(player, step.Reward)
	DataService.Notify(player, "🎓 " .. Rewards.Describe(step.Reward), Color3.fromRGB(120, 200, 255))
	p.Tutorial.Step += 1
	p.Tutorial.Progress = 0
	DataService.MarkDirty(player)
	return { ok = true }
end

function MissionService.Init()
	Hooks.Listen(onHook)
	DataService.Loaded:Connect(function(player, profile)
		generate(player, profile)
	end)
	Remotes.Function("ClaimMission").OnServerInvoke = function(player, index)
		if not RateLimit.Check(player, "Claim", 5) then
			return { ok = false, error = "ببطء!" }
		end
		return MissionService.ClaimMission(player, math.floor(tonumber(index) or 0))
	end
	Remotes.Function("ClaimAchievement").OnServerInvoke = function(player, id)
		if not RateLimit.Check(player, "Claim", 5) then
			return { ok = false, error = "ببطء!" }
		end
		return MissionService.ClaimAchievement(player, tostring(id))
	end
	Remotes.Function("ClaimTutorial").OnServerInvoke = function(player)
		return MissionService.ClaimTutorial(player)
	end
	-- تجديد المهام عند تغير اليوم
	task.spawn(function()
		local Players = game:GetService("Players")
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local p = DataService.Get(player)
				if p then
					generate(player, p)
				end
			end
		end
	end)
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">OfflineService</string><ProtectedString name="Source"><![CDATA[--!strict
-- أرباح وقت الغياب: عند العودة يحصل اللاعب على عملات تقريبية حسب قوته ومدة غيابه
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Breakables = require(Shared.Data.Breakables)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local OfflineService = {}

function OfflineService.Init()
	DataService.Loaded:Connect(function(player, profile)
		task.delay(2, function()
			local p = DataService.Get(player)
			if not p or p ~= profile then
				return
			end
			local last = p.LastSeen or 0
			if last <= 0 then
				return
			end
			local elapsed = math.min(os.time() - last, Config.Offline.MaxHours * 3600)
			if elapsed < 300 then
				return
			end
			local power = PetService.GetPower(player)
			if power <= 0 then
				return
			end
			local best = Zones.List[1]
			for k in pairs(p.UnlockedZones) do
				local z = Zones.Get(tonumber(k) or 1)
				if z and z.Multiplier > best.Multiplier then
					best = z
				end
			end
			local pile = Breakables.Get("CoinPile") :: Breakables.BreakableDef
			local pileHealth = pile.Health * best.Multiplier
			local pileCoins = pile.Coins * best.Multiplier
			local perSecond = math.min(power / pileHealth, 1) * pileCoins
			local coins = math.floor(perSecond * elapsed * Config.Offline.Rate * DataService.CoinMultiplier(player))
			if coins <= 0 then
				return
			end
			DataService.AddCoins(player, coins)
			DataService.MarkDirty(player)
			Remotes.Event("EventEffect"):FireClient(player, { Type = "WelcomeBack", Coins = coins, Seconds = elapsed })
		end)
	end)
end

return OfflineService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المخزن، التجهيز، الحذف، القفل، المستويات/الخبرة، الإنشانتات، والآلات
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Eggs = require(Shared.Data.Eggs)
local PetUtil = require(Shared.Modules.PetUtil)
local Luck = require(Shared.Modules.Luck)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)
local Hooks = require(script.Parent.Hooks)
local Format = require(Shared.Modules.Format)
local TextService = game:GetService("TextService")

local PetService = {}

type PetInstance = PetUtil.PetInstance

local rng = Random.new()
local fire = Hooks.Fire

function PetService.StorageCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseStorage + (p.Upgrades.Storage or 0) * 25 + (p.RebirthUpgrades.RStorage or 0) * 50
	if DataService.HasGamepass(player, "PlusStorage") then
		cap += Config.GamepassStorageBonus
	end
	return cap
end

function PetService.EquipCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseEquip + (p.Upgrades.Equip or 0) + (p.RebirthUpgrades.REquip or 0)
	if DataService.HasGamepass(player, "PlusEquip") then
		cap += Config.GamepassEquipBonus
	end
	return cap
end

function PetService.FreeSlots(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	return PetService.StorageCapacity(player) - #p.Pets
end

local function find(p: DataService.Profile, uid: string): (PetInstance?, number?)
	for i, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end
PetService.Find = find

local function equippedCount(p: DataService.Profile): number
	local n = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			n += 1
		end
	end
	return n
end

function PetService.Equipped(player: Player): { PetInstance }
	local p = DataService.Get(player)
	local out = {}
	if p then
		for _, pet in ipairs(p.Pets) do
			if pet.Equipped then
				table.insert(out, pet)
			end
		end
	end
	return out
end

function PetService.UpdateEquippedAttribute(player: Player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local list = {}
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			table.insert(list, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant, Shiny = pet.Shiny == true, Accessory = pet.Accessory or "" })
		end
	end
	player:SetAttribute("EquippedPets", HttpService:JSONEncode(list))
	player:SetAttribute("TotalPower", PetService.GetPower(player))
end

function PetService.GetPower(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local total = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			total += PetUtil.BasePower(pet)
		end
	end
	return total * DataService.DamageMultiplier(player)
end

function PetService.Add(player: Player, petId: string, variant: string?, ignoreCapacity: boolean?, shiny: boolean?): PetInstance?
	local p = DataService.Get(player)
	local def = Pets.Get(petId)
	if not p or not def then
		return nil
	end
	if not ignoreCapacity and #p.Pets >= PetService.StorageCapacity(player) then
		return nil
	end
	local inst: PetInstance = {
		Uid = HttpService:GenerateGUID(false),
		Id = petId,
		Variant = variant or "Normal",
		Locked = false,
		Equipped = false,
		Time = os.time(),
		Level = 1,
		XP = 0,
		Enchants = {},
		Shiny = shiny == true or nil,
	}
	if shiny then
		p.Stats.Shinies += 1
	end
	table.insert(p.Pets, inst)
	p.Index[petId] = true
	if def.Rarity == "Huge" then
		p.Stats.Huges += 1
	elseif def.Rarity == "Titanic" then
		p.Stats.Titanics += 1
	end
	local power = PetUtil.BasePower(inst)
	if power > (p.Stats.BestPet or 0) then
		p.Stats.BestPet = power
	end
	if equippedCount(p) < PetService.EquipCapacity(player) then
		inst.Equipped = true
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return inst
end

local function remove(p: DataService.Profile, uid: string): PetInstance?
	local pet, idx = find(p, uid)
	if pet and idx then
		table.remove(p.Pets, idx)
	end
	return pet
end
PetService.Remove = remove

-- ===== الخبرة =====
function PetService.GrantXP(player: Player, amount: number)
	local p = DataService.Get(player)
	if not p or amount <= 0 then
		return
	end
	amount = amount * DataService.XPMultiplier(player)
	local changed = false
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped and (pet.Level or 1) < Config.PetMaxLevel then
			pet.XP = (pet.XP or 0) + amount
			local needed = PetUtil.XPToNext(pet.Level or 1)
			while pet.XP >= needed and pet.Level < Config.PetMaxLevel do
				pet.XP -= needed
				pet.Level += 1
				changed = true
				needed = PetUtil.XPToNext(pet.Level)
			end
			if pet.Level >= Config.PetMaxLevel then
				pet.XP = 0
			end
		end
	end
	DataService.MarkDirty(player)
	if changed then
		PetService.UpdateEquippedAttribute(player)
	end
end

-- ===== إجراءات المخزن =====
function PetService.Action(player: Player, action: string, payload: any): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "PetAction", 20) then
		return { ok = false, error = "ببطء!" }
	end
	payload = type(payload) == "table" and payload or {}

	if action == "Equip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		if pet.Equipped then
			return { ok = true }
		end
		if equippedCount(p) >= PetService.EquipCapacity(player) then
			return { ok = false, error = "وصلت للحد الأقصى من التجهيز" }
		end
		pet.Equipped = true
	elseif action == "Unequip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Equipped = false
	elseif action == "Lock" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Locked = not pet.Locked
	elseif action == "Delete" then
		local uids = payload.Uids or { payload.Uid }
		local n = 0
		for _, uid in ipairs(uids) do
			local pet = find(p, tostring(uid))
			if pet and not pet.Locked then
				remove(p, pet.Uid)
				n += 1
			end
		end
		if n == 0 then
			return { ok = false, error = "لا يمكن حذف حيوان مقفول" }
		end
	elseif action == "UnequipAll" then
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
	elseif action == "EquipBest" then
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		local cap = PetService.EquipCapacity(player)
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
		for i = 1, math.min(cap, #sorted) do
			sorted[i].Equipped = true
		end
	elseif action == "Nick" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		local raw = tostring(payload.Nick or ""):sub(1, 20)
		if raw == "" then
			pet.Nick = nil
		else
			local ok, filtered = pcall(function()
				local result = TextService:FilterStringAsync(raw, player.UserId)
				return result:GetNonChatStringForBroadcastAsync()
			end)
			pet.Nick = ok and filtered or nil
		end
	elseif action == "Accessory" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		local id = tostring(payload.Id or "")
		-- إعادة الإكسسوار الحالي للحقيبة
		if pet.Accessory and pet.Accessory ~= "" then
			p.Accessories[pet.Accessory] = (p.Accessories[pet.Accessory] or 0) + 1
			pet.Accessory = nil
		end
		if id ~= "" then
			if (p.Accessories[id] or 0) <= 0 then
				return { ok = false, error = "لا تملك هذا الإكسسوار" }
			end
			p.Accessories[id] -= 1
			pet.Accessory = id
		end
	elseif action == "ClaimIndex" then
		local eggId = tostring(payload.EggId)
		local egg = Eggs.Get(eggId)
		if not egg then
			return { ok = false, error = "بيضة غير موجودة" }
		end
		if p.IndexClaimed[eggId] then
			return { ok = false, error = "تم الاستلام" }
		end
		for _, entry in ipairs(egg.Pets) do
			if not p.Index[entry.Pet] then
				return { ok = false, error = "أكمل فهرس البيضة أولاً" }
			end
		end
		p.IndexClaimed[eggId] = true
		local tier = math.max(1, egg.Zone)
		local reward = Config.IndexReward(tier)
		DataService.AddDiamonds(player, reward.Diamonds or 0)
		DataService.AddGems(player, reward.Gems or 0, true)
		DataService.Notify(player, "📖 أكملت فهرس " .. egg.Name .. "! 💎 " .. Format.Number(reward.Diamonds or 0) .. "  💠 " .. Format.Number(reward.Gems or 0), Color3.fromRGB(200, 140, 255))
	elseif action == "Setting" then
		local k = tostring(payload.Key)
		if p.Settings[k] == nil then
			return { ok = false, error = "إعداد غير معروف" }
		end
		if k == "AutoDeleteRank" then
			p.Settings[k] = math.clamp(math.floor(tonumber(payload.Value) or 0), 0, 4)
		else
			p.Settings[k] = payload.Value == true
		end
	else
		return { ok = false, error = "إجراء غير معروف" }
	end

	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return { ok = true }
end

-- ===== الآلات =====
local function collect(p: DataService.Profile, uids: any): { PetInstance }?
	if type(uids) ~= "table" then
		return nil
	end
	local out = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		uid = tostring(uid)
		if seen[uid] then
			return nil
		end
		seen[uid] = true
		local pet = find(p, uid)
		if not pet or pet.Locked then
			return nil
		end
		table.insert(out, pet)
	end
	return out
end

local function rollEnchant(): PetUtil.Enchant
	local totalW = 0
	for _, cfg in pairs(Config.Enchants) do
		totalW += cfg.Weight
	end
	local r = rng:NextNumber() * totalW
	local chosen = "Coins"
	for k, cfg in pairs(Config.Enchants) do
		r -= cfg.Weight
		if r <= 0 then
			chosen = k
			break
		end
	end
	local tw = 0
	for _, w in ipairs(Config.EnchantTierWeights) do
		tw += w
	end
	local r2 = rng:NextNumber() * tw
	local tier = 1
	for i, w in ipairs(Config.EnchantTierWeights) do
		r2 -= w
		if r2 <= 0 then
			tier = i
			break
		end
	end
	return { Type = chosen, Tier = tier }
end

function PetService.Machine(player: Player, kind: string, payload: any): { ok: boolean, error: string?, result: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Machine", 10) then
		return { ok = false, error = "ببطء!" }
	end
	payload = type(payload) == "table" and payload or {}

	if kind == "Golden" or kind == "Rainbow" then
		local need = Config.Machines[kind].Requires
		local fromVariant = kind == "Golden" and "Normal" or "Golden"
		local toVariant = kind == "Golden" and "Golden" or "Rainbow"
		local pets = collect(p, payload.Uids)
		if not pets or #pets ~= need then
			return { ok = false, error = "اختر " .. need .. " حيوانات (غير مقفولة)" }
		end
		local id = pets[1].Id
		local bestLevel = 1
		for _, pet in ipairs(pets) do
			if pet.Id ~= id or pet.Variant ~= fromVariant then
				return { ok = false, error = "يجب أن تكون نفس الحيوان ونفس النوع" }
			end
			bestLevel = math.max(bestLevel, pet.Level or 1)
		end
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local result = PetService.Add(player, id, toVariant, true) :: PetInstance
		result.Level = bestLevel
		if kind == "Golden" then
			p.Stats.Goldens += 1
			fire(player, "Golden", 1)
		else
			p.Stats.Rainbows += 1
		end
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true, result = result }
	elseif kind == "DarkMatterStart" then
		local pets = collect(p, { payload.Uid })
		if not pets or #pets ~= 1 or pets[1].Variant ~= "Rainbow" then
			return { ok = false, error = "اختر حيوان Rainbow واحد" }
		end
		local cost = Config.Machines.DarkMatter.CostDiamonds
		if not DataService.Spend(player, "Diamonds", cost) then
			return { ok = false, error = "تحتاج " .. cost .. " ألماسة" }
		end
		local pet = remove(p, pets[1].Uid) :: PetInstance
		table.insert(p.DarkMatter, { PetId = pet.Id, Level = pet.Level or 1, Ready = os.time() + Config.Machines.DarkMatter.Time })
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true }
	elseif kind == "DarkMatterClaim" then
		local idx = tonumber(payload.Index)
		local entry = idx and p.DarkMatter[idx]
		if not entry then
			return { ok = false, error = "غير موجود" }
		end
		if os.time() < entry.Ready then
			return { ok = false, error = "لم يجهز بعد" }
		end
		if PetService.FreeSlots(player) <= 0 then
			return { ok = false, error = "المخزن ممتلئ" }
		end
		table.remove(p.DarkMatter, idx :: number)
		local result = PetService.Add(player, entry.PetId, "DarkMatter") :: PetInstance
		result.Level = entry.Level or 1
		p.Stats.DarkMatters += 1
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	elseif kind == "Fuse" then
		local cfg = Config.Machines.Fuse
		local pets = collect(p, payload.Uids)
		if not pets or #pets < cfg.Min or #pets > cfg.Max then
			return { ok = false, error = "اختر من " .. cfg.Min .. " إلى " .. cfg.Max .. " حيوانات" }
		end
		local bestTier = 1
		local variant = pets[1].Variant
		local sameVariant = true
		for _, pet in ipairs(pets) do
			local def = Pets.Get(pet.Id)
			if def and def.Tier > bestTier and def.Tier <= 20 then
				bestTier = def.Tier
			end
			if pet.Variant ~= variant then
				sameVariant = false
			end
		end
		local upgradeChance = math.min(0.6, cfg.UpgradeChance * (#pets - 2))
		local targetTier = bestTier
		if rng:NextNumber() < upgradeChance then
			targetTier = math.min(20, bestTier + 1)
		end
		local function eggForTier(tier: number)
			for _, e in ipairs(Eggs.List) do
				if e.Zone == tier and e.Currency == "Coins" and not e.VIPOnly then
					return e
				end
			end
			return nil
		end
		local egg = eggForTier(targetTier) or eggForTier(bestTier) or Eggs.Get("StarterEgg")
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local petId = Luck.Roll((egg :: any).Id, 1.5, rng) or "cat"
		local result = PetService.Add(player, petId, sameVariant and variant or "Normal", true)
		p.Stats.Fusions += 1
		fire(player, "Fuse", 1)
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	elseif kind == "Enchant" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		local slot = math.floor(tonumber(payload.Slot) or 1)
		pet.Enchants = pet.Enchants or {}
		if slot < 1 or slot > PetUtil.EnchantSlots(pet) then
			return { ok = false, error = "خانة غير متاحة لهذا النوع" }
		end
		if slot > #pet.Enchants + 1 then
			return { ok = false, error = "املأ الخانة السابقة أولاً" }
		end
		local def = Pets.Get(pet.Id) :: Pets.PetDef
		local cost = Config.EnchantCostPerTier * math.min(def.Tier, 20)
		if not DataService.Spend(player, "Diamonds", cost) then
			return { ok = false, error = "تحتاج 💎 " .. cost }
		end
		pet.Enchants = pet.Enchants or {}
		pet.Enchants[slot] = rollEnchant()
		p.Stats.Enchants += 1
		fire(player, "Enchant", 1)
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true, result = pet.Enchants[slot] }
	end
	return { ok = false, error = "آلة غير معروفة" }
end

function PetService.Init()
	Remotes.Function("PetAction").OnServerInvoke = function(player, action, payload)
		return PetService.Action(player, tostring(action), payload)
	end
	Remotes.Function("Machine").OnServerInvoke = function(player, kind, payload)
		return PetService.Machine(player, tostring(kind), payload)
	end
	DataService.Loaded:Connect(function(player)
		PetService.UpdateEquippedAttribute(player)
	end)
	table.insert(DataService.Extenders, function(player, payload)
		payload.StorageCap = PetService.StorageCapacity(player)
		payload.EquipCap = PetService.EquipCapacity(player)
		payload.Power = PetService.GetPower(player)
		payload.Enchants = PetUtil.EnchantBonuses(payload.Pets)
		payload.Abilities = PetUtil.AbilityBonuses(payload.Pets)
		payload.GemChance = DataService.Bonuses(player).GemChance or 0
	end)
	table.insert(DataService.BonusProviders, function(player)
		local p = DataService.Get(player)
		if not p then
			return nil
		end
		return PetUtil.EnchantBonuses(p.Pets)
	end)
	table.insert(DataService.BonusProviders, function(player)
		local p = DataService.Get(player)
		if not p then
			return nil
		end
		return PetUtil.AbilityBonuses(p.Pets)
	end)
end

return PetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!strict
-- حد المعدل لكل لاعب لكل مفتاح (حماية من الإرسال المفرط)
local Players = game:GetService("Players")

local RateLimit = {}
local buckets: { [Player]: { [string]: { Count: number, Reset: number } } } = {}

function RateLimit.Check(player: Player, key: string, maxPerWindow: number, window: number?): boolean
	window = window or 1
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = {}
		buckets[player] = b
	end
	local e = b[key]
	if not e or now >= e.Reset then
		e = { Count = 0, Reset = now + (window :: number) }
		b[key] = e
	end
	e.Count += 1
	return e.Count <= maxPerWindow
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الريبيرث: إعادة العملات والمناطق مقابل مضاعفات دائمة + توكنات
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ZoneService = require(script.Parent.ZoneService)

local RebirthService = {}

function RebirthService.Cost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * (Config.Rebirth.CostMult ^ rebirths))
end

function RebirthService.Rebirth(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not p.UnlockedZones[tostring(Config.Rebirth.RequiredZone)] then
		return { ok = false, error = "افتح المنطقة " .. Config.Rebirth.RequiredZone .. " أولاً" }
	end
	local cost = RebirthService.Cost(p.Rebirths)
	if p.Coins < cost then
		return { ok = false, error = "تحتاج 💰 " .. Format.Number(cost) }
	end
	p.Coins = 0
	for i = 2, 10 do
		p.UnlockedZones[tostring(i)] = nil
	end
	p.Rebirths += 1
	p.Stats.Rebirths += 1
	p.Tokens += Config.Rebirth.TokensPerRebirth
	p.LastZone = 1
	DataService.MarkDirty(player)
	ZoneService.Teleport(player, 1)
	DataService.NotifyAll("🔁 " .. player.Name .. " قام بالريبيرث رقم " .. p.Rebirths .. "!", Color3.fromRGB(255, 120, 60))
	return { ok = true }
end

function RebirthService.BuyUpgrade(player: Player, key: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	for _, u in ipairs(Config.RebirthShop) do
		if u.Key == key then
			local level = p.RebirthUpgrades[key] or 0
			if level >= u.MaxLevel then
				return { ok = false, error = "الحد الأقصى" }
			end
			local cost = u.Cost + u.CostStep * level
			if not DataService.Spend(player, "Tokens", cost) then
				return { ok = false, error = "تحتاج 🔁 " .. cost .. " توكن" }
			end
			p.RebirthUpgrades[key] = level + 1
			DataService.MarkDirty(player)
			return { ok = true }
		end
	end
	return { ok = false, error = "ترقية غير موجودة" }
end

function RebirthService.Init()
	Remotes.Function("Rebirth").OnServerInvoke = function(player)
		return RebirthService.Rebirth(player)
	end
	Remotes.Function("RebirthShop").OnServerInvoke = function(player, key)
		return RebirthService.BuyUpgrade(player, tostring(key))
	end
	table.insert(DataService.Extenders, function(player, payload)
		payload.RebirthCost = RebirthService.Cost(payload.Rebirths or 0)
	end)
end

return RebirthService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المكافآت اليومية، مكافآت وقت اللعب، الأكواد، مكافأة المجموعة
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)

local RewardService = {}

local DAY = 20 * 3600 -- يمكن الاستلام كل 20 ساعة
local RESET = 48 * 3600

local grant = Rewards.Grant

function RewardService.ClaimDaily(player: Player): { ok: boolean, error: string?, reward: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local now = os.time()
	local since = now - (p.Daily.LastClaim or 0)
	if since < DAY then
		return { ok = false, error = "عد بعد " .. math.ceil((DAY - since) / 3600) .. " ساعة" }
	end
	if since > RESET then
		p.Daily.Streak = 0
	end
	p.Daily.Streak += 1
	p.Daily.LastClaim = now
	local idx = ((p.Daily.Streak - 1) % #Config.DailyRewards) + 1
	local reward = Config.DailyRewards[idx]
	grant(player, reward)
	DataService.Notify(player, "🎁 مكافأة اليوم " .. idx .. " استلمتها!", Color3.fromRGB(255, 200, 80))
	return { ok = true, reward = reward }
end

function RewardService.ClaimPlaytime(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local reward = Config.PlaytimeRewards[index]
	if not p or not reward then
		return { ok = false, error = "غير موجود" }
	end
	if p.PlaytimeClaimed[tostring(index)] then
		return { ok = false, error = "تم الاستلام" }
	end
	local elapsed = os.time() - p.SessionStart
	if elapsed < reward.Minutes * 60 then
		return { ok = false, error = "لم يحن الوقت بعد" }
	end
	p.PlaytimeClaimed[tostring(index)] = true
	grant(player, reward)
	DataService.Notify(player, "⏱️ استلمت مكافأة " .. reward.Minutes .. " دقيقة!", Color3.fromRGB(120, 255, 200))
	return { ok = true }
end

function RewardService.RedeemCode(player: Player, code: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	code = string.upper((tostring(code):gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, error = "كود غير صحيح" }
	end
	if p.Codes[code] then
		return { ok = false, error = "استخدمت هذا الكود من قبل" }
	end
	p.Codes[code] = true
	grant(player, reward)
	DataService.Notify(player, "🔑 تم تفعيل الكود " .. code .. "!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function RewardService.ClaimVIPDaily(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not DataService.HasGamepass(player, "VIP") then
		return { ok = false, error = "لأعضاء VIP فقط" }
	end
	local day = math.floor(os.time() / 86400)
	if p.VIPDaily == day then
		return { ok = false, error = "استلمت صندوق اليوم" }
	end
	p.VIPDaily = day
	grant(player, { Diamonds = Config.VIPDailyDiamonds })
	DataService.Notify(player, "👑 صندوق VIP اليومي: 💎 " .. Config.VIPDailyDiamonds, Color3.fromRGB(255, 215, 0))
	return { ok = true }
end

function RewardService.Init()
	Remotes.Function("ClaimDaily").OnServerInvoke = function(player)
		return RewardService.ClaimDaily(player)
	end
	Remotes.Function("ClaimVIPDaily").OnServerInvoke = function(player)
		return RewardService.ClaimVIPDaily(player)
	end
	Remotes.Function("ClaimPlaytime").OnServerInvoke = function(player, index)
		return RewardService.ClaimPlaytime(player, tonumber(index) or 0)
	end
	Remotes.Function("RedeemCode").OnServerInvoke = function(player, code)
		return RewardService.RedeemCode(player, tostring(code))
	end
	Remotes.Function("GetServerTime").OnServerInvoke = function()
		return os.time()
	end
	DataService.Loaded:Connect(function(player, profile)
		if Config.GroupId > 0 then
			local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
			if ok and inGroup then
				profile.InGroup = true
				DataService.MarkDirty(player)
			end
		end
	end)
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!strict
-- منح المكافآت بصيغة موحدة { Coins, Diamonds, Potion, Count, Pet, Variant, Spins, Tokens }
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local Rewards = {}

function Rewards.Grant(player: Player, reward: any, coinScale: number?)
	if type(reward) ~= "table" then
		return
	end
	if reward.Coins then
		DataService.AddCoins(player, math.floor(reward.Coins * (coinScale or 1)))
	end
	if reward.Diamonds then
		DataService.AddDiamonds(player, reward.Diamonds)
	end
	if reward.Potion then
		DataService.GivePotion(player, reward.Potion, reward.Count or 1)
	end
	if reward.Pet then
		PetService.Add(player, reward.Pet, reward.Variant or "Normal", true)
	end
	if reward.Spins then
		DataService.AddSpins(player, reward.Spins)
	end
	if reward.Tokens then
		DataService.AddTokens(player, reward.Tokens)
	end
	if reward.Gems then
		DataService.AddGems(player, reward.Gems, true)
	end
	DataService.MarkDirty(player)
end

function Rewards.Describe(reward: any, coinScale: number?): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, "💰 " .. Format.Number(reward.Coins * (coinScale or 1)))
	end
	if reward.Diamonds then
		table.insert(parts, "💎 " .. Format.Number(reward.Diamonds))
	end
	if reward.Potion then
		table.insert(parts, "🧪 " .. reward.Potion .. (reward.Count and (" x" .. reward.Count) or ""))
	end
	if reward.Pet then
		table.insert(parts, "🐾 " .. reward.Pet)
	end
	if reward.Spins then
		table.insert(parts, "🎡 " .. reward.Spins)
	end
	if reward.Tokens then
		table.insert(parts, "🔁 " .. reward.Tokens)
	end
	if reward.Gems then
		table.insert(parts, "💠 " .. Format.Number(reward.Gems))
	end
	return table.concat(parts, "  ")
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000039"><Properties><string name="Name">SeasonService</string><ProtectedString name="Source"><![CDATA[--!strict
-- باس الموسم: خبرة من الأنشطة + 30 مستوى بمسارين
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local RateLimit = require(script.Parent.RateLimit)

local SeasonService = {}

function SeasonService.Tier(xp: number): (number, number, number)
	local tier = 0
	local acc = 0
	while tier < Config.Season.Tiers and xp >= acc + Config.SeasonXPForTier(tier + 1) do
		acc += Config.SeasonXPForTier(tier + 1)
		tier += 1
	end
	local into = xp - acc
	local needed = tier < Config.Season.Tiers and Config.SeasonXPForTier(tier + 1) or 0
	return tier, into, needed
end

function SeasonService.AddXP(player: Player, amount: number)
	local p = DataService.Get(player)
	if not p or amount <= 0 then
		return
	end
	local before = SeasonService.Tier(p.Season.XP)
	p.Season.XP += amount
	local after = SeasonService.Tier(p.Season.XP)
	if after > before then
		DataService.Notify(player, "🎫 باس الموسم: المستوى " .. after .. "! استلم مكافأتك", Color3.fromRGB(255, 200, 80))
	end
	DataService.MarkDirty(player)
end

function SeasonService.Claim(player: Player, tier: number, premium: boolean): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	tier = math.floor(tier)
	if tier < 1 or tier > Config.Season.Tiers then
		return { ok = false, error = "مستوى غير صحيح" }
	end
	local current = SeasonService.Tier(p.Season.XP)
	if tier > current then
		return { ok = false, error = "لم تصل لهذا المستوى بعد" }
	end
	if premium and not DataService.HasGamepass(player, "SeasonPass") then
		return { ok = false, error = "تحتاج Season Pass" }
	end
	local store = premium and p.Season.PremiumClaimed or p.Season.Claimed
	if store[tostring(tier)] then
		return { ok = false, error = "تم الاستلام" }
	end
	store[tostring(tier)] = true
	local reward = Config.SeasonReward(tier, premium)
	Rewards.Grant(player, reward)
	DataService.Notify(player, "🎫 مستوى " .. tier .. ": " .. Rewards.Describe(reward), Color3.fromRGB(255, 200, 80))
	return { ok = true }
end

function SeasonService.Init()
	Hooks.Listen(function(player, kind, amount)
		local xp = Config.Season.XPPerAction[kind]
		if xp then
			SeasonService.AddXP(player, xp * amount)
		end
	end)
	Remotes.Function("Season").OnServerInvoke = function(player, action, payload)
		if not RateLimit.Check(player, "Season", 5) then
			return { ok = false, error = "ببطء!" }
		end
		payload = type(payload) == "table" and payload or {}
		if action == "Claim" then
			return SeasonService.Claim(player, tonumber(payload.Tier) or 0, payload.Premium == true)
		elseif action == "ClaimAll" then
			local n = 0
			for t = 1, Config.Season.Tiers do
				if SeasonService.Claim(player, t, false).ok then
					n += 1
				end
				if DataService.HasGamepass(player, "SeasonPass") and SeasonService.Claim(player, t, true).ok then
					n += 1
				end
			end
			return { ok = true, count = n }
		end
		return { ok = false, error = "إجراء غير معروف" }
	end
	table.insert(DataService.Extenders, function(_, payload)
		local tier, into, needed = SeasonService.Tier(payload.Season and payload.Season.XP or 0)
		payload.SeasonTier = tier
		payload.SeasonInto = into
		payload.SeasonNeeded = needed
	end)
end

return SeasonService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الجيم باس، المنتجات (الألماس/الجرعات)، الترقيات
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local ZoneService = require(script.Parent.ZoneService)

local ShopService = {}

local function gamepassKeyFromId(id: number): string?
	for key, gid in pairs(Config.Gamepasses) do
		if gid == id and gid > 0 then
			return key
		end
	end
	return nil
end

local function productKeyFromId(id: number): string?
	for key, pid in pairs(Config.DevProducts) do
		if pid == id and pid > 0 then
			return key
		end
	end
	return nil
end

local function grantGamepass(player: Player, key: string)
	local p = DataService.Get(player)
	if not p then
		return
	end
	p.Gamepasses[key] = true
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
end

local function refreshGamepasses(player: Player)
	for key, id in pairs(Config.Gamepasses) do
		if id > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				grantGamepass(player, key)
			end
		end
	end
end

function ShopService.UpgradeCost(key: string, level: number): number?
	for _, u in ipairs(Config.Upgrades) do
		if u.Key == key then
			if level >= u.MaxLevel then
				return nil
			end
			return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
		end
	end
	return nil
end

function ShopService.BuyUpgrade(player: Player, key: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local level = p.Upgrades[key]
	if level == nil then
		return { ok = false, error = "ترقية غير موجودة" }
	end
	local cost = ShopService.UpgradeCost(key, level)
	if not cost then
		return { ok = false, error = "وصلت للمستوى الأقصى" }
	end
	if not DataService.Spend(player, "Diamonds", cost) then
		return { ok = false, error = "تحتاج 💎 " .. cost }
	end
	p.Upgrades[key] = level + 1
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "Speed" then
		ZoneService.RefreshSpeed(player)
	end
	return { ok = true }
end

local function grantProduct(player: Player, key: string): boolean
	local info
	for _, i in ipairs(Config.DevProductInfo) do
		if i.Key == key then
			info = i
		end
	end
	if not info then
		return false
	end
	if info.Diamonds then
		DataService.AddDiamonds(player, info.Diamonds)
		DataService.Notify(player, "💎 حصلت على " .. info.Diamonds .. " ألماسة!", Color3.fromRGB(120, 220, 255))
	elseif info.Potion then
		DataService.GivePotion(player, info.Potion, info.Count or 1)
	elseif info.Spins then
		DataService.AddSpins(player, info.Spins)
		DataService.Notify(player, "🎡 حصلت على " .. info.Spins .. " لفات!", Color3.fromRGB(255, 220, 60))
	elseif info.Gems then
		DataService.AddGems(player, info.Gems)
		DataService.Notify(player, "💠 حصلت على " .. info.Gems .. " جوهرة!", Color3.fromRGB(180, 120, 255))
	end
	return true
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player or not DataService.Get(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = productKeyFromId(receipt.ProductId)
		if key and grantProduct(player, key) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = gamepassKeyFromId(passId)
		if key then
			grantGamepass(player, key)
			DataService.Notify(player, "✅ تم شراء " .. key .. "!", Color3.fromRGB(120, 255, 140))
		end
	end)

	Remotes.Event("PromptPurchase").OnServerEvent:Connect(function(player, kind, key)
		key = tostring(key)
		if kind == "Gamepass" then
			local id = Config.Gamepasses[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم الجيم باس بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		elseif kind == "Product" then
			local id = Config.DevProducts[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم المنتج بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		end
	end)

	Remotes.Function("BuyUpgrade").OnServerInvoke = function(player, key)
		return ShopService.BuyUpgrade(player, tostring(key))
	end

	DataService.Loaded:Connect(function(player)
		task.spawn(refreshGamepasses, player)
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">SpinService</string><ProtectedString name="Source"><![CDATA[--!strict
-- عجلة الحظ: لفة مجانية يومياً + لفات إضافية
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local RateLimit = require(script.Parent.RateLimit)

local SpinService = {}
local rng = Random.new()

local function coinScale(p: DataService.Profile): number
	local best = 1
	for k in pairs(p.UnlockedZones) do
		local z = Zones.Get(tonumber(k) or 1)
		if z then
			best = math.max(best, z.Multiplier)
		end
	end
	return best * 500
end

function SpinService.Spin(player: Player, paid: boolean): { ok: boolean, error: string?, index: number?, reward: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Spin", 1, 4) then
		return { ok = false, error = "انتظر انتهاء اللفة" }
	end
	local day = math.floor(os.time() / 86400)
	if p.SpinDay ~= day then
		p.SpinDay = day
	elseif p.Spins > 0 then
		p.Spins -= 1
	elseif paid then
		if not DataService.Spend(player, "Diamonds", Config.Spin.ExtraSpinCost) then
			return { ok = false, error = "تحتاج 💎 " .. Config.Spin.ExtraSpinCost }
		end
	else
		return { ok = false, error = "لا تملك لفات. اللفة المجانية غداً" }
	end
	local total = 0
	for _, s in ipairs(Config.Spin.Segments) do
		total += s.Weight
	end
	local r = rng:NextNumber() * total
	local index = #Config.Spin.Segments
	for i, s in ipairs(Config.Spin.Segments) do
		r -= s.Weight
		if r <= 0 then
			index = i
			break
		end
	end
	local seg = Config.Spin.Segments[index]
	local scale = coinScale(p)
	Rewards.Grant(player, seg, scale)
	p.Stats.Spins += 1
	DataService.MarkDirty(player)
	return { ok = true, index = index, reward = Rewards.Describe(seg, scale) }
end

function SpinService.Init()
	Remotes.Function("Spin").OnServerInvoke = function(player, paid)
		return SpinService.Spin(player, paid == true)
	end
	table.insert(DataService.Extenders, function(_, payload)
		payload.FreeSpin = payload.SpinDay ~= math.floor(os.time() / 86400)
	end)
end

return SpinService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">TitleService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الألقاب ولوحة الاسم فوق الرأس (لقب + رتبة الريبيرث + VIP)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local TitleService = {}

function TitleService.Available(p: DataService.Profile): { string }
	local out = {}
	for _, t in ipairs(Config.Titles) do
		local ok = true
		if t.Achievement then
			ok = p.Achievements[t.Achievement] == true
		elseif t.Stat then
			ok = (p.Stats[t.Stat] or 0) >= (t.Target or 0)
		end
		if ok then
			table.insert(out, t.Id)
		end
	end
	return out
end

local function rankIcon(rebirths: number): string
	local icon = ""
	for _, r in ipairs(Config.RebirthRanks) do
		if rebirths >= r[1] then
			icon = r[2]
		end
	end
	return icon
end

function TitleService.Refresh(player: Player)
	local p = DataService.Get(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not p or not head then
		return
	end
	local titleName = ""
	for _, t in ipairs(Config.Titles) do
		if t.Id == p.Title and t.Id ~= "" then
			titleName = t.Name
		end
	end
	local rank = rankIcon(p.Rebirths)
	local vip = DataService.HasGamepass(player, "VIP")
	local lines = {}
	if vip then
		table.insert(lines, "👑 VIP")
	end
	if titleName ~= "" then
		table.insert(lines, titleName)
	end
	if rank ~= "" then
		table.insert(lines, rank .. " ريبيرث " .. p.Rebirths)
	end
	local existing = head:FindFirstChild("VIPTag") or head:FindFirstChild("NameTag")
	if existing then
		existing:Destroy()
	end
	if #lines == 0 then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "NameTag"
	bb.Size = UDim2.fromScale(7, #lines * 0.7)
	bb.StudsOffset = Vector3.new(0, 2.4 + #lines * 0.35, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = table.concat(lines, "\n")
	l.TextColor3 = vip and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(255, 255, 255)
	l.TextStrokeTransparency = 0.2
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Parent = bb
	bb.Parent = head
end

function TitleService.Set(player: Player, id: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not table.find(TitleService.Available(p), id) then
		return { ok = false, error = "لم تفتح هذا اللقب بعد" }
	end
	p.Title = id
	DataService.MarkDirty(player)
	TitleService.Refresh(player)
	return { ok = true }
end

function TitleService.Init()
	Remotes.Function("Title").OnServerInvoke = function(player, id)
		return TitleService.Set(player, tostring(id))
	end
	table.insert(DataService.Extenders, function(player, payload)
		local p = DataService.Get(player)
		payload.TitlesAvailable = p and TitleService.Available(p) or {}
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			TitleService.Refresh(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in ipairs(Players:GetPlayers()) do
		hook(pl)
	end
	DataService.Loaded:Connect(function(player)
		task.delay(1, TitleService.Refresh, player)
	end)
	-- تحديث دوري (الريبيرث/الإنجازات قد تتغير)
	task.spawn(function()
		while true do
			task.wait(30)
			for _, pl in ipairs(Players:GetPlayers()) do
				TitleService.Refresh(pl)
			end
		end
	end)
end

return TitleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--!strict
-- نظام التبادل بين اللاعبين مع تأكيد مزدوج وعدّ تنازلي
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local RateLimit = require(script.Parent.RateLimit)
local Hooks = require(script.Parent.Hooks)

local TradeService = {}

type Trade = {
	A: Player,
	B: Player,
	Offers: { [Player]: { string } },
	Gems: { [Player]: number },
	Confirmed: { [Player]: boolean },
	Countdown: number?,
	Token: number,
}

local trades: { [Player]: Trade } = {}
local pending: { [Player]: Player } = {} -- target -> requester
local tokenCounter = 0

local function other(t: Trade, player: Player): Player
	return t.A == player and t.B or t.A
end

local function petsFor(player: Player, uids: { string }): { any }
	local p = DataService.Get(player)
	local out = {}
	if not p then
		return out
	end
	for _, uid in ipairs(uids) do
		local pet = PetService.Find(p, uid)
		if pet then
			table.insert(out, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant, Level = pet.Level, Enchants = pet.Enchants })
		end
	end
	return out
end

local function broadcast(t: Trade)
	for _, player in ipairs({ t.A, t.B }) do
		local o = other(t, player)
		Remotes.Event("TradeUpdate"):FireClient(player, {
			Partner = { Name = o.Name, UserId = o.UserId, DisplayName = o.DisplayName },
			MyOffer = petsFor(player, t.Offers[player]),
			TheirOffer = petsFor(o, t.Offers[o]),
			MyGems = t.Gems[player] or 0,
			TheirGems = t.Gems[o] or 0,
			MyConfirmed = t.Confirmed[player],
			TheirConfirmed = t.Confirmed[o],
			Countdown = t.Countdown,
		})
	end
end

local function cancel(t: Trade, reason: string?)
	trades[t.A] = nil
	trades[t.B] = nil
	for _, player in ipairs({ t.A, t.B }) do
		if player.Parent == Players then
			Remotes.Event("TradeUpdate"):FireClient(player, nil)
			if reason then
				DataService.Notify(player, reason, Color3.fromRGB(255, 120, 120))
			end
		end
	end
end

local function execute(t: Trade)
	local pa, pb = DataService.Get(t.A), DataService.Get(t.B)
	if not pa or not pb then
		cancel(t, "فشل التبادل")
		return
	end
	local function validate(p: DataService.Profile, uids: { string }): boolean
		for _, uid in ipairs(uids) do
			local pet = PetService.Find(p, uid)
			if not pet or pet.Locked then
				return false
			end
		end
		return true
	end
	if not validate(pa, t.Offers[t.A]) or not validate(pb, t.Offers[t.B]) then
		cancel(t, "تغيرت الحيوانات، أُلغي التبادل")
		return
	end
	if #pa.Pets - #t.Offers[t.A] + #t.Offers[t.B] > PetService.StorageCapacity(t.A) then
		cancel(t, "مخزن " .. t.A.Name .. " ممتلئ")
		return
	end
	if #pb.Pets - #t.Offers[t.B] + #t.Offers[t.A] > PetService.StorageCapacity(t.B) then
		cancel(t, "مخزن " .. t.B.Name .. " ممتلئ")
		return
	end
	local gA, gB = t.Gems[t.A] or 0, t.Gems[t.B] or 0
	if pa.Gems < gA or pb.Gems < gB then
		cancel(t, "أحد الطرفين لا يملك الجواهر المعروضة")
		return
	end
	pa.Gems -= gA
	pb.Gems += gA
	pb.Gems -= gB
	pa.Gems += gB
	local movedA, movedB = {}, {}
	for _, uid in ipairs(t.Offers[t.A]) do
		table.insert(movedA, PetService.Remove(pa, uid))
	end
	for _, uid in ipairs(t.Offers[t.B]) do
		table.insert(movedB, PetService.Remove(pb, uid))
	end
	for _, pet in ipairs(movedA) do
		pet.Equipped = false
		pet.Locked = false
		table.insert(pb.Pets, pet)
		pb.Index[pet.Id] = true
	end
	for _, pet in ipairs(movedB) do
		pet.Equipped = false
		pet.Locked = false
		table.insert(pa.Pets, pet)
		pa.Index[pet.Id] = true
	end
	pa.Stats.Trades += 1
	pb.Stats.Trades += 1
	Hooks.Fire(t.A, "Trade", 1)
	Hooks.Fire(t.B, "Trade", 1)
	DataService.MarkDirty(t.A)
	DataService.MarkDirty(t.B)
	PetService.UpdateEquippedAttribute(t.A)
	PetService.UpdateEquippedAttribute(t.B)
	trades[t.A] = nil
	trades[t.B] = nil
	for _, player in ipairs({ t.A, t.B }) do
		Remotes.Event("TradeUpdate"):FireClient(player, nil)
		DataService.Notify(player, "🤝 تم التبادل بنجاح!", Color3.fromRGB(120, 255, 140))
	end
end

local function startCountdown(t: Trade)
	tokenCounter += 1
	local token = tokenCounter
	t.Token = token
	t.Countdown = Config.TradeCountdown
	broadcast(t)
	task.spawn(function()
		for i = Config.TradeCountdown, 1, -1 do
			task.wait(1)
			if trades[t.A] ~= t or t.Token ~= token then
				return
			end
			t.Countdown = i - 1
			broadcast(t)
		end
		if trades[t.A] == t and t.Token == token and t.Confirmed[t.A] and t.Confirmed[t.B] then
			execute(t)
		end
	end)
end

local function resetConfirm(t: Trade)
	t.Confirmed[t.A] = false
	t.Confirmed[t.B] = false
	t.Countdown = nil
	t.Token += 1
end

function TradeService.Init()
	Remotes.Event("TradeRequest").OnServerEvent:Connect(function(player, targetId)
		if not RateLimit.Check(player, "TradeReq", 3, 5) then
			return
		end
		local target = Players:GetPlayerByUserId(tonumber(targetId) or 0)
		if not target or target == player or trades[player] or trades[target] then
			DataService.Notify(player, "اللاعب غير متاح للتبادل", Color3.fromRGB(255, 120, 120))
			return
		end
		pending[target] = player
		Remotes.Event("TradeIncoming"):FireClient(target, { FromUserId = player.UserId, FromName = player.DisplayName })
		DataService.Notify(player, "📨 أُرسل طلب التبادل إلى " .. target.DisplayName, Color3.fromRGB(120, 200, 255))
	end)

	Remotes.Event("TradeRespond").OnServerEvent:Connect(function(player, fromId, accept)
		local requester = pending[player]
		if not requester or requester.UserId ~= tonumber(fromId) then
			return
		end
		pending[player] = nil
		if not accept or requester.Parent ~= Players or trades[requester] or trades[player] then
			if requester.Parent == Players then
				DataService.Notify(requester, player.DisplayName .. " رفض التبادل", Color3.fromRGB(255, 120, 120))
			end
			return
		end
		local t: Trade = { A = requester, B = player, Offers = { [requester] = {}, [player] = {} }, Gems = { [requester] = 0, [player] = 0 }, Confirmed = { [requester] = false, [player] = false }, Countdown = nil, Token = 0 }
		trades[requester] = t
		trades[player] = t
		broadcast(t)
	end)

	Remotes.Event("TradeAction").OnServerEvent:Connect(function(player, action, payload)
		local t = trades[player]
		if not t then
			return
		end
		if not RateLimit.Check(player, "TradeAct", 15) then
			return
		end
		payload = type(payload) == "table" and payload or {}
		if action == "Add" then
			local p = DataService.Get(player)
			local uid = tostring(payload.Uid)
			local pet = p and PetService.Find(p, uid)
			if not pet or pet.Locked or table.find(t.Offers[player], uid) or #t.Offers[player] >= Config.TradeMaxPets then
				return
			end
			table.insert(t.Offers[player], uid)
			resetConfirm(t)
		elseif action == "Remove" then
			local idx = table.find(t.Offers[player], tostring(payload.Uid))
			if idx then
				table.remove(t.Offers[player], idx)
				resetConfirm(t)
			end
		elseif action == "SetGems" then
			local p = DataService.Get(player)
			local amount = math.floor(tonumber(payload.Amount) or 0)
			if not p or amount < 0 or amount > p.Gems then
				DataService.Notify(player, "لا تملك هذا العدد من الجواهر", Color3.fromRGB(255, 120, 120))
				return
			end
			t.Gems[player] = amount
			resetConfirm(t)
		elseif action == "Confirm" then
			t.Confirmed[player] = not t.Confirmed[player]
			t.Countdown = nil
			t.Token += 1
			if t.Confirmed[t.A] and t.Confirmed[t.B] then
				startCountdown(t)
				return
			end
		elseif action == "Cancel" then
			cancel(t, "أُلغي التبادل")
			return
		end
		broadcast(t)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local t = trades[player]
		if t then
			cancel(t, "غادر الطرف الآخر")
		end
		pending[player] = nil
	end)
end

return TradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">TreasureService</string><ProtectedString name="Source"><![CDATA[--!strict
-- كنز عشوائي يظهر في منطقة عشوائية كل فترة
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local BreakableService = require(script.Parent.BreakableService)
local MapBuilder = require(script.Parent.MapBuilder)
local Rewards = require(script.Parent.Rewards)

local TreasureService = {}
local rng = Random.new()

local function spawnTreasure()
	-- منطقة يستطيع أحد اللاعبين الوصول لها
	local candidates = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local p = DataService.Get(pl)
		if p then
			for k in pairs(p.UnlockedZones) do
				local idx = tonumber(k)
				if idx and idx <= 10 and not table.find(candidates, idx) then
					table.insert(candidates, idx)
				end
			end
		end
	end
	if #candidates == 0 then
		return
	end
	local zoneIdx = candidates[rng:NextInteger(1, #candidates)]
	local layout = MapBuilder.Zones[zoneIdx]
	local zone = Zones.Get(zoneIdx)
	if not layout or not zone then
		return
	end
	local spot = layout.Spots[rng:NextInteger(1, #layout.Spots)] + Vector3.new(0, 0, 6)
	local id = BreakableService.SpawnDynamic("Treasure", zoneIdx, spot, {
		Health = math.floor(3000 * zone.Multiplier),
		Lifetime = Config.Treasure.Lifetime,
		Name = "💰 كنز!",
		OnBroken = function(contributors)
			for pl in pairs(contributors) do
				local p = DataService.Get(pl)
				if pl.Parent == Players and p then
					Rewards.Grant(pl, { Diamonds = Config.Treasure.Diamonds, Gems = Config.Treasure.Gems })
					p.Stats.Treasures += 1
					if rng:NextNumber() < Config.Treasure.PetChance then
						PetService.Add(pl, Config.Treasure.Pet, "Normal", true)
						DataService.Notify(pl, "🐢 حصلت على Treasure Turtle!", Color3.fromRGB(255, 215, 0))
					end
					DataService.MarkDirty(pl)
				end
			end
			DataService.NotifyAll("💰 تم فتح الكنز في " .. zone.Name .. "!", Color3.fromRGB(255, 215, 0))
		end,
	})
	if id then
		DataService.NotifyAll("🗺️ ظهر صندوق كنز في " .. zone.Name .. " (" .. zone.Arabic .. ")! لديك " .. Config.Treasure.Lifetime .. " ثانية", Color3.fromRGB(255, 215, 0))
		Remotes.Event("EventEffect"):FireAllClients({ Type = "Treasure", Zone = zoneIdx })
	end
end

function TreasureService.Init()
	task.spawn(function()
		while true do
			task.wait(Config.Treasure.Interval)
			if #Players:GetPlayers() > 0 then
				spawnTreasure()
			end
		end
	end)
end

return TreasureService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source"><![CDATA[--!strict
-- فتح المناطق، البوابات، التنقل، بوابة VIP، سرعة المشي
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local Hooks = require(script.Parent.Hooks)
local PetUtil = require(Shared.Modules.PetUtil)

local ZoneService = {}

local touchDebounce: { [Player]: number } = {}

function ZoneService.Unlock(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local zone = Zones.List[index]
	if not p or not zone then
		return { ok = false, error = "منطقة غير موجودة" }
	end
	if p.UnlockedZones[tostring(index)] then
		return { ok = true }
	end
	local required = Zones.RebirthRequired(index)
	if required > 0 and p.Rebirths < required then
		return { ok = false, error = "هذا العالم يتطلب " .. required .. " ريبيرث" }
	end
	if not Zones.IsWorldStart(index) and not p.UnlockedZones[tostring(index - 1)] then
		return { ok = false, error = "افتح المنطقة السابقة أولاً" }
	end
	if not DataService.Spend(player, "Coins", zone.Cost) then
		return { ok = false, error = "تحتاج 💰 " .. Format.Number(zone.Cost) .. " لفتح " .. zone.Name }
	end
	p.UnlockedZones[tostring(index)] = true
	Hooks.Fire(player, "Zone", index)
	DataService.MarkDirty(player)
	Remotes.Event("EventEffect"):FireClient(player, { Type = "ZoneUnlock", Zone = index })
	DataService.Notify(player, "🔓 فتحت منطقة " .. zone.Name .. " (" .. zone.Arabic .. ")!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function ZoneService.Teleport(player: Player, index: number): boolean
	local p = DataService.Get(player)
	if not p then
		return false
	end
	if index == 0 then
		if not DataService.HasGamepass(player, "VIP") then
			return false
		end
	elseif index == -1 or index == -2 then
		-- السوق والزنزانة متاحان للجميع
	elseif not p.UnlockedZones[tostring(index)] then
		return false
	elseif p.Rebirths < Zones.RebirthRequired(index) then
		return false
	end
	local layout = MapBuilder.Zones[index]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not layout or not hrp then
		return false
	end
	hrp.CFrame = CFrame.new(layout.Spawn + Vector3.new(0, 4, 0), layout.Center)
	p.LastZone = index
	DataService.MarkDirty(player)
	return true
end

local function onGateTouched(gate: BasePart, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 1.5 then
		return
	end
	touchDebounce[player] = now
	local index = gate:GetAttribute("Zone") :: number
	local p = DataService.Get(player)
	if not p or p.UnlockedZones[tostring(index)] then
		return
	end
	local res = ZoneService.Unlock(player, index)
	if not res.ok and res.error then
		DataService.Notify(player, res.error, Color3.fromRGB(255, 120, 120))
	end
end

local function onPortalTouched(kind: string, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 2 then
		return
	end
	touchDebounce[player] = now
	if kind == "VIP" then
		if DataService.HasGamepass(player, "VIP") then
			ZoneService.Teleport(player, 0)
		else
			DataService.Notify(player, "👑 منطقة VIP لأصحاب جيم باس VIP", Color3.fromRGB(255, 215, 0))
			if Config.Gamepasses.VIP > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, Config.Gamepasses.VIP)
			end
		end
	elseif kind == "World2" or kind == "World3" then
		local p = DataService.Get(player)
		if not p then
			return
		end
		local start = kind == "World2" and Zones.WorldStart[2] or Zones.WorldStart[3]
		if not p.UnlockedZones[tostring(start)] then
			local res = ZoneService.Unlock(player, start)
			if not res.ok then
				DataService.Notify(player, res.error or "لا يمكن الدخول", Color3.fromRGB(255, 120, 120))
				return
			end
		end
		ZoneService.Teleport(player, start)
	elseif kind == "World1" then
		ZoneService.Teleport(player, Zones.WorldStart[2] - 1)
	elseif kind == "BackWorld2" then
		ZoneService.Teleport(player, Zones.WorldStart[3] - 1)
	elseif kind == "Market" then
		ZoneService.Teleport(player, -1)
	elseif kind == "Dungeon" then
		ZoneService.Teleport(player, -2)
	elseif kind == "MarketReturn" or kind == "DungeonReturn" then
		ZoneService.Teleport(player, 1)
	else
		ZoneService.Teleport(player, 1)
	end
end

local function computeSpeed(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 16
	end
	local agility = PetUtil.EnchantBonuses(p.Pets).Agility or 0
	local board = tonumber(player:GetAttribute("BoardSpeed")) or 0
	return 16 + (p.Upgrades.Speed or 0) * 2 + agility + board
end

local function applyCharacter(player: Player, char: Model)
	local p = DataService.Get(player)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum and p then
		hum.WalkSpeed = computeSpeed(player)
	end
	task.wait(0.3)
	if p and p.LastZone and p.LastZone ~= 1 then
		ZoneService.Teleport(player, p.LastZone)
	end
	if DataService.HasGamepass(player, "VIP") then
		player:SetAttribute("VIP", true)
		local head = char:FindFirstChild("Head")
		if head and not head:FindFirstChild("VIPTag") then
			local bb = Instance.new("BillboardGui")
			bb.Name = "VIPTag"
			bb.Size = UDim2.fromScale(4, 1)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.AlwaysOnTop = true
			local l = Instance.new("TextLabel")
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Text = "👑 VIP"
			l.TextColor3 = Color3.fromRGB(255, 215, 0)
			l.TextStrokeTransparency = 0.2
			l.Font = Enum.Font.FredokaOne
			l.TextScaled = true
			l.Parent = bb
			bb.Parent = head
		end
	end
end

function ZoneService.RefreshSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = computeSpeed(player)
	end
end

function ZoneService.Init()
	for index, layout in pairs(MapBuilder.Zones) do
		if layout.Gate then
			local gate = layout.Gate
			gate.Touched:Connect(function(hit)
				onGateTouched(gate, hit)
			end)
		end
	end
	if MapBuilder.VIPPortal then
		MapBuilder.VIPPortal.Touched:Connect(function(hit)
			onPortalTouched("VIP", hit)
		end)
	end
	if MapBuilder.VIPReturnPortal then
		MapBuilder.VIPReturnPortal.Touched:Connect(function(hit)
			onPortalTouched("Return", hit)
		end)
	end
	if MapBuilder.World2Portal then
		MapBuilder.World2Portal.Touched:Connect(function(hit)
			onPortalTouched("World2", hit)
		end)
	end
	if MapBuilder.World1Portal then
		MapBuilder.World1Portal.Touched:Connect(function(hit)
			onPortalTouched("World1", hit)
		end)
	end
	for kind, portal in pairs(MapBuilder.Portals) do
		portal.Touched:Connect(function(hit)
			onPortalTouched(kind, hit)
		end)
	end
	-- تحديث السرعة عند تغير الإنشانتات (عبر تغير الحيوانات المجهزة)
	Players.PlayerAdded:Connect(function(player)
		player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
			ZoneService.RefreshSpeed(player)
		end)
	end)

	Remotes.Function("UnlockZone").OnServerInvoke = function(player, index)
		return ZoneService.Unlock(player, tonumber(index) or 0)
	end
	Remotes.Event("Teleport").OnServerEvent:Connect(function(player, index)
		ZoneService.Teleport(player, tonumber(index) or 1)
	end)

	local function hook(player: Player)
		if player:GetAttribute("ZoneHooked") then
			return
		end
		player:SetAttribute("ZoneHooked", true)
		player.CharacterAdded:Connect(function(char)
			applyCharacter(player, char)
		end)
		if player.Character then
			task.spawn(applyCharacter, player, player.Character)
		end
	end
	DataService.Loaded:Connect(function(player)
		hook(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		touchDebounce[player] = nil
	end)
end

return ZoneService
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="Folder" referent="RBX000074"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX000048"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--!strict
-- نقطة تشغيل العميل
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
Remotes.Init()

local Controllers = script.Parent:WaitForChild("Controllers")

local LoadingScreen = require(Controllers.LoadingScreen)
LoadingScreen.Show()

local DataController = require(Controllers.DataController)
local UIController = require(Controllers.UIController)
local InventoryUI = require(Controllers.InventoryUI)
local ShopUI = require(Controllers.ShopUI)
local MachineUI = require(Controllers.MachineUI)
local MissionsUI = require(Controllers.MissionsUI)
local StatsUI = require(Controllers.StatsUI)
local TradeUI = require(Controllers.TradeUI)
local SpinUI = require(Controllers.SpinUI)
local MerchantUI = require(Controllers.MerchantUI)
local AdminUI = require(Controllers.AdminUI)
local MarketUI = require(Controllers.MarketUI)
local SeasonUI = require(Controllers.SeasonUI)
local CraftUI = require(Controllers.CraftUI)
local CosmeticUI = require(Controllers.CosmeticUI)
local LeaderboardUI = require(Controllers.LeaderboardUI)
local EggController = require(Controllers.EggController)
local PetController = require(Controllers.PetController)
local BreakableController = require(Controllers.BreakableController)
local ZoneController = require(Controllers.ZoneController)
local EffectsController = require(Controllers.EffectsController)

DataController.Init()
DataController.Wait()

UIController.Init()
InventoryUI.Init()
ShopUI.Init()
EffectsController.Init()
MachineUI.Init()
MissionsUI.Init()
StatsUI.Init()
TradeUI.Init()
SpinUI.Init()
MerchantUI.Init()
AdminUI.Init()
MarketUI.Init()
SeasonUI.Init()
CraftUI.Init()
CosmeticUI.Init()
LeaderboardUI.Init()
EggController.Init()
PetController.Init()
BreakableController.Init()
ZoneController.Init()

LoadingScreen.Hide()

-- شارة VIP في الشات
local TextChatService = game:GetService("TextChatService")
local Players = game:GetService("Players")
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				props.PrefixText = "<font color='#FFD700'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return props
	end
end

print("[PetKingdom] Client ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000073"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">AdminUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحة الأدمن
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local UIController = require(script.Parent.UIController)

local AdminUI = {}

function AdminUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Admin", "🛠️ لوحة الأدمن", UDim2.fromOffset(520, 520), UIKit.Colors.Red)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 8)
	local function run(cmd: string, payload: any)
		local res = Remotes.Function("Admin"):InvokeServer(cmd, payload)
		UIController.Notify(res.ok and ("✅ " .. cmd) or (res.error or "خطأ"), res.ok and UIKit.Colors.Green or UIKit.Colors.Red)
	end
	local function inputRow(label: string, placeholder: string, cmd: string, build: (string) -> any)
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = label, Size = UDim2.fromOffset(150, 46), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = row })
		local box = UIKit.New("TextBox", { Size = UDim2.new(1, -280, 0, 34), Position = UDim2.fromOffset(160, 6), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = placeholder, Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 18, ClearTextOnFocus = false, Parent = row }) :: TextBox
		UIKit.Corner(box, 8)
		UIKit.Button({ Text = "تنفيذ", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(100, 34), Position = UDim2.new(1, -108, 0, 6), MaxTextSize = 16, Parent = row }, function()
			run(cmd, build(box.Text))
		end)
	end
	local function num(t: string)
		return { Amount = tonumber(t) or 0 }
	end
	inputRow("💰 عملات", "1000000", "Coins", num)
	inputRow("💎 ألماس", "10000", "Diamonds", num)
	inputRow("🔁 توكنات", "5", "Tokens", num)
	inputRow("🎡 لفات", "5", "Spins", num)
	inputRow("🔁 عدد الريبيرث", "3", "Rebirths", num)
	inputRow("🐾 حيوان (id [variant])", "huge_cat Rainbow", "Pet", function(t)
		local id, variant = t:match("^(%S+)%s*(%S*)$")
		return { Id = id or t, Variant = (variant ~= "" and variant) or "Normal" }
	end)
	inputRow("🧪 جرعة (key عدد)", "Lucky 3", "Potion", function(t)
		local key, count = t:match("^(%S+)%s*(%S*)$")
		return { Id = key or t, Amount = tonumber(count) or 1 }
	end)
	local evRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(evRow, 6, true)
	for _, e in ipairs(Config.Events.List) do
		UIKit.Button({ Text = e.Name, Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(92, 40), MaxTextSize = 13, Parent = evRow }, function()
			run("Event", { Id = e.Id })
		end)
	end
	local misc = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(misc, 6, true)
	UIKit.Button({ Text = "🔓 فتح كل المناطق", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(200, 40), MaxTextSize = 16, Parent = misc }, function()
		run("UnlockAll", {})
	end)
	UIKit.Button({ Text = "⚠️ تصفير بياناتي", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(200, 40), MaxTextSize = 16, Parent = misc }, function()
		run("Reset", {})
	end)
	UIController.Register("Admin", w)
end

return AdminUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">BreakableController</string><ProtectedString name="Source"><![CDATA[--!strict
-- أشرطة الصحة فوق الصناديق، تأثير الضرب، ونوافذ المكافأة
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local EffectsController = require(script.Parent.EffectsController)

local BreakableController = {}

local function attach(model: Model)
	local root = model.PrimaryPart or model:FindFirstChild("Base") :: BasePart?
	if not root then
		return
	end
	local typeName = model:GetAttribute("Type") :: string
	local def = Breakables.Get(typeName or "")
	local bb = Instance.new("BillboardGui")
	bb.Name = "HealthBar"
	bb.Size = UDim2.fromOffset(150, 52)
	bb.StudsOffset = Vector3.new(0, root.Size.Y / 2 + 3, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	local name = UIKit.Label({ Text = def and def.Name or typeName, Size = UDim2.new(1, 0, 0, 22), TextStrokeTransparency = 0.2, Parent = bb })
	local coins = model:GetAttribute("Coins") :: number
	local diamonds = model:GetAttribute("Diamonds") :: number
	local rewardText = ""
	if coins and coins > 0 then
		rewardText = "💰 " .. Format.Number(coins)
	end
	if diamonds and diamonds > 0 then
		rewardText = rewardText .. " 💎 " .. diamonds
	end
	UIKit.Label({ Text = rewardText, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 22), TextColor3 = UIKit.Colors.Gold, Parent = bb })
	local _bg, fill, label = UIKit.ProgressBar(bb, UIKit.Colors.Green, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 40))
	label.Visible = false
	local function update()
		local h = model:GetAttribute("Health") :: number or 0
		local mh = model:GetAttribute("MaxHealth") :: number or 1
		local ratio = math.clamp(h / mh, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = ratio > 0.5 and UIKit.Colors.Green or (ratio > 0.2 and UIKit.Colors.Gold or UIKit.Colors.Red)
		name.Text = (def and def.Name or typeName) .. "  " .. Format.Number(h)
	end
	update()
	model:GetAttributeChangedSignal("Health"):Connect(update)
	model:GetAttributeChangedSignal("LastHit"):Connect(function()
		local by = model:GetAttribute("LastHitBy")
		local dmg = model:GetAttribute("LastDamage")
		local p = DataController.Profile
		if by == Players.LocalPlayer.UserId and type(dmg) == "number" and p and p.Settings.DamageNumbers ~= false then
			local crit = model:GetAttribute("LastCrit") == true
			if crit then
				EffectsController.Shockwave(root.Position, Color3.fromRGB(255, 200, 40))
			end
			local anchor = Instance.new("Part")
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.Transparency = 1
			anchor.Size = Vector3.new(1, 1, 1)
			anchor.Position = root.Position + Vector3.new(math.random(-2, 2), root.Size.Y / 2, math.random(-2, 2))
			anchor.Parent = Workspace
			local dbb = Instance.new("BillboardGui")
			dbb.Size = UDim2.fromOffset(160, 40)
			dbb.AlwaysOnTop = true
			local dl = UIKit.Label({ Text = (crit and "💥 " or "-") .. Format.Number(dmg), TextColor3 = crit and UIKit.Colors.Gold or Color3.fromRGB(255, 90, 90), TextStrokeTransparency = 0, MaxTextSize = crit and 30 or 22, Parent = dbb })
			dbb.Parent = anchor
			UIKit.Tween(dbb, { StudsOffset = Vector3.new(0, 4, 0) }, 0.8)
			UIKit.Tween(dl, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(anchor, 0.9)
		end
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.new(1, 1, 1)
		hl.FillTransparency = 0.3
		hl.OutlineTransparency = 1
		hl.Parent = model
		UIKit.Tween(hl, { FillTransparency = 1 }, 0.25)
		Debris:AddItem(hl, 0.3)
	end)
	bb.Parent = root
end

local function popup(data: any)
	local pos = data.Position :: Vector3
	local text = ""
	if data.Coins and data.Coins > 0 then
		text = "+" .. Format.Number(data.Coins) .. " 💰"
	end
	if data.Diamonds and data.Diamonds > 0 then
		text = text .. "  +" .. data.Diamonds .. " 💎"
	end
	if data.Gems and data.Gems > 0 then
		text = text .. "  +" .. data.Gems .. " 💠"
	end
	if text == "" then
		return
	end
	EffectsController.Burst(pos, data.Color or Color3.fromRGB(255, 200, 40), 24, 0.5)
	EffectsController.Play("Break")
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = pos
	anchor.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.AlwaysOnTop = true
	bb.StudsOffset = Vector3.new(0, 0, 0)
	local label = UIKit.Label({ Text = text, TextColor3 = UIKit.Colors.Gold, TextStrokeTransparency = 0, Parent = bb })
	bb.Parent = anchor
	UIKit.Tween(bb, { StudsOffset = Vector3.new(0, 6, 0) }, 1.2)
	UIKit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(anchor, 1.3)
end

function BreakableController.Init()
	local folder = Workspace:WaitForChild("Breakables")
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") then
			attach(m)
		end
	end
	folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") and not m:FindFirstChild("HealthBar", true) then
			task.defer(attach, m)
		end
	end)
	Remotes.Event("RewardPopup").OnClientEvent:Connect(popup)
end

return BreakableController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">CosmeticUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- البيضة التجميلية: الإكسسوارات
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local EffectsController = require(script.Parent.EffectsController)

local CosmeticUI = {}

function CosmeticUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Cosmetic", "🎩 البيضة التجميلية", UDim2.fromOffset(700, 520), UIKit.Colors.Pink)
	UIKit.Label({ Text = "افتح البيضة التجميلية لتحصل على إكسسوار عشوائي، ثم جهّزه على أي حيوان من نافذة الحيوانات.", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = w.Content })
	local grid = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 300), Position = UDim2.fromOffset(0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.Grid(grid, UDim2.fromOffset(150, 130), 8)
	local counts: { [string]: TextLabel } = {}
	local total = 0
	for _, a in ipairs(Config.Accessories) do
		total += a.Chance
	end
	for i, a in ipairs(Config.Accessories) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = grid })
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, a.Color, 2)
		UIKit.Label({ Text = a.Icon, Size = UDim2.new(1, 0, 0, 56), MaxTextSize = 44, Parent = card })
		UIKit.Label({ Text = a.Name, Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 58), MaxTextSize = 15, Parent = card })
		UIKit.Label({ Text = string.format("%.1f%%", a.Chance / total * 100), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 82), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 13, Parent = card })
		counts[a.Id] = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 104), TextColor3 = UIKit.Colors.Green, MaxTextSize = 13, Parent = card })
	end
	local result = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -90), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 22, Parent = w.Content })
	local hatching = false
	UIKit.Button({ Text = "🥚 فتح (💎 " .. Config.CosmeticEggCost .. ")", Color = UIKit.Colors.Pink, Size = UDim2.fromOffset(300, 48), Position = UDim2.new(0.5, -150, 1, -52), MaxTextSize = 20, Parent = w.Content }, function()
		if hatching then
			return
		end
		hatching = true
		local res = Remotes.Function("Cosmetic"):InvokeServer("Hatch")
		if res.ok then
			for _, a in ipairs(Config.Accessories) do
				if a.Id == res.result then
					result.Text = "🎉 " .. a.Icon .. " " .. a.Name .. "!"
					UIKit.Pop(result)
				end
			end
			EffectsController.Play("Hatch")
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
		hatching = false
	end)
	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for id, label in pairs(counts) do
			local n = p.Accessories[id] or 0
			label.Text = n > 0 and ("تملك: " .. n) or ""
		end
	end
	UIController.Register("Cosmetic", w, refresh)
end

return CosmeticUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">CraftUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- محطة التصنيع
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)

local CraftUI = {}

local function have(p: any, input: any): number
	local n = 0
	for _, pet in ipairs(p.Pets) do
		if not pet.Locked then
			local def = Pets.Get(pet.Id)
			if (input.Pet == nil or pet.Id == input.Pet) and (input.Rarity == nil or (def and def.Rarity == input.Rarity)) and (input.Variant or "Normal") == pet.Variant then
				n += 1
			end
		end
	end
	return n
end

function CraftUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Craft", "🔨 محطة التصنيع", UDim2.fromOffset(820, 600), Color3.fromRGB(255, 160, 60))
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 10)
	local rows = {}
	for i, r in ipairs(Config.Recipes) do
		local row = UIKit.Frame({ LayoutOrder = i, Size = UDim2.new(1, -8, 0, 130), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 12)
		local vp = UIKit.Frame({ Size = UDim2.fromOffset(110, 110), Position = UDim2.fromOffset(8, 10), BackgroundTransparency = 1, Parent = row })
		if r.Output.Pet then
			PetViewport.Create(vp, r.Output.Pet, r.Output.Variant or "Normal", true)
		else
			UIKit.Label({ Text = r.Output.Potion and "🧪" or "🔁", MaxTextSize = 60, Parent = vp })
		end
		UIKit.Label({ Text = r.Name, Size = UDim2.new(1, -330, 0, 28), Position = UDim2.fromOffset(126, 8), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		local req = UIKit.Label({ Text = "", Size = UDim2.new(1, -330, 0, 70), Position = UDim2.fromOffset(126, 36), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = row })
		local cost = UIKit.Label({ Text = "", Size = UDim2.fromOffset(190, 30), Position = UDim2.new(1, -200, 0, 10), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 16, Parent = row })
		local btn = UIKit.Button({ Text = "🔨 تصنيع", Color = Color3.fromRGB(255, 160, 60), Size = UDim2.fromOffset(190, 44), Position = UDim2.new(1, -200, 0, 70), MaxTextSize = 18, Parent = row }, function()
			local res = Remotes.Function("Craft"):InvokeServer(r.Id)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		rows[r.Id] = { Req = req, Cost = cost, Btn = btn }
	end
	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for _, r in ipairs(Config.Recipes) do
			local row = rows[r.Id]
			local lines = {}
			local okAll = true
			for _, input in ipairs(r.Inputs) do
				local n = have(p, input)
				local ok = n >= input.Count
				okAll = okAll and ok
				table.insert(lines, (ok and "✅ " or "❌ ") .. input.Count .. " × " .. (input.Pet and (Pets.Get(input.Pet) or { Name = input.Pet }).Name or input.Rarity) .. " (" .. (input.Variant or "Normal") .. ")  [" .. n .. "]")
			end
			row.Req.Text = table.concat(lines, "\n")
			local parts = {}
			if (r.Diamonds or 0) > 0 then
				table.insert(parts, "💎 " .. Format.Number(r.Diamonds))
			end
			if (r.Gems or 0) > 0 then
				table.insert(parts, "💠 " .. Format.Number(r.Gems))
			end
			row.Cost.Text = table.concat(parts, "  ")
			local canPay = p.Diamonds >= (r.Diamonds or 0) and p.Gems >= (r.Gems or 0)
			row.Btn.BackgroundColor3 = (okAll and canPay) and Color3.fromRGB(255, 160, 60) or UIKit.Colors.Panel3
		end
	end
	UIController.Register("Craft", w, refresh)
end

return CraftUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">DataController</string><ProtectedString name="Source"><![CDATA[--!strict
-- نسخة العميل من بيانات اللاعب
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local DataController = {}

local changed = Instance.new("BindableEvent")
DataController.Changed = changed.Event
DataController.Profile = nil :: any
local serverOffset = 0

function DataController.Init()
	Remotes.Event("ProfileUpdate").OnClientEvent:Connect(function(profile)
		DataController.Profile = profile
		if profile.ServerTime then
			serverOffset = profile.ServerTime - os.time()
		end
		changed:Fire(profile)
	end)
end

function DataController.Wait(): any
	local t = 0
	while not DataController.Profile do
		if t % 2 == 0 then
			Remotes.Event("RequestProfile"):FireServer()
		end
		task.wait(0.5)
		t += 1
	end
	return DataController.Profile
end

function DataController.ServerTime(): number
	return os.time() + serverOffset
end

function DataController.Owns(pass: string): boolean
	local p = DataController.Profile
	return p ~= nil and p.OwnedPasses ~= nil and p.OwnedPasses[pass] == true
end

function DataController.FindPet(uid: string): any
	local p = DataController.Profile
	if not p then
		return nil
	end
	for _, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end

return DataController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!strict
-- تأثيرات: ألوان قوس قزح للحيوانات، الموسيقى، الأصوات
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DataController = require(script.Parent.DataController)

local EffectsController = {}

local sounds: { [string]: Sound } = {}
local music: Sound?

function EffectsController.Play(name: string)
	local s = sounds[name]
	if s then
		s:Play()
	end
end

local function screenFlash(color: Color3, text: string)
	local Players = game:GetService("Players")
	local gui = Instance.new("ScreenGui")
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0.4
	flash.BorderSizePixel = 0
	flash.Parent = gui
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 80)
	label.Position = UDim2.new(0, 0, 0.2, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	local tw = game:GetService("TweenService"):Create(flash, TweenInfo.new(1.5), { BackgroundTransparency = 1 })
	tw:Play()
	game:GetService("TweenService"):Create(label, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.6, function()
		gui:Destroy()
	end)
	-- كونفيتي
	local cam = Workspace.CurrentCamera
	if cam then
		local attach = Instance.new("Attachment")
		attach.Parent = Workspace.Terrain
		attach.WorldPosition = cam.CFrame.Position + cam.CFrame.LookVector * 10 + Vector3.new(0, 6, 0)
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 80)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 200, 255)) })
		pe.Size = NumberSequence.new(0.5)
		pe.Lifetime = NumberRange.new(1.5, 2.5)
		pe.Rate = 0
		pe.Speed = NumberRange.new(20, 35)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Acceleration = Vector3.new(0, -25, 0)
		pe.LightEmission = 1
		pe.Parent = attach
		pe:Emit(200)
		task.delay(3, function()
			attach:Destroy()
		end)
	end
end

-- انفجار جزيئات عند نقطة
function EffectsController.Burst(pos: Vector3, color: Color3, count: number, size: number?)
	local attach = Instance.new("Attachment")
	attach.Parent = Workspace.Terrain
	attach.WorldPosition = pos
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	pe.Size = NumberSequence.new(size or 0.5, 0)
	pe.Transparency = NumberSequence.new(0, 1)
	pe.Lifetime = NumberRange.new(0.5, 1)
	pe.Rate = 0
	pe.Speed = NumberRange.new(8, 16)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -20, 0)
	pe.LightEmission = 1
	pe.Parent = attach
	pe:Emit(count)
	task.delay(1.5, function()
		attach:Destroy()
	end)
end

-- موجة صدمة (حلقة تتوسع)
function EffectsController.Shockwave(pos: Vector3, color: Color3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.3, 2, 2)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = Workspace
	local TweenService = game:GetService("TweenService")
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, 18, 18), Transparency = 1 }):Play()
	task.delay(0.6, function()
		ring:Destroy()
	end)
end

-- ألعاب نارية فوق اللاعب
function EffectsController.Fireworks(origin: Vector3, count: number?)
	task.spawn(function()
		for i = 1, count or 6 do
			local pos = origin + Vector3.new(math.random(-20, 20), 20 + math.random(0, 15), math.random(-20, 20))
			local color = Color3.fromHSV(math.random(), 0.8, 1)
			EffectsController.Burst(pos, color, 60, 0.8)
			local light = Instance.new("PointLight")
			local holder = Instance.new("Part")
			holder.Anchored = true
			holder.CanCollide = false
			holder.Transparency = 1
			holder.Position = pos
			holder.Parent = Workspace
			light.Color = color
			light.Range = 40
			light.Brightness = 3
			light.Parent = holder
			EffectsController.Play("Firework")
			task.delay(0.4, function()
				holder:Destroy()
			end)
			task.wait(0.25)
		end
	end)
end

-- وضع الرسومات المنخفضة: إيقاف الجزيئات الجوية والآثار
local lowApplied = false
function EffectsController.ApplyLowGraphics(on: boolean)
	if on == lowApplied then
		return
	end
	lowApplied = on
	local map = Workspace:FindFirstChild("Map")
	if map then
		for _, d in ipairs(map:GetDescendants()) do
			if d:IsA("ParticleEmitter") then
				d.Enabled = not on
			end
		end
	end
	local Lighting = game:GetService("Lighting")
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") then
			e.Enabled = not on
		end
	end
end

function EffectsController.Init()
	local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
	local Remotes = require(ReplicatedStorage2:WaitForChild("Shared").Remotes)
	Remotes.Event("EventEffect").OnClientEvent:Connect(function(data)
		local Players = game:GetService("Players")
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if data.Type == "Huge" then
			screenFlash(Color3.fromRGB(255, 0, 80), "🎉 " .. tostring(data.Player) .. " حصل على حيوان عملاق!")
		elseif data.Type == "Titanic" then
			screenFlash(Color3.new(1, 1, 1), "🌟 " .. tostring(data.Player) .. " حصل على TITANIC!!! 🌟")
			if hrp then
				EffectsController.Fireworks(hrp.Position, 10)
			end
		elseif data.Type == "EventStart" then
			EffectsController.Play(data.Id == "BossRaid" and "Boss" or "Unlock")
			screenFlash(Color3.fromRGB(120, 60, 200), "🎉 بدأ حدث عالمي!")
		elseif data.Type == "ZoneUnlock" then
			EffectsController.Play("Unlock")
			if hrp then
				EffectsController.Fireworks(hrp.Position, 8)
			end
		elseif data.Type == "HatchRare" and hrp then
			local rank = ({ Legendary = 1, Mythical = 2, Exclusive = 3, Huge = 4, Titanic = 5 })[data.Rarity] or 0
			if rank > 0 then
				EffectsController.Burst(hrp.Position + Vector3.new(0, 3, 0), rank >= 4 and Color3.fromRGB(255, 0, 80) or Color3.fromRGB(255, 200, 40), 40 * rank, 0.7)
				EffectsController.Shockwave(hrp.Position, rank >= 4 and Color3.fromRGB(255, 0, 80) or Color3.fromRGB(255, 200, 40))
			end
		elseif data.Type == "DungeonWave" then
			EffectsController.Play("Wave")
			screenFlash(Color3.fromRGB(80, 0, 140), "🌀 الموجة " .. tostring(data.Wave))
		elseif data.Type == "DungeonBoss" then
			EffectsController.Play("Boss")
			screenFlash(Color3.fromRGB(120, 0, 60), "👹 حارس الشق!")
		elseif data.Type == "DungeonClear" and hrp then
			EffectsController.Fireworks(hrp.Position, 8)
		elseif data.Type == "Treasure" then
			screenFlash(Color3.fromRGB(120, 100, 0), "🗺️ ظهر كنز! اذهب قبل اختفائه")
		elseif data.Type == "Purchase" and hrp then
			EffectsController.Burst(hrp.Position + Vector3.new(0, 3, 0), Color3.fromRGB(200, 140, 255), 40, 0.6)
			EffectsController.Play("Sell")
		end
	end)
	for name, id in pairs(Config.Sounds) do
		if id and id > 0 then
			local s = Instance.new("Sound")
			s.SoundId = "rbxassetid://" .. id
			s.Volume = name == "Music" and 0.35 or 0.6
			s.Looped = name == "Music"
			s.Parent = SoundService
			sounds[name] = s
			if name == "Music" then
				music = s
			end
		end
	end
	DataController.Changed:Connect(function(p)
		EffectsController.ApplyLowGraphics(p.Settings and p.Settings.LowGraphics == true)
	end)
	task.delay(3, function()
		local p = DataController.Profile
		if p then
			EffectsController.ApplyLowGraphics(p.Settings and p.Settings.LowGraphics == true)
		end
	end)
	if music then
		music:Play()
		DataController.Changed:Connect(function(p)
			if p.Settings and p.Settings.Music == false then
				music:Pause()
			elseif not music.IsPlaying then
				music:Play()
			end
		end)
	end

	-- دورة ألوان قوس قزح
	local hue = 0
	RunService.Heartbeat:Connect(function(dt)
		hue = (hue + dt * 0.25) % 1
		local color = Color3.fromHSV(hue, 0.85, 1)
		local folder = Workspace:FindFirstChild("ClientPets")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:GetAttribute("Variant") == "Rainbow" then
					for _, part in ipairs(model:GetChildren()) do
						if part:IsA("BasePart") and part:GetAttribute("Rainbow") then
							part.Color = color
						end
					end
				end
			end
		end
	end)
end

return EffectsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">EggController</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحة البيضة عند الاقتراب + شاشة الفتح (أنيميشن) + الفتح التلقائي
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Eggs = require(Shared.Data.Eggs)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Luck = require(Shared.Modules.Luck)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)
local EffectsController = require(script.Parent.EffectsController)

local EggController = {}

local player = Players.LocalPlayer
local panel: Frame
local panelTitle: TextLabel
local panelList: Frame
local tripleBtn: TextButton
local octBtn: TextButton
local autoBtn: TextButton
local variantBtns: { [string]: TextButton } = {}
local currentVariant = "Normal"
local overlay: Frame
local overlayContent: Frame
local panelEgg: string? = nil
local hatching = false
local autoHatch = false
local eggModels: { Model } = {}
local refreshPanel: () -> ()

local function buildPanel(gui: ScreenGui)
	panel = UIKit.Frame({ Name = "EggPanel", Size = UDim2.fromOffset(640, 270), Position = UDim2.new(0.5, -320, 1, -290), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.05, Visible = false, Parent = gui })
	UIKit.Corner(panel, 18)
	UIKit.Stroke(panel, UIKit.Colors.Gold, 3)
	panelTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, -230, 0, 34), Position = UDim2.fromOffset(8, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = panel })
	local variants = UIKit.Frame({ Size = UDim2.fromOffset(220, 30), Position = UDim2.new(1, -228, 0, 8), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(variants, 4, true)
	for _, v in ipairs({ { "Normal", "عادي", UIKit.Colors.Panel3 }, { "Golden", "ذهبي x5", UIKit.Colors.Gold }, { "Rainbow", "قوس قزح x25", UIKit.Colors.Pink } }) do
		variantBtns[v[1]] = UIKit.Button({ Text = v[2], Color = v[3], Size = UDim2.fromOffset(70, 30), MaxTextSize = 12, Parent = variants }, function()
			currentVariant = v[1]
			refreshPanel()
		end)
	end
	panelList = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 120), Position = UDim2.fromOffset(8, 44), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(panelList, 6, true, true)
	local buttons = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -52), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(buttons, 8, true, true)
	UIKit.Button({ Text = "فتح (E)", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(1)
	end)
	tripleBtn = UIKit.Button({ Text = "فتح 3 (R)", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(3)
	end)
	octBtn = UIKit.Button({ Text = "فتح 8 (F)", Color = UIKit.Colors.Cyan, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(8)
	end)
	autoBtn = UIKit.Button({ Text = "تلقائي (T)", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.ToggleAuto()
	end)
end

function refreshPanel()
	if not panelEgg then
		return
	end
	local egg = Eggs.Get(panelEgg) :: Eggs.EggDef
	local p = DataController.Profile
	local luck = p and p.Luck or 1
	if egg.Currency ~= "Coins" then
		currentVariant = "Normal"
	end
	for v, btn in pairs(variantBtns) do
		btn.Visible = egg.Currency == "Coins"
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = v == currentVariant and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
			stroke.Thickness = v == currentVariant and 3 or 2
		end
	end
	local currencyIcon = egg.Currency == "Coins" and "💰 " or (egg.Currency == "Diamonds" and "💎 " or (egg.Currency == "Gems" and "💠 " or "🔁 "))
	local cost = egg.Cost * (Config.EggVariantCost[currentVariant] or 1)
	panelTitle.Text = egg.Name .. (currentVariant ~= "Normal" and (" (" .. currentVariant .. ")") or "") .. "   " .. currencyIcon .. Format.Number(cost) .. (luck > 1 and ("   🍀 x" .. string.format("%.2f", luck)) or "")
	for _, c in ipairs(panelList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, entry in ipairs(Luck.ApplyLuck(panelEgg, luck)) do
		local def = Pets.Get(entry.Pet) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromOffset(84, 118), BackgroundColor3 = UIKit.Colors.Panel2, Parent = panelList })
		UIKit.Corner(card, 10)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 2)
		local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, Parent = card })
		PetViewport.Create(vp, def.Id, currentVariant)
		UIKit.Label({ Text = def.Name, Size = UDim2.new(1, -4, 0, 20), Position = UDim2.fromOffset(2, 72), MaxTextSize = 12, Parent = card })
		UIKit.Label({ Text = Format.Percent(entry.Chance), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 94), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 14, Parent = card })
	end
	tripleBtn.BackgroundColor3 = DataController.Owns("TripleHatch") and UIKit.Colors.Gold or UIKit.Colors.Panel3
	octBtn.BackgroundColor3 = DataController.Owns("OctupleHatch") and UIKit.Colors.Cyan or UIKit.Colors.Panel3
	autoBtn.BackgroundColor3 = autoHatch and UIKit.Colors.Green or (DataController.Owns("AutoHatch") and UIKit.Colors.Purple or UIKit.Colors.Panel3)
	autoBtn.Text = autoHatch and "إيقاف (T)" or "تلقائي (T)"
end

-- ===== شاشة الفتح =====
local function buildOverlay(gui: ScreenGui)
	overlay = UIKit.Frame({ Name = "HatchOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 10, Parent = gui })
	overlayContent = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11, Parent = overlay })
	UIKit.List(overlayContent, 24, true, true)
	local skip = UIKit.Label({ Text = "اضغط في أي مكان للتخطي", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -60), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 20, ZIndex = 12, Parent = overlay })
	skip.Name = "Skip"
end

local function eggViewport(parent: Instance, egg: Eggs.EggDef): (ViewportFrame, Model)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 0.85)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	vp.ZIndex = 12
	local model = Instance.new("Model")
	local shell = Instance.new("Part")
	shell.Size = Vector3.new(4, 5.2, 4)
	shell.Color = egg.Color
	shell.Anchored = true
	shell.Material = Enum.Material.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	shell.Parent = model
	local rng = Random.new(#egg.Id)
	for _ = 1, 6 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-1.4, 1.4)
		local r = 1.85 * math.sqrt(math.max(0, 1 - (y / 2.6) ^ 2))
		local spot = Instance.new("Part")
		spot.Shape = Enum.PartType.Ball
		spot.Size = Vector3.new(0.8, 0.8, 0.8)
		spot.Color = egg.Accent
		spot.Anchored = true
		spot.CFrame = CFrame.new(math.cos(ang) * r, y, math.sin(ang) * r)
		spot.Parent = model
	end
	model.PrimaryPart = shell
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 45
	cam.CFrame = CFrame.new(Vector3.new(0, 0.5, -9), Vector3.new(0, 0, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp, model
end

local function playHatch(eggId: string, results: { any })
	local egg = Eggs.Get(eggId) :: Eggs.EggDef
	hatching = true
	overlay.Visible = true
	for _, c in ipairs(overlayContent:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local slots = {}
	local many = #results > 3
	for _, res in ipairs(results) do
		local holder = UIKit.Frame({ Size = many and UDim2.fromOffset(150, 240) or UDim2.fromOffset(260, 360), BackgroundTransparency = 1, ZIndex = 11, Parent = overlayContent })
		local vp, model = eggViewport(holder, egg)
		table.insert(slots, { Holder = holder, Vp = vp, Model = model, Result = res })
	end
	EffectsController.Play("Hatch")
	-- اهتزاز
	local t0 = os.clock()
	local skipped = false
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Space then
			skipped = true
		end
	end)
	local fast = DataController.Owns("FastHatch")
	while os.clock() - t0 < (fast and 0.8 or 1.6) and not skipped do
		local dt = os.clock() - t0
		for _, s in ipairs(slots) do
			local ang = math.sin(dt * 28) * 0.28 * math.min(1, dt * 2)
			local scale = 1 + math.sin(dt * 10) * 0.04
			s.Model:PivotTo(CFrame.new(0, math.abs(math.sin(dt * 14)) * 0.4, 0) * CFrame.Angles(0, 0, ang))
			s.Vp.Size = UDim2.fromScale(scale, 0.85 * scale)
		end
		RunService.RenderStepped:Wait()
	end
	-- كشف الحيوان
	for _, s in ipairs(slots) do
		s.Vp:Destroy()
		local def = Pets.Get(s.Result.Id) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 12, Parent = s.Holder })
		UIKit.Corner(card, 18)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 4)
		local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0.66, 0), BackgroundTransparency = 1, ZIndex = 12, Parent = card })
		local vp = PetViewport.Create(vpHolder, s.Result.Id, s.Result.Variant, true)
		vp.ZIndex = 12
		local inst = { Uid = s.Result.Uid, Id = s.Result.Id, Variant = s.Result.Variant, Locked = false, Equipped = false, Time = 0, Level = 1, XP = 0, Enchants = {} }
		UIKit.Label({ Text = PetUtil.DisplayName(inst), Size = UDim2.new(1, -8, 0.1, 0), Position = UDim2.new(0, 4, 0.67, 0), MaxTextSize = 22, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or ""), Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.78, 0), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 18, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = s.Result.Deleted and "🗑️ حُذف تلقائياً" or ("⚔️ " .. Format.Number(PetUtil.BasePower(inst))), Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.87, 0), TextColor3 = s.Result.Deleted and UIKit.Colors.Muted or UIKit.Colors.Pink, MaxTextSize = 18, ZIndex = 13, Parent = card })
		UIKit.Pop(card)
		if Rarities.Rank(def.Rarity) >= 5 then
			UIController.Notify("🌟 حصلت على " .. def.Name .. " (" .. def.Rarity .. ")!", Rarities.Color(def.Rarity))
		end
	end
	local t1 = os.clock()
	skipped = false
	while os.clock() - t1 < ((autoHatch or fast) and 1.2 or 2.6) and not skipped do
		task.wait(0.05)
	end
	conn:Disconnect()
	overlay.Visible = false
	hatching = false
end

function EggController.Hatch(count: number)
	if hatching or not panelEgg then
		return
	end
	if count >= 3 and not DataController.Owns("TripleHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "TripleHatch")
		return
	end
	if count == 8 and not DataController.Owns("OctupleHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "OctupleHatch")
		return
	end
	local eggId = panelEgg
	local res = Remotes.Function("HatchEgg"):InvokeServer(eggId, count, currentVariant)
	if res.ok and res.pets and #res.pets > 0 then
		playHatch(eggId, res.pets)
	elseif res.error then
		UIController.Notify(res.error, UIKit.Colors.Red)
		if res.error:find("ممتلئ") then
			autoHatch = false
			refreshPanel()
		end
	end
end

function EggController.ToggleAuto()
	if not DataController.Owns("AutoHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "AutoHatch")
		return
	end
	autoHatch = not autoHatch
	refreshPanel()
end

local function nearestEgg(): string?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end
	local best, bestDist = nil, 16
	for _, m in ipairs(eggModels) do
		local pp = m.PrimaryPart
		if pp then
			local d = (pp.Position - hrp.Position).Magnitude
			if d < bestDist then
				best, bestDist = m:GetAttribute("EggId") :: string, d
			end
		end
	end
	return best
end

function EggController.Init()
	local gui = UIController.Gui :: ScreenGui
	buildPanel(gui)
	buildOverlay(gui)

	local map = Workspace:WaitForChild("Map")
	for _, inst in ipairs(map:GetDescendants()) do
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end
	map.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end)

	-- تحديث اللوحة حسب أقرب بيضة
	task.spawn(function()
		while true do
			task.wait(0.2)
			local id = nearestEgg()
			if id ~= panelEgg then
				panelEgg = id
				if id then
					refreshPanel()
					panel.Visible = true
					UIKit.Pop(panel)
				else
					panel.Visible = false
					autoHatch = false
				end
			end
		end
	end)

	-- الفتح التلقائي
	task.spawn(function()
		while true do
			task.wait(0.3)
			if autoHatch and panelEgg and not hatching then
				EggController.Hatch(DataController.Owns("OctupleHatch") and 8 or (DataController.Owns("TripleHatch") and 3 or 1))
			end
		end
	end)

	-- دوران البيض في العالم (القشرة مع النقاط)
	local spinCache: { [Model]: { Base: Vector3, Spots: { { Part: BasePart, Offset: CFrame } } } } = {}
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in ipairs(eggModels) do
			local shell = m.PrimaryPart
			if shell and shell:IsDescendantOf(Workspace) then
				local cache = spinCache[m]
				if not cache then
					cache = { Base = shell.Position, Spots = {} }
					for _, c in ipairs(m:GetChildren()) do
						if c:IsA("BasePart") and (c.Name == "Spot" or c.Name == "Crown") then
							table.insert(cache.Spots, { Part = c, Offset = shell.CFrame:ToObjectSpace(c.CFrame) })
						end
					end
					spinCache[m] = cache
				end
				local cf = CFrame.new(cache.Base + Vector3.new(0, math.sin(t * 2) * 0.3, 0)) * CFrame.Angles(0, t * 0.6, 0)
				shell.CFrame = cf
				for _, s in ipairs(cache.Spots) do
					s.Part.CFrame = cf * s.Offset
				end
			end
		end
	end)

	DataController.Changed:Connect(function()
		if panel.Visible then
			refreshPanel()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not panel.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			EggController.Hatch(1)
		elseif input.KeyCode == Enum.KeyCode.R then
			EggController.Hatch(3)
		elseif input.KeyCode == Enum.KeyCode.F then
			EggController.Hatch(8)
		elseif input.KeyCode == Enum.KeyCode.T then
			EggController.ToggleAuto()
		end
	end)
end

return EggController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000056"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نافذة الحيوانات: الشبكة، الفرز، البحث، التفاصيل (مستوى، خبرة، إنشانتات)، التجهيز، القفل، الحذف
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local PetViewport = require(script.Parent.PetViewport)
local UIController = require(script.Parent.UIController)

local InventoryUI = {}

local cards: { [string]: Frame } = {}
local selectedUid: string? = nil
local sortMode = "Power"
local search = ""
InventoryUI.OnEnchant = nil :: ((string) -> ())?

function InventoryUI.PetCard(parent: Instance, pet: any, onClick: (() -> ())?): Frame
	local def = Pets.Get(pet.Id)
	local color = def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
	local card = UIKit.Frame({ Name = pet.Uid, BackgroundColor3 = UIKit.Colors.Panel2, Parent = parent })
	UIKit.Corner(card, 12)
	UIKit.Stroke(card, color, 2.5)
	local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 80), BackgroundTransparency = 1, Parent = card })
	PetViewport.Create(vpHolder, pet.Id, pet.Variant, false, { Shiny = pet.Shiny == true, Accessory = pet.Accessory })
	UIKit.Label({ Text = PetUtil.DisplayName(pet), Size = UDim2.new(1, -6, 0, 20), Position = UDim2.fromOffset(3, 80), MaxTextSize = 13, Parent = card })
	UIKit.Label({ Text = "⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 100), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 13, Parent = card })
	UIKit.Label({ Name = "Badge", Text = pet.Equipped and "✅" or "", Size = UDim2.fromOffset(26, 22), Position = UDim2.fromOffset(4, 4), MaxTextSize = 18, Parent = card })
	UIKit.Label({ Name = "Lock", Text = pet.Locked and "🔒" or "", Size = UDim2.fromOffset(26, 22), Position = UDim2.new(1, -30, 0, 4), MaxTextSize = 18, Parent = card })
	UIKit.Label({ Name = "Level", Text = "Lv." .. (pet.Level or 1), Size = UDim2.fromOffset(44, 18), Position = UDim2.new(1, -46, 0, 60), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 12, Parent = card })
	if pet.Enchants and #pet.Enchants > 0 then
		UIKit.Label({ Name = "Ench", Text = "🔧" .. #pet.Enchants, Size = UDim2.fromOffset(34, 18), Position = UDim2.fromOffset(4, 60), TextColor3 = UIKit.Colors.Green, MaxTextSize = 12, Parent = card })
	end
	if pet.Shiny then
		UIKit.Label({ Name = "Shiny", Text = "✨", Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(4, 28), MaxTextSize = 16, Parent = card })
	end
	local ab = PetUtil.Ability(pet)
	if ab then
		UIKit.Label({ Name = "Ability", Text = ab.Icon, Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -26, 0, 28), MaxTextSize = 16, Parent = card })
	end
	if pet.Variant == "Golden" then
		UIKit.Gradient(card, Color3.fromRGB(80, 70, 30), UIKit.Colors.Panel)
	elseif pet.Variant == "Rainbow" then
		UIKit.Gradient(card, Color3.fromRGB(90, 40, 90), UIKit.Colors.Panel)
	elseif pet.Variant == "DarkMatter" then
		UIKit.Gradient(card, Color3.fromRGB(40, 10, 70), Color3.fromRGB(10, 5, 20))
	end
	local btn = UIKit.New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = card }) :: TextButton
	if onClick then
		btn.Activated:Connect(onClick)
	end
	return card
end

local function sortPets(list: { any })
	if sortMode == "Power" then
		PetUtil.SortByPower(list)
	elseif sortMode == "Rarity" then
		table.sort(list, function(a, b)
			local da, db = Pets.Get(a.Id), Pets.Get(b.Id)
			local ra, rb = da and Rarities.Rank(da.Rarity) or 0, db and Rarities.Rank(db.Rarity) or 0
			if ra ~= rb then
				return ra > rb
			end
			return PetUtil.BasePower(a) > PetUtil.BasePower(b)
		end)
	elseif sortMode == "Level" then
		table.sort(list, function(a, b)
			if (a.Level or 1) ~= (b.Level or 1) then
				return (a.Level or 1) > (b.Level or 1)
			end
			return PetUtil.BasePower(a) > PetUtil.BasePower(b)
		end)
	elseif sortMode == "Newest" then
		table.sort(list, function(a, b)
			return (a.Time or 0) > (b.Time or 0)
		end)
	end
end

function InventoryUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Inventory", "🐾 حيواناتي", UDim2.fromOffset(920, 640), UIKit.Colors.Green)

	local header = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	local countLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(150, 44), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = header })
	local equipLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(120, 44), Position = UDim2.fromOffset(150, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = header })
	local searchBox = UIKit.New("TextBox", { Size = UDim2.fromOffset(150, 36), Position = UDim2.fromOffset(276, 4), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "🔍 بحث", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 16, ClearTextOnFocus = false, Parent = header }) :: TextBox
	UIKit.Corner(searchBox, 8)
	local sortBtn = UIKit.Button({ Text = "⇅ القوة", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(110, 36), Position = UDim2.fromOffset(432, 4), MaxTextSize = 15, Parent = header })
	UIKit.Button({ Text = "⭐ الأفضل", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -350, 0, 4), MaxTextSize = 15, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("EquipBest", {})
	end)
	UIKit.Button({ Text = "إزالة الكل", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -234, 0, 4), MaxTextSize = 15, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("UnequipAll", {})
	end)
	UIKit.Button({ Text = "🗑️ عاديات", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -118, 0, 4), MaxTextSize = 15, Parent = header }, function()
		local p = DataController.Profile
		if not p then
			return
		end
		local uids = {}
		for _, pet in ipairs(p.Pets) do
			local def = Pets.Get(pet.Id)
			if def and not pet.Locked and not pet.Equipped and pet.Variant == "Normal" and Rarities.Rank(def.Rarity) <= 2 then
				table.insert(uids, pet.Uid)
			end
		end
		if #uids == 0 then
			UIController.Notify("لا يوجد حيوانات عادية للحذف", UIKit.Colors.Muted)
			return
		end
		local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uids = uids })
		if res.ok then
			UIController.Notify("🗑️ تم حذف " .. #uids .. " حيوان عادي", UIKit.Colors.Red)
		end
	end)

	local grid = UIKit.Scroll(w.Content, { Size = UDim2.new(1, -270, 1, -50), Position = UDim2.fromOffset(0, 50) })
	UIKit.Grid(grid, UDim2.fromOffset(112, 122), 8)

	-- لوحة التفاصيل
	local details = UIKit.Frame({ Size = UDim2.fromOffset(260, 0), Position = UDim2.new(1, -260, 0, 50), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Visible = false, Parent = w.Content })
	UIKit.Corner(details, 14)
	UIKit.Padding(details, 10)
	UIKit.List(details, 6, false, true)
	local dVp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 130), BackgroundTransparency = 1, Parent = details })
	local dName = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), MaxTextSize = 20, Parent = details })
	local dRarity = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 20), MaxTextSize = 16, Parent = details })
	local dPower = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 18, Parent = details })
	local dLevel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 15, Parent = details })
	local _, xpFill, xpLabel = UIKit.ProgressBar(details, UIKit.Colors.Cyan, UDim2.new(1, 0, 0, 14))
	local dAbility = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 44), TextColor3 = UIKit.Colors.Gold, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 14, Parent = details })
	local dEnch = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 60), TextColor3 = UIKit.Colors.Green, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 14, Parent = details })
	local nickBox = UIKit.New("TextBox", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "✏️ اسم مستعار (Enter)", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 15, ClearTextOnFocus = false, Parent = details }) :: TextBox
	UIKit.Corner(nickBox, 8)
	nickBox.FocusLost:Connect(function(enter)
		if enter and selectedUid then
			Remotes.Function("PetAction"):InvokeServer("Nick", { Uid = selectedUid, Nick = nickBox.Text })
		end
	end)
	local accRow = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Visible = false, Parent = details })
	UIKit.List(accRow, 4, true)
	local equipBtn = UIKit.Button({ Text = "تجهيز", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local enchantBtn = UIKit.Button({ Text = "🔧 إنشانت", Color = UIKit.Colors.Purple, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local lockBtn = UIKit.Button({ Text = "🔒 قفل", Color = UIKit.Colors.Blue, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local deleteBtn = UIKit.Button({ Text = "🗑️ حذف", Color = UIKit.Colors.Red, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })

	local function showDetails(uid: string?)
		selectedUid = uid
		local pet = uid and DataController.FindPet(uid)
		if not pet then
			details.Visible = false
			return
		end
		local def = Pets.Get(pet.Id) :: Pets.PetDef
		details.Visible = true
		for _, c in ipairs(dVp:GetChildren()) do
			c:Destroy()
		end
		PetViewport.Create(dVp, pet.Id, pet.Variant, true, { Shiny = pet.Shiny == true, Accessory = pet.Accessory })
		dName.Text = PetUtil.DisplayName(pet)
		nickBox.Text = pet.Nick or ""
		-- الإكسسوارات المملوكة
		for _, c in ipairs(accRow:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		local p = DataController.Profile
		local ownedAny = false
		if p then
			for _, a in ipairs(Config.Accessories) do
				local n = p.Accessories[a.Id] or 0
				if n > 0 or pet.Accessory == a.Id then
					ownedAny = true
					local isOn = pet.Accessory == a.Id
					UIKit.Button({ Text = a.Icon .. (isOn and "✓" or (" " .. n)), Color = isOn and UIKit.Colors.Green or UIKit.Colors.Panel3, Size = UDim2.fromOffset(52, 32), MaxTextSize = 14, Parent = accRow }, function()
						Remotes.Function("PetAction"):InvokeServer("Accessory", { Uid = pet.Uid, Id = isOn and "" or a.Id })
					end)
				end
			end
		end
		accRow.Visible = ownedAny
		dRarity.Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or "")
		dRarity.TextColor3 = Rarities.Color(def.Rarity)
		dPower.Text = "⚔️ القوة: " .. Format.Number(PetUtil.BasePower(pet))
		local level = pet.Level or 1
		dLevel.Text = "المستوى " .. level .. " / 50   (+" .. math.floor((level - 1) * Config.PetLevelPowerPerLevel * 100 + 0.5) .. "% قوة)"
		local nextMilestone
		for _, m in ipairs(Config.PetLevelMilestones) do
			if level < m.Level then
				nextMilestone = m
				break
			end
		end
		dAbility.Text = PetUtil.AbilityText(pet) .. (nextMilestone and ("\n⬆️ عند المستوى " .. nextMilestone.Level .. ": القدرة x" .. nextMilestone.Mult) or "\n🏆 القدرة في أقصى قوتها")
		local needed = PetUtil.XPToNext(level)
		if level >= 50 then
			xpFill.Size = UDim2.fromScale(1, 1)
			xpLabel.Text = "MAX"
		else
			xpFill.Size = UDim2.fromScale(math.clamp((pet.XP or 0) / needed, 0, 1), 1)
			xpLabel.Text = Format.Number(pet.XP or 0) .. " / " .. Format.Number(needed) .. " XP"
		end
		local lines = {}
		local slots = PetUtil.EnchantSlots(pet)
		for i = 1, slots do
			local e = pet.Enchants and pet.Enchants[i]
			table.insert(lines, e and PetUtil.EnchantLabel(e) or ("خانة " .. i .. ": فارغة"))
		end
		dEnch.Text = table.concat(lines, "\n")
		equipBtn.Text = pet.Equipped and "إزالة التجهيز" or "تجهيز"
		equipBtn.BackgroundColor3 = pet.Equipped and UIKit.Colors.Panel3 or UIKit.Colors.Green
		lockBtn.Text = pet.Locked and "🔓 فك القفل" or "🔒 قفل"
		deleteBtn.Visible = not pet.Locked
	end

	equipBtn.Activated:Connect(function()
		local pet = selectedUid and DataController.FindPet(selectedUid)
		if pet then
			local res = Remotes.Function("PetAction"):InvokeServer(pet.Equipped and "Unequip" or "Equip", { Uid = pet.Uid })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)
	enchantBtn.Activated:Connect(function()
		if selectedUid and InventoryUI.OnEnchant then
			InventoryUI.OnEnchant(selectedUid)
		end
	end)
	lockBtn.Activated:Connect(function()
		if selectedUid then
			Remotes.Function("PetAction"):InvokeServer("Lock", { Uid = selectedUid })
		end
	end)
	deleteBtn.Activated:Connect(function()
		if selectedUid then
			local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uid = selectedUid })
			if res.ok then
				showDetails(nil)
			elseif res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local sorted = table.clone(p.Pets)
		sortPets(sorted)
		local seen = {}
		local q = string.lower(search)
		for i, pet in ipairs(sorted) do
			local name = string.lower(PetUtil.DisplayName(pet))
			local visible = q == "" or name:find(q, 1, true) ~= nil
			seen[pet.Uid] = true
			local card = cards[pet.Uid]
			local sig = pet.Variant .. "|" .. (pet.Level or 1) .. "|" .. (pet.Enchants and #pet.Enchants or 0) .. "|" .. tostring(pet.Accessory or "") .. "|" .. tostring(pet.Nick or "")
			if card and card:GetAttribute("Sig") ~= sig then
				card:Destroy()
				card = nil
				cards[pet.Uid] = nil
			end
			if not card then
				card = InventoryUI.PetCard(grid, pet, function()
					showDetails(pet.Uid)
				end)
				card:SetAttribute("Sig", sig)
				cards[pet.Uid] = card
			end
			card.LayoutOrder = i
			card.Visible = visible
			local badge = card:FindFirstChild("Badge") :: TextLabel
			local lock = card:FindFirstChild("Lock") :: TextLabel
			badge.Text = pet.Equipped and "✅" or ""
			lock.Text = pet.Locked and "🔒" or ""
		end
		for uid, card in pairs(cards) do
			if not seen[uid] then
				card:Destroy()
				cards[uid] = nil
			end
		end
		local equipped = 0
		for _, pet in ipairs(p.Pets) do
			if pet.Equipped then
				equipped += 1
			end
		end
		countLabel.Text = "📦 " .. #p.Pets .. " / " .. (p.StorageCap or 0)
		equipLabel.Text = "مجهز " .. equipped .. " / " .. (p.EquipCap or 0)
		if selectedUid then
			showDetails(selectedUid)
		end
	end

	local MODES = { "Power", "Rarity", "Level", "Newest" }
	local LABELS = { Power = "⇅ القوة", Rarity = "⇅ الندرة", Level = "⇅ المستوى", Newest = "⇅ الأحدث" }
	sortBtn.Activated:Connect(function()
		local idx = table.find(MODES, sortMode) or 1
		sortMode = MODES[idx % #MODES + 1]
		sortBtn.Text = LABELS[sortMode]
		refresh()
	end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		search = searchBox.Text
		refresh()
	end)

	UIController.Register("Inventory", w, refresh)
end

return InventoryUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000057"><Properties><string name="Name">LeaderboardUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نافذة المتصدرين
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local UIController = require(script.Parent.UIController)

local LeaderboardUI = {}

function LeaderboardUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Leaderboards", "🏆 المتصدرون", UDim2.fromOffset(860, 560), UIKit.Colors.Gold)
	local grid = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.Grid(grid, UDim2.new(0.5, -6, 0.5, -6), 8)
	local boards = {}
	for i, info in ipairs({ { "Coins", "💰 أغنى اللاعبين", UIKit.Colors.Gold }, { "Hatches", "🥚 أكثر فتحاً", UIKit.Colors.Cyan }, { "Rebirths", "🔁 أكثر ريبيرث", Color3.fromRGB(255, 140, 60) }, { "Damage", "⚔️ أعلى ضرر", UIKit.Colors.Pink } }) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = grid })
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, info[3], 2)
		UIKit.Label({ Text = info[2], Size = UDim2.new(1, 0, 0, 30), TextColor3 = info[3], MaxTextSize = 20, Parent = card })
		boards[info[1]] = UIKit.Label({ Text = "...", Size = UDim2.new(1, -16, 1, -36), Position = UDim2.fromOffset(8, 32), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 16, Parent = card })
	end
	local function refresh()
		local data = Remotes.Function("GetLeaderboards"):InvokeServer()
		for key, label in pairs(boards) do
			local rows = type(data) == "table" and data[key] or nil
			if rows and #rows > 0 then
				local lines = {}
				for _, r in ipairs(rows) do
					table.insert(lines, string.format("%d. %s  —  %s", r.Rank, r.Name, Format.Number(r.Value)))
				end
				label.Text = table.concat(lines, "\n")
			else
				label.Text = "لا توجد بيانات بعد"
			end
		end
	end
	UIController.Register("Leaderboards", w, refresh)
end

return LeaderboardUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000058"><Properties><string name="Name">LoadingScreen</string><ProtectedString name="Source"><![CDATA[--!strict
-- شاشة تحميل مع نصائح
local Players = game:GetService("Players")
local UIKit = require(script.Parent.UIKit)

local LoadingScreen = {}

local TIPS = {
	"اضغط على الصناديق لتهاجمها حيواناتك",
	"E لفتح بيضة، R لفتح 3، T للفتح التلقائي",
	"الحيوانات تكسب خبرة مع كل صندوق وتصبح أقوى بالمستويات",
	"آلة الإنشانت تعطي حيواناتك قدرات إضافية",
	"الريبيرث يعطيك مضاعفات دائمة وتوكنات لبيضة الريبيرث",
	"اضغط Q لركوب الهوفربورد",
	"عجلة الحظ مجانية مرة كل يوم",
	"التاجر المتجول يغير بضاعته كل ساعة",
	"الأحداث العالمية كل 7 دقائق: اجمع أصدقاءك لهزيمة الزعيم",
	"ادمج 10 حيوانات دفعة واحدة لأعلى فرصة ترقية",
}

local gui: ScreenGui
local statusLabel: TextLabel

function LoadingScreen.Show()
	gui = Instance.new("ScreenGui")
	gui.Name = "Loading"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local bg = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(18, 20, 40), Parent = gui })
	UIKit.Gradient(bg, Color3.fromRGB(40, 30, 90), Color3.fromRGB(10, 12, 30))
	local title = UIKit.Label({ Text = "🐾 Pet Kingdom Simulator", Size = UDim2.new(1, 0, 0, 90), Position = UDim2.new(0, 0, 0.32, 0), MaxTextSize = 64, TextStrokeTransparency = 0, Parent = bg })
	UIKit.Gradient(title, Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 150, 60))
	statusLabel = UIKit.Label({ Text = "جاري تحميل بياناتك...", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.32, 100), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 22, Parent = bg })
	local tip = UIKit.Label({ Text = "💡 " .. TIPS[math.random(#TIPS)], Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.new(0.1, 0, 0.75, 0), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 20, Parent = bg })
	local dots = 0
	task.spawn(function()
		while gui and gui.Parent do
			dots = (dots + 1) % 4
			statusLabel.Text = "جاري تحميل بياناتك" .. string.rep(".", dots)
			if dots == 0 then
				tip.Text = "💡 " .. TIPS[math.random(#TIPS)]
			end
			task.wait(0.6)
		end
	end)
end

function LoadingScreen.Hide()
	if gui then
		local g = gui
		gui = nil :: any
		for _, d in ipairs(g:GetDescendants()) do
			if d:IsA("Frame") then
				UIKit.Tween(d, { BackgroundTransparency = 1 }, 0.5)
			elseif d:IsA("TextLabel") then
				UIKit.Tween(d, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
			end
		end
		task.delay(0.55, function()
			g:Destroy()
		end)
	end
end

return LoadingScreen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000059"><Properties><string name="Name">MachineUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نوافذ الآلات: الذهب، قوس قزح، المادة المظلمة، الدمج، الإنشانت + توجيه الـ Prompts للنوافذ الأخرى
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)
local PetViewport = require(script.Parent.PetViewport)

local MachineUI = {}
MachineUI.OnPetShop = nil :: (() -> ())?

local INFO = {
	Golden = { Title = "✨ آلة الذهب", Desc = "ضع 3 حيوانات متطابقة (عادية) لتحصل على نسخة ذهبية بقوة x2 (يحتفظ بأعلى مستوى)", Color = UIKit.Colors.Gold, Max = 3 },
	Rainbow = { Title = "🌈 آلة قوس قزح", Desc = "ضع 3 حيوانات ذهبية متطابقة لتحصل على نسخة قوس قزح بقوة x4", Color = UIKit.Colors.Pink, Max = 3 },
	Fuse = { Title = "🔮 آلة الدمج", Desc = "ادمج 3 إلى 10 حيوانات لتحصل على حيوان عشوائي من نفس المنطقة أو أعلى (كلما زاد العدد زادت فرصة الترقية)", Color = UIKit.Colors.Cyan, Max = 10 },
	DarkMatter = { Title = "🌑 آلة المادة المظلمة", Desc = "ضع حيوان قوس قزح + " .. Config.Machines.DarkMatter.CostDiamonds .. " ألماسة، وبعد ساعة يتحول إلى مادة مظلمة بقوة x8", Color = UIKit.Colors.Purple, Max = 1 },
	Enchant = { Title = "🔧 آلة الإنشانت", Desc = "اختر حيواناً ثم أعد لف أي خانة إنشانت بالألماس. الخانات: عادي 1، ذهبي/قوس قزح 2، مادة مظلمة 3", Color = Color3.fromRGB(0, 255, 140), Max = 1 },
}

local currentKind = "Golden"
local selected: { [string]: boolean } = {}
local window: UIKit.Window
local grid: ScrollingFrame
local descLabel: TextLabel
local selectedLabel: TextLabel
local confirmBtn: TextButton
local resultFrame: Frame
local dmList: Frame
local enchantPanel: Frame

local function eligible(kind: string, pet: any): boolean
	if pet.Locked and kind ~= "Enchant" then
		return false
	end
	if kind == "Golden" then
		return pet.Variant == "Normal"
	elseif kind == "Rainbow" then
		return pet.Variant == "Golden"
	elseif kind == "DarkMatter" then
		return pet.Variant == "Rainbow"
	end
	return true
end

local function selectedCount(): number
	local n = 0
	for _ in pairs(selected) do
		n += 1
	end
	return n
end

local function refreshEnchantPanel()
	for _, c in ipairs(enchantPanel:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local uid
	for u in pairs(selected) do
		uid = u
	end
	local pet = uid and DataController.FindPet(uid)
	enchantPanel.Visible = currentKind == "Enchant"
	if not pet then
		UIKit.Label({ Text = "اختر حيواناً من القائمة", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = enchantPanel })
		return
	end
	local def = Pets.Get(pet.Id) :: Pets.PetDef
	local cost = Config.EnchantCostPerTier * math.min(def.Tier, 15)
	UIKit.Label({ Text = PetUtil.DisplayName(pet) .. "  •  التكلفة 💎 " .. cost, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 16, Parent = enchantPanel })
	for i = 1, PetUtil.EnchantSlots(pet) do
		local e = pet.Enchants and pet.Enchants[i]
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = UIKit.Colors.Panel3, Parent = enchantPanel })
		UIKit.Corner(row, 8)
		UIKit.Label({ Text = e and PetUtil.EnchantLabel(e) or ("خانة " .. i .. ": فارغة"), Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 13, Parent = row })
		UIKit.Button({ Text = e and "إعادة لف" or "لف", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(86, 32), Position = UDim2.new(1, -92, 0, 6), MaxTextSize = 14, Parent = row }, function()
			local res = Remotes.Function("Machine"):InvokeServer("Enchant", { Uid = pet.Uid, Slot = i })
			if res.ok and res.result then
				UIController.Notify("🔧 " .. PetUtil.EnchantLabel(res.result), UIKit.Colors.Green)
			elseif res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
	end
end

local function refresh()
	local p = DataController.Profile
	if not p then
		return
	end
	local info = INFO[currentKind]
	window.Title.Text = info.Title
	descLabel.Text = info.Desc
	for _, c in ipairs(grid:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local sorted = table.clone(p.Pets)
	PetUtil.SortByPower(sorted)
	local count = 0
	local firstId
	for uid in pairs(selected) do
		local sp = DataController.FindPet(uid)
		if sp then
			firstId = sp.Id
		end
	end
	for i, pet in ipairs(sorted) do
		if eligible(currentKind, pet) then
			if (currentKind == "Golden" or currentKind == "Rainbow") and firstId and pet.Id ~= firstId then
				continue
			end
			local card = InventoryUI.PetCard(grid, pet, function()
				if selected[pet.Uid] then
					selected[pet.Uid] = nil
				else
					if info.Max == 1 then
						selected = {}
					elseif selectedCount() >= info.Max then
						UIController.Notify("الحد الأقصى " .. info.Max, UIKit.Colors.Red)
						return
					end
					selected[pet.Uid] = true
				end
				refresh()
			end)
			card.LayoutOrder = i
			if selected[pet.Uid] then
				local stroke = card:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.Colors.Green
					stroke.Thickness = 4
				end
				local badge = card:FindFirstChild("Badge") :: TextLabel
				badge.Text = "☑️"
			end
			count += 1
		end
	end
	local n = selectedCount()
	selectedLabel.Text = "المختار: " .. n .. " / " .. info.Max .. "   (المتاح: " .. count .. ")"
	local minNeeded = currentKind == "Fuse" and Config.Machines.Fuse.Min or info.Max
	confirmBtn.Visible = currentKind ~= "Enchant"
	confirmBtn.BackgroundColor3 = n >= minNeeded and UIKit.Colors.Green or UIKit.Colors.Panel3
	confirmBtn.Text = currentKind == "DarkMatter" and ("بدء التحويل (💎 " .. Config.Machines.DarkMatter.CostDiamonds .. ")") or "تنفيذ"

	for _, c in ipairs(dmList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	dmList.Visible = currentKind == "DarkMatter"
	if currentKind == "DarkMatter" then
		local now = DataController.ServerTime()
		for i, entry in ipairs(p.DarkMatter) do
			local def = Pets.Get(entry.PetId)
			local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = UIKit.Colors.Panel3, Parent = dmList })
			UIKit.Corner(row, 8)
			local remain = entry.Ready - now
			UIKit.Label({ Text = (def and def.Name or entry.PetId) .. "  " .. (remain > 0 and Format.Time(remain) or "جاهز!"), Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = row })
			UIKit.Button({ Text = "استلام", Color = remain > 0 and UIKit.Colors.Panel2 or UIKit.Colors.Green, Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -96, 0, 5), MaxTextSize = 16, Parent = row }, function()
				local res = Remotes.Function("Machine"):InvokeServer("DarkMatterClaim", { Index = i })
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
		end
	end
	refreshEnchantPanel()
end

local function showResult(pet: any)
	for _, c in ipairs(resultFrame:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
	resultFrame.Visible = true
	local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, Parent = resultFrame })
	PetViewport.Create(vp, pet.Id, pet.Variant, true)
	UIKit.Label({ Text = "🎉 " .. PetUtil.DisplayName(pet) .. "  ⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 1, -40), MaxTextSize = 22, Parent = resultFrame })
	UIKit.Pop(resultFrame)
	task.delay(3, function()
		resultFrame.Visible = false
	end)
end

function MachineUI.Open(kind: string, preselectUid: string?)
	currentKind = kind
	selected = {}
	if preselectUid then
		selected[preselectUid] = true
	end
	resultFrame.Visible = false
	if UIController.IsOpen("Machine") then
		refresh()
	else
		UIController.Open("Machine")
	end
	local info = INFO[kind]
	local stroke = window.Root:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = info.Color
	end
end

function MachineUI.Init()
	local gui = UIController.Gui :: ScreenGui
	window = UIKit.Window(gui, "Machine", "آلة", UDim2.fromOffset(900, 620), UIKit.Colors.Gold)
	descLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = window.Content })
	grid = UIKit.Scroll(window.Content, { Size = UDim2.new(1, -290, 1, -50), Position = UDim2.fromOffset(0, 46) })
	UIKit.Grid(grid, UDim2.fromOffset(112, 122), 8)
	local side = UIKit.Frame({ Size = UDim2.fromOffset(280, 0), Position = UDim2.new(1, -280, 0, 46), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Parent = window.Content })
	UIKit.Corner(side, 14)
	UIKit.Padding(side, 10)
	UIKit.List(side, 8)
	selectedLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 15, Parent = side })
	confirmBtn = UIKit.Button({ Text = "تنفيذ", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 44), MaxTextSize = 20, Parent = side }, function()
		local uids = {}
		for uid in pairs(selected) do
			table.insert(uids, uid)
		end
		local kind = currentKind
		local payload: any = { Uids = uids }
		if kind == "DarkMatter" then
			kind = "DarkMatterStart"
			payload = { Uid = uids[1] }
		end
		local res = Remotes.Function("Machine"):InvokeServer(kind, payload)
		if res.ok then
			selected = {}
			if res.result then
				showResult(res.result)
			else
				UIController.Notify("✅ تم!", UIKit.Colors.Green)
			end
			task.delay(0.2, refresh)
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	UIKit.Button({ Text = "إلغاء الاختيار", Color = UIKit.Colors.Panel3, Size = UDim2.new(1, 0, 0, 36), MaxTextSize = 18, Parent = side }, function()
		selected = {}
		refresh()
	end)
	dmList = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = side })
	UIKit.List(dmList, 6)
	enchantPanel = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, Parent = side })
	UIKit.List(enchantPanel, 6)

	resultFrame = UIKit.Frame({ Size = UDim2.fromOffset(260, 260), Position = UDim2.new(0.5, -130, 0.5, -130), BackgroundColor3 = UIKit.Colors.Panel, Visible = false, ZIndex = 5, Parent = window.Root })
	UIKit.Corner(resultFrame, 16)
	UIKit.Stroke(resultFrame, UIKit.Colors.Gold, 3)

	UIController.Register("Machine", window, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Machine") and currentKind == "DarkMatter" then
				refresh()
			end
		end
	end)

	InventoryUI.OnEnchant = function(uid: string)
		MachineUI.Open("Enchant", uid)
	end

	-- توجيه الـ ProximityPrompt
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local model = prompt:FindFirstAncestorOfClass("Model")
		local kind = model and model:GetAttribute("Machine")
		if type(kind) ~= "string" then
			return
		end
		if INFO[kind] then
			MachineUI.Open(kind)
		elseif kind == "Merchant" then
			UIController.Open("Merchant")
		elseif kind == "Spin" then
			UIController.Open("Spin")
		elseif kind == "Rebirth" then
			UIController.Open("Stats")
		elseif kind == "Trade" then
			UIController.Open("Trade")
		elseif kind == "Market" then
			UIController.Open("Market")
		elseif kind == "PetShop" then
			UIController.Open("Market")
			if MachineUI.OnPetShop then
				MachineUI.OnPetShop()
			end
		elseif kind == "Craft" then
			UIController.Open("Craft")
		elseif kind == "Cosmetic" then
			UIController.Open("Cosmetic")
		elseif kind == "Zones" then
			UIController.Open("Zones")
		elseif kind == "Dungeon" then
			local res = Remotes.Function("Dungeon"):InvokeServer("Start")
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)
end

return MachineUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000060"><Properties><string name="Name">MarketUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- السوق العالمي: تصفح، عروضي، بيع، متجر الحيوانات (بيع للتاجر) + الأكشاك
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)
local MachineUI = require(script.Parent.MachineUI)
local PetViewport = require(script.Parent.PetViewport)

local MarketUI = {}

local pages: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Browse"
local sellerFilter: number? = nil
local browseSort = "Newest"
local browseSearch = ""
local sellUid: string? = nil
local npcSelected: { [string]: boolean } = {}
local cachedListings: { any } = {}
local renderExchange: () -> () = function() end

local function npcValue(pet: any): number
	local def = Pets.Get(pet.Id)
	if not def then
		return 0
	end
	return math.floor((Config.Market.NPCValue[def.Rarity] or 1) * (Config.VariantMultipliers[pet.Variant] or 1) * (1 + (pet.Level or 1) / 50))
end

local function clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
			c:Destroy()
		end
	end
end

local function showTab(name: string)
	currentTab = name
	for n, page in pairs(pages) do
		page.Visible = n == name
		tabButtons[n].BackgroundColor3 = n == name and Color3.fromRGB(255, 140, 60) or UIKit.Colors.Panel3
	end
end

-- ===== تصفح =====
local browseHeader: Frame
local function renderBrowse()
	local page = pages.Browse
	clear(page)
	local p = DataController.Profile
	local list = table.clone(cachedListings)
	local q = string.lower(browseSearch)
	if q ~= "" then
		local filtered = {}
		for _, l in ipairs(list) do
			if string.lower(l.Name or ""):find(q, 1, true) or string.lower(l.SellerName or ""):find(q, 1, true) then
				table.insert(filtered, l)
			end
		end
		list = filtered
	end
	if browseSort == "Newest" then
		table.sort(list, function(a, b)
			return (a.Time or 0) > (b.Time or 0)
		end)
	elseif browseSort == "Cheapest" then
		table.sort(list, function(a, b)
			return a.Price < b.Price
		end)
	elseif browseSort == "Power" then
		table.sort(list, function(a, b)
			return (a.Power or 0) > (b.Power or 0)
		end)
	elseif browseSort == "Rarity" then
		table.sort(list, function(a, b)
			return Rarities.Rank(a.Rarity or "Common") > Rarities.Rank(b.Rarity or "Common")
		end)
	end
	if #list == 0 then
		UIKit.Label({ Text = sellerFilter and "هذا الكشك لا يعرض شيئاً حالياً" or "لا توجد عروض حالياً. كن أول بائع!", Size = UDim2.new(1, 0, 0, 60), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 20, Parent = page })
		return
	end
	for i, l in ipairs(list) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = page })
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, Rarities.Color(l.Rarity or "Common"), 2)
		local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 90), BackgroundTransparency = 1, Parent = card })
		PetViewport.Create(vp, l.PetId, l.Variant)
		UIKit.Label({ Text = l.Name, Size = UDim2.new(1, -6, 0, 22), Position = UDim2.fromOffset(3, 90), MaxTextSize = 14, Parent = card })
		UIKit.Label({ Text = "⚔️ " .. Format.Number(l.Power or 0) .. "  Lv." .. (l.Level or 1), Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 112), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 13, Parent = card })
		UIKit.Label({ Text = "👤 " .. (l.SellerName or "?"), Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 130), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 12, Parent = card })
		local mine = p and l.Seller == Players.LocalPlayer.UserId
		UIKit.Button({ Text = mine and "عرضك" or ("💠 " .. Format.Number(l.Price)), Color = mine and UIKit.Colors.Panel3 or ((p and p.Gems >= l.Price) and UIKit.Colors.Green or UIKit.Colors.Panel3), Size = UDim2.new(1, -12, 0, 34), Position = UDim2.new(0, 6, 1, -40), MaxTextSize = 16, Parent = card }, function()
			if mine then
				return
			end
			local res = Remotes.Function("Market"):InvokeServer("Buy", { Id = l.Id })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
			MarketUI.Refresh(true)
		end)
	end
end

local function fetchBrowse(force: boolean?)
	local res = Remotes.Function("Market"):InvokeServer("Browse", { Force = force == true, Seller = sellerFilter })
	if res.ok then
		cachedListings = res.listings or {}
	end
	renderBrowse()
end

-- ===== عروضي =====
local function renderMine()
	local page = pages.Mine
	clear(page)
	local p = DataController.Profile
	if not p then
		return
	end
	local now = DataController.ServerTime()
	local count = 0
	for id, l in pairs(p.MyListings or {}) do
		count += 1
		local card = UIKit.Frame({ LayoutOrder = count, BackgroundColor3 = UIKit.Colors.Panel2, Parent = page })
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, UIKit.Colors.Gold, 2)
		local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 90), BackgroundTransparency = 1, Parent = card })
		PetViewport.Create(vp, l.PetId, l.Variant)
		UIKit.Label({ Text = l.Name, Size = UDim2.new(1, -6, 0, 22), Position = UDim2.fromOffset(3, 90), MaxTextSize = 14, Parent = card })
		UIKit.Label({ Text = "💠 " .. Format.Number(l.Price), Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 112), TextColor3 = Color3.fromRGB(200, 140, 255), MaxTextSize = 14, Parent = card })
		UIKit.Label({ Text = "⏳ " .. Format.Time(math.max(0, (l.Expires or now) - now)), Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 130), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 12, Parent = card })
		UIKit.Button({ Text = "إلغاء العرض", Color = UIKit.Colors.Red, Size = UDim2.new(1, -12, 0, 34), Position = UDim2.new(0, 6, 1, -40), MaxTextSize = 15, Parent = card }, function()
			local res = Remotes.Function("Market"):InvokeServer("Cancel", { Id = id })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
	end
	if count == 0 then
		UIKit.Label({ Text = "ليس لديك عروض. اذهب لتبويب بيع لعرض حيوان.\nالرسوم: " .. Config.Market.FeePercent .. "%  •  الحد: " .. Config.Market.MaxListings .. " عروض  •  المدة: 3 أيام", Size = UDim2.new(1, 0, 0, 70), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = page })
	end
end

-- ===== بيع =====
local sellPanel: Frame
local priceBox: TextBox
local sellInfo: TextLabel
local function renderSell()
	local page = pages.Sell
	clear(page)
	local p = DataController.Profile
	if not p then
		return
	end
	local sorted = table.clone(p.Pets)
	PetUtil.SortByPower(sorted)
	for i, pet in ipairs(sorted) do
		if not pet.Locked then
			local card = InventoryUI.PetCard(page, pet, function()
				sellUid = pet.Uid
				renderSell()
			end)
			card.LayoutOrder = i
			if sellUid == pet.Uid then
				local stroke = card:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.Colors.Green
					stroke.Thickness = 4
				end
			end
		end
	end
	local pet = sellUid and DataController.FindPet(sellUid)
	sellInfo.Text = pet and ("المختار: " .. PetUtil.DisplayName(pet) .. "  ⚔️ " .. Format.Number(PetUtil.BasePower(pet)) .. "\nقيمة التاجر: 💠 " .. npcValue(pet) .. "  •  الرسوم " .. Config.Market.FeePercent .. "%") or "اختر حيواناً من القائمة ثم حدد السعر"
end

-- ===== متجر الحيوانات (بيع للتاجر) =====
local npcInfo: TextLabel
local function renderNPC()
	local page = pages.NPC
	clear(page)
	local p = DataController.Profile
	if not p then
		return
	end
	local sorted = table.clone(p.Pets)
	PetUtil.SortByPower(sorted)
	local total = 0
	local n = 0
	for i, pet in ipairs(sorted) do
		if not pet.Locked then
			local card = InventoryUI.PetCard(page, pet, function()
				npcSelected[pet.Uid] = not npcSelected[pet.Uid] or nil
				renderNPC()
			end)
			card.LayoutOrder = i
			local lvl = card:FindFirstChild("Level") :: TextLabel
			lvl.Text = "💠" .. npcValue(pet)
			if npcSelected[pet.Uid] then
				total += npcValue(pet)
				n += 1
				local stroke = card:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.Colors.Green
					stroke.Thickness = 4
				end
				local badge = card:FindFirstChild("Badge") :: TextLabel
				badge.Text = "☑️"
			end
		end
	end
	npcInfo.Text = "المختار: " .. n .. "  •  الإجمالي: 💠 " .. Format.Number(total)
end

function MarketUI.Refresh(force: boolean?)
	if currentTab == "Browse" then
		fetchBrowse(force)
	elseif currentTab == "Mine" then
		renderMine()
	elseif currentTab == "Sell" then
		renderSell()
	elseif currentTab == "NPC" then
		renderNPC()
	elseif currentTab == "Exchange" then
		renderExchange()
	end
end

function MarketUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Market", "🏪 السوق العالمي", UDim2.fromOffset(940, 640), Color3.fromRGB(255, 140, 60))

	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 6, true, true)
	for _, info in ipairs({ { "Browse", "🔎 تصفح" }, { "Mine", "📦 عروضي" }, { "Sell", "💠 بيع في السوق" }, { "NPC", "🐾 بيع للتاجر" }, { "Exchange", "🏦 صرّاف" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(165, 40), MaxTextSize = 16, Parent = tabs }, function()
			sellerFilter = nil
			showTab(info[1])
			MarketUI.Refresh()
		end)
	end

	-- تصفح: شريط أدوات
	browseHeader = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 50), BackgroundTransparency = 1, Parent = w.Content })
	local searchBox = UIKit.New("TextBox", { Size = UDim2.fromOffset(220, 36), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "🔍 بحث بالاسم أو البائع", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 16, ClearTextOnFocus = false, Parent = browseHeader }) :: TextBox
	UIKit.Corner(searchBox, 8)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		browseSearch = searchBox.Text
		if currentTab == "Browse" then
			renderBrowse()
		end
	end)
	local SORTS = { "Newest", "Cheapest", "Power", "Rarity" }
	local SORT_LABELS = { Newest = "⇅ الأحدث", Cheapest = "⇅ الأرخص", Power = "⇅ القوة", Rarity = "⇅ الندرة" }
	local sortBtn = UIKit.Button({ Text = SORT_LABELS.Newest, Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(130, 36), Position = UDim2.fromOffset(230, 0), MaxTextSize = 15, Parent = browseHeader })
	sortBtn.Activated:Connect(function()
		local idx = table.find(SORTS, browseSort) or 1
		browseSort = SORTS[idx % #SORTS + 1]
		sortBtn.Text = SORT_LABELS[browseSort]
		renderBrowse()
	end)
	UIKit.Button({ Text = "🔄 تحديث", Color = UIKit.Colors.Blue, Size = UDim2.fromOffset(120, 36), Position = UDim2.fromOffset(370, 0), MaxTextSize = 15, Parent = browseHeader }, function()
		fetchBrowse(true)
	end)
	local filterLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(300, 36), Position = UDim2.new(1, -300, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, Parent = browseHeader })

	for _, name in ipairs({ "Browse", "Mine", "Sell", "NPC", "Exchange" }) do
		local top = (name == "Browse" or name == "Sell" or name == "NPC") and 96 or 52
		pages[name] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, name == "Sell" and -280 or 0, 1, -top), Position = UDim2.fromOffset(0, top), Visible = false })
		UIKit.Grid(pages[name], UDim2.fromOffset(150, 190), 8)
	end
	UIKit.Grid(pages.Sell, UDim2.fromOffset(112, 122), 8)
	UIKit.Grid(pages.NPC, UDim2.fromOffset(112, 122), 8)

	-- بيع: لوحة جانبية
	sellPanel = UIKit.Frame({ Size = UDim2.fromOffset(270, 0), Position = UDim2.new(1, -270, 0, 96), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Visible = false, Parent = w.Content })
	UIKit.Corner(sellPanel, 14)
	UIKit.Padding(sellPanel, 10)
	UIKit.List(sellPanel, 8)
	sellInfo = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 70), MaxTextSize = 15, TextYAlignment = Enum.TextYAlignment.Top, Parent = sellPanel })
	priceBox = UIKit.New("TextBox", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "💠 السعر", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 20, ClearTextOnFocus = false, Parent = sellPanel }) :: TextBox
	UIKit.Corner(priceBox, 8)
	UIKit.Button({ Text = "🏪 عرض للبيع", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 42), MaxTextSize = 18, Parent = sellPanel }, function()
		if not sellUid then
			UIController.Notify("اختر حيواناً أولاً", UIKit.Colors.Red)
			return
		end
		local res = Remotes.Function("Market"):InvokeServer("List", { Uid = sellUid, Price = tonumber(priceBox.Text) or 0 })
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		else
			sellUid = nil
			priceBox.Text = ""
		end
	end)
	UIKit.Label({ Text = "💡 العروض تظهر لكل السيرفرات لمدة 3 أيام. احجز كشكاً في السوق ليجدك اللاعبون بسهولة.", Size = UDim2.new(1, 0, 0, 70), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 13, TextYAlignment = Enum.TextYAlignment.Top, Parent = sellPanel })

	-- الصرّاف
	local exPanel = UIKit.Frame({ Size = UDim2.fromOffset(460, 300), Position = UDim2.new(0.5, -230, 0, 110), BackgroundColor3 = UIKit.Colors.Panel2, Visible = false, Parent = w.Content })
	UIKit.Corner(exPanel, 14)
	UIKit.Padding(exPanel, 14)
	UIKit.List(exPanel, 10)
	UIKit.Label({ Text = "🏦 الصرّاف: اشترِ جواهر بالعملات", Size = UDim2.new(1, 0, 0, 34), MaxTextSize = 22, Parent = exPanel })
	local exInfo = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 70), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, TextYAlignment = Enum.TextYAlignment.Top, Parent = exPanel })
	local exBox = UIKit.New("TextBox", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "عدد الجواهر", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 20, ClearTextOnFocus = false, Parent = exPanel }) :: TextBox
	UIKit.Corner(exBox, 8)
	local exTotal = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 18, Parent = exPanel })
	exBox:GetPropertyChangedSignal("Text"):Connect(function()
		local p = DataController.Profile
		local n = tonumber(exBox.Text) or 0
		exTotal.Text = p and ("الإجمالي: 💰 " .. Format.Number(n * (p.GemPrice or 0))) or ""
	end)
	UIKit.Button({ Text = "💠 شراء", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 44), MaxTextSize = 20, Parent = exPanel }, function()
		local res = Remotes.Function("Market"):InvokeServer("Exchange", { Amount = tonumber(exBox.Text) or 0 })
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		else
			exBox.Text = ""
		end
	end)
	renderExchange = function()
		local p = DataController.Profile
		if not p then
			return
		end
		local day = math.floor(DataController.ServerTime() / 86400)
		local used = (p.GemExchange and p.GemExchange.Day == day) and p.GemExchange.Count or 0
		exInfo.Text = "السعر الحالي: 💰 " .. Format.Number(p.GemPrice or 0) .. " لكل جوهرة (يرتفع مع أعلى منطقة فتحتها)\nالسقف اليومي: " .. used .. " / " .. Config.GemExchange.DailyCap .. "\nالجواهر أندر من العملات: مصادرها الصناديق في السوق، قدرة \"باحث الجواهر\"، الزعماء، الزنزانة، وبيع الحيوانات."
	end

	-- التاجر: شريط
	local npcBar = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 50), BackgroundTransparency = 1, Visible = false, Parent = w.Content })
	npcInfo = UIKit.Label({ Text = "", Size = UDim2.fromOffset(360, 40), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 17, Parent = npcBar })
	UIKit.Button({ Text = "بيع المختار 💠", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(170, 36), Position = UDim2.new(1, -350, 0, 2), MaxTextSize = 16, Parent = npcBar }, function()
		local uids = {}
		for uid in pairs(npcSelected) do
			table.insert(uids, uid)
		end
		if #uids == 0 then
			UIController.Notify("اختر حيوانات للبيع", UIKit.Colors.Red)
			return
		end
		local res = Remotes.Function("Market"):InvokeServer("SellNPC", { Uids = uids })
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
		npcSelected = {}
	end)
	UIKit.Button({ Text = "اختيار كل العاديات", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(170, 36), Position = UDim2.new(1, -170, 0, 2), MaxTextSize = 15, Parent = npcBar }, function()
		local p = DataController.Profile
		if not p then
			return
		end
		for _, pet in ipairs(p.Pets) do
			local def = Pets.Get(pet.Id)
			if def and not pet.Locked and not pet.Equipped and pet.Variant == "Normal" and Rarities.Rank(def.Rarity) <= 2 then
				npcSelected[pet.Uid] = true
			end
		end
		renderNPC()
	end)

	local function refresh()
		browseHeader.Visible = currentTab == "Browse"
		sellPanel.Visible = currentTab == "Sell"
		npcBar.Visible = currentTab == "NPC"
		exPanel.Visible = currentTab == "Exchange"
		filterLabel.Text = sellerFilter and "عرض كشك بائع محدد" or ""
		MarketUI.Refresh()
	end
	local baseShow = showTab
	showTab = function(name: string)
		baseShow(name)
		browseHeader.Visible = name == "Browse"
		sellPanel.Visible = name == "Sell"
		npcBar.Visible = name == "NPC"
		exPanel.Visible = name == "Exchange"
		filterLabel.Text = sellerFilter and "عرض كشك بائع محدد" or ""
	end
	showTab("Browse")
	UIController.Register("Market", w, refresh)
	MachineUI.OnPetShop = function()
		showTab("NPC")
		renderNPC()
	end

	-- الأكشاك: الحجز والفتح + اللافتات
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local model = prompt:FindFirstAncestorOfClass("Model")
		local boothId = model and model:GetAttribute("BoothId")
		if type(boothId) ~= "number" then
			return
		end
		local owner = model:GetAttribute("Owner")
		if owner == 0 then
			local res = Remotes.Function("Market"):InvokeServer("Booth", { BoothId = boothId })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		elseif owner == Players.LocalPlayer.UserId then
			sellerFilter = nil
			showTab("Sell")
			UIController.Open("Market")
		else
			sellerFilter = owner
			showTab("Browse")
			UIController.Open("Market")
		end
	end)
	task.spawn(function()
		local map = Workspace:WaitForChild("Map")
		local marketFolder = map:WaitForChild("Zone_Market", 30)
		if not marketFolder then
			return
		end
		local function hook(booth: Instance)
			if not booth:IsA("Model") or booth:GetAttribute("BoothId") == nil then
				return
			end
			local sign = booth:FindFirstChild("BoothSign", true) :: BillboardGui?
			local label = sign and sign:FindFirstChildOfClass("TextLabel")
			local function update()
				if not label then
					return
				end
				local name = booth:GetAttribute("OwnerName")
				local n = booth:GetAttribute("Listings") or 0
				if type(name) == "string" and name ~= "" then
					label.Text = "🏪 " .. name .. "\n" .. n .. " عروض"
					label.TextColor3 = UIKit.Colors.Gold
				else
					label.Text = "كشك فارغ\nاضغط للحجز"
					label.TextColor3 = Color3.new(1, 1, 1)
				end
			end
			booth:GetAttributeChangedSignal("OwnerName"):Connect(update)
			booth:GetAttributeChangedSignal("Listings"):Connect(update)
			update()
		end
		for _, b in ipairs(marketFolder:GetChildren()) do
			hook(b)
		end
		marketFolder.ChildAdded:Connect(hook)
	end)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Market") and currentTab ~= "Browse" then
			MarketUI.Refresh()
		end
	end)
end

return MarketUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000061"><Properties><string name="Name">MerchantUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- التاجر المتجول
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local MerchantStock = require(Shared.Modules.MerchantStock)
local Pets = require(Shared.Data.Pets)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)

local MerchantUI = {}

function MerchantUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Merchant", "🧳 التاجر المتجول", UDim2.fromOffset(760, 420), Color3.fromRGB(200, 60, 60))
	local timer = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = w.Content })
	local grid = UIKit.Frame({ Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.Grid(grid, UDim2.fromOffset(170, 250), 10)
	local lastRotation = -1

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local now = DataController.ServerTime()
		local rotation = MerchantStock.RotationId(now)
		timer.Text = "يتغير المخزون بعد " .. Format.Time(MerchantStock.SecondsLeft(now))
		local bought = p.Merchant.Rotation == rotation and p.Merchant.Bought or {}
		if rotation ~= lastRotation then
			for _, c in ipairs(grid:GetChildren()) do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
		end
		lastRotation = rotation
		local stock = MerchantStock.Stock(rotation)
		for slot, item in ipairs(stock) do
			local card = grid:FindFirstChild("Slot" .. slot) :: Frame?
			if not card then
				card = UIKit.Frame({ Name = "Slot" .. slot, LayoutOrder = slot, BackgroundColor3 = UIKit.Colors.Panel2, Parent = grid })
				UIKit.Corner(card, 14)
				UIKit.Stroke(card, UIKit.Colors.Gold, 2)
				local vis = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, Parent = card })
				if item.Type == "Pet" and Pets.Get(item.Key) then
					PetViewport.Create(vis, item.Key, "Normal", true)
				else
					local icon = item.Type == "Potion" and "🧪" or (item.Type == "Spins" and "🎡" or "🔁")
					UIKit.Label({ Text = icon, MaxTextSize = 70, Parent = vis })
				end
				UIKit.Label({ Text = item.Name, Size = UDim2.new(1, -8, 0, 30), Position = UDim2.fromOffset(4, 122), MaxTextSize = 17, Parent = card })
				UIKit.Label({ Name = "Limit", Text = "", Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 152), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
				UIKit.Button({ Name = "Buy", Text = "💎 " .. item.Cost, Color = UIKit.Colors.Green, Size = UDim2.new(1, -16, 0, 40), Position = UDim2.new(0, 8, 1, -48), MaxTextSize = 18, Parent = card }, function()
					local res = Remotes.Function("Merchant"):InvokeServer(slot)
					if not res.ok and res.error then
						UIController.Notify(res.error, UIKit.Colors.Red)
					end
				end)
			end
			local n = bought[tostring(item.PoolIndex)] or 0
			local limitLabel = card:FindFirstChild("Limit") :: TextLabel
			limitLabel.Text = "اشتريت " .. n .. " / " .. item.Limit
			local btn = card:FindFirstChild("Buy") :: TextButton
			btn.BackgroundColor3 = n >= item.Limit and UIKit.Colors.Panel3 or (p.Diamonds >= item.Cost and UIKit.Colors.Green or UIKit.Colors.Panel3)
			btn.Text = n >= item.Limit and "نفد" or ("💎 " .. item.Cost)
		end
	end
	UIController.Register("Merchant", w, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Merchant") then
				refresh()
			end
		end
	end)
end

return MerchantUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000062"><Properties><string name="Name">MissionsUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- المهام اليومية + الإنجازات
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local MissionsUI = {}

local function describe(reward: any): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, "💰 " .. Format.Number(reward.Coins))
	end
	if reward.Diamonds then
		table.insert(parts, "💎 " .. reward.Diamonds)
	end
	if reward.Potion then
		table.insert(parts, "🧪 " .. reward.Potion)
	end
	if reward.Pet then
		table.insert(parts, "🐾 " .. reward.Pet)
	end
	if reward.Spins then
		table.insert(parts, "🎡 " .. reward.Spins)
	end
	return table.concat(parts, " ")
end

function MissionsUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Missions", "📋 المهام والإنجازات", UDim2.fromOffset(760, 600), UIKit.Colors.Cyan)
	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 8, true, true)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function showPage(name: string)
		for n, page in pairs(pages) do
			page.Visible = n == name
			tabButtons[n].BackgroundColor3 = n == name and UIKit.Colors.Cyan or UIKit.Colors.Panel3
		end
	end
	for _, info in ipairs({ { "Missions", "📋 مهام اليوم" }, { "Achievements", "🏅 الإنجازات" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(240, 40), MaxTextSize = 20, Parent = tabs }, function()
			showPage(info[1])
		end)
		pages[info[1]] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), Visible = false })
		UIKit.List(pages[info[1]], 8)
	end

	local resetLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -8, 0, 24), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = pages.Missions })
	local missionRows: { Frame } = {}

	local function rowFor(parent: Instance, title: string, sub: string, progress: number, target: number, claimed: boolean, onClaim: () -> ()): Frame
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 74), BackgroundColor3 = UIKit.Colors.Panel2, Parent = parent })
		UIKit.Corner(row, 12)
		UIKit.Stroke(row, claimed and UIKit.Colors.Panel3 or (progress >= target and UIKit.Colors.Green or UIKit.Colors.Panel3), 2)
		UIKit.Label({ Text = title, Size = UDim2.new(1, -190, 0, 28), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		UIKit.Label({ Text = sub, Size = UDim2.new(1, -190, 0, 20), Position = UDim2.fromOffset(12, 32), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Gold, MaxTextSize = 15, Parent = row })
		local _, fill, label = UIKit.ProgressBar(row, UIKit.Colors.Cyan, UDim2.new(1, -200, 0, 12), UDim2.fromOffset(12, 56))
		fill.Size = UDim2.fromScale(math.clamp(progress / math.max(1, target), 0, 1), 1)
		label.Text = ""
		local btn = UIKit.Button({ Text = claimed and "✅" or (progress >= target and "استلام" or Format.Number(progress) .. " / " .. Format.Number(target)), Color = claimed and UIKit.Colors.Panel3 or (progress >= target and UIKit.Colors.Green or UIKit.Colors.Panel3), Size = UDim2.fromOffset(160, 44), Position = UDim2.new(1, -170, 0, 15), MaxTextSize = 17, Parent = row })
		if not claimed and progress >= target then
			btn.Activated:Connect(onClaim)
		end
		return row
	end

	local achRows: { Frame } = {}

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for _, r in ipairs(missionRows) do
			r:Destroy()
		end
		missionRows = {}
		local now = DataController.ServerTime()
		resetLabel.Text = "تتجدد المهام بعد " .. Format.Time(86400 - (now % 86400))
		for i, m in ipairs(p.Missions.List or {}) do
			local title = (m.Name:gsub("{n}", Format.Number(m.Target)))
			local row = rowFor(pages.Missions, title, "المكافأة: " .. describe(m.Reward), m.Progress, m.Target, m.Claimed, function()
				local res = Remotes.Function("ClaimMission"):InvokeServer(i)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
			row.LayoutOrder = i
			table.insert(missionRows, row)
		end
		for _, r in ipairs(achRows) do
			r:Destroy()
		end
		achRows = {}
		for i, a in ipairs(Config.Achievements) do
			local value = p.Stats[a.Stat] or 0
			local row = rowFor(pages.Achievements, a.Name, "المكافأة: " .. describe(a.Reward), value, a.Target, p.Achievements[a.Id] == true, function()
				local res = Remotes.Function("ClaimAchievement"):InvokeServer(a.Id)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
			row.LayoutOrder = i
			table.insert(achRows, row)
		end
	end

	showPage("Missions")
	UIController.Register("Missions", w, refresh)
end

return MissionsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000063"><Properties><string name="Name">PetController</string><ProtectedString name="Source"><![CDATA[--!strict
-- يعرض حيوانات كل اللاعبين ويحركها خلفهم، وتهاجم الهدف عند الضرب
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)
local DataController = require(script.Parent.DataController)

local PetController = {}

type Rendered = { Uid: string, Model: Model, Pos: Vector3, Seed: number }
local rendered: { [Player]: { Rendered } } = {}
local folder: Folder
local localPlayer = Players.LocalPlayer

local function rebuild(player: Player)
	local list = rendered[player] or {}
	local raw = player:GetAttribute("EquippedPets")
	local wanted = {}
	if type(raw) == "string" and raw ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			wanted = decoded
		end
	end
	-- إزالة غير الموجود
	local keep = {}
	for _, r in ipairs(list) do
		local found = false
		for _, w in ipairs(wanted) do
			if w.Uid == r.Uid then
				found = true
			end
		end
		if found then
			table.insert(keep, r)
		else
			r.Model:Destroy()
		end
	end
	-- إضافة الجديد
	for _, w in ipairs(wanted) do
		local exists = false
		for _, r in ipairs(keep) do
			if r.Uid == w.Uid then
				exists = true
			end
		end
		if not exists then
			local model = PetModelBuilder.Build(w.Id, w.Variant, { Shiny = w.Shiny == true, Accessory = w.Accessory })
			if model then
				model.Name = player.Name .. "_" .. w.Uid
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local start = hrp and hrp.Position or Vector3.new()
				model:PivotTo(CFrame.new(start))
				model.Parent = folder
				table.insert(keep, { Uid = w.Uid, Model = model, Pos = start, Seed = math.random() * 10 })
			end
		end
	end
	rendered[player] = keep
end

local function hookPlayer(player: Player)
	rendered[player] = {}
	rebuild(player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function unhookPlayer(player: Player)
	local list = rendered[player]
	if list then
		for _, r in ipairs(list) do
			r.Model:Destroy()
		end
	end
	rendered[player] = nil
end

local function findBreakable(id: string): Model?
	local bf = Workspace:FindFirstChild("Breakables")
	return bf and bf:FindFirstChild(id) :: Model?
end

local function step(dt: number)
	local now = os.clock()
	local hideOthers = DataController.Profile and DataController.Profile.Settings and DataController.Profile.Settings.HideOthersPets
	for player, list in pairs(rendered) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hide = hideOthers and player ~= localPlayer
		if not hrp then
			for _, r in ipairs(list) do
				r.Model:PivotTo(CFrame.new(0, -500, 0))
			end
			continue
		end
		local targetId = player:GetAttribute("Target")
		local targetModel = (type(targetId) == "string" and targetId ~= "") and findBreakable(targetId) or nil
		local targetPart = targetModel and targetModel.PrimaryPart
		local n = #list
		for i, r in ipairs(list) do
			if hide then
				r.Model:PivotTo(CFrame.new(0, -500, 0))
				continue
			end
			local goal: Vector3
			local look: Vector3
			if targetPart then
				-- دائرة حول الهدف
				local ang = (i / n) * math.pi * 2 + now * 0.3
				local radius = math.max(targetPart.Size.X, targetPart.Size.Z) * 0.5 + 3.5
				local center = targetPart.Position
				goal = center + Vector3.new(math.cos(ang) * radius, 1.5, math.sin(ang) * radius)
				-- اندفاع نحو الهدف كل ثانية
				local phase = (now + r.Seed) % 1
				local lunge = phase < 0.25 and math.sin(phase / 0.25 * math.pi) * 2 or 0
				goal = goal + (center - goal).Unit * lunge
				look = center
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local scale = tonumber(r.Model:GetAttribute("Scale")) or 1
				local offset = Vector3.new((col - 1) * 3.4 * math.max(1, scale * 0.8), 0, 3.5 + row * 3.4 * math.max(1, scale * 0.8))
				goal = (hrp.CFrame * CFrame.new(offset)).Position
				goal = Vector3.new(goal.X, hrp.Position.Y - 1.6 + (scale - 1) * 1.2, goal.Z)
				look = goal + hrp.CFrame.LookVector
			end
			local bob = math.sin(now * 4 + r.Seed) * 0.35
			r.Pos = r.Pos:Lerp(goal, math.min(1, dt * 7))
			local pos = r.Pos + Vector3.new(0, bob + 1.2, 0)
			local flatLook = Vector3.new(look.X, pos.Y, look.Z)
			if (flatLook - pos).Magnitude < 0.1 then
				flatLook = pos + hrp.CFrame.LookVector
			end
			r.Model:PivotTo(CFrame.lookAt(pos, flatLook))
		end
	end
end

function PetController.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(unhookPlayer)
	RunService.Heartbeat:Connect(step)
end

return PetController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000064"><Properties><string name="Name">PetViewport</string><ProtectedString name="Source"><![CDATA[--!strict
-- عرض حيوان داخل ViewportFrame (للمخزن، البيض، الفتح)
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)

local PetViewport = {}

function PetViewport.Create(parent: Instance, petId: string, variant: string?, spin: boolean?, opts: any?): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	local model = PetModelBuilder.Build(petId, variant, opts)
	if model then
		model:PivotTo(CFrame.new())
		model.Parent = vp
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.new(Vector3.new(2.2, 1.6, -4.6), Vector3.new(0, 0.1, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	if spin and model then
		local angle = 0
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not vp.Parent then
				conn:Disconnect()
				return
			end
			angle += dt * 1.2
			model:PivotTo(CFrame.Angles(0, angle, 0))
		end)
	end
	return vp
end

return PetViewport
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000065"><Properties><string name="Name">SeasonUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- باس الموسم
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local SeasonUI = {}

local function describe(r: any): string
	local parts = {}
	if r.Diamonds then table.insert(parts, "💎" .. Format.Number(r.Diamonds)) end
	if r.Gems then table.insert(parts, "💠" .. r.Gems) end
	if r.Potion then table.insert(parts, "🧪" .. (r.Count or 1)) end
	if r.Spins then table.insert(parts, "🎡" .. r.Spins) end
	if r.Pet then table.insert(parts, "🐾" .. (r.Variant and (r.Variant .. " ") or "") .. r.Pet) end
	return table.concat(parts, " ")
end

function SeasonUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Season", "🎫 " .. Config.Season.Name, UDim2.fromOffset(900, 600), UIKit.Colors.Gold)
	local header = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
	UIKit.Corner(header, 12)
	local tierLabel = UIKit.Label({ Text = "", Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = header })
	local _, fill, xpLabel = UIKit.ProgressBar(header, UIKit.Colors.Gold, UDim2.new(0.5, -24, 0, 20), UDim2.fromOffset(12, 40))
	local passBtn = UIKit.Button({ Text = "🎫 شراء Season Pass", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(220, 40), Position = UDim2.new(1, -460, 0, 15), MaxTextSize = 17, Parent = header }, function()
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "SeasonPass")
	end)
	UIKit.Button({ Text = "استلام الكل", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(220, 40), Position = UDim2.new(1, -232, 0, 15), MaxTextSize = 17, Parent = header }, function()
		local res = Remotes.Function("Season"):InvokeServer("ClaimAll", {})
		if res.ok then
			UIController.Notify("🎫 استلمت " .. (res.count or 0) .. " مكافأة", UIKit.Colors.Green)
		end
	end)
	local scroll = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -80), Position = UDim2.fromOffset(0, 80), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X })
	UIKit.List(scroll, 6, true)
	local columns = {}
	for t = 1, Config.Season.Tiers do
		local col = UIKit.Frame({ LayoutOrder = t, Size = UDim2.new(0, 120, 1, -10), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(col, 12)
		local title = UIKit.Label({ Text = "المستوى " .. t, Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 16, Parent = col })
		local freeCard = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 150), Position = UDim2.fromOffset(4, 30), BackgroundColor3 = UIKit.Colors.Panel3, Parent = col })
		UIKit.Corner(freeCard, 10)
		UIKit.Label({ Text = "مجاني", Size = UDim2.new(1, 0, 0, 20), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 13, Parent = freeCard })
		UIKit.Label({ Text = describe(Config.SeasonReward(t, false)), Size = UDim2.new(1, -6, 0, 80), Position = UDim2.fromOffset(3, 20), MaxTextSize = 14, Parent = freeCard })
		local freeBtn = UIKit.Button({ Text = "", Size = UDim2.new(1, -10, 0, 30), Position = UDim2.new(0, 5, 1, -36), MaxTextSize = 14, Parent = freeCard }, function()
			local res = Remotes.Function("Season"):InvokeServer("Claim", { Tier = t, Premium = false })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		local premCard = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 150), Position = UDim2.fromOffset(4, 186), BackgroundColor3 = Color3.fromRGB(70, 50, 30), Parent = col })
		UIKit.Corner(premCard, 10)
		UIKit.Stroke(premCard, UIKit.Colors.Gold, 1.5)
		UIKit.Label({ Text = "🎫 مميز", Size = UDim2.new(1, 0, 0, 20), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 13, Parent = premCard })
		UIKit.Label({ Text = describe(Config.SeasonReward(t, true)), Size = UDim2.new(1, -6, 0, 80), Position = UDim2.fromOffset(3, 20), MaxTextSize = 14, Parent = premCard })
		local premBtn = UIKit.Button({ Text = "", Size = UDim2.new(1, -10, 0, 30), Position = UDim2.new(0, 5, 1, -36), MaxTextSize = 14, Parent = premCard }, function()
			local res = Remotes.Function("Season"):InvokeServer("Claim", { Tier = t, Premium = true })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		columns[t] = { Title = title, Free = freeBtn, Prem = premBtn, Col = col }
	end
	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local tier = p.SeasonTier or 0
		tierLabel.Text = "المستوى " .. tier .. " / " .. Config.Season.Tiers .. "   •   XP: " .. Format.Number(p.Season.XP or 0)
		if (p.SeasonNeeded or 0) > 0 then
			fill.Size = UDim2.fromScale(math.clamp((p.SeasonInto or 0) / p.SeasonNeeded, 0, 1), 1)
			xpLabel.Text = Format.Number(p.SeasonInto or 0) .. " / " .. Format.Number(p.SeasonNeeded)
		else
			fill.Size = UDim2.fromScale(1, 1)
			xpLabel.Text = "MAX"
		end
		local hasPass = DataController.Owns("SeasonPass")
		passBtn.Text = hasPass and "✅ Season Pass مفعل" or "🎫 شراء Season Pass"
		passBtn.BackgroundColor3 = hasPass and UIKit.Colors.Panel3 or UIKit.Colors.Purple
		for t, c in pairs(columns) do
			local reached = t <= tier
			c.Col.BackgroundColor3 = reached and UIKit.Colors.Panel2 or Color3.fromRGB(25, 27, 45)
			local fc = p.Season.Claimed[tostring(t)]
			c.Free.Text = fc and "✅" or (reached and "استلام" or "🔒")
			c.Free.BackgroundColor3 = fc and UIKit.Colors.Panel3 or (reached and UIKit.Colors.Green or UIKit.Colors.Panel3)
			local pc = p.Season.PremiumClaimed[tostring(t)]
			c.Prem.Text = pc and "✅" or (reached and (hasPass and "استلام" or "🎫") or "🔒")
			c.Prem.BackgroundColor3 = pc and UIKit.Colors.Panel3 or ((reached and hasPass) and UIKit.Colors.Gold or UIKit.Colors.Panel3)
		end
	end
	UIController.Register("Season", w, refresh)
end

return SeasonUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000066"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- المتجر: الجيم باس، الألماس والجرعات، الترقيات، الهوفربورد
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local ShopUI = {}

local function upgradeCost(u: any, level: number): number?
	if level >= u.MaxLevel then
		return nil
	end
	return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
end

function ShopUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Shop", "🛒 المتجر", UDim2.fromOffset(860, 620), UIKit.Colors.Blue)

	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 6, true, true)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function showPage(name: string)
		for n, page in pairs(pages) do
			page.Visible = n == name
			tabButtons[n].BackgroundColor3 = n == name and UIKit.Colors.Blue or UIKit.Colors.Panel3
		end
	end
	for _, info in ipairs({ { "Gamepasses", "🎟️ جيم باس" }, { "Diamonds", "💎 ألماس" }, { "Upgrades", "⬆️ ترقيات" }, { "Potions", "🧪 جرعات" }, { "Boards", "🛹 هوفربورد" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(158, 40), MaxTextSize = 17, Parent = tabs }, function()
			showPage(info[1])
		end)
		pages[info[1]] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), Visible = false })
		UIKit.Grid(pages[info[1]], UDim2.fromOffset(260, 150), 10)
	end

	local passCards: { [string]: TextButton } = {}
	for i, gp in ipairs(Config.GamepassInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Gamepasses })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Gold, 2)
		UIKit.Label({ Text = gp.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = gp.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = gp.Desc, Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 56), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		passCards[gp.Key] = UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Green, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", gp.Key)
		end)
	end

	for i, pr in ipairs(Config.DevProductInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Diamonds })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Cyan, 2)
		UIKit.Label({ Text = pr.Icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 8), Parent = card })
		UIKit.Label({ Text = pr.Name, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 70), MaxTextSize = 20, Parent = card })
		UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Cyan, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Product", pr.Key)
		end)
	end

	local upgradeRows: { [string]: { Btn: TextButton, Level: TextLabel, Bar: Frame } } = {}
	for i, u in ipairs(Config.Upgrades) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Upgrades })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Purple, 2)
		UIKit.Label({ Text = u.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = u.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = u.Desc, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 54), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, Parent = card })
		local level = UIKit.Label({ Text = "", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 76), MaxTextSize = 15, Parent = card })
		local _, fill = UIKit.ProgressBar(card, UIKit.Colors.Purple, UDim2.new(1, -16, 0, 8), UDim2.fromOffset(8, 98))
		local btn = UIKit.Button({ Text = "", Color = UIKit.Colors.Purple, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local res = Remotes.Function("BuyUpgrade"):InvokeServer(u.Key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		upgradeRows[u.Key] = { Btn = btn, Level = level, Bar = fill }
	end

	-- الجرعات
	local potionRows: { [string]: { Btn: TextButton, Count: TextLabel } } = {}
	for i, key in ipairs(Config.PotionOrder) do
		local cfg = Config.Potions[key]
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Potions })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Purple, 2)
		UIKit.Label({ Text = cfg.Icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 6), Parent = card })
		UIKit.Label({ Text = cfg.Name .. " (x" .. cfg.Mult .. " لمدة " .. Format.Time(cfg.Duration) .. ")", Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 66), MaxTextSize = 16, Parent = card })
		local count = UIKit.Label({ Text = "", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 90), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
		local btn = UIKit.Button({ Text = "💎 " .. cfg.Cost, Color = UIKit.Colors.Purple, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local res = Remotes.Function("BuyPotion"):InvokeServer(key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		potionRows[key] = { Btn = btn, Count = count }
	end

	-- الهوفربورد
	local boardRows: { [string]: { Btn: TextButton, Swatch: Frame } } = {}
	for i, b in ipairs(Config.Hoverboards) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Boards })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, b.Color, 2)
		local swatch = UIKit.Frame({ Size = UDim2.fromOffset(120, 22), Position = UDim2.new(0.5, -60, 0, 18), BackgroundColor3 = b.Color, Parent = card })
		UIKit.Corner(swatch, 11)
		UIKit.Label({ Text = b.Icon .. " " .. b.Name, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 48), MaxTextSize = 20, Parent = card })
		UIKit.Label({ Text = "+" .. b.Speed .. " سرعة  •  اضغط Q للركوب", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 78), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
		local btn = UIKit.Button({ Text = "💎 " .. Format.Number(b.Cost), Color = UIKit.Colors.Cyan, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local p = DataController.Profile
			local owned = p and p.Hoverboards.Owned[b.Id]
			local res = Remotes.Function("Hoverboard"):InvokeServer(owned and "Equip" or "Buy", b.Id)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		boardRows[b.Id] = { Btn = btn, Swatch = swatch }
	end

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for key, btn in pairs(passCards) do
			local owned = DataController.Owns(key)
			btn.Text = owned and "✅ مملوك" or "شراء"
			btn.BackgroundColor3 = owned and UIKit.Colors.Panel3 or UIKit.Colors.Green
		end
		for _, u in ipairs(Config.Upgrades) do
			local row = upgradeRows[u.Key]
			local level = p.Upgrades[u.Key] or 0
			local cost = upgradeCost(u, level)
			row.Level.Text = "المستوى " .. level .. " / " .. u.MaxLevel
			row.Bar.Size = UDim2.fromScale(level / u.MaxLevel, 1)
			if cost then
				row.Btn.Text = "💎 " .. Format.Number(cost)
				row.Btn.BackgroundColor3 = p.Diamonds >= cost and UIKit.Colors.Purple or UIKit.Colors.Panel3
			else
				row.Btn.Text = "الحد الأقصى"
				row.Btn.BackgroundColor3 = UIKit.Colors.Panel3
			end
		end
		for key, row in pairs(potionRows) do
			row.Count.Text = "في الحقيبة: " .. (p.PotionBag[key] or 0)
			row.Btn.BackgroundColor3 = p.Diamonds >= Config.Potions[key].Cost and UIKit.Colors.Purple or UIKit.Colors.Panel3
		end
		for _, b in ipairs(Config.Hoverboards) do
			local row = boardRows[b.Id]
			local owned = p.Hoverboards.Owned[b.Id]
			if owned then
				local eq = p.Hoverboards.Equipped == b.Id
				row.Btn.Text = eq and "✅ مجهز" or "تجهيز"
				row.Btn.BackgroundColor3 = eq and UIKit.Colors.Panel3 or UIKit.Colors.Green
			else
				row.Btn.Text = "💎 " .. Format.Number(b.Cost)
				row.Btn.BackgroundColor3 = p.Diamonds >= b.Cost and UIKit.Colors.Cyan or UIKit.Colors.Panel3
			end
		end
	end

	showPage("Gamepasses")
	UIController.Register("Shop", w, refresh)
end

return ShopUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000067"><Properties><string name="Name">SpinUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- عجلة الحظ مع أنيميشن الدوران
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local EffectsController = require(script.Parent.EffectsController)

local SpinUI = {}
local spinning = false

function SpinUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Spin", "🎡 عجلة الحظ", UDim2.fromOffset(560, 600), UIKit.Colors.Gold)
	local wheel = UIKit.Frame({ Size = UDim2.fromOffset(340, 340), Position = UDim2.new(0.5, -170, 0, 10), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
	UIKit.Corner(wheel, 170)
	UIKit.Stroke(wheel, UIKit.Colors.Gold, 4)
	local n = #Config.Spin.Segments
	local colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 255, 120), Color3.fromRGB(200, 100, 255), Color3.fromRGB(255, 150, 60), Color3.fromRGB(80, 255, 220), Color3.fromRGB(255, 120, 200) }
	for i, seg in ipairs(Config.Spin.Segments) do
		local ang = (i - 1) / n * 360
		local holder = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Rotation = ang, Parent = wheel })
		local chip = UIKit.Frame({ Size = UDim2.fromOffset(96, 44), Position = UDim2.new(0.5, -48, 0, 14), BackgroundColor3 = colors[(i - 1) % #colors + 1], Parent = holder })
		UIKit.Corner(chip, 10)
		UIKit.Label({ Text = seg.Label, MaxTextSize = 15, Parent = chip })
	end
	local pointer = UIKit.Label({ Text = "▼", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.5, -20, 0, -22), TextColor3 = UIKit.Colors.Red, MaxTextSize = 40, ZIndex = 3, Parent = w.Content })
	pointer.TextStrokeTransparency = 0
	local info = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 360), MaxTextSize = 18, TextColor3 = UIKit.Colors.Muted, Parent = w.Content })
	local result = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 392), MaxTextSize = 22, TextColor3 = UIKit.Colors.Gold, Parent = w.Content })
	local btns = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 440), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(btns, 10, true, true)
	local spinBtn = UIKit.Button({ Text = "لف!", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(200, 48), MaxTextSize = 22, Parent = btns })
	local buyBtn = UIKit.Button({ Text = "لفة بـ 💎 " .. Config.Spin.ExtraSpinCost, Color = UIKit.Colors.Cyan, Size = UDim2.fromOffset(200, 48), MaxTextSize = 18, Parent = btns })

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local free = p.FreeSpin == true
		info.Text = (free and "🎁 لفة مجانية متاحة!" or "اللفة المجانية القادمة غداً") .. "   •   لفات إضافية: " .. (p.Spins or 0)
		spinBtn.BackgroundColor3 = (free or (p.Spins or 0) > 0) and UIKit.Colors.Green or UIKit.Colors.Panel3
	end

	local function doSpin(paid: boolean)
		if spinning then
			return
		end
		local res = Remotes.Function("Spin"):InvokeServer(paid)
		if not res.ok then
			UIController.Notify(res.error or "خطأ", UIKit.Colors.Red)
			return
		end
		spinning = true
		result.Text = ""
		EffectsController.Play("Spin")
		local target = -((res.index - 1) / n * 360) - 360 * 5
		wheel.Rotation = 0
		local tween = TweenService:Create(wheel, TweenInfo.new(3.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = target })
		tween:Play()
		tween.Completed:Wait()
		result.Text = "🎉 " .. tostring(res.reward)
		UIKit.Pop(result)
		spinning = false
		refresh()
	end
	spinBtn.Activated:Connect(function()
		doSpin(false)
	end)
	buyBtn.Activated:Connect(function()
		doSpin(true)
	end)
	UIController.Register("Spin", w, refresh)
end

return SpinUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000068"><Properties><string name="Name">StatsUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- الإحصائيات + الإتقان + الريبيرث + تفاصيل المضاعفات
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Mastery = require(Shared.Modules.Mastery)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local StatsUI = {}

function StatsUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Stats", "📊 الإحصائيات والريبيرث", UDim2.fromOffset(820, 620), Color3.fromRGB(255, 140, 60))
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 10)

	-- الريبيرث
	local rb = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 130), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
	UIKit.Corner(rb, 14)
	UIKit.Stroke(rb, Color3.fromRGB(255, 140, 60), 2)
	UIKit.Label({ Text = "🔁 الريبيرث", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = rb })
	local rbDesc = UIKit.Label({ Text = "", Size = UDim2.new(1, -220, 0, 60), Position = UDim2.fromOffset(12, 40), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = rb })
	local rbBtn = UIKit.Button({ Text = "ريبيرث", Color = Color3.fromRGB(255, 140, 60), Size = UDim2.fromOffset(190, 52), Position = UDim2.new(1, -202, 0, 40), MaxTextSize = 20, Parent = rb }, function()
		local res = Remotes.Function("Rebirth"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		else
			UIController.Close()
		end
	end)

	-- متجر الريبيرث
	UIKit.Label({ Text = "🔁 متجر الريبيرث (بالتوكنات)", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local shopGrid = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 250), BackgroundTransparency = 1, Parent = scroll })
	UIKit.Grid(shopGrid, UDim2.fromOffset(250, 118), 8)
	local shopRows = {}
	for i, u in ipairs(Config.RebirthShop) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = shopGrid })
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, Color3.fromRGB(255, 140, 60), 2)
		UIKit.Label({ Text = u.Icon .. " " .. u.Name, Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 17, Parent = card })
		UIKit.Label({ Text = u.Desc, Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(6, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 13, Parent = card })
		local lvl = UIKit.Label({ Text = "", Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(6, 50), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 13, Parent = card })
		local btn = UIKit.Button({ Text = "", Color = Color3.fromRGB(255, 140, 60), Size = UDim2.new(1, -12, 0, 34), Position = UDim2.new(0, 6, 1, -40), MaxTextSize = 15, Parent = card }, function()
			local res = Remotes.Function("RebirthShop"):InvokeServer(u.Key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		shopRows[u.Key] = { Level = lvl, Btn = btn }
	end

	-- الألقاب
	UIKit.Label({ Text = "🏷️ الألقاب (تظهر فوق رأسك)", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local titleRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 130), BackgroundTransparency = 1, Parent = scroll })
	UIKit.Grid(titleRow, UDim2.fromOffset(190, 38), 6)
	local titleBtns = {}
	for i, t in ipairs(Config.Titles) do
		titleBtns[t.Id] = UIKit.Button({ LayoutOrder = i, Text = t.Name, Color = UIKit.Colors.Panel3, MaxTextSize = 14, Parent = titleRow }, function()
			local res = Remotes.Function("Title"):InvokeServer(t.Id)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
	end

	-- المضاعفات
	local mult = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 120), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
	UIKit.Corner(mult, 14)
	local multLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 17, Parent = mult })

	-- الإتقان
	UIKit.Label({ Text = "🏆 الإتقان (Mastery)", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local masteryRows = {}
	for _, cfg in ipairs(Config.Mastery) do
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 66), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 12)
		local title = UIKit.Label({ Text = cfg.Icon .. " " .. cfg.Name, Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 19, Parent = row })
		local bonus = UIKit.Label({ Text = "", Size = UDim2.new(0.4, -12, 0, 28), Position = UDim2.new(0.6, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UIKit.Colors.Green, MaxTextSize = 16, Parent = row })
		local _, fill, label = UIKit.ProgressBar(row, UIKit.Colors.Gold, UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 36))
		masteryRows[cfg.Key] = { Title = title, Bonus = bonus, Fill = fill, Label = label }
	end

	-- الإحصائيات
	UIKit.Label({ Text = "📈 الإحصائيات", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local statsGrid = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 260), BackgroundTransparency = 1, Parent = scroll })
	UIKit.Grid(statsGrid, UDim2.fromOffset(190, 56), 8)
	local statLabels = {}
	local STATS = {
		{ "Hatches", "🥚 بيض مفتوح" }, { "Breaks", "💥 صناديق مكسورة" }, { "CoinsEarned", "💰 عملات مكتسبة" }, { "DiamondsEarned", "💎 ألماس مكتسب" },
		{ "Damage", "⚔️ ضرر كلي" }, { "Fusions", "🔮 دمج" }, { "Goldens", "✨ ذهبي" }, { "Rainbows", "🌈 قوس قزح" },
		{ "DarkMatters", "🌑 مادة مظلمة" }, { "BossKills", "👹 زعماء" }, { "Trades", "🤝 تبادلات" }, { "Enchants", "🔧 إنشانت" },
		{ "Spins", "🎡 لفات" }, { "BestPet", "🏅 أقوى حيوان" }, { "Playtime", "⏱️ وقت اللعب" },
	}
	for i, s in ipairs(STATS) do
		local cell = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = statsGrid })
		UIKit.Corner(cell, 10)
		UIKit.Label({ Text = s[2], Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 2), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = cell })
		statLabels[s[1]] = UIKit.Label({ Text = "0", Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, 24), MaxTextSize = 20, Parent = cell })
	end

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local cost = p.RebirthCost or 0
		local next = (p.Rebirths or 0) + 1
		rbDesc.Text = string.format("التكلفة: 💰 %s  •  يتطلب فتح المنطقة %d\nيعيد العملات والمناطق 2–10، وتحصل على: +%d%% عملات، +%d%% حظ، +%d%% قوة، +%d توكن (دائم)",
			Format.Number(cost), Config.Rebirth.RequiredZone,
			math.floor(Config.Rebirth.CoinsPerRebirth * 100), math.floor(Config.Rebirth.LuckPerRebirth * 100), math.floor(Config.Rebirth.DamagePerRebirth * 100), Config.Rebirth.TokensPerRebirth)
		local can = p.Coins >= cost and p.UnlockedZones[tostring(Config.Rebirth.RequiredZone)]
		rbBtn.Text = "ريبيرث #" .. next
		rbBtn.BackgroundColor3 = can and Color3.fromRGB(255, 140, 60) or UIKit.Colors.Panel3
		local ab = p.Abilities or {}
		multLabel.Text = string.format("💰 عملات x%.2f    🍀 حظ x%.2f    ⚔️ قوة x%.2f    💎 ألماس x%.2f    💠 فرصة جوهرة %.1f%%\n🔁 ريبيرث: %d    🔧 إنشانت: عملات +%d%% / قوة +%d%% / حظ +%d%% / قاضية %d%%\n🐾 قدرات الحيوانات: عملات +%d%% / قوة +%d%% / حظ +%d%% / ألماس +%d%% / قاضية +%d%% / خبرة +%d%%",
			p.CoinMult or 1, p.Luck or 1, p.DamageMult or 1, p.DiamondMult or 1, (p.GemChance or 0) * 100, p.Rebirths or 0,
			math.floor(((p.Enchants and p.Enchants.Coins) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Damage) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Luck) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Crit) or 0) * 100),
			math.floor((ab.Coins or 0) * 100), math.floor((ab.Damage or 0) * 100), math.floor((ab.Luck or 0) * 100), math.floor((ab.Diamonds or 0) * 100), math.floor((ab.Crit or 0) * 100), math.floor((ab.XP or 0) * 100))
		for _, u in ipairs(Config.RebirthShop) do
			local row = shopRows[u.Key]
			local level = (p.RebirthUpgrades and p.RebirthUpgrades[u.Key]) or 0
			row.Level.Text = "المستوى " .. level .. " / " .. u.MaxLevel
			if level >= u.MaxLevel then
				row.Btn.Text = "الحد الأقصى"
				row.Btn.BackgroundColor3 = UIKit.Colors.Panel3
			else
				local c = u.Cost + u.CostStep * level
				row.Btn.Text = "🔁 " .. c .. " توكن"
				row.Btn.BackgroundColor3 = (p.Tokens or 0) >= c and Color3.fromRGB(255, 140, 60) or UIKit.Colors.Panel3
			end
		end
		local avail = p.TitlesAvailable or {}
		for id, btn in pairs(titleBtns) do
			local unlocked = table.find(avail, id) ~= nil
			local current = (p.Title or "") == id
			btn.BackgroundColor3 = current and UIKit.Colors.Green or (unlocked and UIKit.Colors.Blue or UIKit.Colors.Panel3)
			btn.TextTransparency = unlocked and 0 or 0.5
		end
		for _, cfg in ipairs(Config.Mastery) do
			local row = masteryRows[cfg.Key]
			local level, value, needed = Mastery.Progress(cfg, p.Stats[cfg.Stat] or 0)
			row.Title.Text = cfg.Icon .. " " .. cfg.Name .. "  Lv." .. level
			local perks = {}
			for k, v in pairs(cfg.PerLevel) do
				table.insert(perks, "+" .. math.floor(v * level * 100 + 0.5) .. "% " .. k)
			end
			row.Bonus.Text = table.concat(perks, " ")
			if needed > 0 then
				local prev = level > 0 and Mastery.Threshold(cfg, level) or 0
				row.Fill.Size = UDim2.fromScale(math.clamp((value - prev) / math.max(1, needed - prev), 0, 1), 1)
				row.Label.Text = Format.Number(value) .. " / " .. Format.Number(needed)
			else
				row.Fill.Size = UDim2.fromScale(1, 1)
				row.Label.Text = "الحد الأقصى"
			end
		end
		for key, label in pairs(statLabels) do
			local v = p.Stats[key] or 0
			if key == "Playtime" then
				label.Text = Format.Time(v + (DataController.ServerTime() - (p.SessionStart or 0)))
			else
				label.Text = Format.Number(v)
			end
		end
	end
	UIController.Register("Stats", w, refresh)
end

return StatsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000069"><Properties><string name="Name">TradeUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- قائمة اللاعبين + نافذة التبادل + طلب وارد
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PetUtil = require(Shared.Modules.PetUtil)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)

local TradeUI = {}

local state: any = nil
local tradeWindow: UIKit.Window
local myGrid: ScrollingFrame
local theirGrid: ScrollingFrame
local invGrid: ScrollingFrame
local statusLabel: TextLabel
local confirmBtn: TextButton
local myGemsBox: TextBox
local theirGemsLabel: TextLabel
local partnerLabel: TextLabel

local function clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
end

local function refreshTrade()
	if not state then
		return
	end
	local p = DataController.Profile
	partnerLabel.Text = "🤝 تبادل مع " .. state.Partner.DisplayName
	clear(myGrid)
	clear(theirGrid)
	clear(invGrid)
	local offered = {}
	for i, pet in ipairs(state.MyOffer) do
		offered[pet.Uid] = true
		local card = InventoryUI.PetCard(myGrid, pet, function()
			Remotes.Event("TradeAction"):FireServer("Remove", { Uid = pet.Uid })
		end)
		card.LayoutOrder = i
	end
	for i, pet in ipairs(state.TheirOffer) do
		local card = InventoryUI.PetCard(theirGrid, pet)
		card.LayoutOrder = i
	end
	if p then
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		for i, pet in ipairs(sorted) do
			if not offered[pet.Uid] and not pet.Locked then
				local card = InventoryUI.PetCard(invGrid, pet, function()
					Remotes.Event("TradeAction"):FireServer("Add", { Uid = pet.Uid })
				end)
				card.LayoutOrder = i
			end
		end
	end
	if not myGemsBox:IsFocused() then
		myGemsBox.Text = tostring(state.MyGems or 0)
	end
	theirGemsLabel.Text = "💠 " .. (state.TheirGems or 0) .. " جوهرة"
	local mine, theirs = state.MyConfirmed, state.TheirConfirmed
	if state.Countdown then
		statusLabel.Text = "⏳ يتم التبادل خلال " .. state.Countdown .. "..."
		statusLabel.TextColor3 = UIKit.Colors.Gold
	else
		statusLabel.Text = (mine and "✅ أكدت" or "⬜ لم تؤكد") .. "   •   " .. (theirs and "✅ الطرف الآخر أكد" or "⬜ الطرف الآخر لم يؤكد")
		statusLabel.TextColor3 = UIKit.Colors.Muted
	end
	confirmBtn.Text = mine and "إلغاء التأكيد" or "✅ تأكيد"
	confirmBtn.BackgroundColor3 = mine and UIKit.Colors.Panel3 or UIKit.Colors.Green
end

function TradeUI.Init()
	local gui = UIController.Gui :: ScreenGui

	-- قائمة اللاعبين
	local list = UIKit.Window(gui, "Trade", "🤝 التبادل — اللاعبون", UDim2.fromOffset(460, 520), Color3.fromRGB(60, 120, 220))
	UIKit.Label({ Text = "اختر لاعباً لإرسال طلب تبادل. الحد " .. Config.TradeMaxPets .. " حيوانات لكل طرف.", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = list.Content })
	local scroll = UIKit.Scroll(list.Content, { Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 44) })
	UIKit.List(scroll, 6)
	local function refreshList()
		clear(scroll)
		local me = Players.LocalPlayer
		local any = false
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= me then
				any = true
				local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 52), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
				UIKit.Corner(row, 10)
				UIKit.Label({ Text = pl.DisplayName .. "  (@" .. pl.Name .. ")", Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = row })
				UIKit.Button({ Text = "طلب تبادل", Color = UIKit.Colors.Blue, Size = UDim2.fromOffset(130, 38), Position = UDim2.new(1, -140, 0, 7), MaxTextSize = 16, Parent = row }, function()
					Remotes.Event("TradeRequest"):FireServer(pl.UserId)
				end)
			end
		end
		if not any then
			UIKit.Label({ Text = "لا يوجد لاعبون آخرون في السيرفر", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = scroll })
		end
	end
	UIController.Register("Trade", list, refreshList)

	-- نافذة التبادل
	tradeWindow = UIKit.Window(gui, "TradeSession", "🤝 تبادل", UDim2.fromOffset(940, 640), Color3.fromRGB(60, 120, 220))
	partnerLabel = tradeWindow.Title
	local left = UIKit.Frame({ Size = UDim2.new(0.5, -6, 0, 250), BackgroundColor3 = UIKit.Colors.Panel2, Parent = tradeWindow.Content })
	UIKit.Corner(left, 12)
	UIKit.Label({ Text = "عرضي", Size = UDim2.new(0.5, 0, 0, 26), MaxTextSize = 18, Parent = left })
	myGemsBox = UIKit.New("TextBox", { Size = UDim2.new(0.5, -8, 0, 26), Position = UDim2.new(0.5, 4, 0, 0), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "💠 جواهر تعرضها", Text = "0", Font = UIKit.Font, TextColor3 = Color3.fromRGB(200, 140, 255), TextSize = 16, ClearTextOnFocus = false, Parent = left }) :: TextBox
	UIKit.Corner(myGemsBox, 8)
	myGemsBox.FocusLost:Connect(function()
		Remotes.Event("TradeAction"):FireServer("SetGems", { Amount = tonumber(myGemsBox.Text) or 0 })
	end)
	myGrid = UIKit.Scroll(left, { Size = UDim2.new(1, -8, 1, -30), Position = UDim2.fromOffset(4, 28) })
	UIKit.Grid(myGrid, UDim2.fromOffset(100, 118), 6)
	local right = UIKit.Frame({ Size = UDim2.new(0.5, -6, 0, 250), Position = UDim2.new(0.5, 6, 0, 0), BackgroundColor3 = UIKit.Colors.Panel2, Parent = tradeWindow.Content })
	UIKit.Corner(right, 12)
	UIKit.Label({ Text = "عرض الطرف الآخر", Size = UDim2.new(0.5, 0, 0, 26), MaxTextSize = 18, Parent = right })
	theirGemsLabel = UIKit.Label({ Text = "💠 0", Size = UDim2.new(0.5, -8, 0, 26), Position = UDim2.new(0.5, 4, 0, 0), TextColor3 = Color3.fromRGB(200, 140, 255), MaxTextSize = 16, Parent = right })
	theirGrid = UIKit.Scroll(right, { Size = UDim2.new(1, -8, 1, -30), Position = UDim2.fromOffset(4, 28) })
	UIKit.Grid(theirGrid, UDim2.fromOffset(100, 118), 6)
	statusLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -240, 0, 40), Position = UDim2.fromOffset(0, 256), MaxTextSize = 18, Parent = tradeWindow.Content })
	confirmBtn = UIKit.Button({ Text = "تأكيد", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -230, 0, 256), MaxTextSize = 18, Parent = tradeWindow.Content }, function()
		Remotes.Event("TradeAction"):FireServer("Confirm", {})
	end)
	UIKit.Button({ Text = "إلغاء", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -110, 0, 256), MaxTextSize = 18, Parent = tradeWindow.Content }, function()
		Remotes.Event("TradeAction"):FireServer("Cancel", {})
	end)
	UIKit.Label({ Text = "حيواناتك (اضغط للإضافة)", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 300), MaxTextSize = 16, TextColor3 = UIKit.Colors.Muted, Parent = tradeWindow.Content })
	invGrid = UIKit.Scroll(tradeWindow.Content, { Size = UDim2.new(1, 0, 1, -326), Position = UDim2.fromOffset(0, 326) })
	UIKit.Grid(invGrid, UDim2.fromOffset(100, 118), 6)
	tradeWindow.Close.Activated:Connect(function()
		Remotes.Event("TradeAction"):FireServer("Cancel", {})
	end)
	UIController.Register("TradeSession", tradeWindow, refreshTrade)

	Remotes.Event("TradeUpdate").OnClientEvent:Connect(function(data)
		state = data
		if data then
			if not UIController.IsOpen("TradeSession") then
				UIController.Open("TradeSession")
			else
				refreshTrade()
			end
		elseif UIController.IsOpen("TradeSession") then
			UIController.Close()
		end
	end)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("TradeSession") then
			refreshTrade()
		end
	end)

	-- طلب وارد
	Remotes.Event("TradeIncoming").OnClientEvent:Connect(function(data)
		local popup = UIKit.Frame({ Size = UDim2.fromOffset(360, 120), Position = UDim2.new(0.5, -180, 0, 200), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 20, Parent = gui })
		UIKit.Corner(popup, 14)
		UIKit.Stroke(popup, UIKit.Colors.Blue, 3)
		UIKit.Label({ Text = "🤝 " .. data.FromName .. " يريد التبادل معك", Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 6), MaxTextSize = 20, ZIndex = 21, Parent = popup })
		UIKit.Button({ Text = "قبول", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(150, 40), Position = UDim2.fromOffset(20, 66), MaxTextSize = 18, ZIndex = 21, Parent = popup }, function()
			Remotes.Event("TradeRespond"):FireServer(data.FromUserId, true)
			popup:Destroy()
		end)
		UIKit.Button({ Text = "رفض", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -170, 0, 66), MaxTextSize = 18, ZIndex = 21, Parent = popup }, function()
			Remotes.Event("TradeRespond"):FireServer(data.FromUserId, false)
			popup:Destroy()
		end)
		UIKit.Pop(popup)
		task.delay(20, function()
			if popup.Parent then
				popup:Destroy()
			end
		end)
	end)
end

return TradeUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000070"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!strict
-- HUD + إدارة النوافذ + الإشعارات + النوافذ البسيطة (المناطق، المكافآت، الأكواد، الفهرس، الإعدادات)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Pets = require(Shared.Data.Pets)
local Eggs = require(Shared.Data.Eggs)
local Rarities = require(Shared.Data.Rarities)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local PetViewport = require(script.Parent.PetViewport)

local UIController = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local windows: { [string]: UIKit.Window } = {}
local currentWindow: string? = nil
local hud: Frame
local notifHolder: Frame
local refreshers: { [string]: () -> () } = {}

UIController.Gui = nil :: ScreenGui?
UIController.Windows = windows

-- ===== النوافذ =====
function UIController.Register(name: string, window: UIKit.Window, refresh: (() -> ())?)
	windows[name] = window
	if refresh then
		refreshers[name] = refresh
	end
	window.Close.Activated:Connect(function()
		UIController.Close()
	end)
end

function UIController.Close()
	if currentWindow and windows[currentWindow] then
		windows[currentWindow].Root.Visible = false
	end
	currentWindow = nil
end

function UIController.Open(name: string)
	if currentWindow == name then
		UIController.Close()
		return
	end
	UIController.Close()
	local w = windows[name]
	if not w then
		return
	end
	currentWindow = name
	if refreshers[name] then
		refreshers[name]()
	end
	w.Root.Visible = true
	UIKit.Pop(w.Root)
end

function UIController.IsOpen(name: string): boolean
	return currentWindow == name
end

function UIController.Refresh(name: string)
	if currentWindow == name and refreshers[name] then
		refreshers[name]()
	end
end

-- ===== الإشعارات =====
function UIController.Notify(text: string, color: Color3?)
	local frame = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = UIKit.Colors.Panel2, BackgroundTransparency = 0.1, Parent = notifHolder })
	UIKit.Corner(frame, 12)
	UIKit.Stroke(frame, color or UIKit.Colors.Blue, 2.5)
	local label = UIKit.Label({ Text = text, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextColor3 = color or UIKit.Colors.Text, MaxTextSize = 22, Parent = frame })
	UIKit.Pop(frame)
	task.delay(4, function()
		UIKit.Tween(frame, { BackgroundTransparency = 1 }, 0.4)
		UIKit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.4)
		task.wait(0.45)
		frame:Destroy()
	end)
end

-- ===== HUD =====
local coinsLabel: TextLabel
local diamondsLabel: TextLabel
local tokensLabel: TextLabel
local gemsLabel: TextLabel
local powerLabel: TextLabel
local zoneLabel: TextLabel
local rebirthLabel: TextLabel
local potionsLabel: TextLabel
local giftButton: TextButton
local adminButton: TextButton
local eventBanner: Frame
local eventLabel: TextLabel
local eventTimer: TextLabel
local dungeonBanner: Frame
local dungeonLabel: TextLabel
local dungeonTimer: TextLabel
local bossBar: Frame
local bossFill: Frame
local bossText: TextLabel
local questFrame: Frame
local questText: TextLabel
local questProgress: TextLabel
local questClaim: TextButton
local potionBar: Frame
local potionButtons: { [string]: TextButton } = {}

local function buildHUD()
	hud = UIKit.Frame({ Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })

	-- العملات
	local currency = UIKit.Frame({ Size = UDim2.fromOffset(220, 180), Position = UDim2.fromOffset(16, 16), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.15, Parent = hud })
	UIKit.Corner(currency, 16)
	UIKit.Stroke(currency, UIKit.Colors.Panel3, 2)
	UIKit.Padding(currency, 8)
	UIKit.List(currency, 6)
	local function currencyRow(icon: string, color: Color3): TextLabel
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Color3.fromRGB(15, 16, 28), Parent = currency })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = icon, Size = UDim2.fromOffset(34, 36), Parent = row })
		return UIKit.Label({ Text = "0", Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(40, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, MaxTextSize = 26, Parent = row })
	end
	coinsLabel = currencyRow("💰", UIKit.Colors.Gold)
	diamondsLabel = currencyRow("💎", UIKit.Colors.Cyan)
	gemsLabel = currencyRow("💠", Color3.fromRGB(200, 140, 255))
	tokensLabel = currencyRow("🔁", Color3.fromRGB(255, 140, 60))

	-- القوة والمنطقة والريبيرث
	local top = UIKit.Frame({ Size = UDim2.fromOffset(440, 40), Position = UDim2.new(0.5, -220, 0, 12), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.15, Parent = hud })
	UIKit.Corner(top, 14)
	UIKit.Stroke(top, UIKit.Colors.Panel3, 2)
	zoneLabel = UIKit.Label({ Text = "Town", Size = UDim2.fromScale(0.4, 1), MaxTextSize = 22, Parent = top })
	powerLabel = UIKit.Label({ Text = "⚔️ 0", Size = UDim2.fromScale(0.35, 1), Position = UDim2.fromScale(0.4, 0), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 22, Parent = top })
	rebirthLabel = UIKit.Label({ Text = "🔁 0", Size = UDim2.fromScale(0.25, 1), Position = UDim2.fromScale(0.75, 0), TextColor3 = Color3.fromRGB(255, 140, 60), MaxTextSize = 22, Parent = top })

	potionsLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(440, 22), Position = UDim2.new(0.5, -220, 0, 56), TextColor3 = UIKit.Colors.Purple, MaxTextSize = 17, Parent = hud })

	-- شريط الحدث
	eventBanner = UIKit.Frame({ Size = UDim2.fromOffset(440, 40), Position = UDim2.new(0.5, -220, 0, 82), BackgroundColor3 = Color3.fromRGB(80, 40, 120), Visible = false, Parent = hud })
	UIKit.Corner(eventBanner, 12)
	UIKit.Stroke(eventBanner, UIKit.Colors.Gold, 2.5)
	UIKit.Gradient(eventBanner, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 150))
	eventLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = eventBanner })
	eventTimer = UIKit.Label({ Text = "", Size = UDim2.fromOffset(80, 40), Position = UDim2.new(1, -86, 0, 0), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 20, Parent = eventBanner })

	-- شريط الزنزانة
	dungeonBanner = UIKit.Frame({ Size = UDim2.fromOffset(440, 40), Position = UDim2.new(0.5, -220, 0, 170), BackgroundColor3 = Color3.fromRGB(60, 0, 110), Visible = false, Parent = hud })
	UIKit.Corner(dungeonBanner, 12)
	UIKit.Stroke(dungeonBanner, Color3.fromRGB(157, 0, 255), 2.5)
	dungeonLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = dungeonBanner })
	dungeonTimer = UIKit.Label({ Text = "", Size = UDim2.fromOffset(80, 40), Position = UDim2.new(1, -86, 0, 0), TextColor3 = Color3.fromRGB(200, 140, 255), MaxTextSize = 20, Parent = dungeonBanner })

	-- شريط الزعيم
	bossBar = UIKit.Frame({ Size = UDim2.fromOffset(520, 34), Position = UDim2.new(0.5, -260, 0, 128), BackgroundColor3 = Color3.fromRGB(15, 15, 25), Visible = false, Parent = hud })
	UIKit.Corner(bossBar, 10)
	UIKit.Stroke(bossBar, UIKit.Colors.Red, 3)
	bossFill = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(60, 200, 60), Parent = bossBar })
	UIKit.Corner(bossFill, 10)
	bossText = UIKit.Label({ Text = "", MaxTextSize = 20, TextStrokeTransparency = 0, Parent = bossBar })

	-- متتبع الدليل التعليمي
	questFrame = UIKit.Frame({ Size = UDim2.fromOffset(300, 92), Position = UDim2.new(1, -316, 0.5, -46), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.15, Visible = false, Parent = hud })
	UIKit.Corner(questFrame, 12)
	UIKit.Stroke(questFrame, UIKit.Colors.Cyan, 2)
	UIKit.Label({ Text = "🎓 الدليل", Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 16, Parent = questFrame })
	questText = UIKit.Label({ Text = "", Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 22), MaxTextSize = 15, Parent = questFrame })
	questProgress = UIKit.Label({ Text = "", Size = UDim2.new(0.5, 0, 0, 28), Position = UDim2.new(0, 6, 1, -32), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = questFrame })
	questClaim = UIKit.Button({ Text = "استلام", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(120, 28), Position = UDim2.new(1, -126, 1, -32), MaxTextSize = 16, Visible = false, Parent = questFrame }, function()
		local res = Remotes.Function("ClaimTutorial"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)

	-- شريط الجرعات السريع
	potionBar = UIKit.Frame({ Size = UDim2.fromOffset(240, 52), Position = UDim2.new(1, -256, 1, -70), BackgroundTransparency = 1, Parent = hud })
	UIKit.List(potionBar, 6, true)
	for _, key in ipairs(Config.PotionOrder) do
		local cfg = Config.Potions[key]
		local btn = UIKit.Button({ Text = cfg.Icon .. " 0", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(54, 48), MaxTextSize = 16, Parent = potionBar }, function()
			local res = Remotes.Function("UsePotion"):InvokeServer(key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		potionButtons[key] = btn
	end

	-- أزرار القائمة اليسرى
	local menu = UIKit.Frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 720), Position = UDim2.fromOffset(16, 206), Parent = hud })
	UIKit.List(menu, 2)
	local function menuBtn(icon: string, text: string, color: Color3, win: string)
		UIKit.IconButton(menu, icon, text, color, function()
			UIController.Open(win)
		end)
	end
	menuBtn("🐾", "Pets", UIKit.Colors.Green, "Inventory")
	menuBtn("🛒", "Shop", UIKit.Colors.Blue, "Shop")
	menuBtn("🗺️", "Zones", UIKit.Colors.Gold, "Zones")
	menuBtn("🎁", "Rewards", UIKit.Colors.Pink, "Rewards")
	menuBtn("📋", "Missions", UIKit.Colors.Cyan, "Missions")
	menuBtn("📊", "Stats", Color3.fromRGB(255, 140, 60), "Stats")
	menuBtn("🤝", "Trade", Color3.fromRGB(60, 120, 220), "Trade")
	menuBtn("🏪", "Market", Color3.fromRGB(255, 140, 60), "Market")
	menuBtn("🎫", "Season", UIKit.Colors.Gold, "Season")
	menuBtn("📖", "Index", UIKit.Colors.Purple, "Index")

	-- أزرار يمين
	local right = UIKit.Frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 360), Position = UDim2.new(1, -96, 0, 16), Parent = hud })
	UIKit.List(right, 2)
	UIKit.IconButton(right, "⚙️", "Settings", UIKit.Colors.Panel3, function()
		UIController.Open("Settings")
	end)
	giftButton = UIKit.IconButton(right, "⏱️", "Gift", UIKit.Colors.Red, function()
		UIController.Open("Rewards")
	end)
	UIKit.IconButton(right, "🔑", "Codes", UIKit.Colors.Cyan, function()
		UIController.Open("Codes")
	end)
	UIKit.IconButton(right, "🏆", "Top", UIKit.Colors.Gold, function()
		UIController.Open("Leaderboards")
	end)
	UIKit.IconButton(right, "👑", "VIP", UIKit.Colors.Gold, function()
		if DataController.Owns("VIP") then
			Remotes.Event("Teleport"):FireServer(0)
		else
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", "VIP")
		end
	end)
	adminButton = UIKit.IconButton(right, "🛠️", "Admin", UIKit.Colors.Red, function()
		UIController.Open("Admin")
	end)
	adminButton.Parent.Visible = false
end

local function tweenNumber(label: TextLabel, from: number, to: number)
	local start = os.clock()
	local dur = 0.35
	task.spawn(function()
		while os.clock() - start < dur do
			local a = (os.clock() - start) / dur
			label.Text = Format.Number(from + (to - from) * a)
			task.wait()
		end
		label.Text = Format.Number(to)
	end)
end

local lastCoins, lastDiamonds = 0, 0

local function refreshHUD(p: any)
	tweenNumber(coinsLabel, lastCoins, p.Coins)
	tweenNumber(diamondsLabel, lastDiamonds, p.Diamonds)
	lastCoins, lastDiamonds = p.Coins, p.Diamonds
	tokensLabel.Text = tostring(p.Tokens or 0)
	gemsLabel.Text = Format.Number(p.Gems or 0)
	powerLabel.Text = "⚔️ " .. Format.Number(p.Power or 0)
	rebirthLabel.Text = "🔁 " .. (p.Rebirths or 0)
	adminButton.Parent.Visible = p.IsAdmin == true
	for key, btn in pairs(potionButtons) do
		local n = p.PotionBag and p.PotionBag[key] or 0
		btn.Text = Config.Potions[key].Icon .. " " .. n
		btn.BackgroundColor3 = n > 0 and UIKit.Colors.Purple or UIKit.Colors.Panel3
	end
	-- الدليل
	local step = Config.Tutorial[p.Tutorial and p.Tutorial.Step or 999]
	if step then
		questFrame.Visible = true
		questText.Text = step.Text
		local prog = p.Tutorial.Progress
		local done = false
		if step.Type == "Zone" then
			done = p.UnlockedZones[tostring(step.Target)] == true
			questProgress.Text = done and "✅" or "🔒"
		else
			questProgress.Text = prog .. " / " .. step.Target
			done = prog >= step.Target
		end
		questClaim.Visible = done
	else
		questFrame.Visible = false
	end
end

local function updateTimers()
	local p = DataController.Profile
	if not p then
		return
	end
	local now = DataController.ServerTime()
	local parts = {}
	for _, key in ipairs(Config.PotionOrder) do
		local cfg = Config.Potions[key]
		local exp = p.Potions[key] or 0
		if exp > now then
			table.insert(parts, cfg.Icon .. " " .. Format.Time(exp - now))
		end
	end
	potionsLabel.Text = table.concat(parts, "   ")
	-- الحدث
	local state = Remotes.State()
	local eventId = state:GetAttribute("EventId")
	local ends = tonumber(state:GetAttribute("EventEnds")) or 0
	if type(eventId) == "string" and eventId ~= "" and ends > now then
		local e
		for _, ev in ipairs(Config.Events.List) do
			if ev.Id == eventId then
				e = ev
			end
		end
		eventBanner.Visible = true
		eventLabel.Text = e and (e.Name .. " • " .. e.Arabic) or eventId
		eventTimer.Text = Format.Time(ends - now)
	else
		eventBanner.Visible = false
		local nextAt = tonumber(state:GetAttribute("NextEvent")) or 0
		if nextAt > now and nextAt - now < 60 then
			eventBanner.Visible = true
			eventLabel.Text = "⏳ حدث قادم بعد"
			eventTimer.Text = Format.Time(nextAt - now)
		end
	end
	-- الزنزانة
	local dEnds = tonumber(state:GetAttribute("DungeonEnds")) or 0
	if dEnds > now then
		dungeonBanner.Visible = true
		dungeonTimer.Text = Format.Time(dEnds - now)
	else
		dungeonBanner.Visible = false
	end
	-- زر الهدية
	local elapsed = now - (p.SessionStart or now)
	local nextReward
	for i, r in ipairs(Config.PlaytimeRewards) do
		if not p.PlaytimeClaimed[tostring(i)] then
			nextReward = r
			break
		end
	end
	if nextReward then
		local remain = nextReward.Minutes * 60 - elapsed
		giftButton.Text = remain <= 0 and "🎁" or Format.Time(remain)
		giftButton.BackgroundColor3 = remain <= 0 and UIKit.Colors.Green or UIKit.Colors.Red
	else
		giftButton.Text = "✅"
	end
	-- المنطقة الحالية
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local pos = hrp.Position
		local vip = Config.Map.VIPOffset
		local market = Config.Map.MarketOffset
		local w2 = Config.Map.World2Offset
		local w3 = Config.Map.World3Offset
		local flat = Vector3.new(pos.X, 0, pos.Z)
		local idx
		if (flat - Vector3.new(vip.X, 0, vip.Z)).Magnitude < 220 then
			idx = 0
		elseif (flat - Vector3.new(market.X, 0, market.Z)).Magnitude < 260 then
			idx = -1
		elseif pos.X > w3.X - 500 then
			idx = math.clamp(Zones.WorldStart[3] + math.floor((pos.Z - w3.Z) / Config.Map.ZoneSpacing + 0.5), Zones.WorldStart[3], #Zones.List)
		elseif pos.X > w2.X - 500 then
			idx = math.clamp(Zones.WorldStart[2] + math.floor((pos.Z - w2.Z) / Config.Map.ZoneSpacing + 0.5), Zones.WorldStart[2], Zones.WorldStart[3] - 1)
		else
			idx = math.clamp(math.floor(pos.Z / Config.Map.ZoneSpacing + 0.5) + 1, 1, Zones.WorldStart[2] - 1)
		end
		local zone = Zones.Get(idx)
		if zone then
			zoneLabel.Text = zone.Name
		end
	end
end

-- ===== نافذة المناطق =====
local function buildZonesWindow()
	local w = UIKit.Window(gui, "Zones", "🗺️ المناطق", UDim2.fromOffset(560, 600), UIKit.Colors.Gold)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 8)
	local rows: { [number]: { Frame: Frame, Button: TextButton, Status: TextLabel } } = {}
	local all = table.clone(Zones.List)
	table.insert(all, Zones.VIP)
	table.insert(all, Zones.Market)
	for _, zone in ipairs(all) do
		if zone.Index == Zones.WorldStart[2] then
			UIKit.Label({ Text = "🌐 العالم الثاني — Tech World (يتطلب ريبيرث)", Size = UDim2.new(1, -8, 0, 30), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 20, Parent = scroll })
		elseif zone.Index == Zones.WorldStart[3] then
			UIKit.Label({ Text = "✨ العالم الثالث — Mythic Realm (يتطلب 3 ريبيرث)", Size = UDim2.new(1, -8, 0, 30), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 20, Parent = scroll })
		elseif zone.Index == 0 then
			UIKit.Label({ Text = "🏝️ جزر خاصة", Size = UDim2.new(1, -8, 0, 30), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 20, Parent = scroll })
		end
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 64), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 12)
		UIKit.Stroke(row, zone.Accent, 2)
		local swatch = UIKit.Frame({ Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = zone.Ground, Parent = row })
		UIKit.Corner(swatch, 10)
		UIKit.Label({ Text = zone.Name .. "  •  " .. zone.Arabic, Size = UDim2.new(1, -230, 0, 30), Position = UDim2.fromOffset(64, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = row })
		local status = UIKit.Label({ Text = "", Size = UDim2.new(1, -230, 0, 22), Position = UDim2.fromOffset(64, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = row })
		local btn = UIKit.Button({ Text = "...", Size = UDim2.fromOffset(150, 44), Position = UDim2.new(1, -160, 0, 10), MaxTextSize = 20, Parent = row })
		rows[zone.Index] = { Frame = row, Button = btn, Status = status }
		btn.Activated:Connect(function()
			local p = DataController.Profile
			if not p then
				return
			end
			if zone.Index == 0 then
				if DataController.Owns("VIP") then
					Remotes.Event("Teleport"):FireServer(0)
					UIController.Close()
				else
					Remotes.Event("PromptPurchase"):FireServer("Gamepass", "VIP")
				end
				return
			elseif zone.Index == -1 then
				Remotes.Event("Teleport"):FireServer(-1)
				UIController.Close()
				return
			end
			if p.UnlockedZones[tostring(zone.Index)] then
				Remotes.Event("Teleport"):FireServer(zone.Index)
				UIController.Close()
			else
				local res = Remotes.Function("UnlockZone"):InvokeServer(zone.Index)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end
		end)
	end
	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for idx, row in pairs(rows) do
			local zone = Zones.Get(idx) :: Zones.ZoneDef
			if idx == 0 then
				local owns = DataController.Owns("VIP")
				row.Button.Text = owns and "انتقال" or "👑 شراء VIP"
				row.Button.BackgroundColor3 = owns and UIKit.Colors.Green or UIKit.Colors.Gold
				row.Status.Text = "منطقة حصرية لأعضاء VIP"
			elseif idx == -1 then
				row.Button.Text = "انتقال"
				row.Button.BackgroundColor3 = Color3.fromRGB(255, 140, 60)
				row.Status.Text = "سوق عالمي، أكشاك، بيضة البازار 💠"
			elseif (p.Rebirths or 0) < Zones.RebirthRequired(idx) then
				row.Button.Text = "🔁 ريبيرث"
				row.Button.BackgroundColor3 = UIKit.Colors.Panel3
				row.Status.Text = "يتطلب " .. Zones.RebirthRequired(idx) .. " ريبيرث"
			elseif p.UnlockedZones[tostring(idx)] then
				row.Button.Text = "انتقال"
				row.Button.BackgroundColor3 = UIKit.Colors.Green
				row.Status.Text = "✅ مفتوحة  •  x" .. Format.Number(zone.Multiplier)
			elseif Zones.IsWorldStart(idx) or p.UnlockedZones[tostring(idx - 1)] then
				row.Button.Text = "🔓 " .. Format.Number(zone.Cost)
				row.Button.BackgroundColor3 = p.Coins >= zone.Cost and UIKit.Colors.Gold or UIKit.Colors.Panel3
				row.Status.Text = "💰 " .. Format.Number(zone.Cost) .. " لفتحها"
			else
				row.Button.Text = "🔒"
				row.Button.BackgroundColor3 = UIKit.Colors.Panel3
				row.Status.Text = "افتح المنطقة السابقة أولاً"
			end
		end
	end
	UIController.Register("Zones", w, refresh)
end

-- ===== نافذة المكافآت =====
local function buildRewardsWindow()
	local w = UIKit.Window(gui, "Rewards", "🎁 المكافآت", UDim2.fromOffset(760, 600), UIKit.Colors.Pink)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 10)

	UIKit.Label({ Text = "📅 المكافأة اليومية", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = scroll })
	local dailyRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 110), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(dailyRow, 6, true)
	local dailyTiles = {}
	for i, r in ipairs(Config.DailyRewards) do
		local tile = UIKit.Frame({ Size = UDim2.fromOffset(92, 100), BackgroundColor3 = UIKit.Colors.Panel2, Parent = dailyRow })
		UIKit.Corner(tile, 10)
		local stroke = UIKit.Stroke(tile, UIKit.Colors.Panel3, 2)
		UIKit.Label({ Text = "يوم " .. i, Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = tile })
		local text = "💎 " .. r.Diamonds
		if r.Potion then
			text = text .. "\n🧪"
		end
		if r.Spins then
			text = text .. " 🎡" .. r.Spins
		end
		UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 1, -24), Position = UDim2.fromOffset(0, 22), MaxTextSize = 18, Parent = tile })
		dailyTiles[i] = { Tile = tile, Stroke = stroke }
	end
	local dailyBtnRow = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(dailyBtnRow, 10, true)
	local dailyBtn = UIKit.Button({ Text = "استلام", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(200, 44), MaxTextSize = 22, Parent = dailyBtnRow })
	local vipBtn = UIKit.Button({ Text = "👑 صندوق VIP اليومي", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(240, 44), MaxTextSize = 20, Parent = dailyBtnRow })
	local dailyStatus = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = scroll })
	dailyBtn.Activated:Connect(function()
		local res = Remotes.Function("ClaimDaily"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	vipBtn.Activated:Connect(function()
		if not DataController.Owns("VIP") then
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", "VIP")
			return
		end
		local res = Remotes.Function("ClaimVIPDaily"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)

	UIKit.Label({ Text = "⏱️ مكافآت وقت اللعب", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = scroll })
	local ptRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 250), BackgroundTransparency = 1, Parent = scroll })
	UIKit.Grid(ptRow, UDim2.fromOffset(92, 116), 6)
	local ptTiles = {}
	for i, r in ipairs(Config.PlaytimeRewards) do
		local tile = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = ptRow })
		UIKit.Corner(tile, 10)
		UIKit.Label({ Text = r.Minutes .. " دقيقة", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = tile })
		UIKit.Label({ Text = "💎 " .. r.Diamonds .. (r.Potion and "\n🧪" or "") .. (r.Spins and " 🎡" or ""), Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 22), MaxTextSize = 18, Parent = tile })
		local btn = UIKit.Button({ Text = "...", Size = UDim2.new(1, -12, 0, 34), Position = UDim2.new(0, 6, 1, -40), MaxTextSize = 16, Parent = tile })
		btn.Activated:Connect(function()
			local res = Remotes.Function("ClaimPlaytime"):InvokeServer(i)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		ptTiles[i] = btn
	end

	local groupLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Green, MaxTextSize = 18, Parent = scroll })

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local now = DataController.ServerTime()
		local nextIdx = ((p.Daily.Streak or 0) % #Config.DailyRewards) + 1
		for i, t in pairs(dailyTiles) do
			t.Stroke.Color = i == nextIdx and UIKit.Colors.Gold or UIKit.Colors.Panel3
			t.Tile.BackgroundColor3 = i < nextIdx and UIKit.Colors.Panel3 or UIKit.Colors.Panel2
		end
		local since = now - (p.Daily.LastClaim or 0)
		local canClaim = since >= 20 * 3600
		dailyBtn.BackgroundColor3 = canClaim and UIKit.Colors.Green or UIKit.Colors.Panel3
		dailyStatus.Text = canClaim and "جاهزة للاستلام! سلسلة: " .. (p.Daily.Streak or 0) or ("التالية بعد " .. Format.Time(20 * 3600 - since))
		local day = math.floor(now / 86400)
		vipBtn.BackgroundColor3 = (DataController.Owns("VIP") and p.VIPDaily ~= day) and UIKit.Colors.Gold or UIKit.Colors.Panel3
		local elapsed = now - (p.SessionStart or now)
		for i, btn in pairs(ptTiles) do
			local r = Config.PlaytimeRewards[i]
			if p.PlaytimeClaimed[tostring(i)] then
				btn.Text = "✅"
				btn.BackgroundColor3 = UIKit.Colors.Panel3
			elseif elapsed >= r.Minutes * 60 then
				btn.Text = "استلام"
				btn.BackgroundColor3 = UIKit.Colors.Green
			else
				btn.Text = Format.Time(r.Minutes * 60 - elapsed)
				btn.BackgroundColor3 = UIKit.Colors.Panel3
			end
		end
		local lines = {}
		if Config.GroupId > 0 then
			table.insert(lines, p.InGroup and "✅ مكافأة المجموعة مفعلة: +25% حظ و +25% عملات" or "انضم لمجموعة اللعبة واحصل على +25% حظ و +25% عملات")
		end
		if p.Premium then
			table.insert(lines, "⭐ Premium: +10% حظ و +10% عملات")
		end
		groupLabel.Text = table.concat(lines, "\n")
	end
	UIController.Register("Rewards", w, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Rewards") then
				refresh()
			end
		end
	end)
end

-- ===== نافذة الأكواد =====
local function buildCodesWindow()
	local w = UIKit.Window(gui, "Codes", "🔑 الأكواد", UDim2.fromOffset(420, 240), UIKit.Colors.Cyan)
	UIKit.Label({ Text = "أدخل الكود للحصول على مكافآت! تابع حساباتنا للأكواد الجديدة.", Size = UDim2.new(1, 0, 0, 44), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = w.Content })
	local box = UIKit.New("TextBox", {
		Size = UDim2.new(1, 0, 0, 46),
		Position = UDim2.fromOffset(0, 54),
		BackgroundColor3 = Color3.fromRGB(15, 16, 28),
		PlaceholderText = "CODE",
		Text = "",
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 24,
		ClearTextOnFocus = false,
		Parent = w.Content,
	}) :: TextBox
	UIKit.Corner(box, 10)
	UIKit.Stroke(box, UIKit.Colors.Panel3, 2)
	UIKit.Button({ Text = "تفعيل", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 112), MaxTextSize = 22, Parent = w.Content }, function()
		local res = Remotes.Function("RedeemCode"):InvokeServer(box.Text)
		if res.ok then
			box.Text = ""
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	UIController.Register("Codes", w)
end

-- ===== نافذة الفهرس =====
local function buildIndexWindow()
	local w = UIKit.Window(gui, "Index", "📖 فهرس الحيوانات", UDim2.fromOffset(820, 600), UIKit.Colors.Purple)
	local counter = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 20, TextColor3 = UIKit.Colors.Muted, Parent = w.Content })
	-- مكافآت إكمال فهرس كل بيضة
	local eggRow = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 0, 62), Position = UDim2.fromOffset(0, 28), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X })
	UIKit.List(eggRow, 6, true)
	local eggChips: { [string]: TextButton } = {}
	for i, egg in ipairs(Eggs.List) do
		eggChips[egg.Id] = UIKit.Button({ LayoutOrder = i, Text = egg.Name, Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(150, 50), MaxTextSize = 13, Parent = eggRow }, function()
			local res = Remotes.Function("PetAction"):InvokeServer("ClaimIndex", { EggId = egg.Id })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
	end
	local scroll = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -96), Position = UDim2.fromOffset(0, 96) })
	UIKit.Grid(scroll, UDim2.fromOffset(110, 140), 8)
	local cards: { [string]: { Card: Frame, Vp: ViewportFrame?, Name: TextLabel } } = {}
	local built = false
	local function build()
		if built then
			return
		end
		built = true
		local sorted = table.clone(Pets.List)
		table.sort(sorted, function(a, b)
			if a.Tier ~= b.Tier then
				return a.Tier < b.Tier
			end
			return Rarities.Rank(a.Rarity) < Rarities.Rank(b.Rarity)
		end)
		for i, def in ipairs(sorted) do
			local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
			UIKit.Corner(card, 12)
			UIKit.Stroke(card, Rarities.Color(def.Rarity), 2)
			local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 96), BackgroundTransparency = 1, Parent = card })
			local name = UIKit.Label({ Text = "???", Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 98), MaxTextSize = 15, Parent = card })
			local ab = Config.Abilities[def.Shape]
			UIKit.Label({ Text = (ab and (ab.Icon .. " ") or "") .. def.Rarity, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 120), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 13, Parent = card })
			cards[def.Id] = { Card = card, Vp = nil, Name = name }
			cards[def.Id].Vp = PetViewport.Create(vpHolder, def.Id, "Normal")
		end
	end
	local function refresh()
		build()
		local p = DataController.Profile
		if not p then
			return
		end
		local found = 0
		for id, c in pairs(cards) do
			local def = Pets.Get(id) :: Pets.PetDef
			local discovered = p.Index[id] == true
			if discovered then
				found += 1
			end
			c.Name.Text = discovered and def.Name or "???"
			if c.Vp then
				c.Vp.ImageTransparency = discovered and 0 or 0.85
			end
		end
		counter.Text = "اكتشفت " .. found .. " / " .. #Pets.List
		for _, egg in ipairs(Eggs.List) do
			local chip = eggChips[egg.Id]
			local have, total = 0, #egg.Pets
			for _, entry in ipairs(egg.Pets) do
				if p.Index[entry.Pet] then
					have += 1
				end
			end
			local claimed = p.IndexClaimed and p.IndexClaimed[egg.Id]
			local reward = Config.IndexReward(math.max(1, egg.Zone))
			chip.Text = egg.Name .. "  " .. have .. "/" .. total .. (claimed and "  ✅" or ("\n💎" .. Format.Number(reward.Diamonds) .. " 💠" .. reward.Gems))
			chip.BackgroundColor3 = claimed and UIKit.Colors.Panel3 or (have >= total and UIKit.Colors.Green or UIKit.Colors.Panel3)
		end
	end
	UIController.Register("Index", w, refresh)
end

-- ===== الإعدادات =====
local function buildSettingsWindow()
	local w = UIKit.Window(gui, "Settings", "⚙️ الإعدادات", UDim2.fromOffset(460, 400), UIKit.Colors.Panel3)
	UIKit.List(w.Content, 8)
	local function toggle(text: string, key: string, defaultOn: boolean)
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = text, Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		local btn = UIKit.Button({ Text = "ON", Size = UDim2.fromOffset(90, 36), Position = UDim2.new(1, -100, 0, 6), MaxTextSize = 18, Parent = row })
		local function refresh()
			local p = DataController.Profile
			local v = p and p.Settings and p.Settings[key]
			local on = if v == nil then defaultOn else v == true
			btn.Text = on and "ON" or "OFF"
			btn.BackgroundColor3 = on and UIKit.Colors.Green or UIKit.Colors.Red
		end
		btn.Activated:Connect(function()
			local p = DataController.Profile
			if p then
				local v = p.Settings[key]
				local on = if v == nil then defaultOn else v == true
				p.Settings[key] = not on
				Remotes.Function("PetAction"):InvokeServer("Setting", { Key = key, Value = p.Settings[key] })
				refresh()
			end
		end)
		DataController.Changed:Connect(refresh)
		refresh()
	end
	toggle("🎵 الموسيقى", "Music", true)
	toggle("🙈 إخفاء حيوانات الآخرين", "HideOthersPets", false)
	toggle("⚡ رسومات منخفضة", "LowGraphics", false)
	toggle("🔢 أرقام الضرر", "DamageNumbers", true)

	-- الحذف التلقائي
	local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 80), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
	UIKit.Corner(row, 10)
	UIKit.Label({ Text = "🗑️ حذف تلقائي بعد الفتح (حتى الندرة):", Size = UDim2.new(1, -12, 0, 28), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = row })
	local opts = UIKit.Frame({ Size = UDim2.new(1, -12, 0, 36), Position = UDim2.fromOffset(6, 38), BackgroundTransparency = 1, Parent = row })
	UIKit.List(opts, 6, true)
	local optButtons = {}
	for rank = 0, 4 do
		local label = rank == 0 and "إيقاف" or Rarities.Order[rank]
		local btn = UIKit.Button({ Text = label, Size = UDim2.fromOffset(80, 34), MaxTextSize = 15, Parent = opts }, function()
			Remotes.Function("PetAction"):InvokeServer("Setting", { Key = "AutoDeleteRank", Value = rank })
		end)
		optButtons[rank] = btn
	end
	local function refreshAuto()
		local p = DataController.Profile
		local cur = p and p.Settings and p.Settings.AutoDeleteRank or 0
		for rank, btn in pairs(optButtons) do
			btn.BackgroundColor3 = rank == cur and UIKit.Colors.Green or UIKit.Colors.Panel3
		end
	end
	DataController.Changed:Connect(refreshAuto)
	refreshAuto()
	UIController.Register("Settings", w)
end

function UIController.Init()
	gui = Instance.new("ScreenGui")
	gui.Name = "PetKingdomUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	UIController.Gui = gui

	notifHolder = UIKit.Frame({ Name = "Notifications", BackgroundTransparency = 1, Size = UDim2.fromOffset(380, 300), Position = UDim2.new(0.5, -190, 0, 170), Parent = gui })
	UIKit.List(notifHolder, 6, false, true)

	buildHUD()
	buildZonesWindow()
	buildRewardsWindow()
	buildCodesWindow()
	buildIndexWindow()
	buildSettingsWindow()

	DataController.Changed:Connect(function(p)
		refreshHUD(p)
		if currentWindow and refreshers[currentWindow] then
			refreshers[currentWindow]()
		end
	end)
	if DataController.Profile then
		refreshHUD(DataController.Profile)
	end
	task.spawn(function()
		while true do
			updateTimers()
			task.wait(1)
		end
	end)

	Remotes.Event("Notify").OnClientEvent:Connect(function(data)
		UIController.Notify(data.Text, data.Color)
	end)
	Remotes.Event("HatchBroadcast").OnClientEvent:Connect(function(data)
		local def = Pets.Get(data.PetId)
		if def then
			UIController.Notify("🌟 " .. data.Player .. " حصل على " .. def.Name .. " (" .. def.Rarity .. ")!", Rarities.Color(def.Rarity))
		end
	end)
	Remotes.Event("BossUpdate").OnClientEvent:Connect(function(data)
		if data.Active then
			bossBar.Visible = true
			local ratio = math.clamp((data.Health or 0) / math.max(1, data.MaxHealth or 1), 0, 1)
			bossFill.Size = UDim2.fromScale(ratio, 1)
			bossText.Text = "👹 " .. (data.Name or Config.Events.Boss.Name) .. "  " .. Format.Number(data.Health or 0) .. " / " .. Format.Number(data.MaxHealth or 0)
		else
			bossBar.Visible = false
		end
	end)

	Remotes.Event("DungeonUpdate").OnClientEvent:Connect(function(data)
		dungeonLabel.Text = data.Text or ""
		if data.Active then
			dungeonBanner.Visible = true
		end
	end)
	Remotes.Event("EventEffect").OnClientEvent:Connect(function(data)
		if data.Type == "WelcomeBack" then
			local popup = UIKit.Frame({ Size = UDim2.fromOffset(420, 150), Position = UDim2.new(0.5, -210, 0, 220), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 20, Parent = gui })
			UIKit.Corner(popup, 16)
			UIKit.Stroke(popup, UIKit.Colors.Gold, 3)
			UIKit.Label({ Text = "👋 أهلاً بعودتك!", Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 8), MaxTextSize = 26, ZIndex = 21, Parent = popup })
			UIKit.Label({ Text = "حيواناتك جمعت أثناء غيابك (" .. Format.Time(data.Seconds or 0) .. "):\n💰 " .. Format.Number(data.Coins or 0), Size = UDim2.new(1, -16, 0, 60), Position = UDim2.fromOffset(8, 48), TextColor3 = UIKit.Colors.Gold, MaxTextSize = 20, ZIndex = 21, Parent = popup })
			UIKit.Button({ Text = "رائع!", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(160, 36), Position = UDim2.new(0.5, -80, 1, -44), MaxTextSize = 18, ZIndex = 21, Parent = popup }, function()
				popup:Destroy()
			end)
			UIKit.Pop(popup)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.X then
			UIController.Close()
		elseif input.KeyCode == Enum.KeyCode.Q then
			local res = Remotes.Function("Hoverboard"):InvokeServer("Toggle", "")
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)
end

return UIController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000071"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- أدوات بناء الواجهة بالكود (بدون أي أصول خارجية)
local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne
UIKit.Colors = {
	Panel = Color3.fromRGB(28, 31, 52),
	Panel2 = Color3.fromRGB(40, 44, 72),
	Panel3 = Color3.fromRGB(52, 57, 92),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(170, 175, 200),
	Green = Color3.fromRGB(70, 210, 110),
	Red = Color3.fromRGB(235, 80, 90),
	Blue = Color3.fromRGB(70, 150, 255),
	Gold = Color3.fromRGB(255, 200, 50),
	Purple = Color3.fromRGB(160, 90, 255),
	Cyan = Color3.fromRGB(80, 220, 255),
	Pink = Color3.fromRGB(255, 110, 190),
}

function UIKit.New(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UIKit.Corner(parent: Instance, px: number?): UICorner
	return UIKit.New("UICorner", { CornerRadius = UDim.new(0, px or 12), Parent = parent })
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UIKit.New("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.Gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UIKit.New("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.Padding(parent: Instance, px: number): UIPadding
	return UIKit.New("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UIKit.Frame(props: { [string]: any }): Frame
	local defaults = {
		BackgroundColor3 = UIKit.Colors.Panel,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UIKit.New("Frame", defaults)
end

function UIKit.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}
	for k, v in pairs(props) do
		if k ~= "MaxTextSize" then
			defaults[k] = v
		end
	end
	local label = UIKit.New("TextLabel", defaults)
	if props.MaxTextSize then
		UIKit.New("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = label })
	end
	return label
end

function UIKit.Tween(inst: Instance, props: { [string]: any }, t: number?, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- زر ملون مع تأثير عند المرور والضغط
function UIKit.Button(props: { [string]: any }, callback: (() -> ())?): TextButton
	local color = props.Color or UIKit.Colors.Blue
	local defaults = {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
		Text = props.Text or "",
		AutoButtonColor = false,
		TextStrokeTransparency = 0.5,
		Size = props.Size or UDim2.fromOffset(120, 40),
	}
	for k, v in pairs(props) do
		if k ~= "Color" and k ~= "MaxTextSize" then
			defaults[k] = v
		end
	end
	local btn = UIKit.New("TextButton", defaults) :: TextButton
	UIKit.Corner(btn, 10)
	UIKit.Stroke(btn, Color3.new(0, 0, 0), 2, 0.5)
	UIKit.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190))
	UIKit.New("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 26, Parent = btn })
	local h, s, v = color:ToHSV()
	btn.MouseEnter:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = Color3.fromHSV(h, s, math.min(1, v * 1.15)) }, 0.1)
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = color }, 0.1)
	end)
	btn.MouseButton1Down:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = Color3.fromHSV(h, s, v * 0.8) }, 0.05)
	end)
	btn.MouseButton1Up:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = color }, 0.1)
	end)
	if callback then
		btn.Activated:Connect(callback)
	end
	return btn
end

-- زر أيقونة دائري للـ HUD
function UIKit.IconButton(parent: Instance, icon: string, text: string, color: Color3, callback: () -> ()): TextButton
	local holder = UIKit.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(74, 84), Parent = parent })
	local btn = UIKit.New("TextButton", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(64, 64),
		Position = UDim2.fromOffset(5, 0),
		Text = icon,
		Font = UIKit.Font,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Parent = holder,
	}) :: TextButton
	UIKit.Corner(btn, 18)
	UIKit.Stroke(btn, Color3.new(0, 0, 0), 2.5, 0.4)
	UIKit.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	UIKit.Padding(btn, 8)
	UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 66), TextStrokeTransparency = 0.2, Parent = holder })
	btn.MouseEnter:Connect(function()
		UIKit.Tween(btn, { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(2, -3) }, 0.1)
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(btn, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(5, 0) }, 0.1)
	end)
	btn.Activated:Connect(callback)
	return btn
end

export type Window = { Root: Frame, Content: Frame, Title: TextLabel, Close: TextButton }

-- نافذة بعنوان وزر إغلاق
function UIKit.Window(parent: Instance, name: string, title: string, size: UDim2, accent: Color3?): Window
	local root = UIKit.Frame({
		Name = name,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		Parent = parent,
	})
	UIKit.Corner(root, 18)
	UIKit.Stroke(root, accent or UIKit.Colors.Panel3, 3)
	UIKit.Gradient(root, UIKit.Colors.Panel2, UIKit.Colors.Panel)

	local bar = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = accent or UIKit.Colors.Blue, Parent = root })
	UIKit.Corner(bar, 18)
	UIKit.Gradient(bar, Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180))
	UIKit.Frame({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = accent or UIKit.Colors.Blue, Parent = bar })
	local titleLabel = UIKit.Label({ Text = title, Size = UDim2.new(1, -120, 1, -10), Position = UDim2.fromOffset(60, 5), TextStrokeTransparency = 0.3, Parent = bar })
	UIKit.New("UITextSizeConstraint", { MaxTextSize = 32, Parent = titleLabel })

	local close = UIKit.Button({ Text = "✕", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -46, 0, 6), MaxTextSize = 24, Parent = bar })

	local content = UIKit.Frame({ Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, -70), Position = UDim2.fromOffset(12, 60), Parent = root })

	return { Root = root, Content = content, Title = titleLabel, Close = close }
end

function UIKit.Scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UIKit.Colors.Muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}
	if props then
		for k, v in pairs(props) do
			defaults[k] = v
		end
	end
	return UIKit.New("ScrollingFrame", defaults)
end

function UIKit.Grid(parent: Instance, cell: UDim2, pad: number): UIGridLayout
	return UIKit.New("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(pad, pad),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = parent,
	})
end

function UIKit.List(parent: Instance, pad: number, horizontal: boolean?, center: boolean?): UIListLayout
	return UIKit.New("UIListLayout", {
		Padding = UDim.new(0, pad),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = center and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Left,
		VerticalAlignment = center and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- شريط تقدم
function UIKit.ProgressBar(parent: Instance, color: Color3, size: UDim2, position: UDim2?): (Frame, Frame, TextLabel)
	local bg = UIKit.Frame({ Size = size, Position = position or UDim2.new(), BackgroundColor3 = Color3.fromRGB(15, 15, 25), Parent = parent })
	UIKit.Corner(bg, 8)
	UIKit.Stroke(bg, Color3.new(0, 0, 0), 2, 0.4)
	local fill = UIKit.Frame({ Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = color, Parent = bg })
	UIKit.Corner(fill, 8)
	UIKit.Gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	local label = UIKit.Label({ Text = "", TextStrokeTransparency = 0.2, Parent = bg })
	return bg, fill, label
end

function UIKit.Pop(inst: GuiObject)
	local target = inst.Size
	inst.Size = UDim2.new(target.X.Scale * 0.8, target.X.Offset * 0.8, target.Y.Scale * 0.8, target.Y.Offset * 0.8)
	UIKit.Tween(inst, { Size = target }, 0.25, Enum.EasingStyle.Back)
end

return UIKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000072"><Properties><string name="Name">ZoneController</string><ProtectedString name="Source"><![CDATA[--!strict
-- البوابات: تسمح بالمرور محلياً للمناطق المفتوحة، وتحديث لافتاتها
local Workspace = game:GetService("Workspace")
local DataController = require(script.Parent.DataController)

local ZoneController = {}

local gates: { BasePart } = {}

local function refresh()
	local p = DataController.Profile
	if not p then
		return
	end
	for _, gate in ipairs(gates) do
		local zone = gate:GetAttribute("Zone")
		local unlocked = p.UnlockedZones[tostring(zone)] == true
		gate.CanCollide = not unlocked
		gate.Transparency = unlocked and 0.85 or 0.3
		local bb = gate:FindFirstChildOfClass("BillboardGui")
		local label = bb and bb:FindFirstChildOfClass("TextLabel")
		if label and unlocked then
			label.Text = (label.Text:gsub("🔒", "🔓"))
		end
	end
end

function ZoneController.Init()
	local map = Workspace:WaitForChild("Map")
	for _, inst in ipairs(map:GetDescendants()) do
		if inst:IsA("BasePart") and inst.Name == "Gate" then
			table.insert(gates, inst)
		end
	end
	map.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") and inst.Name == "Gate" then
			table.insert(gates, inst)
			refresh()
		end
	end)
	DataController.Changed:Connect(refresh)
	refresh()
end

return ZoneController
]]></ProtectedString></Properties></Item></Item></Item>
</Item>
</roblox>
