]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000013"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!strict
local Format = {}

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Number(n: number): string
	if n ~= n or n == math.huge then
		return "∞"
	end
	local neg = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n + 0.5))
		return neg and "-" .. s or s
	end
	local idx = 1
	while n >= 1000 and idx < #SUFFIX do
		n /= 1000
		idx += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", n)
	else
		s = string.format("%.2f", n)
	end
	s = s:gsub("%.?0+$", "")
	return (neg and "-" or "") .. s .. SUFFIX[idx]
end

function Format.Comma(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

function Format.Percent(p: number): string
	if p >= 10 then
		return string.format("%.1f%%", p)
	elseif p >= 1 then
		return string.format("%.2f%%", p)
	else
		return string.format("%.3f%%", p)
	end
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Luck</string><ProtectedString name="Source"><![CDATA[--!strict
-- حساب فرص البيض مع الحظ. مستخدم على السيرفر (للسحب) والعميل (للعرض).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Eggs = require(Shared.Data.Eggs)

local Luck = {}

export type Entry = { Pet: string, Chance: number }

-- يرجع قائمة {Pet, Chance} بعد تطبيق الحظ، المجموع = 100
function Luck.ApplyLuck(eggId: string, luckMult: number): { Entry }
	local egg = Eggs.Get(eggId)
	if not egg then
		return {}
	end
	luckMult = math.max(1, luckMult)
	local weighted = {}
	local total = 0
	for _, entry in ipairs(egg.Pets) do
		local def = Pets.Get(entry.Pet)
		local w = entry.Chance
		if def and Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].LuckAffected then
			w = w * luckMult
		end
		table.insert(weighted, { Pet = entry.Pet, Chance = w })
		total += w
	end
	for _, e in ipairs(weighted) do
		e.Chance = e.Chance / total * 100
	end
	table.sort(weighted, function(a, b)
		return a.Chance > b.Chance
	end)
	return weighted
end

function Luck.Roll(eggId: string, luckMult: number, rng: Random?): string?
	local entries = Luck.ApplyLuck(eggId, luckMult)
	if #entries == 0 then
		return nil
	end
	local r = (rng and rng:NextNumber() or math.random()) * 100
	local acc = 0
	for _, e in ipairs(entries) do
		acc += e.Chance
		if r <= acc then
			return e.Pet
		end
	end
	return entries[#entries].Pet
end

return Luck
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Mastery</string><ProtectedString name="Source"><![CDATA[--!strict
-- الإتقان: مستويات تعتمد على الإحصائيات (مشترك بين السيرفر والعميل)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Mastery = {}

function Mastery.Threshold(cfg: any, level: number): number
	return math.floor(cfg.Base * (cfg.Mult ^ (level - 1)))
end

-- يرجع المستوى الحالي، القيمة الحالية، المطلوب للمستوى التالي (0 = الأقصى)
function Mastery.Progress(cfg: any, statValue: number): (number, number, number)
	local level = 0
	while level < cfg.MaxLevel and statValue >= Mastery.Threshold(cfg, level + 1) do
		level += 1
	end
	local needed = level < cfg.MaxLevel and Mastery.Threshold(cfg, level + 1) or 0
	return level, statValue, needed
end

function Mastery.Bonuses(stats: { [string]: number }): { [string]: number }
	local out = { Coins = 0, Luck = 0, Damage = 0, Diamonds = 0 }
	for _, cfg in ipairs(Config.Mastery) do
		local level = Mastery.Progress(cfg, stats[cfg.Stat] or 0)
		for k, v in pairs(cfg.PerLevel) do
			out[k] = (out[k] or 0) + v * level
		end
	end
	return out
end

return Mastery
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">MerchantStock</string><ProtectedString name="Source"><![CDATA[--!strict
-- مخزون التاجر المتجول: يُحسب من الوقت بنفس الطريقة على السيرفر والعميل
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local MerchantStock = {}

function MerchantStock.RotationId(now: number): number
	return math.floor(now / Config.Merchant.RotationSeconds)
end

function MerchantStock.SecondsLeft(now: number): number
	return Config.Merchant.RotationSeconds - (now % Config.Merchant.RotationSeconds)
end

-- يرجع قائمة العناصر (نسخ من Pool) للدورة المعطاة
function MerchantStock.Stock(rotationId: number): { any }
	local rng = Random.new(rotationId * 7919 + 13)
	local pool = table.clone(Config.Merchant.Pool)
	local out = {}
	for _ = 1, math.min(Config.Merchant.Slots, #pool) do
		local idx = rng:NextInteger(1, #pool)
		local item = table.clone(pool[idx])
		item.PoolIndex = idx
		table.insert(out, item)
		table.remove(pool, idx)
		-- إعادة حساب المؤشرات الأصلية بعد الحذف
		for _, it in ipairs(out) do
			if it.PoolIndex == nil then
				it.PoolIndex = 0
			end
		end
	end
	-- نثبّت PoolIndex بالبحث بالاسم لضمان المطابقة بين السيرفر والعميل
	for _, it in ipairs(out) do
		for i, p in ipairs(Config.Merchant.Pool) do
			if p.Type == it.Type and p.Key == it.Key then
				it.PoolIndex = i
			end
		end
	end
	return out
end

return MerchantStock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">PetModelBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- يبني نموذج حيوان ثلاثي الأبعاد من أجزاء بسيطة (بدون أي أصول خارجية).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)

local Builder = {}

local GOLD = Color3.fromRGB(255, 200, 40)
local GOLD2 = Color3.fromRGB(255, 240, 150)
local DARK = Color3.fromRGB(25, 10, 40)
local DARK2 = Color3.fromRGB(170, 60, 255)

local function part(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, shape: string?, material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "wedge" then
		local w = Instance.new("WedgePart")
		w.Name = name
		w.Size = size
		w.CFrame = cf
		w.Color = color
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.Material = material or Enum.Material.SmoothPlastic
		w.Parent = model
		p:Destroy()
		return w
	elseif shape == "cone" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://1033714"
		mesh.Scale = Vector3.new(size.X / 2, size.Y / 2, size.Z / 2)
		mesh.Parent = p
	end
	p.Parent = model
	return p
end

local function eyes(model: Model, body: BasePart, offset: CFrame, spread: number, size: number, color: Color3?)
	for _, side in ipairs({ -1, 1 }) do
		local eye = part(model, "Eye", Vector3.new(size, size, size), body.CFrame * offset * CFrame.new(side * spread, 0, 0), Color3.new(0, 0, 0), "ball")
		eye.Material = Enum.Material.Glass
		local shine = part(model, "Shine", Vector3.new(size * 0.35, size * 0.35, size * 0.35), eye.CFrame * CFrame.new(-side * size * 0.15, size * 0.2, -size * 0.35), Color3.new(1, 1, 1), "ball")
		shine.Material = Enum.Material.Neon
		if color then
			eye.Color = color
		end
	end
end

local function mouth(model: Model, body: BasePart, offset: CFrame, color: Color3)
	part(model, "Mouth", Vector3.new(0.5, 0.15, 0.15), body.CFrame * offset, color, "ball")
end

local function ears(model: Model, body: BasePart, kind: string, color: Color3, color2: Color3)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	if kind == "cat" or kind == "fox" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.6, 0.7, 0.3), cf * CFrame.new(s * 0.65, h + 0.25, 0) * CFrame.Angles(0, 0, -s * 0.2), color, "wedge")
			part(model, "EarIn", Vector3.new(0.3, 0.4, 0.2), cf * CFrame.new(s * 0.65, h + 0.2, -0.08) * CFrame.Angles(0, 0, -s * 0.2), color2, "wedge")
		end
	elseif kind == "dog" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.35, 1.1, 0.6), cf * CFrame.new(s * 1.05, h - 0.2, 0) * CFrame.Angles(0, 0, s * 0.35), color2)
		end
	elseif kind == "bunny" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.4, 1.5, 0.3), cf * CFrame.new(s * 0.45, h + 0.7, 0) * CFrame.Angles(0, 0, -s * 0.15), color)
			part(model, "EarIn", Vector3.new(0.2, 1.1, 0.1), cf * CFrame.new(s * 0.45, h + 0.7, -0.15) * CFrame.Angles(0, 0, -s * 0.15), color2)
		end
	elseif kind == "bear" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(s * 0.8, h, 0), color, "ball")
			part(model, "EarIn", Vector3.new(0.35, 0.35, 0.35), cf * CFrame.new(s * 0.8, h, -0.2), color2, "ball")
		end
	end
end

local function wings(model: Model, body: BasePart, color: Color3, size: number)
	local cf = body.CFrame
	for _, s in ipairs({ -1, 1 }) do
		local w = part(model, "Wing", Vector3.new(size, size * 0.9, 0.15), cf * CFrame.new(s * (body.Size.X / 2 + size * 0.45), 0.2, 0.3) * CFrame.Angles(0, 0, s * 0.35), color, "wedge")
		w.CFrame = w.CFrame * CFrame.Angles(0, s * math.pi / 2, 0)
	end
end

local function horns(model: Model, body: BasePart, color: Color3, count: number)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	if count == 1 then
		part(model, "Horn", Vector3.new(0.35, 1.2, 0.35), cf * CFrame.new(0, h + 0.4, -0.3) * CFrame.Angles(0.3, 0, 0), color, "cone")
	else
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Horn", Vector3.new(0.35, 0.9, 0.35), cf * CFrame.new(s * 0.55, h + 0.25, 0) * CFrame.Angles(0, 0, -s * 0.5), color, "cone")
		end
	end
end

local function tail(model: Model, body: BasePart, color: Color3, kind: string)
	local cf = body.CFrame
	if kind == "fluffy" then
		part(model, "Tail", Vector3.new(0.7, 0.7, 1.2), cf * CFrame.new(0, -0.2, body.Size.Z / 2 + 0.4) * CFrame.Angles(0.5, 0, 0), color, "ball")
	elseif kind == "long" then
		part(model, "Tail", Vector3.new(0.3, 0.3, 1.4), cf * CFrame.new(0, -0.3, body.Size.Z / 2 + 0.6) * CFrame.Angles(0.6, 0, 0), color, "ball")
	elseif kind == "fin" then
		part(model, "Tail", Vector3.new(0.15, 1.1, 0.9), cf * CFrame.new(0, 0, body.Size.Z / 2 + 0.4), color, "wedge")
	end
end

local function feet(model: Model, body: BasePart, color: Color3)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	for _, s in ipairs({ -1, 1 }) do
		part(model, "Foot", Vector3.new(0.6, 0.35, 0.7), cf * CFrame.new(s * 0.5, -h + 0.1, -0.2), color, "ball")
	end
end

local SHAPES: { [string]: (Model, Color3, Color3) -> BasePart } = {}

SHAPES.blob = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.2, 1.8, 2.2), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.2, -0.85), 0.42, 0.34)
	mouth(m, body, CFrame.new(0, -0.25, -1.05), c2)
	return body
end

SHAPES.cat = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 1.9, 2), CFrame.new(), c1)
	eyes(m, body, CFrame.new(0, 0.25, -0.95), 0.45, 0.36)
	part(m, "Nose", Vector3.new(0.25, 0.18, 0.2), body.CFrame * CFrame.new(0, -0.15, -1.05), c2, "ball")
	ears(m, body, "cat", c1, c2)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.dog = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.1, 1.9, 2.1), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(1, 0.7, 0.7), body.CFrame * CFrame.new(0, -0.3, -1.1), c2)
	part(m, "Nose", Vector3.new(0.35, 0.3, 0.3), body.CFrame * CFrame.new(0, -0.15, -1.5), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.45, 0.36)
	ears(m, body, "dog", c1, c2)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.bunny = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 1.9, 1.9), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.2, -0.8), 0.4, 0.34)
	part(m, "Nose", Vector3.new(0.22, 0.18, 0.2), body.CFrame * CFrame.new(0, -0.15, -0.95), c2, "ball")
	ears(m, body, "bunny", c1, c2)
	tail(m, body, Color3.new(1, 1, 1), "fluffy")
	feet(m, body, c1)
	return body
end

SHAPES.bear = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.3, 2.1, 2.1), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(0.9, 0.6, 0.5), body.CFrame * CFrame.new(0, -0.3, -1.1), c2, "ball")
	part(m, "Nose", Vector3.new(0.3, 0.25, 0.25), body.CFrame * CFrame.new(0, -0.15, -1.35), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.35, -1.0), 0.5, 0.36)
	ears(m, body, "bear", c1, c2)
	feet(m, body, c2)
	return body
end

SHAPES.fox = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 1.8, 2.2), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(0.8, 0.5, 0.8), body.CFrame * CFrame.new(0, -0.35, -1.2) * CFrame.Angles(math.pi / 2, 0, 0), c2, "cone")
	part(m, "Nose", Vector3.new(0.25, 0.22, 0.22), body.CFrame * CFrame.new(0, -0.3, -1.6), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.95), 0.45, 0.34)
	ears(m, body, "fox", c1, c2)
	tail(m, body, c2, "fluffy")
	feet(m, body, Color3.new(0.1, 0.1, 0.1))
	return body
end

SHAPES.dragon = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.2, 2, 2.4), CFrame.new(), c1, "ball")
	part(m, "Belly", Vector3.new(1.3, 1.3, 0.6), body.CFrame * CFrame.new(0, -0.3, -0.9), c2, "ball")
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.5, 0.36, Color3.fromRGB(255, 230, 0))
	horns(m, body, c2, 2)
	wings(m, body, c2, 1.6)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.bird = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 2, 1.9), CFrame.new(), c1, "ball")
	part(m, "Beak", Vector3.new(0.5, 0.5, 0.8), body.CFrame * CFrame.new(0, -0.05, -1.2) * CFrame.Angles(-math.pi / 2, 0, 0), c2, "cone")
	eyes(m, body, CFrame.new(0, 0.35, -0.8), 0.42, 0.34)
	wings(m, body, c2, 1.2)
	part(m, "Crest", Vector3.new(0.3, 0.7, 0.3), body.CFrame * CFrame.new(0, 1.2, 0.1) * CFrame.Angles(0.3, 0, 0), c2, "cone")
	feet(m, body, Color3.fromRGB(255, 150, 0))
	return body
end

SHAPES.robot = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2, 1.8), CFrame.new(), c1, nil, Enum.Material.Metal)
	local screen = part(m, "Screen", Vector3.new(1.5, 1, 0.1), body.CFrame * CFrame.new(0, 0.2, -0.92), Color3.new(0, 0, 0), nil, Enum.Material.Glass)
	eyes(m, screen, CFrame.new(0, 0, -0.1), 0.4, 0.3, c2)
	local ant = part(m, "Antenna", Vector3.new(0.15, 0.9, 0.15), body.CFrame * CFrame.new(0, 1.4, 0), Color3.fromRGB(120, 120, 120), nil, Enum.Material.Metal)
	local bulb = part(m, "Bulb", Vector3.new(0.4, 0.4, 0.4), ant.CFrame * CFrame.new(0, 0.55, 0), c2, "ball", Enum.Material.Neon)
	bulb.Name = "Glow"
	for _, s in ipairs({ -1, 1 }) do
		part(m, "Arm", Vector3.new(0.35, 1.2, 0.35), body.CFrame * CFrame.new(s * 1.2, -0.1, 0), Color3.fromRGB(120, 120, 120), nil, Enum.Material.Metal)
	end
	feet(m, body, Color3.fromRGB(90, 90, 90))
	return body
end

SHAPES.ghost = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2, 2), CFrame.new(), c1, "ball")
	body.Transparency = 0.15
	local bottom = part(m, "Bottom", Vector3.new(2, 1.2, 2), body.CFrame * CFrame.new(0, -0.9, 0), c1, "cyl")
	bottom.CFrame = bottom.CFrame * CFrame.Angles(0, 0, math.pi / 2)
	bottom.Transparency = 0.35
	for i = 1, 3 do
		local x = (i - 2) * 0.6
		part(m, "Wisp", Vector3.new(0.5, 0.5, 0.5), body.CFrame * CFrame.new(x, -1.6, 0), c1, "ball").Transparency = 0.35
	end
	eyes(m, body, CFrame.new(0, 0.2, -0.85), 0.45, 0.4, c2)
	mouth(m, body, CFrame.new(0, -0.35, -0.95), Color3.new(0, 0, 0))
	return body
end

SHAPES.fish = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.6, 1.6, 2.6), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.25, -1.0), 0.45, 0.34)
	tail(m, body, c2, "fin")
	part(m, "Fin", Vector3.new(0.12, 0.8, 1), body.CFrame * CFrame.new(0, 0.9, 0.2), c2, "wedge")
	for _, s in ipairs({ -1, 1 }) do
		part(m, "SideFin", Vector3.new(0.6, 0.12, 0.7), body.CFrame * CFrame.new(s * 0.9, -0.2, 0) * CFrame.Angles(0, 0, s * 0.6), c2, "wedge")
	end
	mouth(m, body, CFrame.new(0, -0.3, -1.25), c2)
	return body
end

SHAPES.golem = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.4, 2.2, 2), CFrame.new(), c1, nil, Enum.Material.Slate)
	local screen = part(m, "Face", Vector3.new(1.6, 0.9, 0.2), body.CFrame * CFrame.new(0, 0.3, -0.95), c2, nil, Enum.Material.Neon)
	screen.Transparency = 0.5
	eyes(m, body, CFrame.new(0, 0.35, -1.0), 0.5, 0.35, c2)
	for _, s in ipairs({ -1, 1 }) do
		part(m, "Arm", Vector3.new(0.8, 1.4, 0.8), body.CFrame * CFrame.new(s * 1.5, -0.2, 0), c1, nil, Enum.Material.Slate)
		part(m, "Shoulder", Vector3.new(0.6, 0.6, 0.6), body.CFrame * CFrame.new(s * 1.5, 0.7, 0), c2, "ball", Enum.Material.Neon)
	end
	feet(m, body, c1)
	return body
end

SHAPES.unicorn = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 2, 2.4), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(1, 0.8, 0.9), body.CFrame * CFrame.new(0, -0.35, -1.3), c1)
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.45, 0.34)
	horns(m, body, c2, 1)
	ears(m, body, "cat", c1, c2)
	local mane = part(m, "Mane", Vector3.new(0.5, 0.9, 1.6), body.CFrame * CFrame.new(0, 0.9, 0.4), c2, "ball")
	mane.Material = Enum.Material.Neon
	tail(m, body, c2, "fluffy")
	feet(m, body, c2)
	return body
end

SHAPES.alien = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2.2, 2), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.75), 0.5, 0.6, c2)
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2
		local t = part(m, "Tentacle", Vector3.new(0.4, 1.2, 0.4), body.CFrame * CFrame.new(math.cos(ang) * 0.8, -1.2, math.sin(ang) * 0.8) * CFrame.Angles(math.sin(ang) * 0.3, 0, -math.cos(ang) * 0.3), c1, "ball")
		t.Name = "Tentacle"
	end
	mouth(m, body, CFrame.new(0, -0.4, -0.95), c2)
	return body
end

SHAPES.demon = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.1, 2.1, 2.1), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.85), 0.45, 0.36, c2)
	horns(m, body, c2, 2)
	wings(m, body, Color3.fromRGB(40, 0, 60), 1.5)
	tail(m, body, c1, "long")
	local mouthPart = part(m, "Mouth", Vector3.new(0.9, 0.25, 0.2), body.CFrame * CFrame.new(0, -0.35, -1.0), Color3.new(0, 0, 0))
	mouthPart.Material = Enum.Material.Neon
	mouthPart.Color = c2
	feet(m, body, c2)
	return body
end

-- يبني النموذج. variant: Normal/Golden/Rainbow/DarkMatter
function Builder.Build(petId: string, variant: string?): Model?
	local def = Pets.Get(petId)
	if not def then
		return nil
	end
	variant = variant or "Normal"
	local c1, c2 = def.Primary, def.Secondary
	if variant == "Golden" then
		c1, c2 = GOLD, GOLD2
	elseif variant == "DarkMatter" then
		c1, c2 = DARK, DARK2
	end

	local model = Instance.new("Model")
	model.Name = petId
	local builder = SHAPES[def.Shape] or SHAPES.blob
	local body = builder(model, c1, c2)
	model.PrimaryPart = body
	model:SetAttribute("PetId", petId)
	model:SetAttribute("Variant", variant)
	model:SetAttribute("Scale", def.Scale or 1)
	if (def.Scale or 1) ~= 1 then
		model:ScaleTo(def.Scale)
	end

	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			if variant == "Golden" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p.Material = Enum.Material.Metal
				p.Reflectance = 0.25
			elseif variant == "DarkMatter" then
				if p.Name == "Body" or p.Name == "Ear" or p.Name == "Arm" or p.Name == "Wing" then
					p.Material = Enum.Material.Slate
				elseif p.Name ~= "Eye" and p.Name ~= "Shine" then
					p.Material = Enum.Material.Neon
				end
			elseif variant == "Rainbow" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p:SetAttribute("Rainbow", true)
			end
		end
	end

	if variant == "DarkMatter" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(DARK2, Color3.fromRGB(60, 0, 120))
		pe.Size = NumberSequence.new(0.35, 0)
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Lifetime = NumberRange.new(0.6, 1.2)
		pe.Rate = 12
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Rainbow" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 255)),
		})
		pe.Size = NumberSequence.new(0.3, 0)
		pe.Lifetime = NumberRange.new(0.5, 1)
		pe.Rate = 8
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Golden" then
		local light = Instance.new("PointLight")
		light.Color = GOLD
		light.Range = 6
		light.Brightness = 0.6
		light.Parent = body
	end

	return model
end

-- يحرك النموذج كله بحيث يكون الجسم عند CFrame المعطى
function Builder.SetCFrame(model: Model, cf: CFrame)
	model:PivotTo(cf)
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">PetUtil</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)

local PetUtil = {}

export type Enchant = { Type: string, Tier: number }
export type PetInstance = {
	Uid: string,
	Id: string,
	Variant: string,
	Locked: boolean,
	Equipped: boolean,
	Time: number,
	Level: number,
	XP: number,
	Enchants: { Enchant },
}

function PetUtil.Level(inst: PetInstance): number
	return math.clamp(inst.Level or 1, 1, Config.PetMaxLevel)
end

function PetUtil.BasePower(inst: PetInstance): number
	local def = Pets.Get(inst.Id)
	if not def then
		return 0
	end
	local mult = Config.VariantMultipliers[inst.Variant] or 1
	local levelMult = 1 + (PetUtil.Level(inst) - 1) * Config.PetLevelPowerPerLevel
	return math.floor(def.Power * mult * levelMult + 0.5)
end

function PetUtil.DisplayName(inst: PetInstance): string
	local def = Pets.Get(inst.Id)
	local prefix = Config.VariantNames[inst.Variant] or ""
	return prefix .. (def and def.Name or inst.Id)
end

function PetUtil.RarityColor(inst: PetInstance): Color3
	local def = Pets.Get(inst.Id)
	return def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
end

function PetUtil.SortByPower(list: { PetInstance })
	table.sort(list, function(a, b)
		local pa, pb = PetUtil.BasePower(a), PetUtil.BasePower(b)
		if pa ~= pb then
			return pa > pb
		end
		return a.Uid < b.Uid
	end)
end

function PetUtil.NextVariant(v: string): string?
	if v == "Normal" then
		return "Golden"
	elseif v == "Golden" then
		return "Rainbow"
	elseif v == "Rainbow" then
		return "DarkMatter"
	end
	return nil
end

function PetUtil.XPToNext(level: number): number
	return Config.XPForLevel(level)
end

function PetUtil.EnchantSlots(inst: PetInstance): number
	return Config.EnchantSlots[inst.Variant] or 1
end

function PetUtil.EnchantLabel(e: Enchant): string
	local cfg = Config.Enchants[e.Type]
	if not cfg then
		return e.Type
	end
	local value = cfg.PerTier * e.Tier
	local text
	if e.Type == "Agility" then
		text = "+" .. value .. " سرعة"
	else
		text = "+" .. math.floor(value * 100 + 0.5) .. "%"
	end
	return cfg.Icon .. " " .. cfg.Arabic .. " " .. string.rep("★", e.Tier) .. " " .. text
end

-- مجموع الإنشانتات للحيوانات المجهزة
function PetUtil.EnchantBonuses(pets: { PetInstance }): { [string]: number }
	local out = { Coins = 0, Damage = 0, Luck = 0, Diamonds = 0, Crit = 0, Agility = 0, XP = 0 }
	for _, pet in ipairs(pets) do
		if pet.Equipped and pet.Enchants then
			for _, e in ipairs(pet.Enchants) do
				local cfg = Config.Enchants[e.Type]
				if cfg then
					out[e.Type] = (out[e.Type] or 0) + cfg.PerTier * e.Tier
				end
			end
		end
	end
	out.Crit = math.min(out.Crit, 0.75)
	out.Agility = math.min(out.Agility, 30)
	return out
end

return PetUtil
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- أسماء الـ Remotes. السيرفر ينشئها، والعميل ينتظرها.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	"ProfileUpdate",   -- S->C: الملف الكامل
	"Notify",          -- S->C: {Text, Color}
	"RewardPopup",     -- S->C: {Position, Coins, Diamonds}
	"HatchBroadcast",  -- S->C all: {Player, PetId, Variant, Rarity}
	"Teleport",        -- C->S: zoneIndex
	"PromptPurchase",  -- C->S: kind, key
	"SetTarget",       -- C->S: breakableId?
	"RequestProfile",  -- C->S: العميل جاهز، أرسل الملف
	"TradeRequest",    -- C->S: targetUserId
	"TradeIncoming",   -- S->C: {FromUserId, FromName}
	"TradeRespond",    -- C->S: fromUserId, accept
	"TradeAction",     -- C->S: action, payload (Add/Remove/Confirm/Cancel)
	"TradeUpdate",     -- S->C: state أو nil
	"EventEffect",     -- S->C all: {Type, ...} تأثيرات بصرية
	"BossUpdate",      -- S->C all: {Active, Health, MaxHealth, Ends}
}

Remotes.Functions = {
	"HatchEgg",       -- (eggId, count, variant) -> {ok, error?, pets?}
	"PetAction",      -- (action, payload) -> {ok, error?}
	"Machine",        -- (kind, payload) -> {ok, error?, result?}
	"UnlockZone",     -- (index) -> {ok, error?}
	"BuyUpgrade",     -- (key) -> {ok, error?}
	"ClaimDaily",     -- () -> {ok, error?, reward?}
	"ClaimPlaytime",  -- (index) -> {ok, error?}
	"RedeemCode",     -- (code) -> {ok, error?}
	"GetServerTime",  -- () -> number
	"Rebirth",        -- () -> {ok, error?}
	"Spin",           -- (paid: boolean) -> {ok, error?, index?, reward?}
	"Merchant",       -- (slotIndex) -> {ok, error?}
	"Hoverboard",     -- (action, id) -> {ok, error?}
	"UsePotion",      -- (key) -> {ok, error?}
	"BuyPotion",      -- (key) -> {ok, error?}
	"ClaimMission",   -- (index) -> {ok, error?}
	"ClaimAchievement", -- (id) -> {ok, error?}
	"ClaimTutorial",  -- () -> {ok, error?}
	"ClaimVIPDaily",  -- () -> {ok, error?}
	"Admin",          -- (command, payload) -> {ok, error?}
}

local folder: Folder

function Remotes.Init(): Folder
	if RunService:IsServer() then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in ipairs(Remotes.Events) do
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
		for _, name in ipairs(Remotes.Functions) do
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
		folder.Parent = ReplicatedStorage
		local state = Instance.new("Folder")
		state.Name = "GameState"
		state:SetAttribute("EventId", "")
		state:SetAttribute("EventEnds", 0)
		state:SetAttribute("NextEvent", 0)
		state.Parent = ReplicatedStorage
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.Event(name: string): RemoteEvent
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

function Remotes.State(): Folder
	return ReplicatedStorage:WaitForChild("GameState") :: Folder
end

return Remotes
]]></ProtectedString></Properties></Item></Item>
<Item class="Folder" referent="RBX000038"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000016"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- نقطة تشغيل السيرفر
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Services = script.Parent:WaitForChild("Services")

Remotes.Init()

local MapBuilder = require(Services.MapBuilder)
local DataService = require(Services.DataService)
local PetService = require(Services.PetService)
local EggService = require(Services.EggService)
local BreakableService = require(Services.BreakableService)
local ZoneService = require(Services.ZoneService)
local ShopService = require(Services.ShopService)
local RewardService = require(Services.RewardService)
local LeaderboardService = require(Services.LeaderboardService)
local EventService = require(Services.EventService)
local MissionService = require(Services.MissionService)
local RebirthService = require(Services.RebirthService)
local TradeService = require(Services.TradeService)
local SpinService = require(Services.SpinService)
local MerchantService = require(Services.MerchantService)
local HoverboardService = require(Services.HoverboardService)
local AdminService = require(Services.AdminService)

MapBuilder.Build()

for _, layout in pairs(MapBuilder.Zones) do
	for eggId, pos in pairs(layout.Eggs) do
		EggService.RegisterEggPosition(eggId, pos)
	end
end

-- الترتيب مهم: الخدمات التي تسجل مزودي المكافآت قبل تحميل اللاعبين
PetService.Init()
EventService.Init()
MissionService.Init()
RebirthService.Init()
SpinService.Init()
EggService.Init()
BreakableService.Init()
ZoneService.Init()
ShopService.Init()
RewardService.Init()
TradeService.Init()
MerchantService.Init()
HoverboardService.Init()
AdminService.Init()
LeaderboardService.Init()
DataService.Init()

print("[PetKingdom] Server ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000037"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[--!strict
-- أوامر الأدمن (للاختبار والإدارة)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local EventService = require(script.Parent.EventService)
local ZoneService = require(script.Parent.ZoneService)

local AdminService = {}

function AdminService.Run(player: Player, command: string, payload: any): { ok: boolean, error: string? }
	if not DataService.IsAdmin(player) then
		return { ok = false, error = "غير مصرح" }
	end
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	payload = type(payload) == "table" and payload or {}
	local n = tonumber(payload.Amount) or 0
	if command == "Coins" then
		p.Coins += n
	elseif command == "Diamonds" then
		p.Diamonds += n
	elseif command == "Tokens" then
		p.Tokens += n
	elseif command == "Spins" then
		p.Spins += n
	elseif command == "Rebirths" then
		p.Rebirths = math.max(0, math.floor(n))
	elseif command == "Pet" then
		local id = tostring(payload.Id)
		if not Pets.Get(id) then
			return { ok = false, error = "حيوان غير موجود: " .. id }
		end
		PetService.Add(player, id, tostring(payload.Variant or "Normal"), true)
	elseif command == "UnlockAll" then
		for i = 1, 15 do
			p.UnlockedZones[tostring(i)] = true
		end
	elseif command == "Event" then
		if not EventService.Start(tostring(payload.Id)) then
			return { ok = false, error = "حدث غير موجود" }
		end
	elseif command == "Potion" then
		DataService.GivePotion(player, tostring(payload.Id), math.max(1, math.floor(n)))
	elseif command == "Reset" then
		DataService.ResetProfile(player)
		ZoneService.Teleport(player, 1)
		return { ok = true }
	else
		return { ok = false, error = "أمر غير معروف" }
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return { ok = true }
end

function AdminService.Init()
	Remotes.Function("Admin").OnServerInvoke = function(player, command, payload)
		return AdminService.Run(player, tostring(command), payload)
	end
end

return AdminService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000018"><Properties><string name="Name">BreakableService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الصناديق والعملات: الظهور، الاستهداف، الضرر، الضربات القاضية، الخبرة، المكافآت، الزعيم
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local MapBuilder = require(script.Parent.MapBuilder)
local Hooks = require(script.Parent.Hooks)

local BreakableService = {}

type Breakable = {
	Id: string,
	Type: string,
	Def: Breakables.BreakableDef,
	Zone: number,
	Mult: number,
	Health: number,
	MaxHealth: number,
	Alive: boolean,
	Damage: { [Player]: number },
	Position: Vector3,
	Model: Model,
	Special: boolean,
	Boss: boolean,
}

local breakables: { [string]: Breakable } = {}
local targets: { [Player]: string } = {}
local lastTap: { [Player]: number } = {}
local folder: Folder
local counter = 0
local rng = Random.new()
local boss: Breakable? = nil
BreakableService.OnBossKilled = nil :: ((contributors: { [Player]: number }) -> ())?

local function canUseZone(player: Player, zone: number): boolean
	local p = DataService.Get(player)
	if not p then
		return false
	end
	if zone == 0 then
		return DataService.HasGamepass(player, "VIP")
	end
	local z = Zones.Get(zone)
	if z and z.World == 2 and p.Rebirths < 1 then
		return false
	end
	return p.UnlockedZones[tostring(zone)] == true
end

local function setTarget(player: Player, id: string?)
	if id then
		targets[player] = id
		player:SetAttribute("Target", id)
	else
		targets[player] = nil
		player:SetAttribute("Target", "")
	end
end

local function playerPosition(player: Player): Vector3?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp and hrp.Position or nil
end

local function tryTarget(player: Player, b: Breakable, maxDist: number): boolean
	if not b.Alive or not canUseZone(player, b.Zone) then
		return false
	end
	local pos = playerPosition(player)
	if not pos or (pos - b.Position).Magnitude > maxDist then
		return false
	end
	setTarget(player, b.Id)
	return true
end

local function respawn(b: Breakable)
	if b.Boss then
		return
	end
	b.Health = b.MaxHealth
	b.Alive = true
	b.Damage = {}
	b.Model:SetAttribute("Health", b.Health)
	b.Model.Parent = folder
end

local function highestZoneMult(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 1
	end
	local best = 1
	for idxStr in pairs(p.UnlockedZones) do
		local z = Zones.Get(tonumber(idxStr) or 1)
		if z and z.Multiplier > best then
			best = z.Multiplier
		end
	end
	return best
end

local function breakIt(b: Breakable)
	if not b.Alive then
		return
	end
	b.Alive = false
	local total = 0
	for _, d in pairs(b.Damage) do
		total += d
	end
	if total <= 0 then
		total = 1
	end
	for player, d in pairs(b.Damage) do
		local p = DataService.Get(player)
		if player.Parent == Players and p then
			local share = d / total
			local mult = b.Boss and highestZoneMult(player) or b.Mult
			local coins, diamonds = 0, 0
			if b.Def.Coins > 0 then
				coins = math.max(1, math.floor(b.Def.Coins * mult * share * DataService.CoinMultiplier(player) + 0.5))
				DataService.AddCoins(player, coins)
				Hooks.Fire(player, "Coins", coins)
			end
			if b.Def.Diamonds > 0 then
				local raw = b.Def.Diamonds * share * DataService.DiamondMultiplier(player)
				diamonds = math.floor(raw)
				if rng:NextNumber() < (raw - diamonds) then
					diamonds += 1
				end
				if diamonds > 0 then
					DataService.AddDiamonds(player, diamonds, true)
					Hooks.Fire(player, "Diamonds", diamonds)
				end
			end
			p.Stats.Breaks += 1
			Hooks.Fire(player, "Break", 1)
			PetService.GrantXP(player, Config.XPPerBreakBase * (b.Zone == 0 and 3 or b.Zone) * (b.Boss and 25 or 1))
			Remotes.Event("RewardPopup"):FireClient(player, { Position = b.Position + Vector3.new(0, b.Def.Size.Y, 0), Coins = coins, Diamonds = diamonds })
		end
	end
	for player, id in pairs(targets) do
		if id == b.Id then
			setTarget(player, nil)
		end
	end
	if b.Type == "GiantChest" then
		DataService.NotifyAll("💥 تم كسر الصندوق العملاق! سيعود بعد " .. Format.Time(b.Def.Respawn), Color3.fromRGB(255, 120, 255))
	elseif b.Type == "MysteryBox" then
		DataService.NotifyAll("🎁 انفتح صندوق الغموض!", Color3.fromRGB(120, 120, 255))
	end
	local contributors = b.Damage
	b.Model.Parent = nil
	if b.Boss then
		boss = nil
		breakables[b.Id] = nil
		if BreakableService.OnBossKilled then
			BreakableService.OnBossKilled(contributors)
		end
	else
		task.delay(b.Def.Respawn, respawn, b)
	end
end

local function applyDamage(b: Breakable, player: Player, amount: number, crit: boolean?)
	if not b.Alive or amount <= 0 then
		return
	end
	amount = math.min(amount, b.Health)
	b.Health -= amount
	b.Damage[player] = (b.Damage[player] or 0) + amount
	local p = DataService.Get(player)
	if p then
		p.Stats.Damage += amount
	end
	b.Model:SetAttribute("Health", math.max(0, b.Health))
	b.Model:SetAttribute("LastHit", os.clock())
	b.Model:SetAttribute("LastHitBy", player.UserId)
	b.Model:SetAttribute("LastDamage", amount)
	b.Model:SetAttribute("LastCrit", crit == true)
	if b.Boss then
		Remotes.Event("BossUpdate"):FireAllClients({ Active = true, Health = math.max(0, b.Health), MaxHealth = b.MaxHealth })
	end
	if b.Health <= 0 then
		breakIt(b)
	end
end

local function tap(player: Player, b: Breakable)
	local now = os.clock()
	if now - (lastTap[player] or 0) < Config.TapCooldown then
		return
	end
	lastTap[player] = now
	local dmg = Config.TapDamageBase * DataService.DamageMultiplier(player)
	if PetService.GetPower(player) <= 0 then
		dmg *= 5
	end
	applyDamage(b, player, dmg)
end

local function spawnBreakable(typeName: string, zone: number, mult: number, pos: Vector3, special: boolean, isBoss: boolean?, healthOverride: number?): Breakable?
	local def = Breakables.Get(typeName)
	if not def then
		return nil
	end
	counter += 1
	local id = typeName .. "_" .. counter
	local model = MapBuilder.BuildBreakable(typeName, pos)
	model.Name = id
	model:SetAttribute("Id", id)
	model:SetAttribute("Type", typeName)
	model:SetAttribute("Zone", zone)
	local maxHealth = healthOverride or math.floor(def.Health * mult)
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("Coins", math.floor(def.Coins * mult))
	model:SetAttribute("Diamonds", def.Diamonds)
	model:SetAttribute("Boss", isBoss == true)
	local b: Breakable = {
		Id = id,
		Type = typeName,
		Def = def,
		Zone = zone,
		Mult = mult,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Alive = true,
		Damage = {},
		Position = pos,
		Model = model,
		Special = special,
		Boss = isBoss == true,
	}
	breakables[id] = b
	local cd = model:FindFirstChildOfClass("ClickDetector") :: ClickDetector
	cd.MouseClick:Connect(function(player)
		if tryTarget(player, b, 70) then
			tap(player, b)
		elseif not canUseZone(player, b.Zone) then
			DataService.Notify(player, "🔒 افتح هذه المنطقة أولاً", Color3.fromRGB(255, 100, 100))
		end
	end)
	model.Parent = folder
	return b
end

local function nearestAlive(player: Player, maxDist: number): Breakable?
	local pos = playerPosition(player)
	if not pos then
		return nil
	end
	local best, bestDist = nil, maxDist
	for _, b in pairs(breakables) do
		if b.Alive and canUseZone(player, b.Zone) then
			local d = (b.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = b, d
			end
		end
	end
	return best
end

local function tick()
	for _, player in ipairs(Players:GetPlayers()) do
		local id = targets[player]
		local b = id and breakables[id]
		if b and b.Alive then
			local pos = playerPosition(player)
			if not pos or (pos - b.Position).Magnitude > 110 then
				setTarget(player, nil)
			else
				local dmg = PetService.GetPower(player)
				local crit = false
				local critChance = DataService.CritChance(player)
				if critChance > 0 and rng:NextNumber() < critChance then
					dmg *= Config.CritMultiplier
					crit = true
				end
				applyDamage(b, player, dmg, crit)
				if DataService.HasGamepass(player, "AutoTap") then
					lastTap[player] = 0
					tap(player, b)
				end
			end
		elseif DataService.HasGamepass(player, "AutoTap") and DataService.Get(player) then
			local nb = nearestAlive(player, 60)
			if nb then
				setTarget(player, nb.Id)
			end
		elseif id then
			setTarget(player, nil)
		end
	end
end

-- ===== الزعيم =====
function BreakableService.SpawnBoss(health: number): Breakable?
	if boss then
		return boss
	end
	local pos = MapBuilder.Specials.BossArena
	local b = spawnBreakable("Boss", 1, 1, pos, true, true, health)
	boss = b
	if b then
		Remotes.Event("BossUpdate"):FireAllClients({ Active = true, Health = b.Health, MaxHealth = b.MaxHealth })
	end
	return b
end

function BreakableService.RemoveBoss()
	if boss then
		local b = boss
		boss = nil
		b.Alive = false
		for player, id in pairs(targets) do
			if id == b.Id then
				setTarget(player, nil)
			end
		end
		b.Model:Destroy()
		breakables[b.Id] = nil
		Remotes.Event("BossUpdate"):FireAllClients({ Active = false })
	end
end

function BreakableService.BossAlive(): boolean
	return boss ~= nil
end

function BreakableService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Breakables"
	folder.Parent = Workspace

	for index, layout in pairs(MapBuilder.Zones) do
		local zone = Zones.Get(index)
		if zone then
			local spotIndex = 1
			for _, entry in ipairs(zone.Breakables) do
				for _ = 1, entry.Count do
					local spot = layout.Spots[spotIndex]
					if not spot then
						break
					end
					spotIndex += 1
					spawnBreakable(entry.Type, index, zone.Multiplier, spot, false)
				end
			end
		end
	end
	spawnBreakable("GiantChest", 1, 1, MapBuilder.Specials.GiantChest, true)
	spawnBreakable("MysteryBox", 1, 1, MapBuilder.Specials.MysteryBox, true)

	Remotes.Event("SetTarget").OnServerEvent:Connect(function(player, id)
		if id == nil then
			setTarget(player, nil)
			return
		end
		local b = breakables[tostring(id)]
		if b then
			tryTarget(player, b, 70)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		lastTap[player] = nil
		for _, b in pairs(breakables) do
			b.Damage[player] = nil
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= Config.DamageTickRate then
			acc -= Config.DamageTickRate
			tick()
		end
	end)
end

return BreakableService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000019"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!strict
-- تحميل وحفظ بيانات اللاعبين + العملات + المضاعفات + إرسال الملف للعميل
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Mastery = require(Shared.Modules.Mastery)

local DataService = {}

export type Profile = {
	Coins: number,
	Diamonds: number,
	Tokens: number,
	Spins: number,
	Rebirths: number,
	Pets: { any },
	UnlockedZones: { [string]: boolean },
	Upgrades: { [string]: number },
	Stats: { [string]: number },
	Daily: { LastClaim: number, Streak: number },
	VIPDaily: number,
	Codes: { [string]: boolean },
	Potions: { [string]: number },
	PotionBag: { [string]: number },
	DarkMatter: { any },
	Settings: { [string]: any },
	Index: { [string]: boolean },
	Gamepasses: { [string]: boolean },
	LastZone: number,
	InGroup: boolean,
	SessionStart: number,
	PlaytimeClaimed: { [string]: boolean },
	Missions: { Day: number, List: { any } },
	Achievements: { [string]: boolean },
	Tutorial: { Step: number, Progress: number },
	Hoverboards: { Owned: { [string]: boolean }, Equipped: string },
	Merchant: { Rotation: number, Bought: { [string]: number } },
	SpinDay: number,
}

local function template(): Profile
	return {
		Coins = 0,
		Diamonds = 0,
		Tokens = 0,
		Spins = 0,
		Rebirths = 0,
		Pets = {},
		UnlockedZones = { ["1"] = true },
		Upgrades = { Storage = 0, Equip = 0, Coins = 0, Luck = 0, Damage = 0, Speed = 0, Diamonds = 0, XP = 0 },
		Stats = { Hatches = 0, Breaks = 0, CoinsEarned = 0, DiamondsEarned = 0, Damage = 0, Playtime = 0, BestPet = 0, Fusions = 0, Goldens = 0, Rainbows = 0, DarkMatters = 0, Rebirths = 0, BossKills = 0, Trades = 0, Enchants = 0, Spins = 0 },
		Daily = { LastClaim = 0, Streak = 0 },
		VIPDaily = 0,
		Codes = {},
		Potions = { Lucky = 0, Coins = 0, Damage = 0, Diamonds = 0 },
		PotionBag = { Lucky = 0, Coins = 0, Damage = 0, Diamonds = 0 },
		DarkMatter = {},
		Settings = { Music = true, HideOthersPets = false, LowGraphics = false, AutoDeleteRank = 0, DamageNumbers = true },
		Index = {},
		Gamepasses = {},
		LastZone = 1,
		InGroup = false,
		SessionStart = 0,
		PlaytimeClaimed = {},
		Missions = { Day = 0, List = {} },
		Achievements = {},
		Tutorial = { Step = 1, Progress = 0 },
		Hoverboards = { Owned = {}, Equipped = "" },
		Merchant = { Rotation = 0, Bought = {} },
		SpinDay = 0,
	}
end

local store = DataStoreService:GetDataStore(Config.DataStoreName)
local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
local loadedEvent = Instance.new("BindableEvent")

DataService.Loaded = loadedEvent.Event
-- دوال إضافية تضيف حقولاً محسوبة للملف المرسل للعميل
DataService.Extenders = {} :: { (Player, any) -> () }
-- مزودو المكافآت: كل دالة ترجع { Coins=, Luck=, Damage=, Diamonds=, XP=, Crit=, Agility= } (إضافات أو مضاعفات)
DataService.BonusProviders = {} :: { (Player) -> { [string]: number }? }

local function key(player: Player): string
	return "p_" .. player.UserId
end

local function reconcile(data: any): Profile
	local t = template()
	if type(data) ~= "table" then
		return t
	end
	for k, v in pairs(t) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "Pets" and k ~= "DarkMatter" then
			for k2, v2 in pairs(v) do
				if data[k][k2] == nil then
					data[k][k2] = v2
				end
			end
		end
	end
	-- ترقية الحيوانات القديمة
	for _, pet in ipairs(data.Pets) do
		pet.Level = pet.Level or 1
		pet.XP = pet.XP or 0
		pet.Enchants = pet.Enchants or {}
	end
	return data :: Profile
end

local function retry<T>(fn: () -> T, attempts: number): (boolean, T?)
	local ok, res
	for i = 1, attempts do
		ok, res = pcall(fn)
		if ok then
			return true, res
		end
		warn("[DataService] attempt " .. i .. " failed: " .. tostring(res))
		task.wait(1.5 * i)
	end
	return false, nil
end

local function load(player: Player)
	local ok, data = retry(function()
		return store:GetAsync(key(player))
	end, 3)
	if not ok then
		player:Kick("تعذر تحميل بياناتك، حاول مرة أخرى بعد قليل.")
		return
	end
	if player.Parent ~= Players then
		return
	end
	local profile = reconcile(data)
	profile.SessionStart = os.time()
	profile.PlaytimeClaimed = {}
	profile.Gamepasses = {}
	profile.InGroup = false
	profiles[player] = profile

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in ipairs({ "Coins", "Diamonds", "Rebirths" }) do
		local v = Instance.new("NumberValue")
		v.Name = name
		v.Value = (profile :: any)[name]
		v.Parent = ls
	end
	ls.Parent = player

	dirty[player] = true
	loadedEvent:Fire(player, profile)
end

local function save(player: Player, remove: boolean?)
	local profile = profiles[player]
	if not profile then
		return
	end
	local snapshot = table.clone(profile)
	snapshot.Gamepasses = nil :: any
	snapshot.PlaytimeClaimed = nil :: any
	snapshot.InGroup = nil :: any
	snapshot.Stats = table.clone(profile.Stats)
	snapshot.Stats.Playtime = (profile.Stats.Playtime or 0) + (os.time() - profile.SessionStart)
	local ok = retry(function()
		return store:UpdateAsync(key(player), function()
			return snapshot
		end)
	end, 3)
	if not ok then
		warn("[DataService] failed to save " .. player.Name)
	end
	if remove then
		profiles[player] = nil
		dirty[player] = nil
	end
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

function DataService.IsAdmin(player: Player): boolean
	if Config.StudioEveryoneAdmin and RunService:IsStudio() then
		return true
	end
	return table.find(Config.Admins, player.UserId) ~= nil
end

function DataService.Replicate(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local payload = table.clone(profile) :: any
	payload.ServerTime = os.time()
	payload.OwnedPasses = {}
	for k in pairs(Config.Gamepasses) do
		payload.OwnedPasses[k] = DataService.HasGamepass(player, k)
	end
	payload.Luck = DataService.LuckMultiplier(player)
	payload.CoinMult = DataService.CoinMultiplier(player)
	payload.DamageMult = DataService.DamageMultiplier(player)
	payload.DiamondMult = DataService.DiamondMultiplier(player)
	payload.IsAdmin = DataService.IsAdmin(player)
	payload.Premium = player.MembershipType == Enum.MembershipType.Premium
	for _, fn in ipairs(DataService.Extenders) do
		fn(player, payload)
	end
	Remotes.Event("ProfileUpdate"):FireClient(player, payload)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		for _, name in ipairs({ "Coins", "Diamonds", "Rebirths" }) do
			local v = ls:FindFirstChild(name) :: NumberValue?
			if v then
				v.Value = math.floor((profile :: any)[name])
			end
		end
	end
end

function DataService.Notify(player: Player, text: string, color: Color3?)
	Remotes.Event("Notify"):FireClient(player, { Text = text, Color = color })
end

function DataService.NotifyAll(text: string, color: Color3?)
	Remotes.Event("Notify"):FireAllClients({ Text = text, Color = color })
end

-- ===== العملات =====
function DataService.AddCoins(player: Player, amount: number)
	local p = profiles[player]
	if not p or amount <= 0 then
		return
	end
	p.Coins += amount
	p.Stats.CoinsEarned += amount
	dirty[player] = true
end

function DataService.AddDiamonds(player: Player, amount: number, fromBreakable: boolean?)
	local p = profiles[player]
	if not p or amount <= 0 then
		return
	end
	p.Diamonds += amount
	if fromBreakable then
		p.Stats.DiamondsEarned += amount
	end
	dirty[player] = true
end

function DataService.AddTokens(player: Player, amount: number)
	local p = profiles[player]
	if p and amount > 0 then
		p.Tokens += amount
		dirty[player] = true
	end
end

function DataService.AddSpins(player: Player, amount: number)
	local p = profiles[player]
	if p and amount > 0 then
		p.Spins += amount
		dirty[player] = true
	end
end

function DataService.Spend(player: Player, currency: string, amount: number): boolean
	local p = profiles[player]
	if not p or amount < 0 then
		return false
	end
	local field = if currency == "Coins" then "Coins" elseif currency == "Diamonds" then "Diamonds" elseif currency == "Tokens" then "Tokens" elseif currency == "Spins" then "Spins" else nil
	if not field then
		return false
	end
	local pp = p :: any
	if pp[field] < amount then
		return false
	end
	pp[field] -= amount
	dirty[player] = true
	return true
end

-- ===== الجيم باس والجرعات =====
function DataService.HasGamepass(player: Player, keyName: string): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	if Config.StudioFreeGamepasses and RunService:IsStudio() then
		return true
	end
	return p.Gamepasses[keyName] == true
end

function DataService.PotionActive(player: Player, potion: string): boolean
	local p = profiles[player]
	return p ~= nil and (p.Potions[potion] or 0) > os.time()
end

-- يضيف جرعة إلى الحقيبة
function DataService.GivePotion(player: Player, potion: string, count: number?)
	local p = profiles[player]
	local cfg = Config.Potions[potion]
	if not p or not cfg then
		return
	end
	p.PotionBag[potion] = (p.PotionBag[potion] or 0) + (count or 1)
	dirty[player] = true
	DataService.Notify(player, "🧪 حصلت على " .. cfg.Name .. " (في الحقيبة)", Color3.fromRGB(180, 120, 255))
end

function DataService.UsePotion(player: Player, potion: string): { ok: boolean, error: string? }
	local p = profiles[player]
	local cfg = Config.Potions[potion]
	if not p or not cfg then
		return { ok = false, error = "جرعة غير معروفة" }
	end
	if (p.PotionBag[potion] or 0) <= 0 then
		return { ok = false, error = "لا تملك هذه الجرعة" }
	end
	p.PotionBag[potion] -= 1
	local base = math.max(os.time(), p.Potions[potion] or 0)
	p.Potions[potion] = base + cfg.Duration
	dirty[player] = true
	DataService.Notify(player, "✨ تم تفعيل " .. cfg.Name, Color3.fromRGB(180, 120, 255))
	return { ok = true }
end

-- ===== المضاعفات =====
local function bonuses(player: Player): { [string]: number }
	local p = profiles[player]
	local out = { Coins = 0, Luck = 0, Damage = 0, Diamonds = 0, XP = 0, Crit = 0, Agility = 0, EventCoins = 1, EventLuck = 1, EventDiamonds = 1, EventXP = 1 }
	if not p then
		return out
	end
	local m = Mastery.Bonuses(p.Stats)
	for k, v in pairs(m) do
		out[k] = (out[k] or 0) + v
	end
	for _, fn in ipairs(DataService.BonusProviders) do
		local b = fn(player)
		if b then
			for k, v in pairs(b) do
				if k:sub(1, 5) == "Event" then
					out[k] = (out[k] or 1) * v
				else
					out[k] = (out[k] or 0) + v
				end
			end
		end
	end
	return out
end

function DataService.Bonuses(player: Player): { [string]: number }
	return bonuses(player)
end

function DataService.LuckMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local b = bonuses(player)
	local add = (p.Upgrades.Luck or 0) * 0.10 + (p.InGroup and Config.GroupBonus.Luck or 0)
		+ (player.MembershipType == Enum.MembershipType.Premium and Config.PremiumBonus.Luck or 0)
		+ p.Rebirths * Config.Rebirth.LuckPerRebirth + b.Luck
	local mult = 1 + add
	if DataService.HasGamepass(player, "Lucky") then
		mult *= 2
	end
	if DataService.HasGamepass(player, "SuperLucky") then
		mult *= 3
	end
	if DataService.PotionActive(player, "Lucky") then
		mult *= Config.Potions.Lucky.Mult
	end
	return mult * b.EventLuck
end

function DataService.CoinMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local b = bonuses(player)
	local add = (p.Upgrades.Coins or 0) * 0.05 + (p.InGroup and Config.GroupBonus.Coins or 0)
		+ (player.MembershipType == Enum.MembershipType.Premium and Config.PremiumBonus.Coins or 0)
		+ p.Rebirths * Config.Rebirth.CoinsPerRebirth + b.Coins
	local mult = 1 + add
	if DataService.HasGamepass(player, "VIP") then
		mult *= Config.VIPCoinMultiplier
	end
	if DataService.HasGamepass(player, "DoubleCoins") then
		mult *= 2
	end
	if DataService.PotionActive(player, "Coins") then
		mult *= Config.Potions.Coins.Mult
	end
	return mult * b.EventCoins
end

function DataService.DamageMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local b = bonuses(player)
	local mult = 1 + (p.Upgrades.Damage or 0) * 0.05 + p.Rebirths * Config.Rebirth.DamagePerRebirth + b.Damage
	if DataService.PotionActive(player, "Damage") then
		mult *= Config.Potions.Damage.Mult
	end
	return mult
end

function DataService.DiamondMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local b = bonuses(player)
	local mult = 1 + (p.Upgrades.Diamonds or 0) * 0.10 + p.Rebirths * Config.Rebirth.DiamondsPerRebirth + b.Diamonds
	if DataService.HasGamepass(player, "DoubleDiamonds") then
		mult *= 2
	end
	if DataService.PotionActive(player, "Diamonds") then
		mult *= Config.Potions.Diamonds.Mult
	end
	return mult * b.EventDiamonds
end

function DataService.XPMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local b = bonuses(player)
	return (1 + (p.Upgrades.XP or 0) * 0.10 + b.XP) * b.EventXP
end

function DataService.CritChance(player: Player): number
	return bonuses(player).Crit
end

function DataService.Save(player: Player)
	save(player)
end

function DataService.ResetProfile(player: Player)
	local fresh = template()
	fresh.SessionStart = os.time()
	profiles[player] = fresh
	dirty[player] = true
	loadedEvent:Fire(player, fresh)
end

function DataService.Init()
	Remotes.Event("RequestProfile").OnServerEvent:Connect(function(player)
		if profiles[player] then
			DataService.Replicate(player)
		end
	end)
	Remotes.Function("UsePotion").OnServerInvoke = function(player, potion)
		return DataService.UsePotion(player, tostring(potion))
	end
	Remotes.Function("BuyPotion").OnServerInvoke = function(player, potion)
		local cfg = Config.Potions[tostring(potion)]
		if not cfg then
			return { ok = false, error = "جرعة غير معروفة" }
		end
		if not DataService.Spend(player, "Diamonds", cfg.Cost) then
			return { ok = false, error = "تحتاج 💎 " .. cfg.Cost }
		end
		DataService.GivePotion(player, tostring(potion), 1)
		return { ok = true }
	end

	Players.PlayerAdded:Connect(load)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player, true)
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		for player, isDirty in pairs(dirty) do
			if isDirty and profiles[player] then
				dirty[player] = false
				DataService.Replicate(player)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in pairs(profiles) do
				save(player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			task.wait(1)
		end
		for player in pairs(profiles) do
			save(player, true)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">EggService</string><ProtectedString name="Source"><![CDATA[--!strict
-- فتح البيض: عادي/ذهبي/قوس قزح، 1/3/8، الحظ، الحذف التلقائي، إعلانات Huge
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Eggs = require(Shared.Data.Eggs)
local Pets = require(Shared.Data.Pets)
local Zones = require(Shared.Data.Zones)
local Rarities = require(Shared.Data.Rarities)
local Luck = require(Shared.Modules.Luck)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local Hooks = require(script.Parent.Hooks)

local EggService = {}

local lastHatch: { [Player]: number } = {}
local rng = Random.new()
local eggPositions: { [string]: Vector3 } = {}

function EggService.RegisterEggPosition(eggId: string, pos: Vector3)
	eggPositions[eggId] = pos
end

function EggService.Hatch(player: Player, eggId: string, count: number, variant: string?): { ok: boolean, error: string?, pets: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local egg = Eggs.Get(eggId)
	if not egg then
		return { ok = false, error = "بيضة غير موجودة" }
	end
	variant = variant or "Normal"
	local variantCost = Config.EggVariantCost[variant]
	if not variantCost then
		return { ok = false, error = "نوع بيضة غير معروف" }
	end
	if variant ~= "Normal" and egg.Currency ~= "Coins" then
		return { ok = false, error = "هذه البيضة لا تملك نسخة " .. variant }
	end
	count = math.floor(tonumber(count) or 1)
	if count ~= 1 and count ~= 3 and count ~= 8 then
		count = 1
	end
	if count >= 3 and not DataService.HasGamepass(player, "TripleHatch") then
		return { ok = false, error = "تحتاج جيم باس Triple Hatch" }
	end
	if count == 8 and not DataService.HasGamepass(player, "OctupleHatch") then
		return { ok = false, error = "تحتاج جيم باس Octuple Hatch" }
	end
	if egg.VIPOnly and not DataService.HasGamepass(player, "VIP") then
		return { ok = false, error = "هذه البيضة لأعضاء VIP فقط" }
	end
	if egg.Zone > 0 and not p.UnlockedZones[tostring(egg.Zone)] then
		return { ok = false, error = "افتح المنطقة أولاً" }
	end
	local zone = Zones.Get(egg.Zone)
	if zone and zone.World == 2 and p.Rebirths < 1 then
		return { ok = false, error = "العالم الثاني يتطلب ريبيرث" }
	end

	local pos = eggPositions[eggId]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if pos and hrp and (hrp.Position - pos).Magnitude > 40 then
		return { ok = false, error = "اقترب من البيضة" }
	end

	local now = os.clock()
	if now - (lastHatch[player] or 0) < Config.HatchCooldown then
		return { ok = false, error = "انتظر قليلاً" }
	end

	local autoDelete = p.Settings.AutoDeleteRank or 0
	if PetService.FreeSlots(player) < count and autoDelete == 0 then
		return { ok = false, error = "المخزن ممتلئ! احذف أو ادمج حيوانات" }
	end

	local total = egg.Cost * count * variantCost
	if not DataService.Spend(player, egg.Currency, total) then
		local name = egg.Currency == "Coins" and "العملات" or (egg.Currency == "Diamonds" and "الألماس" or "توكنات الريبيرث")
		return { ok = false, error = "لا تملك ما يكفي من " .. name }
	end
	lastHatch[player] = now

	local luck = DataService.LuckMultiplier(player)
	local results = {}
	for _ = 1, count do
		local petId = Luck.Roll(eggId, luck, rng) or egg.Pets[1].Pet
		local def = Pets.Get(petId)
		local rank = def and Rarities.Rank(def.Rarity) or 1
		local deleted = autoDelete > 0 and rank <= autoDelete and variant == "Normal"
		if not deleted and PetService.FreeSlots(player) <= 0 then
			deleted = true
		end
		local inst = nil
		if not deleted then
			inst = PetService.Add(player, petId, variant, true)
		else
			p.Index[petId] = true
		end
		table.insert(results, { Uid = inst and inst.Uid or "", Id = petId, Variant = variant, Deleted = deleted })
		if def and rank >= 5 then
			Remotes.Event("HatchBroadcast"):FireAllClients({ Player = player.Name, PetId = petId, Variant = variant, Rarity = def.Rarity })
			if rank >= 8 then
				DataService.NotifyAll("🎉 " .. player.Name .. " حصل على " .. def.Name .. "!!! 🎉", Color3.fromRGB(255, 0, 80))
				Remotes.Event("EventEffect"):FireAllClients({ Type = "Huge", Player = player.Name, PetId = petId })
			end
		end
	end
	p.Stats.Hatches += count
	Hooks.Fire(player, "Hatch", count)
	DataService.MarkDirty(player)
	return { ok = true, pets = results }
end

function EggService.Init()
	Remotes.Function("HatchEgg").OnServerInvoke = function(player, eggId, count, variant)
		return EggService.Hatch(player, tostring(eggId), tonumber(count) or 1, type(variant) == "string" and variant or "Normal")
	end
	Players.PlayerRemoving:Connect(function(player)
		lastHatch[player] = nil
	end)
end

return EggService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الأحداث العالمية الدورية: Coin Rush، Lucky Time، Diamond Rain، XP Fever، غارة الزعيم
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local BreakableService = require(script.Parent.BreakableService)
local Hooks = require(script.Parent.Hooks)

local EventService = {}

local active: any = nil
local activeEnds = 0
local lastId = ""
local rng = Random.new()

local function state(): Folder
	return Remotes.State()
end

local function findEvent(id: string): any?
	for _, e in ipairs(Config.Events.List) do
		if e.Id == id then
			return e
		end
	end
	return nil
end

function EventService.Active(): any?
	if active and os.time() < activeEnds then
		return active
	end
	return nil
end

local function endEvent()
	if active and active.Boss and BreakableService.BossAlive() then
		BreakableService.RemoveBoss()
		DataService.NotifyAll("👹 هرب الزعيم! حاولوا في المرة القادمة", Color3.fromRGB(255, 120, 120))
	end
	active = nil
	local s = state()
	s:SetAttribute("EventId", "")
	s:SetAttribute("EventEnds", 0)
end

function EventService.Start(id: string): boolean
	local e = findEvent(id)
	if not e then
		return false
	end
	if active then
		endEvent()
	end
	active = e
	activeEnds = os.time() + (e.Boss and Config.Events.Boss.Duration or Config.Events.Duration)
	lastId = id
	local s = state()
	s:SetAttribute("EventId", id)
	s:SetAttribute("EventEnds", activeEnds)
	DataService.NotifyAll("🎉 حدث: " .. e.Name .. " — " .. e.Arabic, Color3.fromRGB(255, 220, 90))
	Remotes.Event("EventEffect"):FireAllClients({ Type = "EventStart", Id = id })
	if e.Boss then
		local totalPower = 0
		for _, pl in ipairs(Players:GetPlayers()) do
			totalPower += PetService.GetPower(pl)
		end
		local health = math.max(5000, math.floor(totalPower * Config.Events.Boss.HealthPerPower))
		BreakableService.SpawnBoss(health)
	end
	task.delay(activeEnds - os.time(), function()
		if active == e and os.time() >= activeEnds then
			endEvent()
		end
	end)
	return true
end

local function onBossKilled(contributors: { [Player]: number })
	local bossCfg = Config.Events.Boss
	DataService.NotifyAll("🏆 تم هزيمة " .. bossCfg.Name .. "! المكافآت وُزعت على المشاركين", Color3.fromRGB(120, 255, 140))
	for player in pairs(contributors) do
		local p = DataService.Get(player)
		if p and player.Parent == Players then
			p.Stats.BossKills += 1
			Hooks.Fire(player, "Boss", 1)
			if rng:NextNumber() < bossCfg.PetChance then
				local inst = PetService.Add(player, bossCfg.Pet, "Normal", true)
				if inst then
					DataService.Notify(player, "👑 حصلت على " .. bossCfg.Name .. " من الزعيم!", Color3.fromRGB(255, 200, 40))
					Remotes.Event("HatchBroadcast"):FireAllClients({ Player = player.Name, PetId = bossCfg.Pet, Variant = "Normal", Rarity = "Mythical" })
				end
			end
			DataService.MarkDirty(player)
		end
	end
	if active and active.Boss then
		endEvent()
	end
end

function EventService.Init()
	BreakableService.OnBossKilled = onBossKilled
	table.insert(DataService.BonusProviders, function()
		local e = EventService.Active()
		if not e then
			return nil
		end
		return { EventCoins = e.Coins or 1, EventLuck = e.Luck or 1, EventDiamonds = e.Diamonds or 1, EventXP = e.XP or 1 }
	end)
	task.spawn(function()
		local s = state()
		while true do
			local nextAt = os.time() + Config.Events.Interval
			s:SetAttribute("NextEvent", nextAt)
			while os.time() < nextAt do
				task.wait(1)
			end
			if #Players:GetPlayers() > 0 and not active then
				local candidates = {}
				for _, e in ipairs(Config.Events.List) do
					if e.Id ~= lastId then
						table.insert(candidates, e)
					end
				end
				local pick = candidates[rng:NextInteger(1, #candidates)]
				EventService.Start(pick.Id)
			end
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">Hooks</string><ProtectedString name="Source"><![CDATA[--!strict
-- قناة أحداث داخلية بين الخدمات (للمهام والإنجازات والدليل التعليمي)
local Hooks = {}
Hooks.Listeners = {} :: { (Player, string, number) -> () }

function Hooks.Fire(player: Player, kind: string, amount: number)
	for _, fn in ipairs(Hooks.Listeners) do
		task.spawn(fn, player, kind, amount)
	end
end

function Hooks.Listen(fn: (Player, string, number) -> ())
	table.insert(Hooks.Listeners, fn)
end

return Hooks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">HoverboardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الهوفربورد: شراء، تجهيز، ركوب (لوح ملحوم تحت اللاعب + سرعة)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ZoneService = require(script.Parent.ZoneService)

local HoverboardService = {}

local function boardDef(id: string): any?
	for _, b in ipairs(Config.Hoverboards) do
		if b.Id == id then
			return b
		end
	end
	return nil
end

local function removeBoard(player: Player)
	local char = player.Character
	local board = char and char:FindFirstChild("Hoverboard")
	if board then
		board:Destroy()
	end
	player:SetAttribute("BoardSpeed", 0)
	player:SetAttribute("Riding", false)
	ZoneService.RefreshSpeed(player)
end

local function mountBoard(player: Player, def: any)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end
	removeBoard(player)
	local board = Instance.new("Part")
	board.Name = "Hoverboard"
	board.Size = Vector3.new(4.5, 0.4, 2.2)
	board.Color = def.Color
	board.Material = def.Neon and Enum.Material.Neon or Enum.Material.Metal
	board.CanCollide = false
	board.Massless = true
	board.CFrame = hrp.CFrame * CFrame.new(0, -3.1, 0)
	local weld = Instance.new("Weld")
	weld.Part0 = hrp
	weld.Part1 = board
	weld.C0 = CFrame.new(0, -3.1, 0)
	weld.Parent = board
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-2, 0, 0)
	a0.Parent = board
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(2, 0, 0)
	a1.Parent = board
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(def.Color)
	trail.Lifetime = 0.5
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.LightEmission = 1
	trail.Parent = board
	if def.Neon then
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 8
		light.Parent = board
	end
	board.Parent = char
	player:SetAttribute("BoardSpeed", def.Speed)
	player:SetAttribute("Riding", true)
	ZoneService.RefreshSpeed(player)
end

function HoverboardService.Action(player: Player, action: string, id: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if action == "Buy" then
		local def = boardDef(id)
		if not def then
			return { ok = false, error = "لوح غير موجود" }
		end
		if p.Hoverboards.Owned[id] then
			return { ok = false, error = "تملكه بالفعل" }
		end
		if not DataService.Spend(player, "Diamonds", def.Cost) then
			return { ok = false, error = "تحتاج 💎 " .. def.Cost }
		end
		p.Hoverboards.Owned[id] = true
		p.Hoverboards.Equipped = id
		DataService.Notify(player, "🛹 اشتريت " .. def.Name .. "! اضغط Q للركوب", Color3.fromRGB(120, 255, 140))
	elseif action == "Equip" then
		if not p.Hoverboards.Owned[id] then
			return { ok = false, error = "لا تملك هذا اللوح" }
		end
		p.Hoverboards.Equipped = id
		if player:GetAttribute("Riding") then
			mountBoard(player, boardDef(id))
		end
	elseif action == "Toggle" then
		local eq = p.Hoverboards.Equipped
		local def = eq ~= "" and boardDef(eq) or nil
		if not def then
			return { ok = false, error = "اشترِ لوحاً من المتجر أولاً" }
		end
		if player:GetAttribute("Riding") then
			removeBoard(player)
		else
			mountBoard(player, def)
		end
		return { ok = true }
	else
		return { ok = false, error = "إجراء غير معروف" }
	end
	DataService.MarkDirty(player)
	return { ok = true }
end

function HoverboardService.Init()
	Remotes.Function("Hoverboard").OnServerInvoke = function(player, action, id)
		return HoverboardService.Action(player, tostring(action), tostring(id))
	end
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			player:SetAttribute("Riding", false)
			player:SetAttribute("BoardSpeed", 0)
		end)
	end)
end

return HoverboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000024"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحات المتصدرين العالمية (OrderedDataStore)
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local LeaderboardService = {}

local stores = {
	Coins = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Coins"),
	Hatches = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Hatches"),
	Rebirths = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Rebirths"),
	Damage = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Damage"),
}

local function refresh()
	for _, player in ipairs(Players:GetPlayers()) do
		local p = DataService.Get(player)
		if p then
			pcall(stores.Coins.SetAsync, stores.Coins, tostring(player.UserId), math.floor(math.min(p.Stats.CoinsEarned, 9e15)))
			pcall(stores.Hatches.SetAsync, stores.Hatches, tostring(player.UserId), math.floor(p.Stats.Hatches))
			pcall(stores.Rebirths.SetAsync, stores.Rebirths, tostring(player.UserId), math.floor(p.Rebirths))
			pcall(stores.Damage.SetAsync, stores.Damage, tostring(player.UserId), math.floor(math.min(p.Stats.Damage, 9e15)))
		end
	end
	for key, store in pairs(stores) do
		local label = MapBuilder.Boards[key]
		if label then
			local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
			if ok then
				local lines = {}
				for i, entry in ipairs(pages:GetCurrentPage()) do
					local name = "???"
					local okName, res = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) :: number)
					if okName then
						name = res
					end
					table.insert(lines, string.format("%d. %s  -  %s", i, name, Format.Number(entry.value)))
				end
				label.Text = #lines > 0 and table.concat(lines, "\n") or "لا يوجد بيانات بعد"
			end
		end
	end
end

function LeaderboardService.Init()
	task.spawn(function()
		task.wait(5)
		while true do
			refresh()
			task.wait(60)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000025"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- يبني العالم كاملاً بالكود: الجزر، الجسور، البوابات، البيض، الآلات، الزينة، منطقة VIP، اللوحات.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Eggs = require(Shared.Data.Eggs)
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)

local MapBuilder = {}

export type ZoneLayout = {
	Index: number,
	Center: Vector3,
	Spawn: Vector3,
	Spots: { Vector3 },
	Eggs: { [string]: Vector3 },
	Gate: BasePart?,
	Folder: Folder,
}

MapBuilder.Zones = {} :: { [number]: ZoneLayout }
MapBuilder.Boards = {} :: { [string]: TextLabel }
MapBuilder.Machines = {} :: { [string]: Model }
MapBuilder.Specials = {} :: { [string]: Vector3 }
MapBuilder.VIPPortal = nil :: BasePart?
MapBuilder.VIPReturnPortal = nil :: BasePart?
MapBuilder.World2Portal = nil :: BasePart?
MapBuilder.World1Portal = nil :: BasePart?

local SPACING = Config.Map.ZoneSpacing
local ISLAND = Config.Map.IslandSize
local BRIDGE = Config.Map.BridgeLength

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local pp = Instance.new("Part")
		if shape == "ball" then
			pp.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			pp.Shape = Enum.PartType.Cylinder
		end
		p = pp
	end
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "cone" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://1033714"
		mesh.Scale = Vector3.new(size.X / 2, size.Y / 2, size.Z / 2)
		mesh.Parent = p
	elseif shape == "egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

local function billboard(parent: BasePart, text: string, size: UDim2, color: Color3, offset: number, textSize: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffset = Vector3.new(0, offset, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = textSize == nil
	label.TextSize = textSize or 24
	label.Font = Enum.Font.FredokaOne
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Parent = bb
	bb.Parent = parent
	return bb
end

-- ===== الزينة =====
local function tree(parent: Instance, pos: Vector3, scale: number, leaf: Color3, rng: Random)
	local trunkH = 6 * scale
	part(parent, "Trunk", Vector3.new(1.4 * scale, trunkH, 1.4 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)), Color3.fromRGB(110, 75, 40), Enum.Material.Wood)
	for i = 1, 3 do
		local s = (5 - i) * 1.4 * scale
		part(parent, "Leaves", Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-0.5, 0.5), trunkH + i * 1.6 * scale - 1, rng:NextNumber(-0.5, 0.5))), leaf, Enum.Material.Grass, "ball")
	end
end

local function palm(parent: Instance, pos: Vector3, rng: Random)
	local h = 10
	for i = 1, 5 do
		part(parent, "Trunk", Vector3.new(1.2, h / 5 + 0.2, 1.2), CFrame.new(pos + Vector3.new(i * 0.25, (i - 0.5) * h / 5, 0)), Color3.fromRGB(150, 110, 60), Enum.Material.Wood)
	end
	for i = 1, 6 do
		local ang = i / 6 * math.pi * 2
		part(parent, "Leaf", Vector3.new(1.2, 0.2, 6), CFrame.new(pos + Vector3.new(1.25, h, 0)) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -3) * CFrame.Angles(-0.35, 0, 0), Color3.fromRGB(60, 170, 70), Enum.Material.Grass)
	end
	part(parent, "Coconut", Vector3.new(1, 1, 1), CFrame.new(pos + Vector3.new(1.25, h - 0.6, 0)), Color3.fromRGB(90, 60, 30), nil, "ball")
end

local function cactus(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(5, 8)
	local green = Color3.fromRGB(60, 140, 70)
	part(parent, "Cactus", Vector3.new(2, h, 2), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
	part(parent, "Arm", Vector3.new(1.4, 3, 1.4), CFrame.new(pos + Vector3.new(1.8, h * 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
	part(parent, "Arm", Vector3.new(1.4, 1.4, 2.2), CFrame.new(pos + Vector3.new(1.2, h * 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
end

local function crystalCluster(parent: Instance, pos: Vector3, color: Color3, rng: Random, glow: boolean)
	for i = 1, 3 do
		local h = rng:NextNumber(4, 9)
		local w = rng:NextNumber(1.5, 2.5)
		local off = Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
		local c = part(parent, "Crystal", Vector3.new(w, h, w), CFrame.new(pos + off + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), color, glow and Enum.Material.Neon or Enum.Material.Glass, "cone")
		c.Transparency = glow and 0 or 0.2
	end
end

local function cloudPuff(parent: Instance, pos: Vector3, rng: Random)
	for i = 1, 4 do
		local s = rng:NextNumber(5, 9)
		local c = part(parent, "Cloud", Vector3.new(s, s * 0.7, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(3, 8), rng:NextNumber(-4, 4))), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, "ball")
		c.CanCollide = false
		c.Transparency = 0.1
	end
end

local function lavaRock(parent: Instance, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 8)
	local rock = part(parent, "Rock", Vector3.new(s, s * 0.8, s), CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0), Color3.fromRGB(45, 35, 35), Enum.Material.Basalt)
	local lava = part(parent, "Lava", Vector3.new(s * 0.6, 0.4, s * 0.6), CFrame.new(pos + Vector3.new(0, s * 0.7, 0)), Color3.fromRGB(255, 110, 0), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 0)
	light.Range = 14
	light.Parent = lava
	rock.CanCollide = true
end

local function goldPillar(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(8, 14)
	part(parent, "Pillar", Vector3.new(2.5, h, 2.5), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Metal)
	local top = part(parent, "Top", Vector3.new(3, 3, 3), CFrame.new(pos + Vector3.new(0, h + 1, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, "ball")
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 240, 150)
	light.Range = 18
	light.Parent = top
end

local function iceSpike(parent: Instance, pos: Vector3, rng: Random)
	crystalCluster(parent, pos, Color3.fromRGB(200, 240, 255), rng, false)
end

local function techPillar(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(8, 16)
	part(parent, "Pillar", Vector3.new(3, h, 3), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(50, 55, 75), Enum.Material.Metal)
	for i = 1, 3 do
		local strip = part(parent, "Strip", Vector3.new(3.2, 0.4, 3.2), CFrame.new(pos + Vector3.new(0, h * i / 4, 0)), Color3.fromRGB(0, 255, 255), Enum.Material.Neon)
		strip.CanCollide = false
	end
	local top = part(parent, "Top", Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, h + 1, 0)), Color3.fromRGB(0, 255, 255), Enum.Material.Neon, "ball")
	top.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(0, 255, 255)
	light.Range = 16
	light.Parent = top
end

local function cyberTree(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(6, 10)
	part(parent, "Trunk", Vector3.new(1.4, h, 1.4), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(20, 30, 25), Enum.Material.Metal)
	for i = 1, 3 do
		local s = (5 - i) * 1.6
		local leaves = part(parent, "Leaves", Vector3.new(s, s * 0.6, s), CFrame.new(pos + Vector3.new(0, h + i * 1.4 - 1, 0)), Color3.fromRGB(57, 255, 20), Enum.Material.Neon)
		leaves.Transparency = 0.2
		leaves.CanCollide = false
	end
end

local function neonBuilding(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(14, 30)
	local w = rng:NextNumber(6, 10)
	part(parent, "Building", Vector3.new(w, h, w), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(25, 20, 40), Enum.Material.Concrete)
	local colors = { Color3.fromRGB(255, 45, 149), Color3.fromRGB(0, 240, 255), Color3.fromRGB(255, 230, 0) }
	for y = 3, h - 2, 3 do
		for _, side in ipairs({ -1, 1 }) do
			local win = part(parent, "Window", Vector3.new(w * 0.6, 1.2, 0.3), CFrame.new(pos + Vector3.new(0, y, side * (w / 2 + 0.1))), colors[rng:NextInteger(1, 3)], Enum.Material.Neon)
			win.CanCollide = false
		end
	end
	local sign = part(parent, "Sign", Vector3.new(w * 0.8, 1.5, 0.4), CFrame.new(pos + Vector3.new(0, h + 1, 0)), colors[rng:NextInteger(1, 3)], Enum.Material.Neon)
	sign.CanCollide = false
end

local function serverRack(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(6, 10)
	part(parent, "Rack", Vector3.new(4, h, 3), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(30, 30, 45), Enum.Material.Metal)
	for y = 1, h - 1, 1.2 do
		local led = part(parent, "LED", Vector3.new(3, 0.3, 0.2), CFrame.new(pos + Vector3.new(0, y, -1.6)), rng:NextNumber() < 0.5 and Color3.fromRGB(0, 206, 209) or Color3.fromRGB(0, 255, 120), Enum.Material.Neon)
		led.CanCollide = false
	end
end

local function quantumOrb(parent: Instance, pos: Vector3, rng: Random)
	for i = 1, 3 do
		local s = rng:NextNumber(2, 5)
		local orb = part(parent, "Orb", Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(4, 14), rng:NextNumber(-4, 4))), Color3.fromHSV(rng:NextNumber(), 0.8, 1), Enum.Material.Neon, "ball")
		orb.CanCollide = false
		orb.Transparency = 0.15
	end
	local ring = part(parent, "Ring", Vector3.new(0.5, 8, 8), CFrame.new(pos + Vector3.new(0, 6, 0)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), Color3.fromRGB(255, 0, 255), Enum.Material.Neon, "cyl")
	ring.CanCollide = false
	ring.Transparency = 0.4
end

local DECOR: { [string]: (Instance, Vector3, Random) -> () } = {
	tech = techPillar,
	cybertrees = cyberTree,
	city = neonBuilding,
	servers = serverRack,
	quantum = quantumOrb,
	trees = function(parent, pos, rng)
		tree(parent, pos, rng:NextNumber(0.9, 1.5), Color3.fromRGB(40 + rng:NextInteger(0, 40), 140 + rng:NextInteger(0, 50), 50), rng)
	end,
	palms = palm,
	cactus = cactus,
	ice = iceSpike,
	lava = lavaRock,
	clouds = cloudPuff,
	crystals = function(parent, pos, rng)
		crystalCluster(parent, pos, Color3.fromHSV(rng:NextNumber(), 0.7, 1), rng, true)
	end,
	gold = goldPillar,
}

-- ===== البيضة =====
local function buildEgg(parent: Instance, egg: Eggs.EggDef, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = egg.Id
	model:SetAttribute("EggId", egg.Id)
	part(model, "Pedestal", Vector3.new(1.2, 9, 9), CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(230, 230, 235), Enum.Material.Marble, "cyl")
	part(model, "PedestalRing", Vector3.new(0.5, 10.5, 10.5), CFrame.new(pos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2), egg.Accent, Enum.Material.Neon, "cyl")
	local shell = part(model, "Shell", Vector3.new(5, 6.5, 5), CFrame.new(pos + Vector3.new(0, 4.5, 0)), egg.Color, Enum.Material.SmoothPlastic, "egg")
	shell.CanCollide = false
	local rng = Random.new(#egg.Id * 7)
	for i = 1, 7 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-1.8, 1.8)
		local r = 2.3 * math.sqrt(1 - (y / 3.2) ^ 2)
		local spot = part(model, "Spot", Vector3.new(1, 1, 1) * rng:NextNumber(0.6, 1.1), CFrame.new(pos + Vector3.new(math.cos(ang) * r, 4.5 + y, math.sin(ang) * r)), egg.Accent, Enum.Material.SmoothPlastic, "ball")
		spot.CanCollide = false
	end
	model.PrimaryPart = shell
	local currency = egg.Currency == "Coins" and "💰" or (egg.Currency == "Diamonds" and "💎" or "🔁")
	billboard(shell, egg.Name .. "\n" .. currency .. " " .. Format.Number(egg.Cost), UDim2.fromScale(12, 4), Color3.new(1, 1, 1), 5.5)
	if egg.VIPOnly then
		local crown = part(model, "Crown", Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, 8.6, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, "cone")
		crown.CanCollide = false
	end
	model.Parent = parent
	return model
end

-- ===== الآلات =====
local MACHINE_INFO = {
	{ Kind = "Golden", Name = "Golden Machine", Arabic = "آلة الذهب", Color = Color3.fromRGB(255, 200, 40) },
	{ Kind = "Rainbow", Name = "Rainbow Machine", Arabic = "آلة قوس قزح", Color = Color3.fromRGB(255, 100, 200) },
	{ Kind = "DarkMatter", Name = "Dark Matter Machine", Arabic = "آلة المادة المظلمة", Color = Color3.fromRGB(120, 40, 200) },
	{ Kind = "Fuse", Name = "Fusion Machine", Arabic = "آلة الدمج", Color = Color3.fromRGB(60, 200, 255) },
	{ Kind = "Enchant", Name = "Enchant Machine", Arabic = "آلة الإنشانت", Color = Color3.fromRGB(0, 255, 140) },
}

local function buildMachine(parent: Instance, info: any, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = info.Kind .. "Machine"
	model:SetAttribute("Machine", info.Kind)
	part(model, "Base", Vector3.new(1, 10, 10), CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 60, 70), Enum.Material.Metal, "cyl")
	local body = part(model, "Body", Vector3.new(6, 7, 6), CFrame.new(pos + Vector3.new(0, 4.5, 0)), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local glass = part(model, "Glass", Vector3.new(4.5, 4.5, 4.5), CFrame.new(pos + Vector3.new(0, 5, 0)), info.Color, Enum.Material.Glass, "ball")
	glass.Transparency = 0.35
	glass.CanCollide = false
	local core = part(model, "Core", Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, 5, 0)), info.Color, Enum.Material.Neon, "ball")
	core.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = info.Color
	light.Range = 16
	light.Brightness = 1.5
	light.Parent = core
	local ring = part(model, "Ring", Vector3.new(0.6, 7.5, 7.5), CFrame.new(pos + Vector3.new(0, 8.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), info.Color, Enum.Material.Neon, "cyl")
	ring.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = info.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	billboard(body, info.Name .. "\n" .. info.Arabic, UDim2.fromScale(14, 4), info.Color, 8)
	model.PrimaryPart = body
	model.Parent = parent
	return model
end

-- ===== الصناديق القابلة للكسر =====
function MapBuilder.BuildBreakable(typeName: string, pos: Vector3, scale: number?): Model
	local def = Breakables.Get(typeName) :: Breakables.BreakableDef
	local s = scale or 1
	local size = def.Size * s
	local model = Instance.new("Model")
	model.Name = typeName
	local base: BasePart
	if def.Shape == "pile" then
		base = part(model, "Base", Vector3.new(size.Y * 0.35, size.X, size.X), CFrame.new(pos + Vector3.new(0, size.Y * 0.18, 0)) * CFrame.Angles(0, 0, math.pi / 2), def.Color, def.Material, "cyl")
		part(model, "Coin", Vector3.new(size.Y * 0.3, size.X * 0.75, size.X * 0.75), CFrame.new(pos + Vector3.new(size.X * 0.1, size.Y * 0.5, -size.X * 0.08)) * CFrame.Angles(0, 0.4, math.pi / 2), def.Color, def.Material, "cyl").CanCollide = false
		part(model, "Coin", Vector3.new(size.Y * 0.28, size.X * 0.5, size.X * 0.5), CFrame.new(pos + Vector3.new(-size.X * 0.08, size.Y * 0.78, size.X * 0.06)) * CFrame.Angles(0, 0.9, math.pi / 2), Color3.fromRGB(255, 230, 120), def.Material, "cyl").CanCollide = false
	elseif def.Shape == "chest" or def.Shape == "giant" then
		base = part(model, "Base", Vector3.new(size.X, size.Y * 0.6, size.Z), CFrame.new(pos + Vector3.new(0, size.Y * 0.3, 0)), def.Color, def.Material)
		local lid = part(model, "Lid", Vector3.new(size.X, size.Y * 0.4, size.Z), CFrame.new(pos + Vector3.new(0, size.Y * 0.8, 0)), def.Color, def.Material)
		lid.CanCollide = false
		local band = Color3.fromRGB(255, 215, 0)
		if def.Shape == "giant" then
			band = Color3.fromRGB(255, 255, 255)
		end
		part(model, "Band", Vector3.new(size.X * 0.2, size.Y * 1.02, size.Z * 1.04), CFrame.new(pos + Vector3.new(0, size.Y * 0.5, 0)), band, Enum.Material.Metal).CanCollide = false
		part(model, "Lock", Vector3.new(size.X * 0.18, size.Y * 0.22, size.Z * 0.12), CFrame.new(pos + Vector3.new(0, size.Y * 0.55, -size.Z * 0.52)), band, Enum.Material.Metal).CanCollide = false
		if def.Shape == "giant" then
			local glow = part(model, "Glow", Vector3.new(size.X * 0.8, 0.5, size.Z * 0.8), CFrame.new(pos + Vector3.new(0, size.Y * 0.6, 0)), Color3.fromRGB(255, 120, 255), Enum.Material.Neon)
			glow.CanCollide = false
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 120, 255)
			light.Range = 30
			light.Brightness = 2
			light.Parent = glow
		end
	elseif def.Shape == "crystal" then
		base = part(model, "Base", Vector3.new(size.X, size.Y, size.Z), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), def.Color, def.Material, "cone")
		base.Transparency = 0.15
		for i = 1, 2 do
			local c = part(model, "Shard", Vector3.new(size.X * 0.6, size.Y * 0.55, size.Z * 0.6), CFrame.new(pos + Vector3.new(i == 1 and size.X * 0.6 or -size.X * 0.6, size.Y * 0.27, 0)) * CFrame.Angles(0, 0, i == 1 and -0.3 or 0.3), def.Color, Enum.Material.Neon, "cone")
			c.CanCollide = false
		end
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 12
		light.Parent = base
	elseif def.Shape == "boss" then
		base = part(model, "Base", Vector3.new(size.X, size.Y * 0.8, size.Z), CFrame.new(pos + Vector3.new(0, size.Y * 0.4, 0)), def.Color, def.Material, "ball")
		base.Transparency = 0.1
		for _, side in ipairs({ -1, 1 }) do
			local eye = part(model, "Eye", Vector3.new(2.6, 2.6, 2.6), CFrame.new(pos + Vector3.new(side * size.X * 0.2, size.Y * 0.5, -size.Z * 0.42)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, "ball")
			eye.CanCollide = false
			local pupil = part(model, "Pupil", Vector3.new(1.2, 1.2, 1.2), CFrame.new(pos + Vector3.new(side * size.X * 0.2, size.Y * 0.5, -size.Z * 0.52)), Color3.fromRGB(120, 0, 0), Enum.Material.Neon, "ball")
			pupil.CanCollide = false
		end
		local mouthPart = part(model, "Mouth", Vector3.new(size.X * 0.4, 1, 0.6), CFrame.new(pos + Vector3.new(0, size.Y * 0.28, -size.Z * 0.48)), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic)
		mouthPart.CanCollide = false
		local crown = part(model, "Crown", Vector3.new(size.X * 0.45, 3, size.Z * 0.45), CFrame.new(pos + Vector3.new(0, size.Y * 0.85, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Metal, "cone")
		crown.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 40
		light.Brightness = 2
		light.Parent = base
		billboard(base, "👹 " .. def.Name, UDim2.fromScale(20, 5), Color3.fromRGB(255, 80, 80), size.Y * 0.7)
	else -- gift
		base = part(model, "Base", size, CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), def.Color, def.Material)
		local ribbon = Color3.fromRGB(255, 220, 60)
		part(model, "Ribbon", Vector3.new(size.X * 1.02, size.Y * 1.02, size.Z * 0.2), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), ribbon, Enum.Material.SmoothPlastic).CanCollide = false
		part(model, "Ribbon", Vector3.new(size.X * 0.2, size.Y * 1.02, size.Z * 1.02), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), ribbon, Enum.Material.SmoothPlastic).CanCollide = false
		part(model, "Bow", Vector3.new(size.X * 0.35, size.Y * 0.3, size.Z * 0.35), CFrame.new(pos + Vector3.new(0, size.Y * 1.1, 0)), ribbon, Enum.Material.SmoothPlastic, "ball").CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 16
		light.Parent = base
	end
	base.CanCollide = true
	model.PrimaryPart = base
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 45
	cd.Parent = model
	return model
end

-- ===== الجزيرة =====
local function buildIsland(zone: Zones.ZoneDef, center: Vector3, size: number, parent: Folder, rng: Random): ZoneLayout
	local half = size / 2
	local folder = Instance.new("Folder")
	folder.Name = "Zone_" .. zone.Id
	folder.Parent = parent

	local ground = part(folder, "Ground", Vector3.new(size, 12, size), CFrame.new(center + Vector3.new(0, -6, 0)), zone.Ground, zone.Material)
	ground:SetAttribute("Zone", zone.Index)
	-- حواف الجزيرة
	local rim = part(folder, "Rim", Vector3.new(size + 6, 6, size + 6), CFrame.new(center + Vector3.new(0, -9, 0)), zone.Accent, Enum.Material.Slate)
	rim.CanCollide = false
	part(folder, "Underside", Vector3.new(size * 0.8, 30, size * 0.8), CFrame.new(center + Vector3.new(0, -27, 0)), Color3.fromRGB(80, 60, 50), Enum.Material.Slate)

	-- الزينة على الأطراف
	local decorFn = DECOR[zone.Decor] or DECOR.trees
	local step = 24
	local function reserved(x: number, z: number): boolean
		return zone.Index == 1 and z < -100 and x < -55 and x > -125
	end
	for x = -half + 14, half - 14, step do
		for _, z in ipairs({ -half + 14, half - 14 }) do
			if math.abs(x) > 24 and not reserved(x, z) then
				decorFn(folder, center + Vector3.new(x + rng:NextNumber(-4, 4), 0, z + rng:NextNumber(-4, 4)), rng)
			end
		end
	end
	for z = -half + 14 + step, half - 14 - step, step do
		for _, x in ipairs({ -half + 14, half - 14 }) do
			decorFn(folder, center + Vector3.new(x + rng:NextNumber(-4, 4), 0, z + rng:NextNumber(-4, 4)), rng)
		end
	end

	-- نقاط الصناديق
	local spots = {}
	local xMin, xMax = -half * 0.4, half * 0.62
	local zMin, zMax = -half * 0.72, half * 0.64
	for x = xMin, xMax, 24 do
		for z = zMin, zMax, 24 do
			table.insert(spots, center + Vector3.new(x + rng:NextNumber(-5, 5), 0, z + rng:NextNumber(-5, 5)))
		end
	end
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end

	-- البيض
	local eggs = {}
	local eggList = Eggs.ForZone(zone.Index)
	for _, egg in ipairs(eggList) do
		local pos = center + Vector3.new(-half * 0.72, 0, -40 + (egg.Slot - 1) * 40)
		buildEgg(folder, egg, pos)
		eggs[egg.Id] = pos
	end

	-- لافتة اسم المنطقة
	part(folder, "SignPost", Vector3.new(1, 8, 1), CFrame.new(center + Vector3.new(24, 4, -half * 0.8)), Color3.fromRGB(120, 80, 40), Enum.Material.Wood)
	local sign = part(folder, "Sign", Vector3.new(12, 5, 0.6), CFrame.new(center + Vector3.new(24, 9, -half * 0.8)), Color3.fromRGB(240, 220, 170), Enum.Material.Wood)
	billboard(sign, zone.Name .. "\n" .. zone.Arabic, UDim2.fromScale(14, 5), Color3.new(1, 1, 1), 1)

	local spawn = center + Vector3.new(0, 0, -half * 0.78)

	return {
		Index = zone.Index,
		Center = center,
		Spawn = spawn,
		Spots = spots,
		Eggs = eggs,
		Gate = nil,
		Folder = folder,
	}
end

local function buildBridgeAndGate(fromLayout: ZoneLayout, toZone: Zones.ZoneDef, parent: Folder)
	local half = ISLAND / 2
	local c = fromLayout.Center
	local bridge = part(parent, "Bridge", Vector3.new(26, 2, BRIDGE + 6), CFrame.new(c + Vector3.new(0, -1, half + BRIDGE / 2)), Color3.fromRGB(170, 130, 90), Enum.Material.WoodPlanks)
	bridge:SetAttribute("Zone", toZone.Index)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "Rail", Vector3.new(1, 3, BRIDGE + 6), CFrame.new(c + Vector3.new(s * 12.5, 1.5, half + BRIDGE / 2)), Color3.fromRGB(120, 85, 50), Enum.Material.Wood).CanCollide = false
	end
	local gate = part(parent, "Gate", Vector3.new(26, 14, 2), CFrame.new(c + Vector3.new(0, 7, half - 2)), toZone.Accent, Enum.Material.ForceField)
	gate.Transparency = 0.3
	gate:SetAttribute("Zone", toZone.Index)
	gate:SetAttribute("Cost", toZone.Cost)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "Pillar", Vector3.new(3, 16, 3), CFrame.new(c + Vector3.new(s * 14.5, 8, half - 2)), Color3.fromRGB(90, 90, 100), Enum.Material.Marble)
	end
	part(parent, "Arch", Vector3.new(32, 3, 3), CFrame.new(c + Vector3.new(0, 16.5, half - 2)), Color3.fromRGB(90, 90, 100), Enum.Material.Marble)
	billboard(gate, "🔒 " .. toZone.Name .. "\n💰 " .. Format.Number(toZone.Cost), UDim2.fromScale(16, 5), Color3.new(1, 1, 1), 10)
	return gate
end

local function buildPortal(parent: Instance, pos: Vector3, color: Color3, label: string): BasePart
	local model = Instance.new("Model")
	model.Name = "Portal"
	for _, s in ipairs({ -1, 1 }) do
		part(model, "Pillar", Vector3.new(2, 12, 2), CFrame.new(pos + Vector3.new(s * 5, 6, 0)), color, Enum.Material.Metal)
	end
	part(model, "Top", Vector3.new(12, 2, 2), CFrame.new(pos + Vector3.new(0, 12.5, 0)), color, Enum.Material.Metal)
	local field = part(model, "Field", Vector3.new(8, 11, 0.6), CFrame.new(pos + Vector3.new(0, 5.5, 0)), color, Enum.Material.Neon)
	field.Transparency = 0.45
	field.CanCollide = false
	billboard(field, label, UDim2.fromScale(14, 4), color, 9)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 20
	light.Brightness = 2
	light.Parent = field
	model.Parent = parent
	return field
end

local function buildBoard(parent: Instance, pos: Vector3, title: string, color: Color3): TextLabel
	local rot = CFrame.Angles(0, -math.pi / 2, 0) -- الوجه الأيمن يشير إلى +Z
	local board = part(parent, "Board", Vector3.new(1, 16, 22), CFrame.new(pos + Vector3.new(0, 9, 0)) * rot, Color3.fromRGB(30, 30, 40), Enum.Material.Metal)
	part(parent, "BoardFrame", Vector3.new(1.4, 17, 23), CFrame.new(pos + Vector3.new(0, 9, -0.1)) * rot, color, Enum.Material.Neon).CanCollide = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 0.15, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = color
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Size = UDim2.new(0.94, 0, 0.83, 0)
	list.Position = UDim2.new(0.03, 0, 0.16, 0)
	list.BackgroundTransparency = 1
	list.Text = "..."
	list.TextColor3 = Color3.new(1, 1, 1)
	list.Font = Enum.Font.FredokaOne
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Parent = gui
	gui.Parent = board
	return list
end

local function setupLighting()
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.Ambient = Color3.fromRGB(120, 120, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.32
		atm.Offset = 0.25
		atm.Color = Color3.fromRGB(199, 199, 210)
		atm.Decay = Color3.fromRGB(106, 112, 125)
		atm.Glare = 0.2
		atm.Haze = 1
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.2
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Saturation = 0.15
		cc.Contrast = 0.05
		cc.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local sun = Instance.new("SunRaysEffect")
		sun.Intensity = 0.08
		sun.Parent = Lighting
	end
end

function MapBuilder.ZoneOfPosition(pos: Vector3): number
	local vipCenter = Config.Map.VIPOffset
	if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(vipCenter.X, 0, vipCenter.Z)).Magnitude < 220 then
		return 0
	end
	local w2 = Config.Map.World2Offset
	if pos.X > w2.X - 500 then
		local idx = Zones.World2Start + math.floor((pos.Z - w2.Z) / SPACING + 0.5)
		return math.clamp(idx, Zones.World2Start, #Zones.List)
	end
	local idx = math.floor(pos.Z / SPACING + 0.5) + 1
	return math.clamp(idx, 1, Zones.World2Start - 1)
end

local function buildStall(parent: Instance, pos: Vector3, kind: string, title: string, color: Color3): Model
	local model = Instance.new("Model")
	model.Name = kind .. "Stall"
	model:SetAttribute("Machine", kind)
	local base = part(model, "Base", Vector3.new(10, 1, 8), CFrame.new(pos + Vector3.new(0, 0.5, 0)), Color3.fromRGB(120, 80, 50), Enum.Material.WoodPlanks)
	part(model, "Counter", Vector3.new(8, 3, 2), CFrame.new(pos + Vector3.new(0, 2.5, -2.5)), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
	for _, s in ipairs({ -1, 1 }) do
		part(model, "Pole", Vector3.new(0.6, 9, 0.6), CFrame.new(pos + Vector3.new(s * 4.5, 5, 3)), Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
	end
	local roof = part(model, "Roof", Vector3.new(11, 0.6, 9), CFrame.new(pos + Vector3.new(0, 9.5, 0)) * CFrame.Angles(0.12, 0, 0), color, Enum.Material.Fabric)
	roof.CanCollide = false
	for i = 0, 4 do
		local stripe = part(model, "Stripe", Vector3.new(1.4, 0.7, 9.2), CFrame.new(pos + Vector3.new(-4.4 + i * 2.2, 9.55, 0)) * CFrame.Angles(0.12, 0, 0), Color3.new(1, 1, 1), Enum.Material.Fabric)
		stripe.CanCollide = false
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	billboard(base, title, UDim2.fromScale(14, 4), color, 12)
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

local function buildWheel(parent: Instance, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "SpinWheel"
	model:SetAttribute("Machine", "Spin")
	local stand = part(model, "Stand", Vector3.new(2, 8, 2), CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
	local wheel = part(model, "Wheel", Vector3.new(1, 12, 12), CFrame.new(pos + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic, "cyl")
	wheel.CanCollide = false
	local colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 255, 120), Color3.fromRGB(200, 100, 255), Color3.fromRGB(255, 150, 60), Color3.fromRGB(80, 255, 220), Color3.fromRGB(255, 120, 200) }
	for i = 1, 8 do
		local ang = (i / 8) * math.pi * 2
		local seg = part(model, "Segment", Vector3.new(1.2, 3, 3), CFrame.new(pos + Vector3.new(0, 9 + math.sin(ang) * 4, math.cos(ang) * 4)), colors[i], Enum.Material.Neon, "ball")
		seg.CanCollide = false
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "لف"
	prompt.ObjectText = "عجلة الحظ"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = stand
	billboard(wheel, "🎡 عجلة الحظ\nلفة مجانية كل يوم", UDim2.fromScale(14, 4), Color3.fromRGB(255, 220, 60), 8)
	model.PrimaryPart = stand
	model.Parent = parent
	return model
end

local function buildAltar(parent: Instance, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "RebirthAltar"
	model:SetAttribute("Machine", "Rebirth")
	local base = part(model, "Base", Vector3.new(1.5, 14, 14), CFrame.new(pos + Vector3.new(0, 0.75, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 40, 40), Enum.Material.Marble, "cyl")
	for i = 1, 6 do
		local ang = i / 6 * math.pi * 2
		part(model, "Pillar", Vector3.new(1.5, 9, 1.5), CFrame.new(pos + Vector3.new(math.cos(ang) * 6, 5, math.sin(ang) * 6)), Color3.fromRGB(90, 70, 70), Enum.Material.Marble)
	end
	local core = part(model, "Core", Vector3.new(4, 4, 4), CFrame.new(pos + Vector3.new(0, 6, 0)), Color3.fromRGB(255, 120, 40), Enum.Material.Neon, "ball")
	core.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 24
	light.Brightness = 2
	light.Parent = core
	local fire = Instance.new("Fire")
	fire.Size = 8
	fire.Heat = 12
	fire.Parent = core
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = "مذبح الريبيرث"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	billboard(core, "🔁 Rebirth\nمذبح الريبيرث", UDim2.fromScale(14, 4), Color3.fromRGB(255, 140, 60), 6)
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

local function buildLamp(parent: Instance, pos: Vector3)
	part(parent, "LampPost", Vector3.new(0.6, 9, 0.6), CFrame.new(pos + Vector3.new(0, 4.5, 0)), Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
	local bulb = part(parent, "Bulb", Vector3.new(1.6, 1.6, 1.6), CFrame.new(pos + Vector3.new(0, 9.5, 0)), Color3.fromRGB(255, 240, 180), Enum.Material.Neon, "ball")
	bulb.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 240, 180)
	light.Range = 22
	light.Brightness = 1.2
	light.Parent = bulb
end

local function buildFountain(parent: Instance, pos: Vector3)
	local basin = part(parent, "Basin", Vector3.new(2, 16, 16), CFrame.new(pos + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 200, 210), Enum.Material.Marble, "cyl")
	local water = part(parent, "Water", Vector3.new(0.6, 14, 14), CFrame.new(pos + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(80, 170, 255), Enum.Material.Glass, "cyl")
	water.Transparency = 0.4
	water.CanCollide = false
	part(parent, "Column", Vector3.new(2, 6, 2), CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.fromRGB(200, 200, 210), Enum.Material.Marble)
	local top = part(parent, "Top", Vector3.new(0.8, 6, 6), CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 200, 210), Enum.Material.Marble, "cyl")
	local attach = Instance.new("Attachment")
	attach.Position = Vector3.new(0, 0.5, 0)
	attach.Parent = top
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(150, 210, 255))
	pe.Size = NumberSequence.new(0.6, 0.2)
	pe.Transparency = NumberSequence.new(0.3, 1)
	pe.Lifetime = NumberRange.new(0.8, 1.4)
	pe.Rate = 40
	pe.Speed = NumberRange.new(10, 14)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, -30, 0)
	pe.Parent = attach
	basin.CanCollide = true
end

local function buildBench(parent: Instance, pos: Vector3, rot: number)
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	part(parent, "Seat", Vector3.new(6, 0.5, 2), cf * CFrame.new(0, 1.5, 0), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
	part(parent, "Back", Vector3.new(6, 2, 0.4), cf * CFrame.new(0, 2.7, 0.9), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "Leg", Vector3.new(0.5, 1.4, 1.8), cf * CFrame.new(s * 2.5, 0.7, 0), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
	end
end

function MapBuilder.Build()
	setupLighting()
	local existing = Workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	local rng = Random.new(2024)

	-- المناطق (عالم 1 و 2)
	local w2 = Config.Map.World2Offset
	for i, zone in ipairs(Zones.List) do
		local center
		if zone.World == 2 then
			center = w2 + Vector3.new(0, 0, (i - Zones.World2Start) * SPACING)
		else
			center = Vector3.new(0, 0, (i - 1) * SPACING)
		end
		local layout = buildIsland(zone, center, ISLAND, map, rng)
		MapBuilder.Zones[i] = layout
		local prevZone = Zones.List[i - 1]
		if prevZone and prevZone.World == zone.World then
			local prev = MapBuilder.Zones[i - 1]
			layout.Gate = buildBridgeAndGate(prev, zone, prev.Folder)
		end
	end

	-- بوابة العالم الثاني (في الفراغ) وبوابة العودة (في مركز التقنية)
	local void = MapBuilder.Zones[Zones.World2Start - 1]
	local hub = MapBuilder.Zones[Zones.World2Start]
	MapBuilder.World2Portal = buildPortal(void.Folder, void.Center + Vector3.new(0, 0, ISLAND / 2 - 8), Color3.fromRGB(0, 255, 255), "🌐 Tech World\nيتطلب ريبيرث + 💰 " .. Format.Number(Zones.List[Zones.World2Start].Cost))
	MapBuilder.World2Portal:SetAttribute("Portal", "World2")
	MapBuilder.World1Portal = buildPortal(hub.Folder, hub.Center + Vector3.new(0, 0, -ISLAND / 2 + 30), Color3.fromRGB(120, 200, 255), "🏠 العودة للعالم الأول")
	MapBuilder.World1Portal:SetAttribute("Portal", "World1")

	-- منطقة VIP
	local vipCenter = Config.Map.VIPOffset
	local vipLayout = buildIsland(Zones.VIP, vipCenter, 200, map, rng)
	MapBuilder.Zones[0] = vipLayout
	MapBuilder.VIPReturnPortal = buildPortal(vipLayout.Folder, vipCenter + Vector3.new(0, 0, -70), Color3.fromRGB(120, 200, 255), "🏠 العودة للبلدة")
	MapBuilder.VIPReturnPortal:SetAttribute("Portal", "Return")

	-- البلدة
	local town = MapBuilder.Zones[1]
	local tf = town.Folder
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(14, 1, 14)
	spawnLoc.CFrame = CFrame.new(town.Spawn + Vector3.new(0, 0.5, 0))
	spawnLoc.Anchored = true
	spawnLoc.Color = Color3.fromRGB(255, 255, 255)
	spawnLoc.Material = Enum.Material.Marble
	spawnLoc.TopSurface = Enum.SurfaceType.Smooth
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Parent = tf

	for i, info in ipairs(MACHINE_INFO) do
		local pos = town.Center + Vector3.new(118, 0, -118 + (i - 1) * 32)
		MapBuilder.Machines[info.Kind] = buildMachine(tf, info, pos)
	end

	MapBuilder.Specials.GiantChest = town.Center + Vector3.new(60, 0, 118)
	MapBuilder.Specials.MysteryBox = town.Center + Vector3.new(-60, 0, 118)
	MapBuilder.Specials.BossArena = town.Center + Vector3.new(-100, 0, 96)

	MapBuilder.VIPPortal = buildPortal(tf, town.Center + Vector3.new(-118, 0, -112), Color3.fromRGB(255, 215, 0), "👑 VIP Lounge")
	MapBuilder.VIPPortal:SetAttribute("Portal", "VIP")

	-- الأكشاك والعجلة والمذبح والنافورة
	MapBuilder.Machines.Merchant = buildStall(tf, town.Center + Vector3.new(-62, 0, -116), "Merchant", "🧳 التاجر المتجول", Color3.fromRGB(200, 60, 60))
	MapBuilder.Machines.Trade = buildStall(tf, town.Center + Vector3.new(62, 0, -116), "Trade", "🤝 ساحة التبادل", Color3.fromRGB(60, 120, 220))
	MapBuilder.Machines.Spin = buildWheel(tf, town.Center + Vector3.new(-30, 0, -124))
	MapBuilder.Machines.Rebirth = buildAltar(tf, town.Center + Vector3.new(118, 0, 60))
	buildFountain(tf, town.Center + Vector3.new(0, 0, -60))
	for _, off in ipairs({ Vector3.new(-16, 0, -80), Vector3.new(16, 0, -80), Vector3.new(-16, 0, -40), Vector3.new(16, 0, -40), Vector3.new(-40, 0, -100), Vector3.new(40, 0, -100) }) do
		buildLamp(tf, town.Center + off)
	end
	buildBench(tf, town.Center + Vector3.new(-14, 0, -60), math.pi / 2)
	buildBench(tf, town.Center + Vector3.new(14, 0, -60), -math.pi / 2)

	MapBuilder.Boards.Coins = buildBoard(tf, town.Center + Vector3.new(-72, 0, -142), "💰 أغنى اللاعبين", Color3.fromRGB(255, 200, 40))
	MapBuilder.Boards.Hatches = buildBoard(tf, town.Center + Vector3.new(-104, 0, -142), "🥚 أكثر فتحاً للبيض", Color3.fromRGB(120, 200, 255))
	MapBuilder.Boards.Rebirths = buildBoard(vipLayout.Folder, vipCenter + Vector3.new(-40, 0, -95), "🔁 أكثر ريبيرث", Color3.fromRGB(255, 140, 60))
	MapBuilder.Boards.Damage = buildBoard(vipLayout.Folder, vipCenter + Vector3.new(40, 0, -95), "⚔️ أعلى ضرر", Color3.fromRGB(255, 90, 120))

	-- أرضية الموت تحت الجزر
	local kill = part(map, "KillPlane", Vector3.new(4000, 1, 8000), CFrame.new(300, -120, 2000), Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic)
	kill.Transparency = 1
	kill.CanCollide = false
	kill.Touched:Connect(function(hit)
		local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		end
	end)
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000026"><Properties><string name="Name">MerchantService</string><ProtectedString name="Source"><![CDATA[--!strict
-- التاجر المتجول: مخزون يتغير كل ساعة، حدود شراء لكل لاعب
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MerchantStock = require(Shared.Modules.MerchantStock)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local RateLimit = require(script.Parent.RateLimit)

local MerchantService = {}

function MerchantService.Buy(player: Player, slot: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Merchant", 5) then
		return { ok = false, error = "ببطء!" }
	end
	local rotation = MerchantStock.RotationId(os.time())
	if p.Merchant.Rotation ~= rotation then
		p.Merchant = { Rotation = rotation, Bought = {} }
	end
	local stock = MerchantStock.Stock(rotation)
	local item = stock[slot]
	if not item then
		return { ok = false, error = "عنصر غير موجود" }
	end
	local k = tostring(item.PoolIndex)
	if (p.Merchant.Bought[k] or 0) >= item.Limit then
		return { ok = false, error = "وصلت لحد الشراء لهذا العنصر" }
	end
	if not DataService.Spend(player, "Diamonds", item.Cost) then
		return { ok = false, error = "تحتاج 💎 " .. item.Cost }
	end
	p.Merchant.Bought[k] = (p.Merchant.Bought[k] or 0) + 1
	if item.Type == "Potion" then
		Rewards.Grant(player, { Potion = item.Key })
	elseif item.Type == "Pet" then
		Rewards.Grant(player, { Pet = item.Key })
	elseif item.Type == "Spins" then
		Rewards.Grant(player, { Spins = tonumber(item.Key) or 1 })
	elseif item.Type == "Tokens" then
		Rewards.Grant(player, { Tokens = tonumber(item.Key) or 1 })
	end
	DataService.Notify(player, "🧳 اشتريت " .. item.Name, Color3.fromRGB(120, 255, 140))
	DataService.MarkDirty(player)
	return { ok = true }
end

function MerchantService.Init()
	Remotes.Function("Merchant").OnServerInvoke = function(player, slot)
		return MerchantService.Buy(player, math.floor(tonumber(slot) or 0))
	end
end

return MerchantService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المهام اليومية + الإنجازات + الدليل التعليمي
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local RateLimit = require(script.Parent.RateLimit)

local MissionService = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function maxZone(p: DataService.Profile): number
	local best = 1
	for k in pairs(p.UnlockedZones) do
		best = math.max(best, tonumber(k) or 1)
	end
	return best
end

local function generate(player: Player, p: DataService.Profile)
	local day = today()
	if p.Missions.Day == day and #p.Missions.List > 0 then
		return
	end
	local rng = Random.new(day * 1000 + (player.UserId % 1000))
	local pool = table.clone(Config.Missions.Pool)
	local tierIdx = math.clamp(1 + math.floor(maxZone(p) / 5) + math.min(p.Rebirths, 1), 1, 3)
	local list = {}
	for _ = 1, math.min(Config.Missions.PerDay, #pool) do
		local idx = rng:NextInteger(1, #pool)
		local m = pool[idx]
		table.remove(pool, idx)
		table.insert(list, { Type = m.Type, Name = m.Name, Target = m.Targets[tierIdx], Progress = 0, Claimed = false, Reward = m.Reward })
	end
	p.Missions = { Day = day, List = list }
	DataService.MarkDirty(player)
end

local function onHook(player: Player, kind: string, amount: number)
	local p = DataService.Get(player)
	if not p then
		return
	end
	generate(player, p)
	local changed = false
	for _, m in ipairs(p.Missions.List) do
		if m.Type == kind and not m.Claimed and m.Progress < m.Target then
			m.Progress = math.min(m.Target, m.Progress + amount)
			changed = true
		end
	end
	-- الدليل التعليمي
	local step = Config.Tutorial[p.Tutorial.Step]
	if step then
		if step.Type == kind and step.Type ~= "Zone" then
			p.Tutorial.Progress = math.min(step.Target, p.Tutorial.Progress + amount)
			changed = true
		elseif step.Type == "Zone" and kind == "Zone" then
			if amount >= step.Target then
				p.Tutorial.Progress = step.Target
				changed = true
			end
		end
	end
	if changed then
		DataService.MarkDirty(player)
	end
end

function MissionService.ClaimMission(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local m = p.Missions.List[index]
	if not m then
		return { ok = false, error = "مهمة غير موجودة" }
	end
	if m.Claimed then
		return { ok = false, error = "تم الاستلام" }
	end
	if m.Progress < m.Target then
		return { ok = false, error = "لم تكتمل بعد" }
	end
	m.Claimed = true
	Rewards.Grant(player, m.Reward)
	DataService.Notify(player, "✅ مهمة مكتملة: " .. Rewards.Describe(m.Reward), Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function MissionService.ClaimAchievement(player: Player, id: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if p.Achievements[id] then
		return { ok = false, error = "تم الاستلام" }
	end
	for _, a in ipairs(Config.Achievements) do
		if a.Id == id then
			if (p.Stats[a.Stat] or 0) < a.Target then
				return { ok = false, error = "لم يكتمل بعد" }
			end
			p.Achievements[id] = true
			Rewards.Grant(player, a.Reward)
			DataService.Notify(player, "🏅 إنجاز: " .. a.Name .. " — " .. Rewards.Describe(a.Reward), Color3.fromRGB(255, 200, 40))
			return { ok = true }
		end
	end
	return { ok = false, error = "إنجاز غير موجود" }
end

function MissionService.ClaimTutorial(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local step = Config.Tutorial[p.Tutorial.Step]
	if not step then
		return { ok = false, error = "أكملت الدليل" }
	end
	if step.Type == "Zone" then
		if not p.UnlockedZones[tostring(step.Target)] then
			return { ok = false, error = "لم تكتمل بعد" }
		end
	elseif p.Tutorial.Progress < step.Target then
		return { ok = false, error = "لم تكتمل بعد" }
	end
	Rewards.Grant(player, step.Reward)
	DataService.Notify(player, "🎓 " .. Rewards.Describe(step.Reward), Color3.fromRGB(120, 200, 255))
	p.Tutorial.Step += 1
	p.Tutorial.Progress = 0
	DataService.MarkDirty(player)
	return { ok = true }
end

function MissionService.Init()
	Hooks.Listen(onHook)
	DataService.Loaded:Connect(function(player, profile)
		generate(player, profile)
	end)
	Remotes.Function("ClaimMission").OnServerInvoke = function(player, index)
		if not RateLimit.Check(player, "Claim", 5) then
			return { ok = false, error = "ببطء!" }
		end
		return MissionService.ClaimMission(player, math.floor(tonumber(index) or 0))
	end
	Remotes.Function("ClaimAchievement").OnServerInvoke = function(player, id)
		if not RateLimit.Check(player, "Claim", 5) then
			return { ok = false, error = "ببطء!" }
		end
		return MissionService.ClaimAchievement(player, tostring(id))
	end
	Remotes.Function("ClaimTutorial").OnServerInvoke = function(player)
		return MissionService.ClaimTutorial(player)
	end
	-- تجديد المهام عند تغير اليوم
	task.spawn(function()
		local Players = game:GetService("Players")
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local p = DataService.Get(player)
				if p then
					generate(player, p)
				end
			end
		end
	end)
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المخزن، التجهيز، الحذف، القفل، المستويات/الخبرة، الإنشانتات، والآلات
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Eggs = require(Shared.Data.Eggs)
local PetUtil = require(Shared.Modules.PetUtil)
local Luck = require(Shared.Modules.Luck)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)
local Hooks = require(script.Parent.Hooks)

local PetService = {}

type PetInstance = PetUtil.PetInstance

local rng = Random.new()
local fire = Hooks.Fire

function PetService.StorageCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseStorage + (p.Upgrades.Storage or 0) * 25
	if DataService.HasGamepass(player, "PlusStorage") then
		cap += Config.GamepassStorageBonus
	end
	return cap
end

function PetService.EquipCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseEquip + (p.Upgrades.Equip or 0)
	if DataService.HasGamepass(player, "PlusEquip") then
		cap += Config.GamepassEquipBonus
	end
	return cap
end

function PetService.FreeSlots(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	return PetService.StorageCapacity(player) - #p.Pets
end

local function find(p: DataService.Profile, uid: string): (PetInstance?, number?)
	for i, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end
PetService.Find = find

local function equippedCount(p: DataService.Profile): number
	local n = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			n += 1
		end
	end
	return n
end

function PetService.Equipped(player: Player): { PetInstance }
	local p = DataService.Get(player)
	local out = {}
	if p then
		for _, pet in ipairs(p.Pets) do
			if pet.Equipped then
				table.insert(out, pet)
			end
		end
	end
	return out
end

function PetService.UpdateEquippedAttribute(player: Player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local list = {}
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			table.insert(list, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant })
		end
	end
	player:SetAttribute("EquippedPets", HttpService:JSONEncode(list))
	player:SetAttribute("TotalPower", PetService.GetPower(player))
end

function PetService.GetPower(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local total = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			total += PetUtil.BasePower(pet)
		end
	end
	return total * DataService.DamageMultiplier(player)
end

function PetService.Add(player: Player, petId: string, variant: string?, ignoreCapacity: boolean?): PetInstance?
	local p = DataService.Get(player)
	local def = Pets.Get(petId)
	if not p or not def then
		return nil
	end
	if not ignoreCapacity and #p.Pets >= PetService.StorageCapacity(player) then
		return nil
	end
	local inst: PetInstance = {
		Uid = HttpService:GenerateGUID(false),
		Id = petId,
		Variant = variant or "Normal",
		Locked = false,
		Equipped = false,
		Time = os.time(),
		Level = 1,
		XP = 0,
		Enchants = {},
	}
	table.insert(p.Pets, inst)
	p.Index[petId] = true
	local power = PetUtil.BasePower(inst)
	if power > (p.Stats.BestPet or 0) then
		p.Stats.BestPet = power
	end
	if equippedCount(p) < PetService.EquipCapacity(player) then
		inst.Equipped = true
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return inst
end

local function remove(p: DataService.Profile, uid: string): PetInstance?
	local pet, idx = find(p, uid)
	if pet and idx then
		table.remove(p.Pets, idx)
	end
	return pet
end
PetService.Remove = remove

-- ===== الخبرة =====
function PetService.GrantXP(player: Player, amount: number)
	local p = DataService.Get(player)
	if not p or amount <= 0 then
		return
	end
	amount = amount * DataService.XPMultiplier(player)
	local changed = false
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped and (pet.Level or 1) < Config.PetMaxLevel then
			pet.XP = (pet.XP or 0) + amount
			local needed = PetUtil.XPToNext(pet.Level or 1)
			while pet.XP >= needed and pet.Level < Config.PetMaxLevel do
				pet.XP -= needed
				pet.Level += 1
				changed = true
				needed = PetUtil.XPToNext(pet.Level)
			end
			if pet.Level >= Config.PetMaxLevel then
				pet.XP = 0
			end
		end
	end
	DataService.MarkDirty(player)
	if changed then
		PetService.UpdateEquippedAttribute(player)
	end
end

-- ===== إجراءات المخزن =====
function PetService.Action(player: Player, action: string, payload: any): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "PetAction", 20) then
		return { ok = false, error = "ببطء!" }
	end
	payload = type(payload) == "table" and payload or {}

	if action == "Equip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		if pet.Equipped then
			return { ok = true }
		end
		if equippedCount(p) >= PetService.EquipCapacity(player) then
			return { ok = false, error = "وصلت للحد الأقصى من التجهيز" }
		end
		pet.Equipped = true
	elseif action == "Unequip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Equipped = false
	elseif action == "Lock" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Locked = not pet.Locked
	elseif action == "Delete" then
		local uids = payload.Uids or { payload.Uid }
		local n = 0
		for _, uid in ipairs(uids) do
			local pet = find(p, tostring(uid))
			if pet and not pet.Locked then
				remove(p, pet.Uid)
				n += 1
			end
		end
		if n == 0 then
			return { ok = false, error = "لا يمكن حذف حيوان مقفول" }
		end
	elseif action == "UnequipAll" then
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
	elseif action == "EquipBest" then
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		local cap = PetService.EquipCapacity(player)
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
		for i = 1, math.min(cap, #sorted) do
			sorted[i].Equipped = true
		end
	elseif action == "Setting" then
		local k = tostring(payload.Key)
		if p.Settings[k] == nil then
			return { ok = false, error = "إعداد غير معروف" }
		end
		if k == "AutoDeleteRank" then
			p.Settings[k] = math.clamp(math.floor(tonumber(payload.Value) or 0), 0, 4)
		else
			p.Settings[k] = payload.Value == true
		end
	else
		return { ok = false, error = "إجراء غير معروف" }
	end

	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return { ok = true }
end

-- ===== الآلات =====
local function collect(p: DataService.Profile, uids: any): { PetInstance }?
	if type(uids) ~= "table" then
		return nil
	end
	local out = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		uid = tostring(uid)
		if seen[uid] then
			return nil
		end
		seen[uid] = true
		local pet = find(p, uid)
		if not pet or pet.Locked then
			return nil
		end
		table.insert(out, pet)
	end
	return out
end

local function rollEnchant(): PetUtil.Enchant
	local totalW = 0
	for _, cfg in pairs(Config.Enchants) do
		totalW += cfg.Weight
	end
	local r = rng:NextNumber() * totalW
	local chosen = "Coins"
	for k, cfg in pairs(Config.Enchants) do
		r -= cfg.Weight
		if r <= 0 then
			chosen = k
			break
		end
	end
	local tw = 0
	for _, w in ipairs(Config.EnchantTierWeights) do
		tw += w
	end
	local r2 = rng:NextNumber() * tw
	local tier = 1
	for i, w in ipairs(Config.EnchantTierWeights) do
		r2 -= w
		if r2 <= 0 then
			tier = i
			break
		end
	end
	return { Type = chosen, Tier = tier }
end

function PetService.Machine(player: Player, kind: string, payload: any): { ok: boolean, error: string?, result: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Machine", 10) then
		return { ok = false, error = "ببطء!" }
	end
	payload = type(payload) == "table" and payload or {}

	if kind == "Golden" or kind == "Rainbow" then
		local need = Config.Machines[kind].Requires
		local fromVariant = kind == "Golden" and "Normal" or "Golden"
		local toVariant = kind == "Golden" and "Golden" or "Rainbow"
		local pets = collect(p, payload.Uids)
		if not pets or #pets ~= need then
			return { ok = false, error = "اختر " .. need .. " حيوانات (غير مقفولة)" }
		end
		local id = pets[1].Id
		local bestLevel = 1
		for _, pet in ipairs(pets) do
			if pet.Id ~= id or pet.Variant ~= fromVariant then
				return { ok = false, error = "يجب أن تكون نفس الحيوان ونفس النوع" }
			end
			bestLevel = math.max(bestLevel, pet.Level or 1)
		end
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local result = PetService.Add(player, id, toVariant, true) :: PetInstance
		result.Level = bestLevel
		if kind == "Golden" then
			p.Stats.Goldens += 1
			fire(player, "Golden", 1)
		else
			p.Stats.Rainbows += 1
		end
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true, result = result }
	elseif kind == "DarkMatterStart" then
		local pets = collect(p, { payload.Uid })
		if not pets or #pets ~= 1 or pets[1].Variant ~= "Rainbow" then
			return { ok = false, error = "اختر حيوان Rainbow واحد" }
		end
		local cost = Config.Machines.DarkMatter.CostDiamonds
		if not DataService.Spend(player, "Diamonds", cost) then
			return { ok = false, error = "تحتاج " .. cost .. " ألماسة" }
		end
		local pet = remove(p, pets[1].Uid) :: PetInstance
		table.insert(p.DarkMatter, { PetId = pet.Id, Level = pet.Level or 1, Ready = os.time() + Config.Machines.DarkMatter.Time })
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true }
	elseif kind == "DarkMatterClaim" then
		local idx = tonumber(payload.Index)
		local entry = idx and p.DarkMatter[idx]
		if not entry then
			return { ok = false, error = "غير موجود" }
		end
		if os.time() < entry.Ready then
			return { ok = false, error = "لم يجهز بعد" }
		end
		if PetService.FreeSlots(player) <= 0 then
			return { ok = false, error = "المخزن ممتلئ" }
		end
		table.remove(p.DarkMatter, idx :: number)
		local result = PetService.Add(player, entry.PetId, "DarkMatter") :: PetInstance
		result.Level = entry.Level or 1
		p.Stats.DarkMatters += 1
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	elseif kind == "Fuse" then
		local cfg = Config.Machines.Fuse
		local pets = collect(p, payload.Uids)
		if not pets or #pets < cfg.Min or #pets > cfg.Max then
			return { ok = false, error = "اختر من " .. cfg.Min .. " إلى " .. cfg.Max .. " حيوانات" }
		end
		local bestTier = 1
		local variant = pets[1].Variant
		local sameVariant = true
		for _, pet in ipairs(pets) do
			local def = Pets.Get(pet.Id)
			if def and def.Tier > bestTier and def.Tier <= 15 then
				bestTier = def.Tier
			end
			if pet.Variant ~= variant then
				sameVariant = false
			end
		end
		local upgradeChance = math.min(0.6, cfg.UpgradeChance * (#pets - 2))
		local targetTier = bestTier
		if rng:NextNumber() < upgradeChance then
			targetTier = math.min(15, bestTier + 1)
		end
		local function eggForTier(tier: number)
			for _, e in ipairs(Eggs.List) do
				if e.Zone == tier and e.Currency == "Coins" and not e.VIPOnly then
					return e
				end
			end
			return nil
		end
		local egg = eggForTier(targetTier) or eggForTier(bestTier) or Eggs.Get("StarterEgg")
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local petId = Luck.Roll((egg :: any).Id, 1.5, rng) or "cat"
		local result = PetService.Add(player, petId, sameVariant and variant or "Normal", true)
		p.Stats.Fusions += 1
		fire(player, "Fuse", 1)
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	elseif kind == "Enchant" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		local slot = math.floor(tonumber(payload.Slot) or 1)
		pet.Enchants = pet.Enchants or {}
		if slot < 1 or slot > PetUtil.EnchantSlots(pet) then
			return { ok = false, error = "خانة غير متاحة لهذا النوع" }
		end
		if slot > #pet.Enchants + 1 then
			return { ok = false, error = "املأ الخانة السابقة أولاً" }
		end
		local def = Pets.Get(pet.Id) :: Pets.PetDef
		local cost = Config.EnchantCostPerTier * math.min(def.Tier, 15)
		if not DataService.Spend(player, "Diamonds", cost) then
			return { ok = false, error = "تحتاج 💎 " .. cost }
		end
		pet.Enchants = pet.Enchants or {}
		pet.Enchants[slot] = rollEnchant()
		p.Stats.Enchants += 1
		fire(player, "Enchant", 1)
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true, result = pet.Enchants[slot] }
	end
	return { ok = false, error = "آلة غير معروفة" }
end

function PetService.Init()
	Remotes.Function("PetAction").OnServerInvoke = function(player, action, payload)
		return PetService.Action(player, tostring(action), payload)
	end
	Remotes.Function("Machine").OnServerInvoke = function(player, kind, payload)
		return PetService.Machine(player, tostring(kind), payload)
	end
	DataService.Loaded:Connect(function(player)
		PetService.UpdateEquippedAttribute(player)
	end)
	table.insert(DataService.Extenders, function(player, payload)
		payload.StorageCap = PetService.StorageCapacity(player)
		payload.EquipCap = PetService.EquipCapacity(player)
		payload.Power = PetService.GetPower(player)
		payload.Enchants = PetUtil.EnchantBonuses(payload.Pets)
	end)
	table.insert(DataService.BonusProviders, function(player)
		local p = DataService.Get(player)
		if not p then
			return nil
		end
		return PetUtil.EnchantBonuses(p.Pets)
	end)
end

return PetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!strict
-- حد المعدل لكل لاعب لكل مفتاح (حماية من الإرسال المفرط)
local Players = game:GetService("Players")

local RateLimit = {}
local buckets: { [Player]: { [string]: { Count: number, Reset: number } } } = {}

function RateLimit.Check(player: Player, key: string, maxPerWindow: number, window: number?): boolean
	window = window or 1
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = {}
		buckets[player] = b
	end
	local e = b[key]
	if not e or now >= e.Reset then
		e = { Count = 0, Reset = now + (window :: number) }
		b[key] = e
	end
	e.Count += 1
	return e.Count <= maxPerWindow
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الريبيرث: إعادة العملات والمناطق مقابل مضاعفات دائمة + توكنات
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local ZoneService = require(script.Parent.ZoneService)

local RebirthService = {}

function RebirthService.Cost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * (Config.Rebirth.CostMult ^ rebirths))
end

function RebirthService.Rebirth(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not p.UnlockedZones[tostring(Config.Rebirth.RequiredZone)] then
		return { ok = false, error = "افتح المنطقة " .. Config.Rebirth.RequiredZone .. " أولاً" }
	end
	local cost = RebirthService.Cost(p.Rebirths)
	if p.Coins < cost then
		return { ok = false, error = "تحتاج 💰 " .. Format.Number(cost) }
	end
	p.Coins = 0
	for i = 2, 10 do
		p.UnlockedZones[tostring(i)] = nil
	end
	p.Rebirths += 1
	p.Stats.Rebirths += 1
	p.Tokens += Config.Rebirth.TokensPerRebirth
	p.LastZone = 1
	DataService.MarkDirty(player)
	ZoneService.Teleport(player, 1)
	DataService.NotifyAll("🔁 " .. player.Name .. " قام بالريبيرث رقم " .. p.Rebirths .. "!", Color3.fromRGB(255, 120, 60))
	return { ok = true }
end

function RebirthService.Init()
	Remotes.Function("Rebirth").OnServerInvoke = function(player)
		return RebirthService.Rebirth(player)
	end
	table.insert(DataService.Extenders, function(player, payload)
		payload.RebirthCost = RebirthService.Cost(payload.Rebirths or 0)
	end)
end

return RebirthService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المكافآت اليومية، مكافآت وقت اللعب، الأكواد، مكافأة المجموعة
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)

local RewardService = {}

local DAY = 20 * 3600 -- يمكن الاستلام كل 20 ساعة
local RESET = 48 * 3600

local grant = Rewards.Grant

function RewardService.ClaimDaily(player: Player): { ok: boolean, error: string?, reward: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local now = os.time()
	local since = now - (p.Daily.LastClaim or 0)
	if since < DAY then
		return { ok = false, error = "عد بعد " .. math.ceil((DAY - since) / 3600) .. " ساعة" }
	end
	if since > RESET then
		p.Daily.Streak = 0
	end
	p.Daily.Streak += 1
	p.Daily.LastClaim = now
	local idx = ((p.Daily.Streak - 1) % #Config.DailyRewards) + 1
	local reward = Config.DailyRewards[idx]
	grant(player, reward)
	DataService.Notify(player, "🎁 مكافأة اليوم " .. idx .. " استلمتها!", Color3.fromRGB(255, 200, 80))
	return { ok = true, reward = reward }
end

function RewardService.ClaimPlaytime(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local reward = Config.PlaytimeRewards[index]
	if not p or not reward then
		return { ok = false, error = "غير موجود" }
	end
	if p.PlaytimeClaimed[tostring(index)] then
		return { ok = false, error = "تم الاستلام" }
	end
	local elapsed = os.time() - p.SessionStart
	if elapsed < reward.Minutes * 60 then
		return { ok = false, error = "لم يحن الوقت بعد" }
	end
	p.PlaytimeClaimed[tostring(index)] = true
	grant(player, reward)
	DataService.Notify(player, "⏱️ استلمت مكافأة " .. reward.Minutes .. " دقيقة!", Color3.fromRGB(120, 255, 200))
	return { ok = true }
end

function RewardService.RedeemCode(player: Player, code: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	code = string.upper((tostring(code):gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, error = "كود غير صحيح" }
	end
	if p.Codes[code] then
		return { ok = false, error = "استخدمت هذا الكود من قبل" }
	end
	p.Codes[code] = true
	grant(player, reward)
	DataService.Notify(player, "🔑 تم تفعيل الكود " .. code .. "!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function RewardService.ClaimVIPDaily(player: Player): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not DataService.HasGamepass(player, "VIP") then
		return { ok = false, error = "لأعضاء VIP فقط" }
	end
	local day = math.floor(os.time() / 86400)
	if p.VIPDaily == day then
		return { ok = false, error = "استلمت صندوق اليوم" }
	end
	p.VIPDaily = day
	grant(player, { Diamonds = Config.VIPDailyDiamonds })
	DataService.Notify(player, "👑 صندوق VIP اليومي: 💎 " .. Config.VIPDailyDiamonds, Color3.fromRGB(255, 215, 0))
	return { ok = true }
end

function RewardService.Init()
	Remotes.Function("ClaimDaily").OnServerInvoke = function(player)
		return RewardService.ClaimDaily(player)
	end
	Remotes.Function("ClaimVIPDaily").OnServerInvoke = function(player)
		return RewardService.ClaimVIPDaily(player)
	end
	Remotes.Function("ClaimPlaytime").OnServerInvoke = function(player, index)
		return RewardService.ClaimPlaytime(player, tonumber(index) or 0)
	end
	Remotes.Function("RedeemCode").OnServerInvoke = function(player, code)
		return RewardService.RedeemCode(player, tostring(code))
	end
	Remotes.Function("GetServerTime").OnServerInvoke = function()
		return os.time()
	end
	DataService.Loaded:Connect(function(player, profile)
		if Config.GroupId > 0 then
			local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
			if ok and inGroup then
				profile.InGroup = true
				DataService.MarkDirty(player)
			end
		end
	end)
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!strict
-- منح المكافآت بصيغة موحدة { Coins, Diamonds, Potion, Count, Pet, Variant, Spins, Tokens }
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local Rewards = {}

function Rewards.Grant(player: Player, reward: any, coinScale: number?)
	if type(reward) ~= "table" then
		return
	end
	if reward.Coins then
		DataService.AddCoins(player, math.floor(reward.Coins * (coinScale or 1)))
	end
	if reward.Diamonds then
		DataService.AddDiamonds(player, reward.Diamonds)
	end
	if reward.Potion then
		DataService.GivePotion(player, reward.Potion, reward.Count or 1)
	end
	if reward.Pet then
		PetService.Add(player, reward.Pet, reward.Variant or "Normal", true)
	end
	if reward.Spins then
		DataService.AddSpins(player, reward.Spins)
	end
	if reward.Tokens then
		DataService.AddTokens(player, reward.Tokens)
	end
	DataService.MarkDirty(player)
end

function Rewards.Describe(reward: any, coinScale: number?): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, "💰 " .. Format.Number(reward.Coins * (coinScale or 1)))
	end
	if reward.Diamonds then
		table.insert(parts, "💎 " .. Format.Number(reward.Diamonds))
	end
	if reward.Potion then
		table.insert(parts, "🧪 " .. reward.Potion .. (reward.Count and (" x" .. reward.Count) or ""))
	end
	if reward.Pet then
		table.insert(parts, "🐾 " .. reward.Pet)
	end
	if reward.Spins then
		table.insert(parts, "🎡 " .. reward.Spins)
	end
	if reward.Tokens then
		table.insert(parts, "🔁 " .. reward.Tokens)
	end
	return table.concat(parts, "  ")
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الجيم باس، المنتجات (الألماس/الجرعات)، الترقيات
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local ZoneService = require(script.Parent.ZoneService)

local ShopService = {}

local function gamepassKeyFromId(id: number): string?
	for key, gid in pairs(Config.Gamepasses) do
		if gid == id and gid > 0 then
			return key
		end
	end
	return nil
end

local function productKeyFromId(id: number): string?
	for key, pid in pairs(Config.DevProducts) do
		if pid == id and pid > 0 then
			return key
		end
	end
	return nil
end

local function grantGamepass(player: Player, key: string)
	local p = DataService.Get(player)
	if not p then
		return
	end
	p.Gamepasses[key] = true
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
end

local function refreshGamepasses(player: Player)
	for key, id in pairs(Config.Gamepasses) do
		if id > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				grantGamepass(player, key)
			end
		end
	end
end

function ShopService.UpgradeCost(key: string, level: number): number?
	for _, u in ipairs(Config.Upgrades) do
		if u.Key == key then
			if level >= u.MaxLevel then
				return nil
			end
			return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
		end
	end
	return nil
end

function ShopService.BuyUpgrade(player: Player, key: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local level = p.Upgrades[key]
	if level == nil then
		return { ok = false, error = "ترقية غير موجودة" }
	end
	local cost = ShopService.UpgradeCost(key, level)
	if not cost then
		return { ok = false, error = "وصلت للمستوى الأقصى" }
	end
	if not DataService.Spend(player, "Diamonds", cost) then
		return { ok = false, error = "تحتاج 💎 " .. cost }
	end
	p.Upgrades[key] = level + 1
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "Speed" then
		ZoneService.RefreshSpeed(player)
	end
	return { ok = true }
end

local function grantProduct(player: Player, key: string): boolean
	local info
	for _, i in ipairs(Config.DevProductInfo) do
		if i.Key == key then
			info = i
		end
	end
	if not info then
		return false
	end
	if info.Diamonds then
		DataService.AddDiamonds(player, info.Diamonds)
		DataService.Notify(player, "💎 حصلت على " .. info.Diamonds .. " ألماسة!", Color3.fromRGB(120, 220, 255))
	elseif info.Potion then
		DataService.GivePotion(player, info.Potion, info.Count or 1)
	elseif info.Spins then
		DataService.AddSpins(player, info.Spins)
		DataService.Notify(player, "🎡 حصلت على " .. info.Spins .. " لفات!", Color3.fromRGB(255, 220, 60))
	end
	return true
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player or not DataService.Get(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = productKeyFromId(receipt.ProductId)
		if key and grantProduct(player, key) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = gamepassKeyFromId(passId)
		if key then
			grantGamepass(player, key)
			DataService.Notify(player, "✅ تم شراء " .. key .. "!", Color3.fromRGB(120, 255, 140))
		end
	end)

	Remotes.Event("PromptPurchase").OnServerEvent:Connect(function(player, kind, key)
		key = tostring(key)
		if kind == "Gamepass" then
			local id = Config.Gamepasses[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم الجيم باس بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		elseif kind == "Product" then
			local id = Config.DevProducts[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم المنتج بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		end
	end)

	Remotes.Function("BuyUpgrade").OnServerInvoke = function(player, key)
		return ShopService.BuyUpgrade(player, tostring(key))
	end

	DataService.Loaded:Connect(function(player)
		task.spawn(refreshGamepasses, player)
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">SpinService</string><ProtectedString name="Source"><![CDATA[--!strict
-- عجلة الحظ: لفة مجانية يومياً + لفات إضافية
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Rewards = require(script.Parent.Rewards)
local RateLimit = require(script.Parent.RateLimit)

local SpinService = {}
local rng = Random.new()

local function coinScale(p: DataService.Profile): number
	local best = 1
	for k in pairs(p.UnlockedZones) do
		local z = Zones.Get(tonumber(k) or 1)
		if z then
			best = math.max(best, z.Multiplier)
		end
	end
	return best * 500
end

function SpinService.Spin(player: Player, paid: boolean): { ok: boolean, error: string?, index: number?, reward: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	if not RateLimit.Check(player, "Spin", 1, 4) then
		return { ok = false, error = "انتظر انتهاء اللفة" }
	end
	local day = math.floor(os.time() / 86400)
	if p.SpinDay ~= day then
		p.SpinDay = day
	elseif p.Spins > 0 then
		p.Spins -= 1
	elseif paid then
		if not DataService.Spend(player, "Diamonds", Config.Spin.ExtraSpinCost) then
			return { ok = false, error = "تحتاج 💎 " .. Config.Spin.ExtraSpinCost }
		end
	else
		return { ok = false, error = "لا تملك لفات. اللفة المجانية غداً" }
	end
	local total = 0
	for _, s in ipairs(Config.Spin.Segments) do
		total += s.Weight
	end
	local r = rng:NextNumber() * total
	local index = #Config.Spin.Segments
	for i, s in ipairs(Config.Spin.Segments) do
		r -= s.Weight
		if r <= 0 then
			index = i
			break
		end
	end
	local seg = Config.Spin.Segments[index]
	local scale = coinScale(p)
	Rewards.Grant(player, seg, scale)
	p.Stats.Spins += 1
	DataService.MarkDirty(player)
	return { ok = true, index = index, reward = Rewards.Describe(seg, scale) }
end

function SpinService.Init()
	Remotes.Function("Spin").OnServerInvoke = function(player, paid)
		return SpinService.Spin(player, paid == true)
	end
	table.insert(DataService.Extenders, function(_, payload)
		payload.FreeSpin = payload.SpinDay ~= math.floor(os.time() / 86400)
	end)
end

return SpinService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--!strict
-- نظام التبادل بين اللاعبين مع تأكيد مزدوج وعدّ تنازلي
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local RateLimit = require(script.Parent.RateLimit)

local TradeService = {}

type Trade = {
	A: Player,
	B: Player,
	Offers: { [Player]: { string } },
	Confirmed: { [Player]: boolean },
	Countdown: number?,
	Token: number,
}

local trades: { [Player]: Trade } = {}
local pending: { [Player]: Player } = {} -- target -> requester
local tokenCounter = 0

local function other(t: Trade, player: Player): Player
	return t.A == player and t.B or t.A
end

local function petsFor(player: Player, uids: { string }): { any }
	local p = DataService.Get(player)
	local out = {}
	if not p then
		return out
	end
	for _, uid in ipairs(uids) do
		local pet = PetService.Find(p, uid)
		if pet then
			table.insert(out, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant, Level = pet.Level, Enchants = pet.Enchants })
		end
	end
	return out
end

local function broadcast(t: Trade)
	for _, player in ipairs({ t.A, t.B }) do
		local o = other(t, player)
		Remotes.Event("TradeUpdate"):FireClient(player, {
			Partner = { Name = o.Name, UserId = o.UserId, DisplayName = o.DisplayName },
			MyOffer = petsFor(player, t.Offers[player]),
			TheirOffer = petsFor(o, t.Offers[o]),
			MyConfirmed = t.Confirmed[player],
			TheirConfirmed = t.Confirmed[o],
			Countdown = t.Countdown,
		})
	end
end

local function cancel(t: Trade, reason: string?)
	trades[t.A] = nil
	trades[t.B] = nil
	for _, player in ipairs({ t.A, t.B }) do
		if player.Parent == Players then
			Remotes.Event("TradeUpdate"):FireClient(player, nil)
			if reason then
				DataService.Notify(player, reason, Color3.fromRGB(255, 120, 120))
			end
		end
	end
end

local function execute(t: Trade)
	local pa, pb = DataService.Get(t.A), DataService.Get(t.B)
	if not pa or not pb then
		cancel(t, "فشل التبادل")
		return
	end
	local function validate(p: DataService.Profile, uids: { string }): boolean
		for _, uid in ipairs(uids) do
			local pet = PetService.Find(p, uid)
			if not pet or pet.Locked then
				return false
			end
		end
		return true
	end
	if not validate(pa, t.Offers[t.A]) or not validate(pb, t.Offers[t.B]) then
		cancel(t, "تغيرت الحيوانات، أُلغي التبادل")
		return
	end
	if #pa.Pets - #t.Offers[t.A] + #t.Offers[t.B] > PetService.StorageCapacity(t.A) then
		cancel(t, "مخزن " .. t.A.Name .. " ممتلئ")
		return
	end
	if #pb.Pets - #t.Offers[t.B] + #t.Offers[t.A] > PetService.StorageCapacity(t.B) then
		cancel(t, "مخزن " .. t.B.Name .. " ممتلئ")
		return
	end
	local movedA, movedB = {}, {}
	for _, uid in ipairs(t.Offers[t.A]) do
		table.insert(movedA, PetService.Remove(pa, uid))
	end
	for _, uid in ipairs(t.Offers[t.B]) do
		table.insert(movedB, PetService.Remove(pb, uid))
	end
	for _, pet in ipairs(movedA) do
		pet.Equipped = false
		pet.Locked = false
		table.insert(pb.Pets, pet)
		pb.Index[pet.Id] = true
	end
	for _, pet in ipairs(movedB) do
		pet.Equipped = false
		pet.Locked = false
		table.insert(pa.Pets, pet)
		pa.Index[pet.Id] = true
	end
	pa.Stats.Trades += 1
	pb.Stats.Trades += 1
	DataService.MarkDirty(t.A)
	DataService.MarkDirty(t.B)
	PetService.UpdateEquippedAttribute(t.A)
	PetService.UpdateEquippedAttribute(t.B)
	trades[t.A] = nil
	trades[t.B] = nil
	for _, player in ipairs({ t.A, t.B }) do
		Remotes.Event("TradeUpdate"):FireClient(player, nil)
		DataService.Notify(player, "🤝 تم التبادل بنجاح!", Color3.fromRGB(120, 255, 140))
	end
end

local function startCountdown(t: Trade)
	tokenCounter += 1
	local token = tokenCounter
	t.Token = token
	t.Countdown = Config.TradeCountdown
	broadcast(t)
	task.spawn(function()
		for i = Config.TradeCountdown, 1, -1 do
			task.wait(1)
			if trades[t.A] ~= t or t.Token ~= token then
				return
			end
			t.Countdown = i - 1
			broadcast(t)
		end
		if trades[t.A] == t and t.Token == token and t.Confirmed[t.A] and t.Confirmed[t.B] then
			execute(t)
		end
	end)
end

local function resetConfirm(t: Trade)
	t.Confirmed[t.A] = false
	t.Confirmed[t.B] = false
	t.Countdown = nil
	t.Token += 1
end

function TradeService.Init()
	Remotes.Event("TradeRequest").OnServerEvent:Connect(function(player, targetId)
		if not RateLimit.Check(player, "TradeReq", 3, 5) then
			return
		end
		local target = Players:GetPlayerByUserId(tonumber(targetId) or 0)
		if not target or target == player or trades[player] or trades[target] then
			DataService.Notify(player, "اللاعب غير متاح للتبادل", Color3.fromRGB(255, 120, 120))
			return
		end
		pending[target] = player
		Remotes.Event("TradeIncoming"):FireClient(target, { FromUserId = player.UserId, FromName = player.DisplayName })
		DataService.Notify(player, "📨 أُرسل طلب التبادل إلى " .. target.DisplayName, Color3.fromRGB(120, 200, 255))
	end)

	Remotes.Event("TradeRespond").OnServerEvent:Connect(function(player, fromId, accept)
		local requester = pending[player]
		if not requester or requester.UserId ~= tonumber(fromId) then
			return
		end
		pending[player] = nil
		if not accept or requester.Parent ~= Players or trades[requester] or trades[player] then
			if requester.Parent == Players then
				DataService.Notify(requester, player.DisplayName .. " رفض التبادل", Color3.fromRGB(255, 120, 120))
			end
			return
		end
		local t: Trade = { A = requester, B = player, Offers = { [requester] = {}, [player] = {} }, Confirmed = { [requester] = false, [player] = false }, Countdown = nil, Token = 0 }
		trades[requester] = t
		trades[player] = t
		broadcast(t)
	end)

	Remotes.Event("TradeAction").OnServerEvent:Connect(function(player, action, payload)
		local t = trades[player]
		if not t then
			return
		end
		if not RateLimit.Check(player, "TradeAct", 15) then
			return
		end
		payload = type(payload) == "table" and payload or {}
		if action == "Add" then
			local p = DataService.Get(player)
			local uid = tostring(payload.Uid)
			local pet = p and PetService.Find(p, uid)
			if not pet or pet.Locked or table.find(t.Offers[player], uid) or #t.Offers[player] >= Config.TradeMaxPets then
				return
			end
			table.insert(t.Offers[player], uid)
			resetConfirm(t)
		elseif action == "Remove" then
			local idx = table.find(t.Offers[player], tostring(payload.Uid))
			if idx then
				table.remove(t.Offers[player], idx)
				resetConfirm(t)
			end
		elseif action == "Confirm" then
			t.Confirmed[player] = not t.Confirmed[player]
			t.Countdown = nil
			t.Token += 1
			if t.Confirmed[t.A] and t.Confirmed[t.B] then
				startCountdown(t)
				return
			end
		elseif action == "Cancel" then
			cancel(t, "أُلغي التبادل")
			return
		end
		broadcast(t)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local t = trades[player]
		if t then
			cancel(t, "غادر الطرف الآخر")
		end
		pending[player] = nil
	end)
end

return TradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source"><![CDATA[--!strict
-- فتح المناطق، البوابات، التنقل، بوابة VIP، سرعة المشي
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)
local Hooks = require(script.Parent.Hooks)
local PetUtil = require(Shared.Modules.PetUtil)

local ZoneService = {}

local touchDebounce: { [Player]: number } = {}

function ZoneService.Unlock(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local zone = Zones.List[index]
	if not p or not zone then
		return { ok = false, error = "منطقة غير موجودة" }
	end
	if p.UnlockedZones[tostring(index)] then
		return { ok = true }
	end
	if index == Zones.World2Start then
		if p.Rebirths < 1 then
			return { ok = false, error = "العالم الثاني يتطلب ريبيرث واحد على الأقل" }
		end
	elseif not p.UnlockedZones[tostring(index - 1)] then
		return { ok = false, error = "افتح المنطقة السابقة أولاً" }
	end
	if not DataService.Spend(player, "Coins", zone.Cost) then
		return { ok = false, error = "تحتاج 💰 " .. Format.Number(zone.Cost) .. " لفتح " .. zone.Name }
	end
	p.UnlockedZones[tostring(index)] = true
	Hooks.Fire(player, "Zone", index)
	DataService.MarkDirty(player)
	DataService.Notify(player, "🔓 فتحت منطقة " .. zone.Name .. " (" .. zone.Arabic .. ")!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function ZoneService.Teleport(player: Player, index: number): boolean
	local p = DataService.Get(player)
	if not p then
		return false
	end
	if index == 0 then
		if not DataService.HasGamepass(player, "VIP") then
			return false
		end
	elseif not p.UnlockedZones[tostring(index)] then
		return false
	elseif index >= Zones.World2Start and p.Rebirths < 1 then
		return false
	end
	local layout = MapBuilder.Zones[index]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not layout or not hrp then
		return false
	end
	hrp.CFrame = CFrame.new(layout.Spawn + Vector3.new(0, 4, 0), layout.Center)
	p.LastZone = index
	DataService.MarkDirty(player)
	return true
end

local function onGateTouched(gate: BasePart, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 1.5 then
		return
	end
	touchDebounce[player] = now
	local index = gate:GetAttribute("Zone") :: number
	local p = DataService.Get(player)
	if not p or p.UnlockedZones[tostring(index)] then
		return
	end
	local res = ZoneService.Unlock(player, index)
	if not res.ok and res.error then
		DataService.Notify(player, res.error, Color3.fromRGB(255, 120, 120))
	end
end

local function onPortalTouched(kind: string, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 2 then
		return
	end
	touchDebounce[player] = now
	if kind == "VIP" then
		if DataService.HasGamepass(player, "VIP") then
			ZoneService.Teleport(player, 0)
		else
			DataService.Notify(player, "👑 منطقة VIP لأصحاب جيم باس VIP", Color3.fromRGB(255, 215, 0))
			if Config.Gamepasses.VIP > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, Config.Gamepasses.VIP)
			end
		end
	elseif kind == "World2" then
		local p = DataService.Get(player)
		if not p then
			return
		end
		if not p.UnlockedZones[tostring(Zones.World2Start)] then
			local res = ZoneService.Unlock(player, Zones.World2Start)
			if not res.ok then
				DataService.Notify(player, res.error or "لا يمكن الدخول", Color3.fromRGB(255, 120, 120))
				return
			end
		end
		ZoneService.Teleport(player, Zones.World2Start)
	elseif kind == "World1" then
		ZoneService.Teleport(player, Zones.World2Start - 1)
	else
		ZoneService.Teleport(player, 1)
	end
end

local function computeSpeed(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 16
	end
	local agility = PetUtil.EnchantBonuses(p.Pets).Agility or 0
	local board = tonumber(player:GetAttribute("BoardSpeed")) or 0
	return 16 + (p.Upgrades.Speed or 0) * 2 + agility + board
end

local function applyCharacter(player: Player, char: Model)
	local p = DataService.Get(player)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum and p then
		hum.WalkSpeed = computeSpeed(player)
	end
	task.wait(0.3)
	if p and p.LastZone and p.LastZone ~= 1 then
		ZoneService.Teleport(player, p.LastZone)
	end
	if DataService.HasGamepass(player, "VIP") then
		player:SetAttribute("VIP", true)
		local head = char:FindFirstChild("Head")
		if head and not head:FindFirstChild("VIPTag") then
			local bb = Instance.new("BillboardGui")
			bb.Name = "VIPTag"
			bb.Size = UDim2.fromScale(4, 1)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.AlwaysOnTop = true
			local l = Instance.new("TextLabel")
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Text = "👑 VIP"
			l.TextColor3 = Color3.fromRGB(255, 215, 0)
			l.TextStrokeTransparency = 0.2
			l.Font = Enum.Font.FredokaOne
			l.TextScaled = true
			l.Parent = bb
			bb.Parent = head
		end
	end
end

function ZoneService.RefreshSpeed(player: Player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = computeSpeed(player)
	end
end

function ZoneService.Init()
	for index, layout in pairs(MapBuilder.Zones) do
		if layout.Gate then
			local gate = layout.Gate
			gate.Touched:Connect(function(hit)
				onGateTouched(gate, hit)
			end)
		end
	end
	if MapBuilder.VIPPortal then
		MapBuilder.VIPPortal.Touched:Connect(function(hit)
			onPortalTouched("VIP", hit)
		end)
	end
	if MapBuilder.VIPReturnPortal then
		MapBuilder.VIPReturnPortal.Touched:Connect(function(hit)
			onPortalTouched("Return", hit)
		end)
	end
	if MapBuilder.World2Portal then
		MapBuilder.World2Portal.Touched:Connect(function(hit)
			onPortalTouched("World2", hit)
		end)
	end
	if MapBuilder.World1Portal then
		MapBuilder.World1Portal.Touched:Connect(function(hit)
			onPortalTouched("World1", hit)
		end)
	end
	-- تحديث السرعة عند تغير الإنشانتات (عبر تغير الحيوانات المجهزة)
	Players.PlayerAdded:Connect(function(player)
		player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
			ZoneService.RefreshSpeed(player)
		end)
	end)

	Remotes.Function("UnlockZone").OnServerInvoke = function(player, index)
		return ZoneService.Unlock(player, tonumber(index) or 0)
	end
	Remotes.Event("Teleport").OnServerEvent:Connect(function(player, index)
		ZoneService.Teleport(player, tonumber(index) or 1)
	end)

	local function hook(player: Player)
		if player:GetAttribute("ZoneHooked") then
			return
		end
		player:SetAttribute("ZoneHooked", true)
		player.CharacterAdded:Connect(function(char)
			applyCharacter(player, char)
		end)
		if player.Character then
			task.spawn(applyCharacter, player, player.Character)
		end
	end
	DataService.Loaded:Connect(function(player)
		hook(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		touchDebounce[player] = nil
	end)
end

return ZoneService
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="Folder" referent="RBX000060"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX000039"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--!strict
-- نقطة تشغيل العميل
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
Remotes.Init()

local Controllers = script.Parent:WaitForChild("Controllers")

local LoadingScreen = require(Controllers.LoadingScreen)
LoadingScreen.Show()

local DataController = require(Controllers.DataController)
local UIController = require(Controllers.UIController)
local InventoryUI = require(Controllers.InventoryUI)
local ShopUI = require(Controllers.ShopUI)
local MachineUI = require(Controllers.MachineUI)
local MissionsUI = require(Controllers.MissionsUI)
local StatsUI = require(Controllers.StatsUI)
local TradeUI = require(Controllers.TradeUI)
local SpinUI = require(Controllers.SpinUI)
local MerchantUI = require(Controllers.MerchantUI)
local AdminUI = require(Controllers.AdminUI)
local EggController = require(Controllers.EggController)
local PetController = require(Controllers.PetController)
local BreakableController = require(Controllers.BreakableController)
local ZoneController = require(Controllers.ZoneController)
local EffectsController = require(Controllers.EffectsController)

DataController.Init()
DataController.Wait()

UIController.Init()
InventoryUI.Init()
ShopUI.Init()
EffectsController.Init()
MachineUI.Init()
MissionsUI.Init()
StatsUI.Init()
TradeUI.Init()
SpinUI.Init()
MerchantUI.Init()
AdminUI.Init()
EggController.Init()
PetController.Init()
BreakableController.Init()
ZoneController.Init()

LoadingScreen.Hide()

-- شارة VIP في الشات
local TextChatService = game:GetService("TextChatService")
local Players = game:GetService("Players")
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				props.PrefixText = "<font color='#FFD700'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return props
	end
end

print("[PetKingdom] Client ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000059"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000040"><Properties><string name="Name">AdminUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحة الأدمن
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local UIController = require(script.Parent.UIController)

local AdminUI = {}

function AdminUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Admin", "🛠️ لوحة الأدمن", UDim2.fromOffset(520, 520), UIKit.Colors.Red)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 8)
	local function run(cmd: string, payload: any)
		local res = Remotes.Function("Admin"):InvokeServer(cmd, payload)
		UIController.Notify(res.ok and ("✅ " .. cmd) or (res.error or "خطأ"), res.ok and UIKit.Colors.Green or UIKit.Colors.Red)
	end
	local function inputRow(label: string, placeholder: string, cmd: string, build: (string) -> any)
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = label, Size = UDim2.fromOffset(150, 46), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = row })
		local box = UIKit.New("TextBox", { Size = UDim2.new(1, -280, 0, 34), Position = UDim2.fromOffset(160, 6), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = placeholder, Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 18, ClearTextOnFocus = false, Parent = row }) :: TextBox
		UIKit.Corner(box, 8)
		UIKit.Button({ Text = "تنفيذ", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(100, 34), Position = UDim2.new(1, -108, 0, 6), MaxTextSize = 16, Parent = row }, function()
			run(cmd, build(box.Text))
		end)
	end
	local function num(t: string)
		return { Amount = tonumber(t) or 0 }
	end
	inputRow("💰 عملات", "1000000", "Coins", num)
	inputRow("💎 ألماس", "10000", "Diamonds", num)
	inputRow("🔁 توكنات", "5", "Tokens", num)
	inputRow("🎡 لفات", "5", "Spins", num)
	inputRow("🔁 عدد الريبيرث", "3", "Rebirths", num)
	inputRow("🐾 حيوان (id [variant])", "huge_cat Rainbow", "Pet", function(t)
		local id, variant = t:match("^(%S+)%s*(%S*)$")
		return { Id = id or t, Variant = (variant ~= "" and variant) or "Normal" }
	end)
	inputRow("🧪 جرعة (key عدد)", "Lucky 3", "Potion", function(t)
		local key, count = t:match("^(%S+)%s*(%S*)$")
		return { Id = key or t, Amount = tonumber(count) or 1 }
	end)
	local evRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(evRow, 6, true)
	for _, e in ipairs(Config.Events.List) do
		UIKit.Button({ Text = e.Name, Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(92, 40), MaxTextSize = 13, Parent = evRow }, function()
			run("Event", { Id = e.Id })
		end)
	end
	local misc = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(misc, 6, true)
	UIKit.Button({ Text = "🔓 فتح كل المناطق", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(200, 40), MaxTextSize = 16, Parent = misc }, function()
		run("UnlockAll", {})
	end)
	UIKit.Button({ Text = "⚠️ تصفير بياناتي", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(200, 40), MaxTextSize = 16, Parent = misc }, function()
		run("Reset", {})
	end)
	UIController.Register("Admin", w)
end

return AdminUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000041"><Properties><string name="Name">BreakableController</string><ProtectedString name="Source"><![CDATA[--!strict
-- أشرطة الصحة فوق الصناديق، تأثير الضرب، ونوافذ المكافأة
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)

local BreakableController = {}

local function attach(model: Model)
	local root = model.PrimaryPart or model:FindFirstChild("Base") :: BasePart?
	if not root then
		return
	end
	local typeName = model:GetAttribute("Type") :: string
	local def = Breakables.Get(typeName or "")
	local bb = Instance.new("BillboardGui")
	bb.Name = "HealthBar"
	bb.Size = UDim2.fromOffset(150, 52)
	bb.StudsOffset = Vector3.new(0, root.Size.Y / 2 + 3, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	local name = UIKit.Label({ Text = def and def.Name or typeName, Size = UDim2.new(1, 0, 0, 22), TextStrokeTransparency = 0.2, Parent = bb })
	local coins = model:GetAttribute("Coins") :: number
	local diamonds = model:GetAttribute("Diamonds") :: number
	local rewardText = ""
	if coins and coins > 0 then
		rewardText = "💰 " .. Format.Number(coins)
	end
	if diamonds and diamonds > 0 then
		rewardText = rewardText .. " 💎 " .. diamonds
	end
	UIKit.Label({ Text = rewardText, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 22), TextColor3 = UIKit.Colors.Gold, Parent = bb })
	local _bg, fill, label = UIKit.ProgressBar(bb, UIKit.Colors.Green, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 40))
	label.Visible = false
	local function update()
		local h = model:GetAttribute("Health") :: number or 0
		local mh = model:GetAttribute("MaxHealth") :: number or 1
		local ratio = math.clamp(h / mh, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = ratio > 0.5 and UIKit.Colors.Green or (ratio > 0.2 and UIKit.Colors.Gold or UIKit.Colors.Red)
		name.Text = (def and def.Name or typeName) .. "  " .. Format.Number(h)
	end
	update()
	model:GetAttributeChangedSignal("Health"):Connect(update)
	model:GetAttributeChangedSignal("LastHit"):Connect(function()
		local by = model:GetAttribute("LastHitBy")
		local dmg = model:GetAttribute("LastDamage")
		local p = DataController.Profile
		if by == Players.LocalPlayer.UserId and type(dmg) == "number" and p and p.Settings.DamageNumbers ~= false then
			local crit = model:GetAttribute("LastCrit") == true
			local anchor = Instance.new("Part")
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.Transparency = 1
			anchor.Size = Vector3.new(1, 1, 1)
			anchor.Position = root.Position + Vector3.new(math.random(-2, 2), root.Size.Y / 2, math.random(-2, 2))
			anchor.Parent = Workspace
			local dbb = Instance.new("BillboardGui")
			dbb.Size = UDim2.fromOffset(160, 40)
			dbb.AlwaysOnTop = true
			local dl = UIKit.Label({ Text = (crit and "💥 " or "-") .. Format.Number(dmg), TextColor3 = crit and UIKit.Colors.Gold or Color3.fromRGB(255, 90, 90), TextStrokeTransparency = 0, MaxTextSize = crit and 30 or 22, Parent = dbb })
			dbb.Parent = anchor
			UIKit.Tween(dbb, { StudsOffset = Vector3.new(0, 4, 0) }, 0.8)
			UIKit.Tween(dl, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(anchor, 0.9)
		end
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.new(1, 1, 1)
		hl.FillTransparency = 0.3
		hl.OutlineTransparency = 1
		hl.Parent = model
		UIKit.Tween(hl, { FillTransparency = 1 }, 0.25)
		Debris:AddItem(hl, 0.3)
	end)
	bb.Parent = root
end

local function popup(data: any)
	local pos = data.Position :: Vector3
	local text = ""
	if data.Coins and data.Coins > 0 then
		text = "+" .. Format.Number(data.Coins) .. " 💰"
	end
	if data.Diamonds and data.Diamonds > 0 then
		text = text .. "  +" .. data.Diamonds .. " 💎"
	end
	if text == "" then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = pos
	anchor.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.AlwaysOnTop = true
	bb.StudsOffset = Vector3.new(0, 0, 0)
	local label = UIKit.Label({ Text = text, TextColor3 = UIKit.Colors.Gold, TextStrokeTransparency = 0, Parent = bb })
	bb.Parent = anchor
	UIKit.Tween(bb, { StudsOffset = Vector3.new(0, 6, 0) }, 1.2)
	UIKit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(anchor, 1.3)
end

function BreakableController.Init()
	local folder = Workspace:WaitForChild("Breakables")
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") then
			attach(m)
		end
	end
	folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") and not m:FindFirstChild("HealthBar", true) then
			task.defer(attach, m)
		end
	end)
	Remotes.Event("RewardPopup").OnClientEvent:Connect(popup)
end

return BreakableController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000042"><Properties><string name="Name">DataController</string><ProtectedString name="Source"><![CDATA[--!strict
-- نسخة العميل من بيانات اللاعب
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local DataController = {}

local changed = Instance.new("BindableEvent")
DataController.Changed = changed.Event
DataController.Profile = nil :: any
local serverOffset = 0

function DataController.Init()
	Remotes.Event("ProfileUpdate").OnClientEvent:Connect(function(profile)
		DataController.Profile = profile
		if profile.ServerTime then
			serverOffset = profile.ServerTime - os.time()
		end
		changed:Fire(profile)
	end)
end

function DataController.Wait(): any
	local t = 0
	while not DataController.Profile do
		if t % 2 == 0 then
			Remotes.Event("RequestProfile"):FireServer()
		end
		task.wait(0.5)
		t += 1
	end
	return DataController.Profile
end

function DataController.ServerTime(): number
	return os.time() + serverOffset
end

function DataController.Owns(pass: string): boolean
	local p = DataController.Profile
	return p ~= nil and p.OwnedPasses ~= nil and p.OwnedPasses[pass] == true
end

function DataController.FindPet(uid: string): any
	local p = DataController.Profile
	if not p then
		return nil
	end
	for _, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end

return DataController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000043"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!strict
-- تأثيرات: ألوان قوس قزح للحيوانات، الموسيقى، الأصوات
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DataController = require(script.Parent.DataController)

local EffectsController = {}

local sounds: { [string]: Sound } = {}
local music: Sound?

function EffectsController.Play(name: string)
	local s = sounds[name]
	if s then
		s:Play()
	end
end

local function screenFlash(color: Color3, text: string)
	local Players = game:GetService("Players")
	local gui = Instance.new("ScreenGui")
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0.4
	flash.BorderSizePixel = 0
	flash.Parent = gui
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 80)
	label.Position = UDim2.new(0, 0, 0.2, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	local tw = game:GetService("TweenService"):Create(flash, TweenInfo.new(1.5), { BackgroundTransparency = 1 })
	tw:Play()
	game:GetService("TweenService"):Create(label, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.6, function()
		gui:Destroy()
	end)
	-- كونفيتي
	local cam = Workspace.CurrentCamera
	if cam then
		local attach = Instance.new("Attachment")
		attach.Parent = Workspace.Terrain
		attach.WorldPosition = cam.CFrame.Position + cam.CFrame.LookVector * 10 + Vector3.new(0, 6, 0)
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 80)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 200, 255)) })
		pe.Size = NumberSequence.new(0.5)
		pe.Lifetime = NumberRange.new(1.5, 2.5)
		pe.Rate = 0
		pe.Speed = NumberRange.new(20, 35)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Acceleration = Vector3.new(0, -25, 0)
		pe.LightEmission = 1
		pe.Parent = attach
		pe:Emit(200)
		task.delay(3, function()
			attach:Destroy()
		end)
	end
end

function EffectsController.Init()
	local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
	local Remotes = require(ReplicatedStorage2:WaitForChild("Shared").Remotes)
	Remotes.Event("EventEffect").OnClientEvent:Connect(function(data)
		if data.Type == "Huge" then
			screenFlash(Color3.fromRGB(255, 0, 80), "🎉 " .. tostring(data.Player) .. " حصل على حيوان عملاق!")
		elseif data.Type == "EventStart" then
			EffectsController.Play(data.Id == "BossRaid" and "Boss" or "Unlock")
			screenFlash(Color3.fromRGB(120, 60, 200), "🎉 بدأ حدث عالمي!")
		end
	end)
	for name, id in pairs(Config.Sounds) do
		if id and id > 0 then
			local s = Instance.new("Sound")
			s.SoundId = "rbxassetid://" .. id
			s.Volume = name == "Music" and 0.35 or 0.6
			s.Looped = name == "Music"
			s.Parent = SoundService
			sounds[name] = s
			if name == "Music" then
				music = s
			end
		end
	end
	if music then
		music:Play()
		DataController.Changed:Connect(function(p)
			if p.Settings and p.Settings.Music == false then
				music:Pause()
			elseif not music.IsPlaying then
				music:Play()
			end
		end)
	end

	-- دورة ألوان قوس قزح
	local hue = 0
	RunService.Heartbeat:Connect(function(dt)
		hue = (hue + dt * 0.25) % 1
		local color = Color3.fromHSV(hue, 0.85, 1)
		local folder = Workspace:FindFirstChild("ClientPets")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:GetAttribute("Variant") == "Rainbow" then
					for _, part in ipairs(model:GetChildren()) do
						if part:IsA("BasePart") and part:GetAttribute("Rainbow") then
							part.Color = color
						end
					end
				end
			end
		end
	end)
end

return EffectsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000044"><Properties><string name="Name">EggController</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحة البيضة عند الاقتراب + شاشة الفتح (أنيميشن) + الفتح التلقائي
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Eggs = require(Shared.Data.Eggs)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Luck = require(Shared.Modules.Luck)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)
local EffectsController = require(script.Parent.EffectsController)

local EggController = {}

local player = Players.LocalPlayer
local panel: Frame
local panelTitle: TextLabel
local panelList: Frame
local tripleBtn: TextButton
local octBtn: TextButton
local autoBtn: TextButton
local variantBtns: { [string]: TextButton } = {}
local currentVariant = "Normal"
local overlay: Frame
local overlayContent: Frame
local panelEgg: string? = nil
local hatching = false
local autoHatch = false
local eggModels: { Model } = {}
local refreshPanel: () -> ()

local function buildPanel(gui: ScreenGui)
	panel = UIKit.Frame({ Name = "EggPanel", Size = UDim2.fromOffset(640, 270), Position = UDim2.new(0.5, -320, 1, -290), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.05, Visible = false, Parent = gui })
	UIKit.Corner(panel, 18)
	UIKit.Stroke(panel, UIKit.Colors.Gold, 3)
	panelTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, -230, 0, 34), Position = UDim2.fromOffset(8, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = panel })
	local variants = UIKit.Frame({ Size = UDim2.fromOffset(220, 30), Position = UDim2.new(1, -228, 0, 8), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(variants, 4, true)
	for _, v in ipairs({ { "Normal", "عادي", UIKit.Colors.Panel3 }, { "Golden", "ذهبي x5", UIKit.Colors.Gold }, { "Rainbow", "قوس قزح x25", UIKit.Colors.Pink } }) do
		variantBtns[v[1]] = UIKit.Button({ Text = v[2], Color = v[3], Size = UDim2.fromOffset(70, 30), MaxTextSize = 12, Parent = variants }, function()
			currentVariant = v[1]
			refreshPanel()
		end)
	end
	panelList = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 120), Position = UDim2.fromOffset(8, 44), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(panelList, 6, true, true)
	local buttons = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -52), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(buttons, 8, true, true)
	UIKit.Button({ Text = "فتح (E)", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(1)
	end)
	tripleBtn = UIKit.Button({ Text = "فتح 3 (R)", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(3)
	end)
	octBtn = UIKit.Button({ Text = "فتح 8 (F)", Color = UIKit.Colors.Cyan, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.Hatch(8)
	end)
	autoBtn = UIKit.Button({ Text = "تلقائي (T)", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(145, 44), MaxTextSize = 18, Parent = buttons }, function()
		EggController.ToggleAuto()
	end)
end

function refreshPanel()
	if not panelEgg then
		return
	end
	local egg = Eggs.Get(panelEgg) :: Eggs.EggDef
	local p = DataController.Profile
	local luck = p and p.Luck or 1
	if egg.Currency ~= "Coins" then
		currentVariant = "Normal"
	end
	for v, btn in pairs(variantBtns) do
		btn.Visible = egg.Currency == "Coins"
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = v == currentVariant and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
			stroke.Thickness = v == currentVariant and 3 or 2
		end
	end
	local currencyIcon = egg.Currency == "Coins" and "💰 " or (egg.Currency == "Diamonds" and "💎 " or "🔁 ")
	local cost = egg.Cost * (Config.EggVariantCost[currentVariant] or 1)
	panelTitle.Text = egg.Name .. (currentVariant ~= "Normal" and (" (" .. currentVariant .. ")") or "") .. "   " .. currencyIcon .. Format.Number(cost) .. (luck > 1 and ("   🍀 x" .. string.format("%.2f", luck)) or "")
	for _, c in ipairs(panelList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, entry in ipairs(Luck.ApplyLuck(panelEgg, luck)) do
		local def = Pets.Get(entry.Pet) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromOffset(84, 118), BackgroundColor3 = UIKit.Colors.Panel2, Parent = panelList })
		UIKit.Corner(card, 10)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 2)
		local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, Parent = card })
		PetViewport.Create(vp, def.Id, currentVariant)
		UIKit.Label({ Text = def.Name, Size = UDim2.new(1, -4, 0, 20), Position = UDim2.fromOffset(2, 72), MaxTextSize = 12, Parent = card })
		UIKit.Label({ Text = Format.Percent(entry.Chance), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 94), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 14, Parent = card })
	end
	tripleBtn.BackgroundColor3 = DataController.Owns("TripleHatch") and UIKit.Colors.Gold or UIKit.Colors.Panel3
	octBtn.BackgroundColor3 = DataController.Owns("OctupleHatch") and UIKit.Colors.Cyan or UIKit.Colors.Panel3
	autoBtn.BackgroundColor3 = autoHatch and UIKit.Colors.Green or (DataController.Owns("AutoHatch") and UIKit.Colors.Purple or UIKit.Colors.Panel3)
	autoBtn.Text = autoHatch and "إيقاف (T)" or "تلقائي (T)"
end

-- ===== شاشة الفتح =====
local function buildOverlay(gui: ScreenGui)
	overlay = UIKit.Frame({ Name = "HatchOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 10, Parent = gui })
	overlayContent = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11, Parent = overlay })
	UIKit.List(overlayContent, 24, true, true)
	local skip = UIKit.Label({ Text = "اضغط في أي مكان للتخطي", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -60), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 20, ZIndex = 12, Parent = overlay })
	skip.Name = "Skip"
end

local function eggViewport(parent: Instance, egg: Eggs.EggDef): (ViewportFrame, Model)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 0.85)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	vp.ZIndex = 12
	local model = Instance.new("Model")
	local shell = Instance.new("Part")
	shell.Size = Vector3.new(4, 5.2, 4)
	shell.Color = egg.Color
	shell.Anchored = true
	shell.Material = Enum.Material.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	shell.Parent = model
	local rng = Random.new(#egg.Id)
	for _ = 1, 6 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-1.4, 1.4)
		local r = 1.85 * math.sqrt(math.max(0, 1 - (y / 2.6) ^ 2))
		local spot = Instance.new("Part")
		spot.Shape = Enum.PartType.Ball
		spot.Size = Vector3.new(0.8, 0.8, 0.8)
		spot.Color = egg.Accent
		spot.Anchored = true
		spot.CFrame = CFrame.new(math.cos(ang) * r, y, math.sin(ang) * r)
		spot.Parent = model
	end
	model.PrimaryPart = shell
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 45
	cam.CFrame = CFrame.new(Vector3.new(0, 0.5, -9), Vector3.new(0, 0, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp, model
end

local function playHatch(eggId: string, results: { any })
	local egg = Eggs.Get(eggId) :: Eggs.EggDef
	hatching = true
	overlay.Visible = true
	for _, c in ipairs(overlayContent:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local slots = {}
	local many = #results > 3
	for _, res in ipairs(results) do
		local holder = UIKit.Frame({ Size = many and UDim2.fromOffset(150, 240) or UDim2.fromOffset(260, 360), BackgroundTransparency = 1, ZIndex = 11, Parent = overlayContent })
		local vp, model = eggViewport(holder, egg)
		table.insert(slots, { Holder = holder, Vp = vp, Model = model, Result = res })
	end
	EffectsController.Play("Hatch")
	-- اهتزاز
	local t0 = os.clock()
	local skipped = false
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Space then
			skipped = true
		end
	end)
	local fast = DataController.Owns("FastHatch")
	while os.clock() - t0 < (fast and 0.8 or 1.6) and not skipped do
		local dt = os.clock() - t0
		for _, s in ipairs(slots) do
			local ang = math.sin(dt * 28) * 0.28 * math.min(1, dt * 2)
			local scale = 1 + math.sin(dt * 10) * 0.04
			s.Model:PivotTo(CFrame.new(0, math.abs(math.sin(dt * 14)) * 0.4, 0) * CFrame.Angles(0, 0, ang))
			s.Vp.Size = UDim2.fromScale(scale, 0.85 * scale)
		end
		RunService.RenderStepped:Wait()
	end
	-- كشف الحيوان
	for _, s in ipairs(slots) do
		s.Vp:Destroy()
		local def = Pets.Get(s.Result.Id) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 12, Parent = s.Holder })
		UIKit.Corner(card, 18)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 4)
		local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0.66, 0), BackgroundTransparency = 1, ZIndex = 12, Parent = card })
		local vp = PetViewport.Create(vpHolder, s.Result.Id, s.Result.Variant, true)
		vp.ZIndex = 12
		local inst = { Uid = s.Result.Uid, Id = s.Result.Id, Variant = s.Result.Variant, Locked = false, Equipped = false, Time = 0, Level = 1, XP = 0, Enchants = {} }
		UIKit.Label({ Text = PetUtil.DisplayName(inst), Size = UDim2.new(1, -8, 0.1, 0), Position = UDim2.new(0, 4, 0.67, 0), MaxTextSize = 22, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or ""), Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.78, 0), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 18, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = s.Result.Deleted and "🗑️ حُذف تلقائياً" or ("⚔️ " .. Format.Number(PetUtil.BasePower(inst))), Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.87, 0), TextColor3 = s.Result.Deleted and UIKit.Colors.Muted or UIKit.Colors.Pink, MaxTextSize = 18, ZIndex = 13, Parent = card })
		UIKit.Pop(card)
		if Rarities.Rank(def.Rarity) >= 5 then
			UIController.Notify("🌟 حصلت على " .. def.Name .. " (" .. def.Rarity .. ")!", Rarities.Color(def.Rarity))
		end
	end
	local t1 = os.clock()
	skipped = false
	while os.clock() - t1 < ((autoHatch or fast) and 1.2 or 2.6) and not skipped do
		task.wait(0.05)
	end
	conn:Disconnect()
	overlay.Visible = false
	hatching = false
end

function EggController.Hatch(count: number)
	if hatching or not panelEgg then
		return
	end
	if count >= 3 and not DataController.Owns("TripleHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "TripleHatch")
		return
	end
	if count == 8 and not DataController.Owns("OctupleHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "OctupleHatch")
		return
	end
	local eggId = panelEgg
	local res = Remotes.Function("HatchEgg"):InvokeServer(eggId, count, currentVariant)
	if res.ok and res.pets and #res.pets > 0 then
		playHatch(eggId, res.pets)
	elseif res.error then
		UIController.Notify(res.error, UIKit.Colors.Red)
		if res.error:find("ممتلئ") then
			autoHatch = false
			refreshPanel()
		end
	end
end

function EggController.ToggleAuto()
	if not DataController.Owns("AutoHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "AutoHatch")
		return
	end
	autoHatch = not autoHatch
	refreshPanel()
end

local function nearestEgg(): string?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end
	local best, bestDist = nil, 16
	for _, m in ipairs(eggModels) do
		local pp = m.PrimaryPart
		if pp then
			local d = (pp.Position - hrp.Position).Magnitude
			if d < bestDist then
				best, bestDist = m:GetAttribute("EggId") :: string, d
			end
		end
	end
	return best
end

function EggController.Init()
	local gui = UIController.Gui :: ScreenGui
	buildPanel(gui)
	buildOverlay(gui)

	local map = Workspace:WaitForChild("Map")
	for _, inst in ipairs(map:GetDescendants()) do
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end
	map.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end)

	-- تحديث اللوحة حسب أقرب بيضة
	task.spawn(function()
		while true do
			task.wait(0.2)
			local id = nearestEgg()
			if id ~= panelEgg then
				panelEgg = id
				if id then
					refreshPanel()
					panel.Visible = true
					UIKit.Pop(panel)
				else
					panel.Visible = false
					autoHatch = false
				end
			end
		end
	end)

	-- الفتح التلقائي
	task.spawn(function()
		while true do
			task.wait(0.3)
			if autoHatch and panelEgg and not hatching then
				EggController.Hatch(DataController.Owns("OctupleHatch") and 8 or (DataController.Owns("TripleHatch") and 3 or 1))
			end
		end
	end)

	-- دوران البيض في العالم (القشرة مع النقاط)
	local spinCache: { [Model]: { Base: Vector3, Spots: { { Part: BasePart, Offset: CFrame } } } } = {}
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in ipairs(eggModels) do
			local shell = m.PrimaryPart
			if shell and shell:IsDescendantOf(Workspace) then
				local cache = spinCache[m]
				if not cache then
					cache = { Base = shell.Position, Spots = {} }
					for _, c in ipairs(m:GetChildren()) do
						if c:IsA("BasePart") and (c.Name == "Spot" or c.Name == "Crown") then
							table.insert(cache.Spots, { Part = c, Offset = shell.CFrame:ToObjectSpace(c.CFrame) })
						end
					end
					spinCache[m] = cache
				end
				local cf = CFrame.new(cache.Base + Vector3.new(0, math.sin(t * 2) * 0.3, 0)) * CFrame.Angles(0, t * 0.6, 0)
				shell.CFrame = cf
				for _, s in ipairs(cache.Spots) do
					s.Part.CFrame = cf * s.Offset
				end
			end
		end
	end)

	DataController.Changed:Connect(function()
		if panel.Visible then
			refreshPanel()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not panel.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			EggController.Hatch(1)
		elseif input.KeyCode == Enum.KeyCode.R then
			EggController.Hatch(3)
		elseif input.KeyCode == Enum.KeyCode.F then
			EggController.Hatch(8)
		elseif input.KeyCode == Enum.KeyCode.T then
			EggController.ToggleAuto()
		end
	end)
end

return EggController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000045"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نافذة الحيوانات: الشبكة، الفرز، البحث، التفاصيل (مستوى، خبرة، إنشانتات)، التجهيز، القفل، الحذف
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local PetViewport = require(script.Parent.PetViewport)
local UIController = require(script.Parent.UIController)

local InventoryUI = {}

local cards: { [string]: Frame } = {}
local selectedUid: string? = nil
local sortMode = "Power"
local search = ""
InventoryUI.OnEnchant = nil :: ((string) -> ())?

function InventoryUI.PetCard(parent: Instance, pet: any, onClick: (() -> ())?): Frame
	local def = Pets.Get(pet.Id)
	local color = def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
	local card = UIKit.Frame({ Name = pet.Uid, BackgroundColor3 = UIKit.Colors.Panel2, Parent = parent })
	UIKit.Corner(card, 12)
	UIKit.Stroke(card, color, 2.5)
	local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 80), BackgroundTransparency = 1, Parent = card })
	PetViewport.Create(vpHolder, pet.Id, pet.Variant)
	UIKit.Label({ Text = PetUtil.DisplayName(pet), Size = UDim2.new(1, -6, 0, 20), Position = UDim2.fromOffset(3, 80), MaxTextSize = 13, Parent = card })
	UIKit.Label({ Text = "⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 100), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 13, Parent = card })
	UIKit.Label({ Name = "Badge", Text = pet.Equipped and "✅" or "", Size = UDim2.fromOffset(26, 22), Position = UDim2.fromOffset(4, 4), MaxTextSize = 18, Parent = card })
	UIKit.Label({ Name = "Lock", Text = pet.Locked and "🔒" or "", Size = UDim2.fromOffset(26, 22), Position = UDim2.new(1, -30, 0, 4), MaxTextSize = 18, Parent = card })
	UIKit.Label({ Name = "Level", Text = "Lv." .. (pet.Level or 1), Size = UDim2.fromOffset(44, 18), Position = UDim2.new(1, -46, 0, 60), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 12, Parent = card })
	if pet.Enchants and #pet.Enchants > 0 then
		UIKit.Label({ Name = "Ench", Text = "🔧" .. #pet.Enchants, Size = UDim2.fromOffset(34, 18), Position = UDim2.fromOffset(4, 60), TextColor3 = UIKit.Colors.Green, MaxTextSize = 12, Parent = card })
	end
	if pet.Variant == "Golden" then
		UIKit.Gradient(card, Color3.fromRGB(80, 70, 30), UIKit.Colors.Panel)
	elseif pet.Variant == "Rainbow" then
		UIKit.Gradient(card, Color3.fromRGB(90, 40, 90), UIKit.Colors.Panel)
	elseif pet.Variant == "DarkMatter" then
		UIKit.Gradient(card, Color3.fromRGB(40, 10, 70), Color3.fromRGB(10, 5, 20))
	end
	local btn = UIKit.New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = card }) :: TextButton
	if onClick then
		btn.Activated:Connect(onClick)
	end
	return card
end

local function sortPets(list: { any })
	if sortMode == "Power" then
		PetUtil.SortByPower(list)
	elseif sortMode == "Rarity" then
		table.sort(list, function(a, b)
			local da, db = Pets.Get(a.Id), Pets.Get(b.Id)
			local ra, rb = da and Rarities.Rank(da.Rarity) or 0, db and Rarities.Rank(db.Rarity) or 0
			if ra ~= rb then
				return ra > rb
			end
			return PetUtil.BasePower(a) > PetUtil.BasePower(b)
		end)
	elseif sortMode == "Level" then
		table.sort(list, function(a, b)
			if (a.Level or 1) ~= (b.Level or 1) then
				return (a.Level or 1) > (b.Level or 1)
			end
			return PetUtil.BasePower(a) > PetUtil.BasePower(b)
		end)
	elseif sortMode == "Newest" then
		table.sort(list, function(a, b)
			return (a.Time or 0) > (b.Time or 0)
		end)
	end
end

function InventoryUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Inventory", "🐾 حيواناتي", UDim2.fromOffset(920, 640), UIKit.Colors.Green)

	local header = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	local countLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(150, 44), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = header })
	local equipLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(120, 44), Position = UDim2.fromOffset(150, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = header })
	local searchBox = UIKit.New("TextBox", { Size = UDim2.fromOffset(150, 36), Position = UDim2.fromOffset(276, 4), BackgroundColor3 = Color3.fromRGB(15, 16, 28), PlaceholderText = "🔍 بحث", Text = "", Font = UIKit.Font, TextColor3 = UIKit.Colors.Text, TextSize = 16, ClearTextOnFocus = false, Parent = header }) :: TextBox
	UIKit.Corner(searchBox, 8)
	local sortBtn = UIKit.Button({ Text = "⇅ القوة", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(110, 36), Position = UDim2.fromOffset(432, 4), MaxTextSize = 15, Parent = header })
	UIKit.Button({ Text = "⭐ الأفضل", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -350, 0, 4), MaxTextSize = 15, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("EquipBest", {})
	end)
	UIKit.Button({ Text = "إزالة الكل", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -234, 0, 4), MaxTextSize = 15, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("UnequipAll", {})
	end)
	UIKit.Button({ Text = "🗑️ عاديات", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -118, 0, 4), MaxTextSize = 15, Parent = header }, function()
		local p = DataController.Profile
		if not p then
			return
		end
		local uids = {}
		for _, pet in ipairs(p.Pets) do
			local def = Pets.Get(pet.Id)
			if def and not pet.Locked and not pet.Equipped and pet.Variant == "Normal" and Rarities.Rank(def.Rarity) <= 2 then
				table.insert(uids, pet.Uid)
			end
		end
		if #uids == 0 then
			UIController.Notify("لا يوجد حيوانات عادية للحذف", UIKit.Colors.Muted)
			return
		end
		local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uids = uids })
		if res.ok then
			UIController.Notify("🗑️ تم حذف " .. #uids .. " حيوان عادي", UIKit.Colors.Red)
		end
	end)

	local grid = UIKit.Scroll(w.Content, { Size = UDim2.new(1, -270, 1, -50), Position = UDim2.fromOffset(0, 50) })
	UIKit.Grid(grid, UDim2.fromOffset(112, 122), 8)

	-- لوحة التفاصيل
	local details = UIKit.Frame({ Size = UDim2.fromOffset(260, 0), Position = UDim2.new(1, -260, 0, 50), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Visible = false, Parent = w.Content })
	UIKit.Corner(details, 14)
	UIKit.Padding(details, 10)
	UIKit.List(details, 6, false, true)
	local dVp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 130), BackgroundTransparency = 1, Parent = details })
	local dName = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), MaxTextSize = 20, Parent = details })
	local dRarity = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 20), MaxTextSize = 16, Parent = details })
	local dPower = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 18, Parent = details })
	local dLevel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 15, Parent = details })
	local _, xpFill, xpLabel = UIKit.ProgressBar(details, UIKit.Colors.Cyan, UDim2.new(1, 0, 0, 14))
	local dEnch = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 60), TextColor3 = UIKit.Colors.Green, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 14, Parent = details })
	local equipBtn = UIKit.Button({ Text = "تجهيز", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local enchantBtn = UIKit.Button({ Text = "🔧 إنشانت", Color = UIKit.Colors.Purple, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local lockBtn = UIKit.Button({ Text = "🔒 قفل", Color = UIKit.Colors.Blue, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })
	local deleteBtn = UIKit.Button({ Text = "🗑️ حذف", Color = UIKit.Colors.Red, Size = UDim2.new(1, 0, 0, 38), MaxTextSize = 18, Parent = details })

	local function showDetails(uid: string?)
		selectedUid = uid
		local pet = uid and DataController.FindPet(uid)
		if not pet then
			details.Visible = false
			return
		end
		local def = Pets.Get(pet.Id) :: Pets.PetDef
		details.Visible = true
		for _, c in ipairs(dVp:GetChildren()) do
			c:Destroy()
		end
		PetViewport.Create(dVp, pet.Id, pet.Variant, true)
		dName.Text = PetUtil.DisplayName(pet)
		dRarity.Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or "")
		dRarity.TextColor3 = Rarities.Color(def.Rarity)
		dPower.Text = "⚔️ القوة: " .. Format.Number(PetUtil.BasePower(pet))
		local level = pet.Level or 1
		dLevel.Text = "المستوى " .. level .. " / 50   (+" .. math.floor((level - 1) * 2) .. "% قوة)"
		local needed = PetUtil.XPToNext(level)
		if level >= 50 then
			xpFill.Size = UDim2.fromScale(1, 1)
			xpLabel.Text = "MAX"
		else
			xpFill.Size = UDim2.fromScale(math.clamp((pet.XP or 0) / needed, 0, 1), 1)
			xpLabel.Text = Format.Number(pet.XP or 0) .. " / " .. Format.Number(needed) .. " XP"
		end
		local lines = {}
		local slots = PetUtil.EnchantSlots(pet)
		for i = 1, slots do
			local e = pet.Enchants and pet.Enchants[i]
			table.insert(lines, e and PetUtil.EnchantLabel(e) or ("خانة " .. i .. ": فارغة"))
		end
		dEnch.Text = table.concat(lines, "\n")
		equipBtn.Text = pet.Equipped and "إزالة التجهيز" or "تجهيز"
		equipBtn.BackgroundColor3 = pet.Equipped and UIKit.Colors.Panel3 or UIKit.Colors.Green
		lockBtn.Text = pet.Locked and "🔓 فك القفل" or "🔒 قفل"
		deleteBtn.Visible = not pet.Locked
	end

	equipBtn.Activated:Connect(function()
		local pet = selectedUid and DataController.FindPet(selectedUid)
		if pet then
			local res = Remotes.Function("PetAction"):InvokeServer(pet.Equipped and "Unequip" or "Equip", { Uid = pet.Uid })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)
	enchantBtn.Activated:Connect(function()
		if selectedUid and InventoryUI.OnEnchant then
			InventoryUI.OnEnchant(selectedUid)
		end
	end)
	lockBtn.Activated:Connect(function()
		if selectedUid then
			Remotes.Function("PetAction"):InvokeServer("Lock", { Uid = selectedUid })
		end
	end)
	deleteBtn.Activated:Connect(function()
		if selectedUid then
			local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uid = selectedUid })
			if res.ok then
				showDetails(nil)
			elseif res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local sorted = table.clone(p.Pets)
		sortPets(sorted)
		local seen = {}
		local q = string.lower(search)
		for i, pet in ipairs(sorted) do
			local name = string.lower(PetUtil.DisplayName(pet))
			local visible = q == "" or name:find(q, 1, true) ~= nil
			seen[pet.Uid] = true
			local card = cards[pet.Uid]
			local sig = pet.Variant .. "|" .. (pet.Level or 1) .. "|" .. (pet.Enchants and #pet.Enchants or 0)
			if card and card:GetAttribute("Sig") ~= sig then
				card:Destroy()
				card = nil
				cards[pet.Uid] = nil
			end
			if not card then
				card = InventoryUI.PetCard(grid, pet, function()
					showDetails(pet.Uid)
				end)
				card:SetAttribute("Sig", sig)
				cards[pet.Uid] = card
			end
			card.LayoutOrder = i
			card.Visible = visible
			local badge = card:FindFirstChild("Badge") :: TextLabel
			local lock = card:FindFirstChild("Lock") :: TextLabel
			badge.Text = pet.Equipped and "✅" or ""
			lock.Text = pet.Locked and "🔒" or ""
		end
		for uid, card in pairs(cards) do
			if not seen[uid] then
				card:Destroy()
				cards[uid] = nil
			end
		end
		local equipped = 0
		for _, pet in ipairs(p.Pets) do
			if pet.Equipped then
				equipped += 1
			end
		end
		countLabel.Text = "📦 " .. #p.Pets .. " / " .. (p.StorageCap or 0)
		equipLabel.Text = "مجهز " .. equipped .. " / " .. (p.EquipCap or 0)
		if selectedUid then
			showDetails(selectedUid)
		end
	end

	local MODES = { "Power", "Rarity", "Level", "Newest" }
	local LABELS = { Power = "⇅ القوة", Rarity = "⇅ الندرة", Level = "⇅ المستوى", Newest = "⇅ الأحدث" }
	sortBtn.Activated:Connect(function()
		local idx = table.find(MODES, sortMode) or 1
		sortMode = MODES[idx % #MODES + 1]
		sortBtn.Text = LABELS[sortMode]
		refresh()
	end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		search = searchBox.Text
		refresh()
	end)

	UIController.Register("Inventory", w, refresh)
end

return InventoryUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000046"><Properties><string name="Name">LoadingScreen</string><ProtectedString name="Source"><![CDATA[--!strict
-- شاشة تحميل مع نصائح
local Players = game:GetService("Players")
local UIKit = require(script.Parent.UIKit)

local LoadingScreen = {}

local TIPS = {
	"اضغط على الصناديق لتهاجمها حيواناتك",
	"E لفتح بيضة، R لفتح 3، T للفتح التلقائي",
	"الحيوانات تكسب خبرة مع كل صندوق وتصبح أقوى بالمستويات",
	"آلة الإنشانت تعطي حيواناتك قدرات إضافية",
	"الريبيرث يعطيك مضاعفات دائمة وتوكنات لبيضة الريبيرث",
	"اضغط Q لركوب الهوفربورد",
	"عجلة الحظ مجانية مرة كل يوم",
	"التاجر المتجول يغير بضاعته كل ساعة",
	"الأحداث العالمية كل 7 دقائق: اجمع أصدقاءك لهزيمة الزعيم",
	"ادمج 10 حيوانات دفعة واحدة لأعلى فرصة ترقية",
}

local gui: ScreenGui
local statusLabel: TextLabel

function LoadingScreen.Show()
	gui = Instance.new("ScreenGui")
	gui.Name = "Loading"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local bg = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(18, 20, 40), Parent = gui })
	UIKit.Gradient(bg, Color3.fromRGB(40, 30, 90), Color3.fromRGB(10, 12, 30))
	local title = UIKit.Label({ Text = "🐾 Pet Kingdom Simulator", Size = UDim2.new(1, 0, 0, 90), Position = UDim2.new(0, 0, 0.32, 0), MaxTextSize = 64, TextStrokeTransparency = 0, Parent = bg })
	UIKit.Gradient(title, Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 150, 60))
	statusLabel = UIKit.Label({ Text = "جاري تحميل بياناتك...", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.32, 100), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 22, Parent = bg })
	local tip = UIKit.Label({ Text = "💡 " .. TIPS[math.random(#TIPS)], Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.new(0.1, 0, 0.75, 0), TextColor3 = UIKit.Colors.Cyan, MaxTextSize = 20, Parent = bg })
	local dots = 0
	task.spawn(function()
		while gui and gui.Parent do
			dots = (dots + 1) % 4
			statusLabel.Text = "جاري تحميل بياناتك" .. string.rep(".", dots)
			if dots == 0 then
				tip.Text = "💡 " .. TIPS[math.random(#TIPS)]
			end
			task.wait(0.6)
		end
	end)
end

function LoadingScreen.Hide()
	if gui then
		local g = gui
		gui = nil :: any
		for _, d in ipairs(g:GetDescendants()) do
			if d:IsA("Frame") then
				UIKit.Tween(d, { BackgroundTransparency = 1 }, 0.5)
			elseif d:IsA("TextLabel") then
				UIKit.Tween(d, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
			end
		end
		task.delay(0.55, function()
			g:Destroy()
		end)
	end
end

return LoadingScreen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000047"><Properties><string name="Name">MachineUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نوافذ الآلات: الذهب، قوس قزح، المادة المظلمة، الدمج، الإنشانت + توجيه الـ Prompts للنوافذ الأخرى
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)
local PetViewport = require(script.Parent.PetViewport)

local MachineUI = {}

local INFO = {
	Golden = { Title = "✨ آلة الذهب", Desc = "ضع 3 حيوانات متطابقة (عادية) لتحصل على نسخة ذهبية بقوة x2 (يحتفظ بأعلى مستوى)", Color = UIKit.Colors.Gold, Max = 3 },
	Rainbow = { Title = "🌈 آلة قوس قزح", Desc = "ضع 3 حيوانات ذهبية متطابقة لتحصل على نسخة قوس قزح بقوة x4", Color = UIKit.Colors.Pink, Max = 3 },
	Fuse = { Title = "🔮 آلة الدمج", Desc = "ادمج 3 إلى 10 حيوانات لتحصل على حيوان عشوائي من نفس المنطقة أو أعلى (كلما زاد العدد زادت فرصة الترقية)", Color = UIKit.Colors.Cyan, Max = 10 },
	DarkMatter = { Title = "🌑 آلة المادة المظلمة", Desc = "ضع حيوان قوس قزح + " .. Config.Machines.DarkMatter.CostDiamonds .. " ألماسة، وبعد ساعة يتحول إلى مادة مظلمة بقوة x8", Color = UIKit.Colors.Purple, Max = 1 },
	Enchant = { Title = "🔧 آلة الإنشانت", Desc = "اختر حيواناً ثم أعد لف أي خانة إنشانت بالألماس. الخانات: عادي 1، ذهبي/قوس قزح 2، مادة مظلمة 3", Color = Color3.fromRGB(0, 255, 140), Max = 1 },
}

local currentKind = "Golden"
local selected: { [string]: boolean } = {}
local window: UIKit.Window
local grid: ScrollingFrame
local descLabel: TextLabel
local selectedLabel: TextLabel
local confirmBtn: TextButton
local resultFrame: Frame
local dmList: Frame
local enchantPanel: Frame

local function eligible(kind: string, pet: any): boolean
	if pet.Locked and kind ~= "Enchant" then
		return false
	end
	if kind == "Golden" then
		return pet.Variant == "Normal"
	elseif kind == "Rainbow" then
		return pet.Variant == "Golden"
	elseif kind == "DarkMatter" then
		return pet.Variant == "Rainbow"
	end
	return true
end

local function selectedCount(): number
	local n = 0
	for _ in pairs(selected) do
		n += 1
	end
	return n
end

local function refreshEnchantPanel()
	for _, c in ipairs(enchantPanel:GetChildren()) do
		if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local uid
	for u in pairs(selected) do
		uid = u
	end
	local pet = uid and DataController.FindPet(uid)
	enchantPanel.Visible = currentKind == "Enchant"
	if not pet then
		UIKit.Label({ Text = "اختر حيواناً من القائمة", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = enchantPanel })
		return
	end
	local def = Pets.Get(pet.Id) :: Pets.PetDef
	local cost = Config.EnchantCostPerTier * math.min(def.Tier, 15)
	UIKit.Label({ Text = PetUtil.DisplayName(pet) .. "  •  التكلفة 💎 " .. cost, Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 16, Parent = enchantPanel })
	for i = 1, PetUtil.EnchantSlots(pet) do
		local e = pet.Enchants and pet.Enchants[i]
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = UIKit.Colors.Panel3, Parent = enchantPanel })
		UIKit.Corner(row, 8)
		UIKit.Label({ Text = e and PetUtil.EnchantLabel(e) or ("خانة " .. i .. ": فارغة"), Size = UDim2.new(1, -100, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 13, Parent = row })
		UIKit.Button({ Text = e and "إعادة لف" or "لف", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(86, 32), Position = UDim2.new(1, -92, 0, 6), MaxTextSize = 14, Parent = row }, function()
			local res = Remotes.Function("Machine"):InvokeServer("Enchant", { Uid = pet.Uid, Slot = i })
			if res.ok and res.result then
				UIController.Notify("🔧 " .. PetUtil.EnchantLabel(res.result), UIKit.Colors.Green)
			elseif res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
	end
end

local function refresh()
	local p = DataController.Profile
	if not p then
		return
	end
	local info = INFO[currentKind]
	window.Title.Text = info.Title
	descLabel.Text = info.Desc
	for _, c in ipairs(grid:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local sorted = table.clone(p.Pets)
	PetUtil.SortByPower(sorted)
	local count = 0
	local firstId
	for uid in pairs(selected) do
		local sp = DataController.FindPet(uid)
		if sp then
			firstId = sp.Id
		end
	end
	for i, pet in ipairs(sorted) do
		if eligible(currentKind, pet) then
			if (currentKind == "Golden" or currentKind == "Rainbow") and firstId and pet.Id ~= firstId then
				continue
			end
			local card = InventoryUI.PetCard(grid, pet, function()
				if selected[pet.Uid] then
					selected[pet.Uid] = nil
				else
					if info.Max == 1 then
						selected = {}
					elseif selectedCount() >= info.Max then
						UIController.Notify("الحد الأقصى " .. info.Max, UIKit.Colors.Red)
						return
					end
					selected[pet.Uid] = true
				end
				refresh()
			end)
			card.LayoutOrder = i
			if selected[pet.Uid] then
				local stroke = card:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.Colors.Green
					stroke.Thickness = 4
				end
				local badge = card:FindFirstChild("Badge") :: TextLabel
				badge.Text = "☑️"
			end
			count += 1
		end
	end
	local n = selectedCount()
	selectedLabel.Text = "المختار: " .. n .. " / " .. info.Max .. "   (المتاح: " .. count .. ")"
	local minNeeded = currentKind == "Fuse" and Config.Machines.Fuse.Min or info.Max
	confirmBtn.Visible = currentKind ~= "Enchant"
	confirmBtn.BackgroundColor3 = n >= minNeeded and UIKit.Colors.Green or UIKit.Colors.Panel3
	confirmBtn.Text = currentKind == "DarkMatter" and ("بدء التحويل (💎 " .. Config.Machines.DarkMatter.CostDiamonds .. ")") or "تنفيذ"

	for _, c in ipairs(dmList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	dmList.Visible = currentKind == "DarkMatter"
	if currentKind == "DarkMatter" then
		local now = DataController.ServerTime()
		for i, entry in ipairs(p.DarkMatter) do
			local def = Pets.Get(entry.PetId)
			local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = UIKit.Colors.Panel3, Parent = dmList })
			UIKit.Corner(row, 8)
			local remain = entry.Ready - now
			UIKit.Label({ Text = (def and def.Name or entry.PetId) .. "  " .. (remain > 0 and Format.Time(remain) or "جاهز!"), Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = row })
			UIKit.Button({ Text = "استلام", Color = remain > 0 and UIKit.Colors.Panel2 or UIKit.Colors.Green, Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -96, 0, 5), MaxTextSize = 16, Parent = row }, function()
				local res = Remotes.Function("Machine"):InvokeServer("DarkMatterClaim", { Index = i })
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
		end
	end
	refreshEnchantPanel()
end

local function showResult(pet: any)
	for _, c in ipairs(resultFrame:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
	resultFrame.Visible = true
	local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, Parent = resultFrame })
	PetViewport.Create(vp, pet.Id, pet.Variant, true)
	UIKit.Label({ Text = "🎉 " .. PetUtil.DisplayName(pet) .. "  ⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 1, -40), MaxTextSize = 22, Parent = resultFrame })
	UIKit.Pop(resultFrame)
	task.delay(3, function()
		resultFrame.Visible = false
	end)
end

function MachineUI.Open(kind: string, preselectUid: string?)
	currentKind = kind
	selected = {}
	if preselectUid then
		selected[preselectUid] = true
	end
	resultFrame.Visible = false
	if UIController.IsOpen("Machine") then
		refresh()
	else
		UIController.Open("Machine")
	end
	local info = INFO[kind]
	local stroke = window.Root:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = info.Color
	end
end

function MachineUI.Init()
	local gui = UIController.Gui :: ScreenGui
	window = UIKit.Window(gui, "Machine", "آلة", UDim2.fromOffset(900, 620), UIKit.Colors.Gold)
	descLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = window.Content })
	grid = UIKit.Scroll(window.Content, { Size = UDim2.new(1, -290, 1, -50), Position = UDim2.fromOffset(0, 46) })
	UIKit.Grid(grid, UDim2.fromOffset(112, 122), 8)
	local side = UIKit.Frame({ Size = UDim2.fromOffset(280, 0), Position = UDim2.new(1, -280, 0, 46), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Parent = window.Content })
	UIKit.Corner(side, 14)
	UIKit.Padding(side, 10)
	UIKit.List(side, 8)
	selectedLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 15, Parent = side })
	confirmBtn = UIKit.Button({ Text = "تنفيذ", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 44), MaxTextSize = 20, Parent = side }, function()
		local uids = {}
		for uid in pairs(selected) do
			table.insert(uids, uid)
		end
		local kind = currentKind
		local payload: any = { Uids = uids }
		if kind == "DarkMatter" then
			kind = "DarkMatterStart"
			payload = { Uid = uids[1] }
		end
		local res = Remotes.Function("Machine"):InvokeServer(kind, payload)
		if res.ok then
			selected = {}
			if res.result then
				showResult(res.result)
			else
				UIController.Notify("✅ تم!", UIKit.Colors.Green)
			end
			task.delay(0.2, refresh)
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	UIKit.Button({ Text = "إلغاء الاختيار", Color = UIKit.Colors.Panel3, Size = UDim2.new(1, 0, 0, 36), MaxTextSize = 18, Parent = side }, function()
		selected = {}
		refresh()
	end)
	dmList = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = side })
	UIKit.List(dmList, 6)
	enchantPanel = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, Parent = side })
	UIKit.List(enchantPanel, 6)

	resultFrame = UIKit.Frame({ Size = UDim2.fromOffset(260, 260), Position = UDim2.new(0.5, -130, 0.5, -130), BackgroundColor3 = UIKit.Colors.Panel, Visible = false, ZIndex = 5, Parent = window.Root })
	UIKit.Corner(resultFrame, 16)
	UIKit.Stroke(resultFrame, UIKit.Colors.Gold, 3)

	UIController.Register("Machine", window, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Machine") and currentKind == "DarkMatter" then
				refresh()
			end
		end
	end)

	InventoryUI.OnEnchant = function(uid: string)
		MachineUI.Open("Enchant", uid)
	end

	-- توجيه الـ ProximityPrompt
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local model = prompt:FindFirstAncestorOfClass("Model")
		local kind = model and model:GetAttribute("Machine")
		if type(kind) ~= "string" then
			return
		end
		if INFO[kind] then
			MachineUI.Open(kind)
		elseif kind == "Merchant" then
			UIController.Open("Merchant")
		elseif kind == "Spin" then
			UIController.Open("Spin")
		elseif kind == "Rebirth" then
			UIController.Open("Stats")
		elseif kind == "Trade" then
			UIController.Open("Trade")
		end
	end)
end

return MachineUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000048"><Properties><string name="Name">MerchantUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- التاجر المتجول
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)
local MerchantStock = require(Shared.Modules.MerchantStock)
local Pets = require(Shared.Data.Pets)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)

local MerchantUI = {}

function MerchantUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Merchant", "🧳 التاجر المتجول", UDim2.fromOffset(760, 420), Color3.fromRGB(200, 60, 60))
	local timer = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = w.Content })
	local grid = UIKit.Frame({ Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.Grid(grid, UDim2.fromOffset(170, 250), 10)
	local lastRotation = -1

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local now = DataController.ServerTime()
		local rotation = MerchantStock.RotationId(now)
		timer.Text = "يتغير المخزون بعد " .. Format.Time(MerchantStock.SecondsLeft(now))
		local bought = p.Merchant.Rotation == rotation and p.Merchant.Bought or {}
		if rotation ~= lastRotation then
			for _, c in ipairs(grid:GetChildren()) do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
		end
		lastRotation = rotation
		local stock = MerchantStock.Stock(rotation)
		for slot, item in ipairs(stock) do
			local card = grid:FindFirstChild("Slot" .. slot) :: Frame?
			if not card then
				card = UIKit.Frame({ Name = "Slot" .. slot, LayoutOrder = slot, BackgroundColor3 = UIKit.Colors.Panel2, Parent = grid })
				UIKit.Corner(card, 14)
				UIKit.Stroke(card, UIKit.Colors.Gold, 2)
				local vis = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, Parent = card })
				if item.Type == "Pet" and Pets.Get(item.Key) then
					PetViewport.Create(vis, item.Key, "Normal", true)
				else
					local icon = item.Type == "Potion" and "🧪" or (item.Type == "Spins" and "🎡" or "🔁")
					UIKit.Label({ Text = icon, MaxTextSize = 70, Parent = vis })
				end
				UIKit.Label({ Text = item.Name, Size = UDim2.new(1, -8, 0, 30), Position = UDim2.fromOffset(4, 122), MaxTextSize = 17, Parent = card })
				UIKit.Label({ Name = "Limit", Text = "", Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 152), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
				UIKit.Button({ Name = "Buy", Text = "💎 " .. item.Cost, Color = UIKit.Colors.Green, Size = UDim2.new(1, -16, 0, 40), Position = UDim2.new(0, 8, 1, -48), MaxTextSize = 18, Parent = card }, function()
					local res = Remotes.Function("Merchant"):InvokeServer(slot)
					if not res.ok and res.error then
						UIController.Notify(res.error, UIKit.Colors.Red)
					end
				end)
			end
			local n = bought[tostring(item.PoolIndex)] or 0
			local limitLabel = card:FindFirstChild("Limit") :: TextLabel
			limitLabel.Text = "اشتريت " .. n .. " / " .. item.Limit
			local btn = card:FindFirstChild("Buy") :: TextButton
			btn.BackgroundColor3 = n >= item.Limit and UIKit.Colors.Panel3 or (p.Diamonds >= item.Cost and UIKit.Colors.Green or UIKit.Colors.Panel3)
			btn.Text = n >= item.Limit and "نفد" or ("💎 " .. item.Cost)
		end
	end
	UIController.Register("Merchant", w, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Merchant") then
				refresh()
			end
		end
	end)
end

return MerchantUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000049"><Properties><string name="Name">MissionsUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- المهام اليومية + الإنجازات
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local MissionsUI = {}

local function describe(reward: any): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, "💰 " .. Format.Number(reward.Coins))
	end
	if reward.Diamonds then
		table.insert(parts, "💎 " .. reward.Diamonds)
	end
	if reward.Potion then
		table.insert(parts, "🧪 " .. reward.Potion)
	end
	if reward.Pet then
		table.insert(parts, "🐾 " .. reward.Pet)
	end
	if reward.Spins then
		table.insert(parts, "🎡 " .. reward.Spins)
	end
	return table.concat(parts, " ")
end

function MissionsUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Missions", "📋 المهام والإنجازات", UDim2.fromOffset(760, 600), UIKit.Colors.Cyan)
	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 8, true, true)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function showPage(name: string)
		for n, page in pairs(pages) do
			page.Visible = n == name
			tabButtons[n].BackgroundColor3 = n == name and UIKit.Colors.Cyan or UIKit.Colors.Panel3
		end
	end
	for _, info in ipairs({ { "Missions", "📋 مهام اليوم" }, { "Achievements", "🏅 الإنجازات" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(240, 40), MaxTextSize = 20, Parent = tabs }, function()
			showPage(info[1])
		end)
		pages[info[1]] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), Visible = false })
		UIKit.List(pages[info[1]], 8)
	end

	local resetLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -8, 0, 24), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = pages.Missions })
	local missionRows: { Frame } = {}

	local function rowFor(parent: Instance, title: string, sub: string, progress: number, target: number, claimed: boolean, onClaim: () -> ()): Frame
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 74), BackgroundColor3 = UIKit.Colors.Panel2, Parent = parent })
		UIKit.Corner(row, 12)
		UIKit.Stroke(row, claimed and UIKit.Colors.Panel3 or (progress >= target and UIKit.Colors.Green or UIKit.Colors.Panel3), 2)
		UIKit.Label({ Text = title, Size = UDim2.new(1, -190, 0, 28), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		UIKit.Label({ Text = sub, Size = UDim2.new(1, -190, 0, 20), Position = UDim2.fromOffset(12, 32), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Gold, MaxTextSize = 15, Parent = row })
		local _, fill, label = UIKit.ProgressBar(row, UIKit.Colors.Cyan, UDim2.new(1, -200, 0, 12), UDim2.fromOffset(12, 56))
		fill.Size = UDim2.fromScale(math.clamp(progress / math.max(1, target), 0, 1), 1)
		label.Text = ""
		local btn = UIKit.Button({ Text = claimed and "✅" or (progress >= target and "استلام" or Format.Number(progress) .. " / " .. Format.Number(target)), Color = claimed and UIKit.Colors.Panel3 or (progress >= target and UIKit.Colors.Green or UIKit.Colors.Panel3), Size = UDim2.fromOffset(160, 44), Position = UDim2.new(1, -170, 0, 15), MaxTextSize = 17, Parent = row })
		if not claimed and progress >= target then
			btn.Activated:Connect(onClaim)
		end
		return row
	end

	local achRows: { Frame } = {}

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for _, r in ipairs(missionRows) do
			r:Destroy()
		end
		missionRows = {}
		local now = DataController.ServerTime()
		resetLabel.Text = "تتجدد المهام بعد " .. Format.Time(86400 - (now % 86400))
		for i, m in ipairs(p.Missions.List or {}) do
			local title = (m.Name:gsub("{n}", Format.Number(m.Target)))
			local row = rowFor(pages.Missions, title, "المكافأة: " .. describe(m.Reward), m.Progress, m.Target, m.Claimed, function()
				local res = Remotes.Function("ClaimMission"):InvokeServer(i)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
			row.LayoutOrder = i
			table.insert(missionRows, row)
		end
		for _, r in ipairs(achRows) do
			r:Destroy()
		end
		achRows = {}
		for i, a in ipairs(Config.Achievements) do
			local value = p.Stats[a.Stat] or 0
			local row = rowFor(pages.Achievements, a.Name, "المكافأة: " .. describe(a.Reward), value, a.Target, p.Achievements[a.Id] == true, function()
				local res = Remotes.Function("ClaimAchievement"):InvokeServer(a.Id)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
			row.LayoutOrder = i
			table.insert(achRows, row)
		end
	end

	showPage("Missions")
	UIController.Register("Missions", w, refresh)
end

return MissionsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000050"><Properties><string name="Name">PetController</string><ProtectedString name="Source"><![CDATA[--!strict
-- يعرض حيوانات كل اللاعبين ويحركها خلفهم، وتهاجم الهدف عند الضرب
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)
local DataController = require(script.Parent.DataController)

local PetController = {}

type Rendered = { Uid: string, Model: Model, Pos: Vector3, Seed: number }
local rendered: { [Player]: { Rendered } } = {}
local folder: Folder
local localPlayer = Players.LocalPlayer

local function rebuild(player: Player)
	local list = rendered[player] or {}
	local raw = player:GetAttribute("EquippedPets")
	local wanted = {}
	if type(raw) == "string" and raw ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			wanted = decoded
		end
	end
	-- إزالة غير الموجود
	local keep = {}
	for _, r in ipairs(list) do
		local found = false
		for _, w in ipairs(wanted) do
			if w.Uid == r.Uid then
				found = true
			end
		end
		if found then
			table.insert(keep, r)
		else
			r.Model:Destroy()
		end
	end
	-- إضافة الجديد
	for _, w in ipairs(wanted) do
		local exists = false
		for _, r in ipairs(keep) do
			if r.Uid == w.Uid then
				exists = true
			end
		end
		if not exists then
			local model = PetModelBuilder.Build(w.Id, w.Variant)
			if model then
				model.Name = player.Name .. "_" .. w.Uid
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local start = hrp and hrp.Position or Vector3.new()
				model:PivotTo(CFrame.new(start))
				model.Parent = folder
				table.insert(keep, { Uid = w.Uid, Model = model, Pos = start, Seed = math.random() * 10 })
			end
		end
	end
	rendered[player] = keep
end

local function hookPlayer(player: Player)
	rendered[player] = {}
	rebuild(player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function unhookPlayer(player: Player)
	local list = rendered[player]
	if list then
		for _, r in ipairs(list) do
			r.Model:Destroy()
		end
	end
	rendered[player] = nil
end

local function findBreakable(id: string): Model?
	local bf = Workspace:FindFirstChild("Breakables")
	return bf and bf:FindFirstChild(id) :: Model?
end

local function step(dt: number)
	local now = os.clock()
	local hideOthers = DataController.Profile and DataController.Profile.Settings and DataController.Profile.Settings.HideOthersPets
	for player, list in pairs(rendered) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hide = hideOthers and player ~= localPlayer
		if not hrp then
			for _, r in ipairs(list) do
				r.Model:PivotTo(CFrame.new(0, -500, 0))
			end
			continue
		end
		local targetId = player:GetAttribute("Target")
		local targetModel = (type(targetId) == "string" and targetId ~= "") and findBreakable(targetId) or nil
		local targetPart = targetModel and targetModel.PrimaryPart
		local n = #list
		for i, r in ipairs(list) do
			if hide then
				r.Model:PivotTo(CFrame.new(0, -500, 0))
				continue
			end
			local goal: Vector3
			local look: Vector3
			if targetPart then
				-- دائرة حول الهدف
				local ang = (i / n) * math.pi * 2 + now * 0.3
				local radius = math.max(targetPart.Size.X, targetPart.Size.Z) * 0.5 + 3.5
				local center = targetPart.Position
				goal = center + Vector3.new(math.cos(ang) * radius, 1.5, math.sin(ang) * radius)
				-- اندفاع نحو الهدف كل ثانية
				local phase = (now + r.Seed) % 1
				local lunge = phase < 0.25 and math.sin(phase / 0.25 * math.pi) * 2 or 0
				goal = goal + (center - goal).Unit * lunge
				look = center
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local scale = tonumber(r.Model:GetAttribute("Scale")) or 1
				local offset = Vector3.new((col - 1) * 3.4 * math.max(1, scale * 0.8), 0, 3.5 + row * 3.4 * math.max(1, scale * 0.8))
				goal = (hrp.CFrame * CFrame.new(offset)).Position
				goal = Vector3.new(goal.X, hrp.Position.Y - 1.6 + (scale - 1) * 1.2, goal.Z)
				look = goal + hrp.CFrame.LookVector
			end
			local bob = math.sin(now * 4 + r.Seed) * 0.35
			r.Pos = r.Pos:Lerp(goal, math.min(1, dt * 7))
			local pos = r.Pos + Vector3.new(0, bob + 1.2, 0)
			local flatLook = Vector3.new(look.X, pos.Y, look.Z)
			if (flatLook - pos).Magnitude < 0.1 then
				flatLook = pos + hrp.CFrame.LookVector
			end
			r.Model:PivotTo(CFrame.lookAt(pos, flatLook))
		end
	end
end

function PetController.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(unhookPlayer)
	RunService.Heartbeat:Connect(step)
end

return PetController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000051"><Properties><string name="Name">PetViewport</string><ProtectedString name="Source"><![CDATA[--!strict
-- عرض حيوان داخل ViewportFrame (للمخزن، البيض، الفتح)
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)

local PetViewport = {}

function PetViewport.Create(parent: Instance, petId: string, variant: string?, spin: boolean?): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	local model = PetModelBuilder.Build(petId, variant)
	if model then
		model:PivotTo(CFrame.new())
		model.Parent = vp
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.new(Vector3.new(2.2, 1.6, -4.6), Vector3.new(0, 0.1, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	if spin and model then
		local angle = 0
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not vp.Parent then
				conn:Disconnect()
				return
			end
			angle += dt * 1.2
			model:PivotTo(CFrame.Angles(0, angle, 0))
		end)
	end
	return vp
end

return PetViewport
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000052"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- المتجر: الجيم باس، الألماس والجرعات، الترقيات، الهوفربورد
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local ShopUI = {}

local function upgradeCost(u: any, level: number): number?
	if level >= u.MaxLevel then
		return nil
	end
	return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
end

function ShopUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Shop", "🛒 المتجر", UDim2.fromOffset(860, 620), UIKit.Colors.Blue)

	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 6, true, true)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function showPage(name: string)
		for n, page in pairs(pages) do
			page.Visible = n == name
			tabButtons[n].BackgroundColor3 = n == name and UIKit.Colors.Blue or UIKit.Colors.Panel3
		end
	end
	for _, info in ipairs({ { "Gamepasses", "🎟️ جيم باس" }, { "Diamonds", "💎 ألماس" }, { "Upgrades", "⬆️ ترقيات" }, { "Potions", "🧪 جرعات" }, { "Boards", "🛹 هوفربورد" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(158, 40), MaxTextSize = 17, Parent = tabs }, function()
			showPage(info[1])
		end)
		pages[info[1]] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), Visible = false })
		UIKit.Grid(pages[info[1]], UDim2.fromOffset(260, 150), 10)
	end

	local passCards: { [string]: TextButton } = {}
	for i, gp in ipairs(Config.GamepassInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Gamepasses })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Gold, 2)
		UIKit.Label({ Text = gp.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = gp.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = gp.Desc, Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 56), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		passCards[gp.Key] = UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Green, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", gp.Key)
		end)
	end

	for i, pr in ipairs(Config.DevProductInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Diamonds })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Cyan, 2)
		UIKit.Label({ Text = pr.Icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 8), Parent = card })
		UIKit.Label({ Text = pr.Name, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 70), MaxTextSize = 20, Parent = card })
		UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Cyan, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Product", pr.Key)
		end)
	end

	local upgradeRows: { [string]: { Btn: TextButton, Level: TextLabel, Bar: Frame } } = {}
	for i, u in ipairs(Config.Upgrades) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Upgrades })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Purple, 2)
		UIKit.Label({ Text = u.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = u.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = u.Desc, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 54), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, Parent = card })
		local level = UIKit.Label({ Text = "", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 76), MaxTextSize = 15, Parent = card })
		local _, fill = UIKit.ProgressBar(card, UIKit.Colors.Purple, UDim2.new(1, -16, 0, 8), UDim2.fromOffset(8, 98))
		local btn = UIKit.Button({ Text = "", Color = UIKit.Colors.Purple, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local res = Remotes.Function("BuyUpgrade"):InvokeServer(u.Key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		upgradeRows[u.Key] = { Btn = btn, Level = level, Bar = fill }
	end

	-- الجرعات
	local potionRows: { [string]: { Btn: TextButton, Count: TextLabel } } = {}
	for i, key in ipairs(Config.PotionOrder) do
		local cfg = Config.Potions[key]
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Potions })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Purple, 2)
		UIKit.Label({ Text = cfg.Icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 6), Parent = card })
		UIKit.Label({ Text = cfg.Name .. " (x" .. cfg.Mult .. " لمدة " .. Format.Time(cfg.Duration) .. ")", Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 66), MaxTextSize = 16, Parent = card })
		local count = UIKit.Label({ Text = "", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 90), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
		local btn = UIKit.Button({ Text = "💎 " .. cfg.Cost, Color = UIKit.Colors.Purple, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local res = Remotes.Function("BuyPotion"):InvokeServer(key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		potionRows[key] = { Btn = btn, Count = count }
	end

	-- الهوفربورد
	local boardRows: { [string]: { Btn: TextButton, Swatch: Frame } } = {}
	for i, b in ipairs(Config.Hoverboards) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Boards })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, b.Color, 2)
		local swatch = UIKit.Frame({ Size = UDim2.fromOffset(120, 22), Position = UDim2.new(0.5, -60, 0, 18), BackgroundColor3 = b.Color, Parent = card })
		UIKit.Corner(swatch, 11)
		UIKit.Label({ Text = b.Icon .. " " .. b.Name, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 48), MaxTextSize = 20, Parent = card })
		UIKit.Label({ Text = "+" .. b.Speed .. " سرعة  •  اضغط Q للركوب", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 78), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = card })
		local btn = UIKit.Button({ Text = "💎 " .. Format.Number(b.Cost), Color = UIKit.Colors.Cyan, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local p = DataController.Profile
			local owned = p and p.Hoverboards.Owned[b.Id]
			local res = Remotes.Function("Hoverboard"):InvokeServer(owned and "Equip" or "Buy", b.Id)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		boardRows[b.Id] = { Btn = btn, Swatch = swatch }
	end

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for key, btn in pairs(passCards) do
			local owned = DataController.Owns(key)
			btn.Text = owned and "✅ مملوك" or "شراء"
			btn.BackgroundColor3 = owned and UIKit.Colors.Panel3 or UIKit.Colors.Green
		end
		for _, u in ipairs(Config.Upgrades) do
			local row = upgradeRows[u.Key]
			local level = p.Upgrades[u.Key] or 0
			local cost = upgradeCost(u, level)
			row.Level.Text = "المستوى " .. level .. " / " .. u.MaxLevel
			row.Bar.Size = UDim2.fromScale(level / u.MaxLevel, 1)
			if cost then
				row.Btn.Text = "💎 " .. Format.Number(cost)
				row.Btn.BackgroundColor3 = p.Diamonds >= cost and UIKit.Colors.Purple or UIKit.Colors.Panel3
			else
				row.Btn.Text = "الحد الأقصى"
				row.Btn.BackgroundColor3 = UIKit.Colors.Panel3
			end
		end
		for key, row in pairs(potionRows) do
			row.Count.Text = "في الحقيبة: " .. (p.PotionBag[key] or 0)
			row.Btn.BackgroundColor3 = p.Diamonds >= Config.Potions[key].Cost and UIKit.Colors.Purple or UIKit.Colors.Panel3
		end
		for _, b in ipairs(Config.Hoverboards) do
			local row = boardRows[b.Id]
			local owned = p.Hoverboards.Owned[b.Id]
			if owned then
				local eq = p.Hoverboards.Equipped == b.Id
				row.Btn.Text = eq and "✅ مجهز" or "تجهيز"
				row.Btn.BackgroundColor3 = eq and UIKit.Colors.Panel3 or UIKit.Colors.Green
			else
				row.Btn.Text = "💎 " .. Format.Number(b.Cost)
				row.Btn.BackgroundColor3 = p.Diamonds >= b.Cost and UIKit.Colors.Cyan or UIKit.Colors.Panel3
			end
		end
	end

	showPage("Gamepasses")
	UIController.Register("Shop", w, refresh)
end

return ShopUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000053"><Properties><string name="Name">SpinUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- عجلة الحظ مع أنيميشن الدوران
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local EffectsController = require(script.Parent.EffectsController)

local SpinUI = {}
local spinning = false

function SpinUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Spin", "🎡 عجلة الحظ", UDim2.fromOffset(560, 600), UIKit.Colors.Gold)
	local wheel = UIKit.Frame({ Size = UDim2.fromOffset(340, 340), Position = UDim2.new(0.5, -170, 0, 10), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
	UIKit.Corner(wheel, 170)
	UIKit.Stroke(wheel, UIKit.Colors.Gold, 4)
	local n = #Config.Spin.Segments
	local colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 255, 120), Color3.fromRGB(200, 100, 255), Color3.fromRGB(255, 150, 60), Color3.fromRGB(80, 255, 220), Color3.fromRGB(255, 120, 200) }
	for i, seg in ipairs(Config.Spin.Segments) do
		local ang = (i - 1) / n * 360
		local holder = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Rotation = ang, Parent = wheel })
		local chip = UIKit.Frame({ Size = UDim2.fromOffset(96, 44), Position = UDim2.new(0.5, -48, 0, 14), BackgroundColor3 = colors[(i - 1) % #colors + 1], Parent = holder })
		UIKit.Corner(chip, 10)
		UIKit.Label({ Text = seg.Label, MaxTextSize = 15, Parent = chip })
	end
	local pointer = UIKit.Label({ Text = "▼", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.5, -20, 0, -22), TextColor3 = UIKit.Colors.Red, MaxTextSize = 40, ZIndex = 3, Parent = w.Content })
	pointer.TextStrokeTransparency = 0
	local info = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 360), MaxTextSize = 18, TextColor3 = UIKit.Colors.Muted, Parent = w.Content })
	local result = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 392), MaxTextSize = 22, TextColor3 = UIKit.Colors.Gold, Parent = w.Content })
	local btns = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 440), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(btns, 10, true, true)
	local spinBtn = UIKit.Button({ Text = "لف!", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(200, 48), MaxTextSize = 22, Parent = btns })
	local buyBtn = UIKit.Button({ Text = "لفة بـ 💎 " .. Config.Spin.ExtraSpinCost, Color = UIKit.Colors.Cyan, Size = UDim2.fromOffset(200, 48), MaxTextSize = 18, Parent = btns })

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local free = p.FreeSpin == true
		info.Text = (free and "🎁 لفة مجانية متاحة!" or "اللفة المجانية القادمة غداً") .. "   •   لفات إضافية: " .. (p.Spins or 0)
		spinBtn.BackgroundColor3 = (free or (p.Spins or 0) > 0) and UIKit.Colors.Green or UIKit.Colors.Panel3
	end

	local function doSpin(paid: boolean)
		if spinning then
			return
		end
		local res = Remotes.Function("Spin"):InvokeServer(paid)
		if not res.ok then
			UIController.Notify(res.error or "خطأ", UIKit.Colors.Red)
			return
		end
		spinning = true
		result.Text = ""
		EffectsController.Play("Spin")
		local target = -((res.index - 1) / n * 360) - 360 * 5
		wheel.Rotation = 0
		local tween = TweenService:Create(wheel, TweenInfo.new(3.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = target })
		tween:Play()
		tween.Completed:Wait()
		result.Text = "🎉 " .. tostring(res.reward)
		UIKit.Pop(result)
		spinning = false
		refresh()
	end
	spinBtn.Activated:Connect(function()
		doSpin(false)
	end)
	buyBtn.Activated:Connect(function()
		doSpin(true)
	end)
	UIController.Register("Spin", w, refresh)
end

return SpinUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000054"><Properties><string name="Name">StatsUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- الإحصائيات + الإتقان + الريبيرث + تفاصيل المضاعفات
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Mastery = require(Shared.Modules.Mastery)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local StatsUI = {}

function StatsUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Stats", "📊 الإحصائيات والريبيرث", UDim2.fromOffset(820, 620), Color3.fromRGB(255, 140, 60))
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 10)

	-- الريبيرث
	local rb = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 130), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
	UIKit.Corner(rb, 14)
	UIKit.Stroke(rb, Color3.fromRGB(255, 140, 60), 2)
	UIKit.Label({ Text = "🔁 الريبيرث", Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = rb })
	local rbDesc = UIKit.Label({ Text = "", Size = UDim2.new(1, -220, 0, 60), Position = UDim2.fromOffset(12, 40), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = rb })
	local rbBtn = UIKit.Button({ Text = "ريبيرث", Color = Color3.fromRGB(255, 140, 60), Size = UDim2.fromOffset(190, 52), Position = UDim2.new(1, -202, 0, 40), MaxTextSize = 20, Parent = rb }, function()
		local res = Remotes.Function("Rebirth"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		else
			UIController.Close()
		end
	end)

	-- المضاعفات
	local mult = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 96), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
	UIKit.Corner(mult, 14)
	local multLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxTextSize = 17, Parent = mult })

	-- الإتقان
	UIKit.Label({ Text = "🏆 الإتقان (Mastery)", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local masteryRows = {}
	for _, cfg in ipairs(Config.Mastery) do
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 66), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 12)
		local title = UIKit.Label({ Text = cfg.Icon .. " " .. cfg.Name, Size = UDim2.new(0.6, 0, 0, 28), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 19, Parent = row })
		local bonus = UIKit.Label({ Text = "", Size = UDim2.new(0.4, -12, 0, 28), Position = UDim2.new(0.6, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UIKit.Colors.Green, MaxTextSize = 16, Parent = row })
		local _, fill, label = UIKit.ProgressBar(row, UIKit.Colors.Gold, UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 36))
		masteryRows[cfg.Key] = { Title = title, Bonus = bonus, Fill = fill, Label = label }
	end

	-- الإحصائيات
	UIKit.Label({ Text = "📈 الإحصائيات", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = scroll })
	local statsGrid = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 260), BackgroundTransparency = 1, Parent = scroll })
	UIKit.Grid(statsGrid, UDim2.fromOffset(190, 56), 8)
	local statLabels = {}
	local STATS = {
		{ "Hatches", "🥚 بيض مفتوح" }, { "Breaks", "💥 صناديق مكسورة" }, { "CoinsEarned", "💰 عملات مكتسبة" }, { "DiamondsEarned", "💎 ألماس مكتسب" },
		{ "Damage", "⚔️ ضرر كلي" }, { "Fusions", "🔮 دمج" }, { "Goldens", "✨ ذهبي" }, { "Rainbows", "🌈 قوس قزح" },
		{ "DarkMatters", "🌑 مادة مظلمة" }, { "BossKills", "👹 زعماء" }, { "Trades", "🤝 تبادلات" }, { "Enchants", "🔧 إنشانت" },
		{ "Spins", "🎡 لفات" }, { "BestPet", "🏅 أقوى حيوان" }, { "Playtime", "⏱️ وقت اللعب" },
	}
	for i, s in ipairs(STATS) do
		local cell = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = statsGrid })
		UIKit.Corner(cell, 10)
		UIKit.Label({ Text = s[2], Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 2), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 14, Parent = cell })
		statLabels[s[1]] = UIKit.Label({ Text = "0", Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, 24), MaxTextSize = 20, Parent = cell })
	end

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local cost = p.RebirthCost or 0
		local next = (p.Rebirths or 0) + 1
		rbDesc.Text = string.format("التكلفة: 💰 %s  •  يتطلب فتح المنطقة %d\nيعيد العملات والمناطق 2–10، وتحصل على: +%d%% عملات، +%d%% حظ، +%d%% قوة، +%d توكن (دائم)",
			Format.Number(cost), Config.Rebirth.RequiredZone,
			math.floor(Config.Rebirth.CoinsPerRebirth * 100), math.floor(Config.Rebirth.LuckPerRebirth * 100), math.floor(Config.Rebirth.DamagePerRebirth * 100), Config.Rebirth.TokensPerRebirth)
		local can = p.Coins >= cost and p.UnlockedZones[tostring(Config.Rebirth.RequiredZone)]
		rbBtn.Text = "ريبيرث #" .. next
		rbBtn.BackgroundColor3 = can and Color3.fromRGB(255, 140, 60) or UIKit.Colors.Panel3
		multLabel.Text = string.format("💰 عملات x%.2f    🍀 حظ x%.2f    ⚔️ قوة x%.2f    💎 ألماس x%.2f\n🔁 ريبيرث: %d    🔧 إنشانت: عملات +%d%% / قوة +%d%% / حظ +%d%% / قاضية %d%%",
			p.CoinMult or 1, p.Luck or 1, p.DamageMult or 1, p.DiamondMult or 1, p.Rebirths or 0,
			math.floor(((p.Enchants and p.Enchants.Coins) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Damage) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Luck) or 0) * 100), math.floor(((p.Enchants and p.Enchants.Crit) or 0) * 100))
		for _, cfg in ipairs(Config.Mastery) do
			local row = masteryRows[cfg.Key]
			local level, value, needed = Mastery.Progress(cfg, p.Stats[cfg.Stat] or 0)
			row.Title.Text = cfg.Icon .. " " .. cfg.Name .. "  Lv." .. level
			local perks = {}
			for k, v in pairs(cfg.PerLevel) do
				table.insert(perks, "+" .. math.floor(v * level * 100 + 0.5) .. "% " .. k)
			end
			row.Bonus.Text = table.concat(perks, " ")
			if needed > 0 then
				local prev = level > 0 and Mastery.Threshold(cfg, level) or 0
				row.Fill.Size = UDim2.fromScale(math.clamp((value - prev) / math.max(1, needed - prev), 0, 1), 1)
				row.Label.Text = Format.Number(value) .. " / " .. Format.Number(needed)
			else
				row.Fill.Size = UDim2.fromScale(1, 1)
				row.Label.Text = "الحد الأقصى"
			end
		end
		for key, label in pairs(statLabels) do
			local v = p.Stats[key] or 0
			if key == "Playtime" then
				label.Text = Format.Time(v + (DataController.ServerTime() - (p.SessionStart or 0)))
			else
				label.Text = Format.Number(v)
			end
		end
	end
	UIController.Register("Stats", w, refresh)
end

return StatsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000055"><Properties><string name="Name">TradeUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- قائمة اللاعبين + نافذة التبادل + طلب وارد
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local PetUtil = require(Shared.Modules.PetUtil)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)

local TradeUI = {}

local state: any = nil
local tradeWindow: UIKit.Window
local myGrid: ScrollingFrame
local theirGrid: ScrollingFrame
local invGrid: ScrollingFrame
local statusLabel: TextLabel
local confirmBtn: TextButton
local partnerLabel: TextLabel

local function clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
end

local function refreshTrade()
	if not state then
		return
	end
	local p = DataController.Profile
	partnerLabel.Text = "🤝 تبادل مع " .. state.Partner.DisplayName
	clear(myGrid)
	clear(theirGrid)
	clear(invGrid)
	local offered = {}
	for i, pet in ipairs(state.MyOffer) do
		offered[pet.Uid] = true
		local card = InventoryUI.PetCard(myGrid, pet, function()
			Remotes.Event("TradeAction"):FireServer("Remove", { Uid = pet.Uid })
		end)
		card.LayoutOrder = i
	end
	for i, pet in ipairs(state.TheirOffer) do
		local card = InventoryUI.PetCard(theirGrid, pet)
		card.LayoutOrder = i
	end
	if p then
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		for i, pet in ipairs(sorted) do
			if not offered[pet.Uid] and not pet.Locked then
				local card = InventoryUI.PetCard(invGrid, pet, function()
					Remotes.Event("TradeAction"):FireServer("Add", { Uid = pet.Uid })
				end)
				card.LayoutOrder = i
			end
		end
	end
	local mine, theirs = state.MyConfirmed, state.TheirConfirmed
	if state.Countdown then
		statusLabel.Text = "⏳ يتم التبادل خلال " .. state.Countdown .. "..."
		statusLabel.TextColor3 = UIKit.Colors.Gold
	else
		statusLabel.Text = (mine and "✅ أكدت" or "⬜ لم تؤكد") .. "   •   " .. (theirs and "✅ الطرف الآخر أكد" or "⬜ الطرف الآخر لم يؤكد")
		statusLabel.TextColor3 = UIKit.Colors.Muted
	end
	confirmBtn.Text = mine and "إلغاء التأكيد" or "✅ تأكيد"
	confirmBtn.BackgroundColor3 = mine and UIKit.Colors.Panel3 or UIKit.Colors.Green
end

function TradeUI.Init()
	local gui = UIController.Gui :: ScreenGui

	-- قائمة اللاعبين
	local list = UIKit.Window(gui, "Trade", "🤝 التبادل — اللاعبون", UDim2.fromOffset(460, 520), Color3.fromRGB(60, 120, 220))
	UIKit.Label({ Text = "اختر لاعباً لإرسال طلب تبادل. الحد " .. Config.TradeMaxPets .. " حيوانات لكل طرف.", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = list.Content })
	local scroll = UIKit.Scroll(list.Content, { Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 44) })
	UIKit.List(scroll, 6)
	local function refreshList()
		clear(scroll)
		local me = Players.LocalPlayer
		local any = false
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= me then
				any = true
				local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 52), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
				UIKit.Corner(row, 10)
				UIKit.Label({ Text = pl.DisplayName .. "  (@" .. pl.Name .. ")", Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 18, Parent = row })
				UIKit.Button({ Text = "طلب تبادل", Color = UIKit.Colors.Blue, Size = UDim2.fromOffset(130, 38), Position = UDim2.new(1, -140, 0, 7), MaxTextSize = 16, Parent = row }, function()
					Remotes.Event("TradeRequest"):FireServer(pl.UserId)
				end)
			end
		end
		if not any then
			UIKit.Label({ Text = "لا يوجد لاعبون آخرون في السيرفر", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = scroll })
		end
	end
	UIController.Register("Trade", list, refreshList)

	-- نافذة التبادل
	tradeWindow = UIKit.Window(gui, "TradeSession", "🤝 تبادل", UDim2.fromOffset(940, 640), Color3.fromRGB(60, 120, 220))
	partnerLabel = tradeWindow.Title
	local left = UIKit.Frame({ Size = UDim2.new(0.5, -6, 0, 250), BackgroundColor3 = UIKit.Colors.Panel2, Parent = tradeWindow.Content })
	UIKit.Corner(left, 12)
	UIKit.Label({ Text = "عرضي", Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 18, Parent = left })
	myGrid = UIKit.Scroll(left, { Size = UDim2.new(1, -8, 1, -30), Position = UDim2.fromOffset(4, 28) })
	UIKit.Grid(myGrid, UDim2.fromOffset(100, 118), 6)
	local right = UIKit.Frame({ Size = UDim2.new(0.5, -6, 0, 250), Position = UDim2.new(0.5, 6, 0, 0), BackgroundColor3 = UIKit.Colors.Panel2, Parent = tradeWindow.Content })
	UIKit.Corner(right, 12)
	UIKit.Label({ Text = "عرض الطرف الآخر", Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 18, Parent = right })
	theirGrid = UIKit.Scroll(right, { Size = UDim2.new(1, -8, 1, -30), Position = UDim2.fromOffset(4, 28) })
	UIKit.Grid(theirGrid, UDim2.fromOffset(100, 118), 6)
	statusLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -240, 0, 40), Position = UDim2.fromOffset(0, 256), MaxTextSize = 18, Parent = tradeWindow.Content })
	confirmBtn = UIKit.Button({ Text = "تأكيد", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -230, 0, 256), MaxTextSize = 18, Parent = tradeWindow.Content }, function()
		Remotes.Event("TradeAction"):FireServer("Confirm", {})
	end)
	UIKit.Button({ Text = "إلغاء", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(110, 40), Position = UDim2.new(1, -110, 0, 256), MaxTextSize = 18, Parent = tradeWindow.Content }, function()
		Remotes.Event("TradeAction"):FireServer("Cancel", {})
	end)
	UIKit.Label({ Text = "حيواناتك (اضغط للإضافة)", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 300), MaxTextSize = 16, TextColor3 = UIKit.Colors.Muted, Parent = tradeWindow.Content })
	invGrid = UIKit.Scroll(tradeWindow.Content, { Size = UDim2.new(1, 0, 1, -326), Position = UDim2.fromOffset(0, 326) })
	UIKit.Grid(invGrid, UDim2.fromOffset(100, 118), 6)
	tradeWindow.Close.Activated:Connect(function()
		Remotes.Event("TradeAction"):FireServer("Cancel", {})
	end)
	UIController.Register("TradeSession", tradeWindow, refreshTrade)

	Remotes.Event("TradeUpdate").OnClientEvent:Connect(function(data)
		state = data
		if data then
			if not UIController.IsOpen("TradeSession") then
				UIController.Open("TradeSession")
			else
				refreshTrade()
			end
		elseif UIController.IsOpen("TradeSession") then
			UIController.Close()
		end
	end)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("TradeSession") then
			refreshTrade()
		end
	end)

	-- طلب وارد
	Remotes.Event("TradeIncoming").OnClientEvent:Connect(function(data)
		local popup = UIKit.Frame({ Size = UDim2.fromOffset(360, 120), Position = UDim2.new(0.5, -180, 0, 200), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 20, Parent = gui })
		UIKit.Corner(popup, 14)
		UIKit.Stroke(popup, UIKit.Colors.Blue, 3)
		UIKit.Label({ Text = "🤝 " .. data.FromName .. " يريد التبادل معك", Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 6), MaxTextSize = 20, ZIndex = 21, Parent = popup })
		UIKit.Button({ Text = "قبول", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(150, 40), Position = UDim2.fromOffset(20, 66), MaxTextSize = 18, ZIndex = 21, Parent = popup }, function()
			Remotes.Event("TradeRespond"):FireServer(data.FromUserId, true)
			popup:Destroy()
		end)
		UIKit.Button({ Text = "رفض", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -170, 0, 66), MaxTextSize = 18, ZIndex = 21, Parent = popup }, function()
			Remotes.Event("TradeRespond"):FireServer(data.FromUserId, false)
			popup:Destroy()
		end)
		UIKit.Pop(popup)
		task.delay(20, function()
			if popup.Parent then
				popup:Destroy()
			end
		end)
	end)
end

return TradeUI
