end

SHAPES.alien = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2.2, 2), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.75), 0.5, 0.6, c2)
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2
		local t = part(m, "Tentacle", Vector3.new(0.4, 1.2, 0.4), body.CFrame * CFrame.new(math.cos(ang) * 0.8, -1.2, math.sin(ang) * 0.8) * CFrame.Angles(math.sin(ang) * 0.3, 0, -math.cos(ang) * 0.3), c1, "ball")
		t.Name = "Tentacle"
	end
	mouth(m, body, CFrame.new(0, -0.4, -0.95), c2)
	return body
end

SHAPES.demon = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.1, 2.1, 2.1), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.85), 0.45, 0.36, c2)
	horns(m, body, c2, 2)
	wings(m, body, Color3.fromRGB(40, 0, 60), 1.5)
	tail(m, body, c1, "long")
	local mouthPart = part(m, "Mouth", Vector3.new(0.9, 0.25, 0.2), body.CFrame * CFrame.new(0, -0.35, -1.0), Color3.new(0, 0, 0))
	mouthPart.Material = Enum.Material.Neon
	mouthPart.Color = c2
	feet(m, body, c2)
	return body
end

-- يبني النموذج. variant: Normal/Golden/Rainbow/DarkMatter
function Builder.Build(petId: string, variant: string?): Model?
	local def = Pets.Get(petId)
	if not def then
		return nil
	end
	variant = variant or "Normal"
	local c1, c2 = def.Primary, def.Secondary
	if variant == "Golden" then
		c1, c2 = GOLD, GOLD2
	elseif variant == "DarkMatter" then
		c1, c2 = DARK, DARK2
	end

	local model = Instance.new("Model")
	model.Name = petId
	local builder = SHAPES[def.Shape] or SHAPES.blob
	local body = builder(model, c1, c2)
	model.PrimaryPart = body
	model:SetAttribute("PetId", petId)
	model:SetAttribute("Variant", variant)

	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			if variant == "Golden" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p.Material = Enum.Material.Metal
				p.Reflectance = 0.25
			elseif variant == "DarkMatter" then
				if p.Name == "Body" or p.Name == "Ear" or p.Name == "Arm" or p.Name == "Wing" then
					p.Material = Enum.Material.Slate
				elseif p.Name ~= "Eye" and p.Name ~= "Shine" then
					p.Material = Enum.Material.Neon
				end
			elseif variant == "Rainbow" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p:SetAttribute("Rainbow", true)
			end
		end
	end

	if variant == "DarkMatter" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(DARK2, Color3.fromRGB(60, 0, 120))
		pe.Size = NumberSequence.new(0.35, 0)
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Lifetime = NumberRange.new(0.6, 1.2)
		pe.Rate = 12
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Rainbow" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 255)),
		})
		pe.Size = NumberSequence.new(0.3, 0)
		pe.Lifetime = NumberRange.new(0.5, 1)
		pe.Rate = 8
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Golden" then
		local light = Instance.new("PointLight")
		light.Color = GOLD
		light.Range = 6
		light.Brightness = 0.6
		light.Parent = body
	end

	return model
end

-- يحرك النموذج كله بحيث يكون الجسم عند CFrame المعطى
function Builder.SetCFrame(model: Model, cf: CFrame)
	model:PivotTo(cf)
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">PetUtil</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)

local PetUtil = {}

export type PetInstance = {
	Uid: string,
	Id: string,
	Variant: string,
	Locked: boolean,
	Equipped: boolean,
	Time: number,
}

function PetUtil.BasePower(inst: PetInstance): number
	local def = Pets.Get(inst.Id)
	if not def then
		return 0
	end
	local mult = Config.VariantMultipliers[inst.Variant] or 1
	return def.Power * mult
end

function PetUtil.DisplayName(inst: PetInstance): string
	local def = Pets.Get(inst.Id)
	local prefix = Config.VariantNames[inst.Variant] or ""
	return prefix .. (def and def.Name or inst.Id)
end

function PetUtil.RarityColor(inst: PetInstance): Color3
	local def = Pets.Get(inst.Id)
	return def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
end

-- ترتيب حسب القوة ثم الندرة
function PetUtil.SortByPower(list: { PetInstance })
	table.sort(list, function(a, b)
		local pa, pb = PetUtil.BasePower(a), PetUtil.BasePower(b)
		if pa ~= pb then
			return pa > pb
		end
		return a.Uid < b.Uid
	end)
end

function PetUtil.NextVariant(v: string): string?
	if v == "Normal" then
		return "Golden"
	elseif v == "Golden" then
		return "Rainbow"
	elseif v == "Rainbow" then
		return "DarkMatter"
	end
	return nil
end

return PetUtil
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- أسماء الـ Remotes. السيرفر ينشئها، والعميل ينتظرها.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	"ProfileUpdate",   -- S->C: الملف الكامل
	"Notify",          -- S->C: {Text, Color}
	"RewardPopup",     -- S->C: {Position, Coins, Diamonds}
	"HatchBroadcast",  -- S->C all: {Player, PetId, Variant}
	"Teleport",        -- C->S: zoneIndex
	"PromptPurchase",  -- C->S: kind, key
	"SetTarget",       -- C->S: breakableId?
	"RequestProfile",  -- C->S: العميل جاهز، أرسل الملف
}

Remotes.Functions = {
	"HatchEgg",       -- (eggId, count) -> {ok, error?, pets?}
	"PetAction",      -- (action, payload) -> {ok, error?}
	"Machine",        -- (kind, payload) -> {ok, error?, result?}
	"UnlockZone",     -- (index) -> {ok, error?}
	"BuyUpgrade",     -- (key) -> {ok, error?}
	"ClaimDaily",     -- () -> {ok, error?, reward?}
	"ClaimPlaytime",  -- (index) -> {ok, error?}
	"RedeemCode",     -- (code) -> {ok, error?}
	"GetServerTime",  -- () -> number
}

local folder: Folder

function Remotes.Init(): Folder
	if RunService:IsServer() then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in ipairs(Remotes.Events) do
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
		for _, name in ipairs(Remotes.Functions) do
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.Event(name: string): RemoteEvent
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></ProtectedString></Properties></Item></Item>
<Item class="Folder" referent="RBX000025"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX000014"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- نقطة تشغيل السيرفر
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Services = script.Parent:WaitForChild("Services")

Remotes.Init()

local MapBuilder = require(Services.MapBuilder)
local DataService = require(Services.DataService)
local PetService = require(Services.PetService)
local EggService = require(Services.EggService)
local BreakableService = require(Services.BreakableService)
local ZoneService = require(Services.ZoneService)
local ShopService = require(Services.ShopService)
local RewardService = require(Services.RewardService)
local LeaderboardService = require(Services.LeaderboardService)

MapBuilder.Build()

for _, layout in pairs(MapBuilder.Zones) do
	for eggId, pos in pairs(layout.Eggs) do
		EggService.RegisterEggPosition(eggId, pos)
	end
end

DataService.Init()
PetService.Init()
EggService.Init()
BreakableService.Init()
ZoneService.Init()
ShopService.Init()
RewardService.Init()
LeaderboardService.Init()

print("[PetKingdom] Server ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000015"><Properties><string name="Name">BreakableService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الصناديق والعملات: الظهور، الاستهداف، الضرر من الحيوانات، المكافآت، إعادة الظهور
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local MapBuilder = require(script.Parent.MapBuilder)

local BreakableService = {}

type Breakable = {
	Id: string,
	Type: string,
	Def: Breakables.BreakableDef,
	Zone: number,
	Mult: number,
	Health: number,
	MaxHealth: number,
	Alive: boolean,
	Damage: { [Player]: number },
	Position: Vector3,
	Model: Model,
	Special: boolean,
}

local breakables: { [string]: Breakable } = {}
local targets: { [Player]: string } = {}
local lastTap: { [Player]: number } = {}
local folder: Folder
local counter = 0
local rng = Random.new()

local function canUseZone(player: Player, zone: number): boolean
	local p = DataService.Get(player)
	if not p then
		return false
	end
	if zone == 0 then
		return DataService.HasGamepass(player, "VIP")
	end
	return p.UnlockedZones[tostring(zone)] == true
end

local function setTarget(player: Player, id: string?)
	if id then
		targets[player] = id
		player:SetAttribute("Target", id)
	else
		targets[player] = nil
		player:SetAttribute("Target", "")
	end
end

local function playerPosition(player: Player): Vector3?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp and hrp.Position or nil
end

local function tryTarget(player: Player, b: Breakable, maxDist: number): boolean
	if not b.Alive or not canUseZone(player, b.Zone) then
		return false
	end
	local pos = playerPosition(player)
	if not pos or (pos - b.Position).Magnitude > maxDist then
		return false
	end
	setTarget(player, b.Id)
	return true
end

local function respawn(b: Breakable)
	b.Health = b.MaxHealth
	b.Alive = true
	b.Damage = {}
	b.Model:SetAttribute("Health", b.Health)
	b.Model.Parent = folder
end

local function breakIt(b: Breakable)
	if not b.Alive then
		return
	end
	b.Alive = false
	local total = 0
	for _, d in pairs(b.Damage) do
		total += d
	end
	if total <= 0 then
		total = 1
	end
	for player, d in pairs(b.Damage) do
		if player.Parent == Players and DataService.Get(player) then
			local share = d / total
			local coins = 0
			local diamonds = 0
			if b.Def.Coins > 0 then
				coins = math.max(1, math.floor(b.Def.Coins * b.Mult * share * DataService.CoinMultiplier(player) + 0.5))
				DataService.AddCoins(player, coins)
			end
			if b.Def.Diamonds > 0 then
				local raw = b.Def.Diamonds * share
				diamonds = math.floor(raw)
				if rng:NextNumber() < (raw - diamonds) then
					diamonds += 1
				end
				if diamonds > 0 then
					DataService.AddDiamonds(player, diamonds)
				end
			end
			local p = DataService.Get(player) :: DataService.Profile
			p.Stats.Breaks += 1
			Remotes.Event("RewardPopup"):FireClient(player, { Position = b.Position + Vector3.new(0, b.Def.Size.Y, 0), Coins = coins, Diamonds = diamonds })
		end
	end
	for player, id in pairs(targets) do
		if id == b.Id then
			setTarget(player, nil)
		end
	end
	if b.Type == "GiantChest" then
		DataService.NotifyAll("💥 تم كسر الصندوق العملاق! سيعود بعد " .. Format.Time(b.Def.Respawn), Color3.fromRGB(255, 120, 255))
	elseif b.Type == "MysteryBox" then
		DataService.NotifyAll("🎁 انفتح صندوق الغموض!", Color3.fromRGB(120, 120, 255))
	end
	b.Model.Parent = nil
	task.delay(b.Def.Respawn, respawn, b)
end

local function applyDamage(b: Breakable, player: Player, amount: number)
	if not b.Alive or amount <= 0 then
		return
	end
	b.Health -= amount
	b.Damage[player] = (b.Damage[player] or 0) + amount
	b.Model:SetAttribute("Health", math.max(0, b.Health))
	b.Model:SetAttribute("LastHit", os.clock())
	if b.Health <= 0 then
		breakIt(b)
	end
end

local function tap(player: Player, b: Breakable)
	local now = os.clock()
	if now - (lastTap[player] or 0) < Config.TapCooldown then
		return
	end
	lastTap[player] = now
	local p = DataService.Get(player)
	local dmg = Config.TapDamageBase * (1 + ((p and p.Upgrades.Damage or 0) * 0.05))
	-- الضغط بدون حيوانات يعطي ضرر أقوى في البداية حتى يقدر اللاعب يشتري أول بيضة
	if PetService.GetPower(player) <= 0 then
		dmg *= 5
	end
	applyDamage(b, player, dmg)
end

local function spawnBreakable(typeName: string, zone: number, mult: number, pos: Vector3, special: boolean)
	local def = Breakables.Get(typeName)
	if not def then
		return
	end
	counter += 1
	local id = typeName .. "_" .. counter
	local model = MapBuilder.BuildBreakable(typeName, pos)
	model.Name = id
	model:SetAttribute("Id", id)
	model:SetAttribute("Type", typeName)
	model:SetAttribute("Zone", zone)
	local maxHealth = math.floor(def.Health * mult)
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("Coins", math.floor(def.Coins * mult))
	model:SetAttribute("Diamonds", def.Diamonds)
	local b: Breakable = {
		Id = id,
		Type = typeName,
		Def = def,
		Zone = zone,
		Mult = mult,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Alive = true,
		Damage = {},
		Position = pos,
		Model = model,
		Special = special,
	}
	breakables[id] = b
	local cd = model:FindFirstChildOfClass("ClickDetector") :: ClickDetector
	cd.MouseClick:Connect(function(player)
		if tryTarget(player, b, 70) then
			tap(player, b)
		elseif not canUseZone(player, b.Zone) then
			DataService.Notify(player, "🔒 افتح هذه المنطقة أولاً", Color3.fromRGB(255, 100, 100))
		end
	end)
	model.Parent = folder
end

local function nearestAlive(player: Player, maxDist: number): Breakable?
	local pos = playerPosition(player)
	if not pos then
		return nil
	end
	local best, bestDist = nil, maxDist
	for _, b in pairs(breakables) do
		if b.Alive and canUseZone(player, b.Zone) then
			local d = (b.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = b, d
			end
		end
	end
	return best
end

local function tick()
	for _, player in ipairs(Players:GetPlayers()) do
		local id = targets[player]
		local b = id and breakables[id]
		if b and b.Alive then
			local pos = playerPosition(player)
			if not pos or (pos - b.Position).Magnitude > 110 then
				setTarget(player, nil)
			else
				applyDamage(b, player, PetService.GetPower(player))
				if DataService.HasGamepass(player, "AutoTap") then
					lastTap[player] = 0
					tap(player, b)
				end
			end
		elseif DataService.HasGamepass(player, "AutoTap") and DataService.Get(player) then
			local nb = nearestAlive(player, 60)
			if nb then
				setTarget(player, nb.Id)
			end
		elseif id then
			setTarget(player, nil)
		end
	end
end

function BreakableService.Init()
	folder = Instance.new("Folder")
	folder.Name = "Breakables"
	folder.Parent = Workspace

	for index, layout in pairs(MapBuilder.Zones) do
		local zone = Zones.Get(index)
		if zone then
			local spotIndex = 1
			for _, entry in ipairs(zone.Breakables) do
				for _ = 1, entry.Count do
					local spot = layout.Spots[spotIndex]
					if not spot then
						break
					end
					spotIndex += 1
					spawnBreakable(entry.Type, index, zone.Multiplier, spot, false)
				end
			end
		end
	end
	spawnBreakable("GiantChest", 1, 1, MapBuilder.Specials.GiantChest, true)
	spawnBreakable("MysteryBox", 1, 1, MapBuilder.Specials.MysteryBox, true)

	Remotes.Event("SetTarget").OnServerEvent:Connect(function(player, id)
		if id == nil then
			setTarget(player, nil)
			return
		end
		local b = breakables[tostring(id)]
		if b then
			tryTarget(player, b, 70)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		targets[player] = nil
		lastTap[player] = nil
		for _, b in pairs(breakables) do
			b.Damage[player] = nil
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= Config.DamageTickRate then
			acc -= Config.DamageTickRate
			tick()
		end
	end)
end

return BreakableService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!strict
-- تحميل وحفظ بيانات اللاعبين + العملات + إرسال الملف للعميل
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = {}

export type Profile = {
	Coins: number,
	Diamonds: number,
	Pets: { any },
	UnlockedZones: { [string]: boolean },
	Upgrades: { [string]: number },
	Stats: { [string]: number },
	Daily: { LastClaim: number, Streak: number },
	Codes: { [string]: boolean },
	Potions: { [string]: number },
	DarkMatter: { any },
	Settings: { [string]: boolean },
	Index: { [string]: boolean },
	Gamepasses: { [string]: boolean },
	LastZone: number,
	InGroup: boolean,
	SessionStart: number,
	PlaytimeClaimed: { [string]: boolean },
}

local function template(): Profile
	return {
		Coins = 0,
		Diamonds = 0,
		Pets = {},
		UnlockedZones = { ["1"] = true },
		Upgrades = { Storage = 0, Equip = 0, Coins = 0, Luck = 0, Damage = 0, Speed = 0 },
		Stats = { Hatches = 0, Breaks = 0, CoinsEarned = 0, Playtime = 0, BestPet = 0 },
		Daily = { LastClaim = 0, Streak = 0 },
		Codes = {},
		Potions = { Lucky = 0, Coins = 0 },
		DarkMatter = {},
		Settings = { Music = true, HideOthersPets = false, LowGraphics = false },
		Index = {},
		Gamepasses = {},
		LastZone = 1,
		InGroup = false,
		SessionStart = 0,
		PlaytimeClaimed = {},
	}
end

local store = DataStoreService:GetDataStore(Config.DataStoreName)
local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
local loadedEvent = Instance.new("BindableEvent")

DataService.Loaded = loadedEvent.Event

local function key(player: Player): string
	return "p_" .. player.UserId
end

local function reconcile(data: any): Profile
	local t = template()
	if type(data) ~= "table" then
		return t
	end
	for k, v in pairs(t) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "Pets" and k ~= "DarkMatter" then
			for k2, v2 in pairs(v) do
				if data[k][k2] == nil then
					data[k][k2] = v2
				end
			end
		end
	end
	return data :: Profile
end

local function retry<T>(fn: () -> T, attempts: number): (boolean, T?)
	local ok, res
	for i = 1, attempts do
		ok, res = pcall(fn)
		if ok then
			return true, res
		end
		warn("[DataService] attempt " .. i .. " failed: " .. tostring(res))
		task.wait(1.5 * i)
	end
	return false, nil
end

local function load(player: Player)
	local ok, data = retry(function()
		return store:GetAsync(key(player))
	end, 3)
	if not ok then
		player:Kick("تعذر تحميل بياناتك، حاول مرة أخرى بعد قليل.")
		return
	end
	if player.Parent ~= Players then
		return -- غادر أثناء التحميل
	end
	local profile = reconcile(data)
	profile.SessionStart = os.time()
	profile.PlaytimeClaimed = {}
	profile.Gamepasses = {}
	profile.InGroup = false
	profiles[player] = profile

	-- leaderstats
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("NumberValue")
	coins.Name = "Coins"
	coins.Value = profile.Coins
	coins.Parent = ls
	local diamonds = Instance.new("NumberValue")
	diamonds.Name = "Diamonds"
	diamonds.Value = profile.Diamonds
	diamonds.Parent = ls
	ls.Parent = player

	dirty[player] = true
	loadedEvent:Fire(player, profile)
end

local function save(player: Player, remove: boolean?)
	local profile = profiles[player]
	if not profile then
		return
	end
	local snapshot = table.clone(profile)
	snapshot.Gamepasses = nil :: any
	snapshot.PlaytimeClaimed = nil :: any
	snapshot.InGroup = nil :: any
	snapshot.Stats = table.clone(profile.Stats)
	snapshot.Stats.Playtime = (profile.Stats.Playtime or 0) + (os.time() - profile.SessionStart)
	local ok = retry(function()
		return store:UpdateAsync(key(player), function()
			return snapshot
		end)
	end, 3)
	if not ok then
		warn("[DataService] failed to save " .. player.Name)
	end
	if remove then
		profiles[player] = nil
		dirty[player] = nil
	end
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

-- دوال إضافية تضيف حقولاً محسوبة للملف المرسل للعميل (تسجلها الخدمات الأخرى)
DataService.Extenders = {} :: { (Player, any) -> () }

function DataService.Replicate(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local payload = table.clone(profile) :: any
	payload.ServerTime = os.time()
	payload.OwnedPasses = {}
	for key in pairs(Config.Gamepasses) do
		payload.OwnedPasses[key] = DataService.HasGamepass(player, key)
	end
	payload.Luck = DataService.LuckMultiplier(player)
	payload.CoinMult = DataService.CoinMultiplier(player)
	for _, fn in ipairs(DataService.Extenders) do
		fn(player, payload)
	end
	Remotes.Event("ProfileUpdate"):FireClient(player, payload)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local coins = ls:FindFirstChild("Coins") :: NumberValue?
		local diamonds = ls:FindFirstChild("Diamonds") :: NumberValue?
		if coins then
			coins.Value = math.floor(profile.Coins)
		end
		if diamonds then
			diamonds.Value = math.floor(profile.Diamonds)
		end
	end
end

function DataService.Notify(player: Player, text: string, color: Color3?)
	Remotes.Event("Notify"):FireClient(player, { Text = text, Color = color })
end

function DataService.NotifyAll(text: string, color: Color3?)
	Remotes.Event("Notify"):FireAllClients({ Text = text, Color = color })
end

function DataService.AddCoins(player: Player, amount: number)
	local p = profiles[player]
	if not p or amount <= 0 then
		return
	end
	p.Coins += amount
	p.Stats.CoinsEarned += amount
	dirty[player] = true
end

function DataService.AddDiamonds(player: Player, amount: number)
	local p = profiles[player]
	if not p or amount <= 0 then
		return
	end
	p.Diamonds += amount
	dirty[player] = true
end

function DataService.Spend(player: Player, currency: string, amount: number): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	if currency == "Coins" then
		if p.Coins < amount then
			return false
		end
		p.Coins -= amount
	elseif currency == "Diamonds" then
		if p.Diamonds < amount then
			return false
		end
		p.Diamonds -= amount
	else
		return false
	end
	dirty[player] = true
	return true
end

function DataService.HasGamepass(player: Player, keyName: string): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	if Config.StudioFreeGamepasses and RunService:IsStudio() then
		return true
	end
	return p.Gamepasses[keyName] == true
end

function DataService.PotionActive(player: Player, potion: string): boolean
	local p = profiles[player]
	return p ~= nil and (p.Potions[potion] or 0) > os.time()
end

function DataService.GivePotion(player: Player, potion: string)
	local p = profiles[player]
	local cfg = Config.Potions[potion]
	if not p or not cfg then
		return
	end
	local base = math.max(os.time(), p.Potions[potion] or 0)
	p.Potions[potion] = base + cfg.Duration
	dirty[player] = true
	DataService.Notify(player, "تم تفعيل " .. cfg.Name .. " ✨", Color3.fromRGB(180, 120, 255))
end

function DataService.LuckMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local upgrade = (p.Upgrades.Luck or 0) * 0.10
	local group = p.InGroup and Config.GroupBonus.Luck or 0
	local mult = 1 + upgrade + group
	if DataService.HasGamepass(player, "Lucky") then
		mult *= 2
	end
	if DataService.HasGamepass(player, "SuperLucky") then
		mult *= 3
	end
	if DataService.PotionActive(player, "Lucky") then
		mult *= Config.Potions.Lucky.Mult
	end
	return mult
end

function DataService.CoinMultiplier(player: Player): number
	local p = profiles[player]
	if not p then
		return 1
	end
	local upgrade = (p.Upgrades.Coins or 0) * 0.05
	local group = p.InGroup and Config.GroupBonus.Coins or 0
	local mult = 1 + upgrade + group
	if DataService.HasGamepass(player, "VIP") then
		mult *= Config.VIPCoinMultiplier
	end
	if DataService.HasGamepass(player, "DoubleCoins") then
		mult *= 2
	end
	if DataService.PotionActive(player, "Coins") then
		mult *= Config.Potions.Coins.Mult
	end
	return mult
end

function DataService.Init()
	Remotes.Event("RequestProfile").OnServerEvent:Connect(function(player)
		if profiles[player] then
			DataService.Replicate(player)
		end
	end)
	Players.PlayerAdded:Connect(load)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player, true)
	end)

	-- إرسال التحديثات للعميل (بحد أقصى 10 مرات بالثانية)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		for player, isDirty in pairs(dirty) do
			if isDirty and profiles[player] then
				dirty[player] = false
				DataService.Replicate(player)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for player in pairs(profiles) do
				save(player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			task.wait(1)
		end
		for player in pairs(profiles) do
			save(player, true)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000017"><Properties><string name="Name">EggService</string><ProtectedString name="Source"><![CDATA[--!strict
-- فتح البيض مع الحظ والتحقق من كل الشروط
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Eggs = require(Shared.Data.Eggs)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Luck = require(Shared.Modules.Luck)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local EggService = {}

local lastHatch: { [Player]: number } = {}
local rng = Random.new()
local eggPositions: { [string]: Vector3 } = {}

function EggService.RegisterEggPosition(eggId: string, pos: Vector3)
	eggPositions[eggId] = pos
end

function EggService.Hatch(player: Player, eggId: string, count: number): { ok: boolean, error: string?, pets: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local egg = Eggs.Get(eggId)
	if not egg then
		return { ok = false, error = "بيضة غير موجودة" }
	end
	count = math.clamp(math.floor(tonumber(count) or 1), 1, 3)
	if count == 3 and not DataService.HasGamepass(player, "TripleHatch") then
		return { ok = false, error = "تحتاج جيم باس Triple Hatch" }
	end
	if count == 2 then
		count = 1
	end
	if egg.VIPOnly and not DataService.HasGamepass(player, "VIP") then
		return { ok = false, error = "هذه البيضة لأعضاء VIP فقط" }
	end
	if egg.Zone > 0 and not p.UnlockedZones[tostring(egg.Zone)] then
		return { ok = false, error = "افتح المنطقة أولاً" }
	end

	-- المسافة
	local pos = eggPositions[eggId]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if pos and hrp and (hrp.Position - pos).Magnitude > 40 then
		return { ok = false, error = "اقترب من البيضة" }
	end

	local now = os.clock()
	if now - (lastHatch[player] or 0) < Config.HatchCooldown then
		return { ok = false, error = "انتظر قليلاً" }
	end

	if PetService.FreeSlots(player) < count then
		return { ok = false, error = "المخزن ممتلئ! احذف أو ادمج حيوانات" }
	end

	local total = egg.Cost * count
	if not DataService.Spend(player, egg.Currency, total) then
		return { ok = false, error = "لا تملك ما يكفي من " .. (egg.Currency == "Coins" and "العملات" or "الألماس") }
	end
	lastHatch[player] = now

	local luck = DataService.LuckMultiplier(player)
	local results = {}
	for _ = 1, count do
		local petId = Luck.Roll(eggId, luck, rng) or egg.Pets[1].Pet
		local inst = PetService.Add(player, petId, "Normal", true)
		if inst then
			table.insert(results, { Uid = inst.Uid, Id = inst.Id, Variant = inst.Variant })
			local def = Pets.Get(petId)
			if def and Rarities.Rank(def.Rarity) >= 5 then
				Remotes.Event("HatchBroadcast"):FireAllClients({ Player = player.Name, PetId = petId, Variant = "Normal", Rarity = def.Rarity })
			end
		end
	end
	p.Stats.Hatches += count
	DataService.MarkDirty(player)
	return { ok = true, pets = results }
end

function EggService.Init()
	Remotes.Function("HatchEgg").OnServerInvoke = function(player, eggId, count)
		return EggService.Hatch(player, tostring(eggId), tonumber(count) or 1)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastHatch[player] = nil
	end)
end

return EggService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000018"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحات المتصدرين العالمية (OrderedDataStore)
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local LeaderboardService = {}

local stores = {
	Coins = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Coins"),
	Hatches = DataStoreService:GetOrderedDataStore(Config.LeaderboardStore .. "_Hatches"),
}

local function refresh()
	for _, player in ipairs(Players:GetPlayers()) do
		local p = DataService.Get(player)
		if p then
			pcall(stores.Coins.SetAsync, stores.Coins, tostring(player.UserId), math.floor(p.Stats.CoinsEarned))
			pcall(stores.Hatches.SetAsync, stores.Hatches, tostring(player.UserId), math.floor(p.Stats.Hatches))
		end
	end
	for key, store in pairs(stores) do
		local label = MapBuilder.Boards[key]
		if label then
			local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
			if ok then
				local lines = {}
				for i, entry in ipairs(pages:GetCurrentPage()) do
					local name = "???"
					local okName, res = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) :: number)
					if okName then
						name = res
					end
					table.insert(lines, string.format("%d. %s  -  %s", i, name, Format.Number(entry.value)))
				end
				label.Text = #lines > 0 and table.concat(lines, "\n") or "لا يوجد بيانات بعد"
			end
		end
	end
end

function LeaderboardService.Init()
	task.spawn(function()
		task.wait(5)
		while true do
			refresh()
			task.wait(60)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000019"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- يبني العالم كاملاً بالكود: الجزر، الجسور، البوابات، البيض، الآلات، الزينة، منطقة VIP، اللوحات.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Eggs = require(Shared.Data.Eggs)
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)

local MapBuilder = {}

export type ZoneLayout = {
	Index: number,
	Center: Vector3,
	Spawn: Vector3,
	Spots: { Vector3 },
	Eggs: { [string]: Vector3 },
	Gate: BasePart?,
	Folder: Folder,
}

MapBuilder.Zones = {} :: { [number]: ZoneLayout }
MapBuilder.Boards = {} :: { [string]: TextLabel }
MapBuilder.Machines = {} :: { [string]: Model }
MapBuilder.Specials = {} :: { [string]: Vector3 }
MapBuilder.VIPPortal = nil :: BasePart?
MapBuilder.VIPReturnPortal = nil :: BasePart?

local SPACING = Config.Map.ZoneSpacing
local ISLAND = Config.Map.IslandSize
local BRIDGE = Config.Map.BridgeLength

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local pp = Instance.new("Part")
		if shape == "ball" then
			pp.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			pp.Shape = Enum.PartType.Cylinder
		end
		p = pp
	end
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "cone" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://1033714"
		mesh.Scale = Vector3.new(size.X / 2, size.Y / 2, size.Z / 2)
		mesh.Parent = p
	elseif shape == "egg" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

local function billboard(parent: BasePart, text: string, size: UDim2, color: Color3, offset: number, textSize: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffset = Vector3.new(0, offset, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = textSize == nil
	label.TextSize = textSize or 24
	label.Font = Enum.Font.FredokaOne
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Parent = bb
	bb.Parent = parent
	return bb
end

-- ===== الزينة =====
local function tree(parent: Instance, pos: Vector3, scale: number, leaf: Color3, rng: Random)
	local trunkH = 6 * scale
	part(parent, "Trunk", Vector3.new(1.4 * scale, trunkH, 1.4 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)), Color3.fromRGB(110, 75, 40), Enum.Material.Wood)
	for i = 1, 3 do
		local s = (5 - i) * 1.4 * scale
		part(parent, "Leaves", Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-0.5, 0.5), trunkH + i * 1.6 * scale - 1, rng:NextNumber(-0.5, 0.5))), leaf, Enum.Material.Grass, "ball")
	end
end

local function palm(parent: Instance, pos: Vector3, rng: Random)
	local h = 10
	for i = 1, 5 do
		part(parent, "Trunk", Vector3.new(1.2, h / 5 + 0.2, 1.2), CFrame.new(pos + Vector3.new(i * 0.25, (i - 0.5) * h / 5, 0)), Color3.fromRGB(150, 110, 60), Enum.Material.Wood)
	end
	for i = 1, 6 do
		local ang = i / 6 * math.pi * 2
		part(parent, "Leaf", Vector3.new(1.2, 0.2, 6), CFrame.new(pos + Vector3.new(1.25, h, 0)) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -3) * CFrame.Angles(-0.35, 0, 0), Color3.fromRGB(60, 170, 70), Enum.Material.Grass)
	end
	part(parent, "Coconut", Vector3.new(1, 1, 1), CFrame.new(pos + Vector3.new(1.25, h - 0.6, 0)), Color3.fromRGB(90, 60, 30), nil, "ball")
end

local function cactus(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(5, 8)
	local green = Color3.fromRGB(60, 140, 70)
	part(parent, "Cactus", Vector3.new(2, h, 2), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
	part(parent, "Arm", Vector3.new(1.4, 3, 1.4), CFrame.new(pos + Vector3.new(1.8, h * 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
	part(parent, "Arm", Vector3.new(1.4, 1.4, 2.2), CFrame.new(pos + Vector3.new(1.2, h * 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass, "cyl")
end

local function crystalCluster(parent: Instance, pos: Vector3, color: Color3, rng: Random, glow: boolean)
	for i = 1, 3 do
		local h = rng:NextNumber(4, 9)
		local w = rng:NextNumber(1.5, 2.5)
		local off = Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
		local c = part(parent, "Crystal", Vector3.new(w, h, w), CFrame.new(pos + off + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), color, glow and Enum.Material.Neon or Enum.Material.Glass, "cone")
		c.Transparency = glow and 0 or 0.2
	end
end

local function cloudPuff(parent: Instance, pos: Vector3, rng: Random)
	for i = 1, 4 do
		local s = rng:NextNumber(5, 9)
		local c = part(parent, "Cloud", Vector3.new(s, s * 0.7, s), CFrame.new(pos + Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(3, 8), rng:NextNumber(-4, 4))), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, "ball")
		c.CanCollide = false
		c.Transparency = 0.1
	end
end

local function lavaRock(parent: Instance, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 8)
	local rock = part(parent, "Rock", Vector3.new(s, s * 0.8, s), CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), 0), Color3.fromRGB(45, 35, 35), Enum.Material.Basalt)
	local lava = part(parent, "Lava", Vector3.new(s * 0.6, 0.4, s * 0.6), CFrame.new(pos + Vector3.new(0, s * 0.7, 0)), Color3.fromRGB(255, 110, 0), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 0)
	light.Range = 14
	light.Parent = lava
	rock.CanCollide = true
end

local function goldPillar(parent: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(8, 14)
	part(parent, "Pillar", Vector3.new(2.5, h, 2.5), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Metal)
	local top = part(parent, "Top", Vector3.new(3, 3, 3), CFrame.new(pos + Vector3.new(0, h + 1, 0)), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, "ball")
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 240, 150)
	light.Range = 18
	light.Parent = top
end

local function iceSpike(parent: Instance, pos: Vector3, rng: Random)
	crystalCluster(parent, pos, Color3.fromRGB(200, 240, 255), rng, false)
end

local DECOR: { [string]: (Instance, Vector3, Random) -> () } = {
	trees = function(parent, pos, rng)
		tree(parent, pos, rng:NextNumber(0.9, 1.5), Color3.fromRGB(40 + rng:NextInteger(0, 40), 140 + rng:NextInteger(0, 50), 50), rng)
	end,
	palms = palm,
	cactus = cactus,
	ice = iceSpike,
	lava = lavaRock,
	clouds = cloudPuff,
	crystals = function(parent, pos, rng)
		crystalCluster(parent, pos, Color3.fromHSV(rng:NextNumber(), 0.7, 1), rng, true)
	end,
	gold = goldPillar,
}

-- ===== البيضة =====
local function buildEgg(parent: Instance, egg: Eggs.EggDef, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = egg.Id
	model:SetAttribute("EggId", egg.Id)
	part(model, "Pedestal", Vector3.new(1.2, 9, 9), CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(230, 230, 235), Enum.Material.Marble, "cyl")
	part(model, "PedestalRing", Vector3.new(0.5, 10.5, 10.5), CFrame.new(pos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2), egg.Accent, Enum.Material.Neon, "cyl")
	local shell = part(model, "Shell", Vector3.new(5, 6.5, 5), CFrame.new(pos + Vector3.new(0, 4.5, 0)), egg.Color, Enum.Material.SmoothPlastic, "egg")
	shell.CanCollide = false
	local rng = Random.new(#egg.Id * 7)
	for i = 1, 7 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-1.8, 1.8)
		local r = 2.3 * math.sqrt(1 - (y / 3.2) ^ 2)
		local spot = part(model, "Spot", Vector3.new(1, 1, 1) * rng:NextNumber(0.6, 1.1), CFrame.new(pos + Vector3.new(math.cos(ang) * r, 4.5 + y, math.sin(ang) * r)), egg.Accent, Enum.Material.SmoothPlastic, "ball")
		spot.CanCollide = false
	end
	model.PrimaryPart = shell
	local currency = egg.Currency == "Coins" and "💰" or "💎"
	billboard(shell, egg.Name .. "\n" .. currency .. " " .. Format.Number(egg.Cost), UDim2.fromScale(12, 4), Color3.new(1, 1, 1), 5.5)
	if egg.VIPOnly then
		local crown = part(model, "Crown", Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, 8.6, 0)), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, "cone")
		crown.CanCollide = false
	end
	model.Parent = parent
	return model
end

-- ===== الآلات =====
local MACHINE_INFO = {
	{ Kind = "Golden", Name = "Golden Machine", Arabic = "آلة الذهب", Color = Color3.fromRGB(255, 200, 40) },
	{ Kind = "Rainbow", Name = "Rainbow Machine", Arabic = "آلة قوس قزح", Color = Color3.fromRGB(255, 100, 200) },
	{ Kind = "DarkMatter", Name = "Dark Matter Machine", Arabic = "آلة المادة المظلمة", Color = Color3.fromRGB(120, 40, 200) },
	{ Kind = "Fuse", Name = "Fusion Machine", Arabic = "آلة الدمج", Color = Color3.fromRGB(60, 200, 255) },
}

local function buildMachine(parent: Instance, info: any, pos: Vector3): Model
	local model = Instance.new("Model")
	model.Name = info.Kind .. "Machine"
	model:SetAttribute("Machine", info.Kind)
	part(model, "Base", Vector3.new(1, 10, 10), CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 60, 70), Enum.Material.Metal, "cyl")
	local body = part(model, "Body", Vector3.new(6, 7, 6), CFrame.new(pos + Vector3.new(0, 4.5, 0)), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
	local glass = part(model, "Glass", Vector3.new(4.5, 4.5, 4.5), CFrame.new(pos + Vector3.new(0, 5, 0)), info.Color, Enum.Material.Glass, "ball")
	glass.Transparency = 0.35
	glass.CanCollide = false
	local core = part(model, "Core", Vector3.new(2, 2, 2), CFrame.new(pos + Vector3.new(0, 5, 0)), info.Color, Enum.Material.Neon, "ball")
	core.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = info.Color
	light.Range = 16
	light.Brightness = 1.5
	light.Parent = core
	local ring = part(model, "Ring", Vector3.new(0.6, 7.5, 7.5), CFrame.new(pos + Vector3.new(0, 8.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), info.Color, Enum.Material.Neon, "cyl")
	ring.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "فتح"
	prompt.ObjectText = info.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	billboard(body, info.Name .. "\n" .. info.Arabic, UDim2.fromScale(14, 4), info.Color, 8)
	model.PrimaryPart = body
	model.Parent = parent
	return model
end

-- ===== الصناديق القابلة للكسر =====
function MapBuilder.BuildBreakable(typeName: string, pos: Vector3, scale: number?): Model
	local def = Breakables.Get(typeName) :: Breakables.BreakableDef
	local s = scale or 1
	local size = def.Size * s
	local model = Instance.new("Model")
	model.Name = typeName
	local base: BasePart
	if def.Shape == "pile" then
		base = part(model, "Base", Vector3.new(size.Y * 0.35, size.X, size.X), CFrame.new(pos + Vector3.new(0, size.Y * 0.18, 0)) * CFrame.Angles(0, 0, math.pi / 2), def.Color, def.Material, "cyl")
		part(model, "Coin", Vector3.new(size.Y * 0.3, size.X * 0.75, size.X * 0.75), CFrame.new(pos + Vector3.new(size.X * 0.1, size.Y * 0.5, -size.X * 0.08)) * CFrame.Angles(0, 0.4, math.pi / 2), def.Color, def.Material, "cyl").CanCollide = false
		part(model, "Coin", Vector3.new(size.Y * 0.28, size.X * 0.5, size.X * 0.5), CFrame.new(pos + Vector3.new(-size.X * 0.08, size.Y * 0.78, size.X * 0.06)) * CFrame.Angles(0, 0.9, math.pi / 2), Color3.fromRGB(255, 230, 120), def.Material, "cyl").CanCollide = false
	elseif def.Shape == "chest" or def.Shape == "giant" then
		base = part(model, "Base", Vector3.new(size.X, size.Y * 0.6, size.Z), CFrame.new(pos + Vector3.new(0, size.Y * 0.3, 0)), def.Color, def.Material)
		local lid = part(model, "Lid", Vector3.new(size.X, size.Y * 0.4, size.Z), CFrame.new(pos + Vector3.new(0, size.Y * 0.8, 0)), def.Color, def.Material)
		lid.CanCollide = false
		local band = Color3.fromRGB(255, 215, 0)
		if def.Shape == "giant" then
			band = Color3.fromRGB(255, 255, 255)
		end
		part(model, "Band", Vector3.new(size.X * 0.2, size.Y * 1.02, size.Z * 1.04), CFrame.new(pos + Vector3.new(0, size.Y * 0.5, 0)), band, Enum.Material.Metal).CanCollide = false
		part(model, "Lock", Vector3.new(size.X * 0.18, size.Y * 0.22, size.Z * 0.12), CFrame.new(pos + Vector3.new(0, size.Y * 0.55, -size.Z * 0.52)), band, Enum.Material.Metal).CanCollide = false
		if def.Shape == "giant" then
			local glow = part(model, "Glow", Vector3.new(size.X * 0.8, 0.5, size.Z * 0.8), CFrame.new(pos + Vector3.new(0, size.Y * 0.6, 0)), Color3.fromRGB(255, 120, 255), Enum.Material.Neon)
			glow.CanCollide = false
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 120, 255)
			light.Range = 30
			light.Brightness = 2
			light.Parent = glow
		end
	elseif def.Shape == "crystal" then
		base = part(model, "Base", Vector3.new(size.X, size.Y, size.Z), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), def.Color, def.Material, "cone")
		base.Transparency = 0.15
		for i = 1, 2 do
			local c = part(model, "Shard", Vector3.new(size.X * 0.6, size.Y * 0.55, size.Z * 0.6), CFrame.new(pos + Vector3.new(i == 1 and size.X * 0.6 or -size.X * 0.6, size.Y * 0.27, 0)) * CFrame.Angles(0, 0, i == 1 and -0.3 or 0.3), def.Color, Enum.Material.Neon, "cone")
			c.CanCollide = false
		end
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 12
		light.Parent = base
	else -- gift
		base = part(model, "Base", size, CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), def.Color, def.Material)
		local ribbon = Color3.fromRGB(255, 220, 60)
		part(model, "Ribbon", Vector3.new(size.X * 1.02, size.Y * 1.02, size.Z * 0.2), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), ribbon, Enum.Material.SmoothPlastic).CanCollide = false
		part(model, "Ribbon", Vector3.new(size.X * 0.2, size.Y * 1.02, size.Z * 1.02), CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)), ribbon, Enum.Material.SmoothPlastic).CanCollide = false
		part(model, "Bow", Vector3.new(size.X * 0.35, size.Y * 0.3, size.Z * 0.35), CFrame.new(pos + Vector3.new(0, size.Y * 1.1, 0)), ribbon, Enum.Material.SmoothPlastic, "ball").CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = def.Color
		light.Range = 16
		light.Parent = base
	end
	base.CanCollide = true
	model.PrimaryPart = base
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 45
	cd.Parent = model
	return model
end

-- ===== الجزيرة =====
local function buildIsland(zone: Zones.ZoneDef, center: Vector3, size: number, parent: Folder, rng: Random): ZoneLayout
	local half = size / 2
	local folder = Instance.new("Folder")
	folder.Name = "Zone_" .. zone.Id
	folder.Parent = parent

	local ground = part(folder, "Ground", Vector3.new(size, 12, size), CFrame.new(center + Vector3.new(0, -6, 0)), zone.Ground, zone.Material)
	ground:SetAttribute("Zone", zone.Index)
	-- حواف الجزيرة
	local rim = part(folder, "Rim", Vector3.new(size + 6, 6, size + 6), CFrame.new(center + Vector3.new(0, -9, 0)), zone.Accent, Enum.Material.Slate)
	rim.CanCollide = false
	part(folder, "Underside", Vector3.new(size * 0.8, 30, size * 0.8), CFrame.new(center + Vector3.new(0, -27, 0)), Color3.fromRGB(80, 60, 50), Enum.Material.Slate)

	-- الزينة على الأطراف
	local decorFn = DECOR[zone.Decor] or DECOR.trees
	local step = 24
	local function reserved(x: number, z: number): boolean
		return zone.Index == 1 and z < -100 and x < -55 and x > -125
	end
	for x = -half + 14, half - 14, step do
		for _, z in ipairs({ -half + 14, half - 14 }) do
			if math.abs(x) > 24 and not reserved(x, z) then
				decorFn(folder, center + Vector3.new(x + rng:NextNumber(-4, 4), 0, z + rng:NextNumber(-4, 4)), rng)
			end
		end
	end
	for z = -half + 14 + step, half - 14 - step, step do
		for _, x in ipairs({ -half + 14, half - 14 }) do
			decorFn(folder, center + Vector3.new(x + rng:NextNumber(-4, 4), 0, z + rng:NextNumber(-4, 4)), rng)
		end
	end

	-- نقاط الصناديق
	local spots = {}
	local xMin, xMax = -half * 0.4, half * 0.62
	local zMin, zMax = -half * 0.72, half * 0.64
	for x = xMin, xMax, 24 do
		for z = zMin, zMax, 24 do
			table.insert(spots, center + Vector3.new(x + rng:NextNumber(-5, 5), 0, z + rng:NextNumber(-5, 5)))
		end
	end
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end

	-- البيض
	local eggs = {}
	local eggList = Eggs.ForZone(zone.Index)
	for _, egg in ipairs(eggList) do
		local pos = center + Vector3.new(-half * 0.72, 0, -40 + (egg.Slot - 1) * 40)
		buildEgg(folder, egg, pos)
		eggs[egg.Id] = pos
	end

	-- لافتة اسم المنطقة
	part(folder, "SignPost", Vector3.new(1, 8, 1), CFrame.new(center + Vector3.new(24, 4, -half * 0.8)), Color3.fromRGB(120, 80, 40), Enum.Material.Wood)
	local sign = part(folder, "Sign", Vector3.new(12, 5, 0.6), CFrame.new(center + Vector3.new(24, 9, -half * 0.8)), Color3.fromRGB(240, 220, 170), Enum.Material.Wood)
	billboard(sign, zone.Name .. "\n" .. zone.Arabic, UDim2.fromScale(14, 5), Color3.new(1, 1, 1), 1)

	local spawn = center + Vector3.new(0, 0, -half * 0.78)

	return {
		Index = zone.Index,
		Center = center,
		Spawn = spawn,
		Spots = spots,
		Eggs = eggs,
		Gate = nil,
		Folder = folder,
	}
end

local function buildBridgeAndGate(fromLayout: ZoneLayout, toZone: Zones.ZoneDef, parent: Folder)
	local half = ISLAND / 2
	local c = fromLayout.Center
	local bridge = part(parent, "Bridge", Vector3.new(26, 2, BRIDGE + 6), CFrame.new(c + Vector3.new(0, -1, half + BRIDGE / 2)), Color3.fromRGB(170, 130, 90), Enum.Material.WoodPlanks)
	bridge:SetAttribute("Zone", toZone.Index)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "Rail", Vector3.new(1, 3, BRIDGE + 6), CFrame.new(c + Vector3.new(s * 12.5, 1.5, half + BRIDGE / 2)), Color3.fromRGB(120, 85, 50), Enum.Material.Wood).CanCollide = false
	end
	local gate = part(parent, "Gate", Vector3.new(26, 14, 2), CFrame.new(c + Vector3.new(0, 7, half - 2)), toZone.Accent, Enum.Material.ForceField)
	gate.Transparency = 0.3
	gate:SetAttribute("Zone", toZone.Index)
	gate:SetAttribute("Cost", toZone.Cost)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, "Pillar", Vector3.new(3, 16, 3), CFrame.new(c + Vector3.new(s * 14.5, 8, half - 2)), Color3.fromRGB(90, 90, 100), Enum.Material.Marble)
	end
	part(parent, "Arch", Vector3.new(32, 3, 3), CFrame.new(c + Vector3.new(0, 16.5, half - 2)), Color3.fromRGB(90, 90, 100), Enum.Material.Marble)
	billboard(gate, "🔒 " .. toZone.Name .. "\n💰 " .. Format.Number(toZone.Cost), UDim2.fromScale(16, 5), Color3.new(1, 1, 1), 10)
	return gate
end

local function buildPortal(parent: Instance, pos: Vector3, color: Color3, label: string): BasePart
	local model = Instance.new("Model")
	model.Name = "Portal"
	for _, s in ipairs({ -1, 1 }) do
		part(model, "Pillar", Vector3.new(2, 12, 2), CFrame.new(pos + Vector3.new(s * 5, 6, 0)), color, Enum.Material.Metal)
	end
	part(model, "Top", Vector3.new(12, 2, 2), CFrame.new(pos + Vector3.new(0, 12.5, 0)), color, Enum.Material.Metal)
	local field = part(model, "Field", Vector3.new(8, 11, 0.6), CFrame.new(pos + Vector3.new(0, 5.5, 0)), color, Enum.Material.Neon)
	field.Transparency = 0.45
	field.CanCollide = false
	billboard(field, label, UDim2.fromScale(14, 4), color, 9)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 20
	light.Brightness = 2
	light.Parent = field
	model.Parent = parent
	return field
end

local function buildBoard(parent: Instance, pos: Vector3, title: string, color: Color3): TextLabel
	local rot = CFrame.Angles(0, -math.pi / 2, 0) -- الوجه الأيمن يشير إلى +Z
	local board = part(parent, "Board", Vector3.new(1, 16, 22), CFrame.new(pos + Vector3.new(0, 9, 0)) * rot, Color3.fromRGB(30, 30, 40), Enum.Material.Metal)
	part(parent, "BoardFrame", Vector3.new(1.4, 17, 23), CFrame.new(pos + Vector3.new(0, 9, -0.1)) * rot, color, Enum.Material.Neon).CanCollide = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 0.15, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = color
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Size = UDim2.new(0.94, 0, 0.83, 0)
	list.Position = UDim2.new(0.03, 0, 0.16, 0)
	list.BackgroundTransparency = 1
	list.Text = "..."
	list.TextColor3 = Color3.new(1, 1, 1)
	list.Font = Enum.Font.FredokaOne
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Parent = gui
	gui.Parent = board
	return list
end

local function setupLighting()
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.Ambient = Color3.fromRGB(120, 120, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.32
		atm.Offset = 0.25
		atm.Color = Color3.fromRGB(199, 199, 210)
		atm.Decay = Color3.fromRGB(106, 112, 125)
		atm.Glare = 0.2
		atm.Haze = 1
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.2
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Saturation = 0.15
		cc.Contrast = 0.05
		cc.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local sun = Instance.new("SunRaysEffect")
		sun.Intensity = 0.08
		sun.Parent = Lighting
	end
end

function MapBuilder.ZoneOfPosition(pos: Vector3): number
	local vipCenter = Config.Map.VIPOffset
	if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(vipCenter.X, 0, vipCenter.Z)).Magnitude < 220 then
		return 0
	end
	local idx = math.floor(pos.Z / SPACING + 0.5) + 1
	return math.clamp(idx, 1, #Zones.List)
end

function MapBuilder.Build()
	setupLighting()
	local existing = Workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = Workspace

	local rng = Random.new(2024)

	-- المناطق
	for i, zone in ipairs(Zones.List) do
		local center = Vector3.new(0, 0, (i - 1) * SPACING)
		local layout = buildIsland(zone, center, ISLAND, map, rng)
		MapBuilder.Zones[i] = layout
		if i > 1 then
			local prev = MapBuilder.Zones[i - 1]
			layout.Gate = buildBridgeAndGate(prev, zone, prev.Folder)
		end
	end

	-- منطقة VIP
	local vipCenter = Config.Map.VIPOffset
	local vipLayout = buildIsland(Zones.VIP, vipCenter, 200, map, rng)
	MapBuilder.Zones[0] = vipLayout
	MapBuilder.VIPReturnPortal = buildPortal(vipLayout.Folder, vipCenter + Vector3.new(0, 0, -70), Color3.fromRGB(120, 200, 255), "🏠 العودة للبلدة")
	MapBuilder.VIPReturnPortal:SetAttribute("Portal", "Return")

	-- البلدة: سبون، آلات، صناديق خاصة، بوابة VIP، لوحات
	local town = MapBuilder.Zones[1]
	local tf = town.Folder
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Size = Vector3.new(14, 1, 14)
	spawnLoc.CFrame = CFrame.new(town.Spawn + Vector3.new(0, 0.5, 0))
	spawnLoc.Anchored = true
	spawnLoc.Color = Color3.fromRGB(255, 255, 255)
	spawnLoc.Material = Enum.Material.Marble
	spawnLoc.TopSurface = Enum.SurfaceType.Smooth
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Parent = tf

	for i, info in ipairs(MACHINE_INFO) do
		local pos = town.Center + Vector3.new(118, 0, -105 + (i - 1) * 34)
		MapBuilder.Machines[info.Kind] = buildMachine(tf, info, pos)
	end

	MapBuilder.Specials.GiantChest = town.Center + Vector3.new(60, 0, 118)
	MapBuilder.Specials.MysteryBox = town.Center + Vector3.new(-60, 0, 118)

	MapBuilder.VIPPortal = buildPortal(tf, town.Center + Vector3.new(-118, 0, -112), Color3.fromRGB(255, 215, 0), "👑 VIP Lounge")
	MapBuilder.VIPPortal:SetAttribute("Portal", "VIP")

	MapBuilder.Boards.Coins = buildBoard(tf, town.Center + Vector3.new(-72, 0, -140), "💰 أغنى اللاعبين", Color3.fromRGB(255, 200, 40))
	MapBuilder.Boards.Hatches = buildBoard(tf, town.Center + Vector3.new(-104, 0, -140), "🥚 أكثر فتحاً للبيض", Color3.fromRGB(120, 200, 255))

	-- أرضية الموت تحت الجزر
	local kill = part(map, "KillPlane", Vector3.new(4000, 1, 8000), CFrame.new(300, -120, 2000), Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic)
	kill.Transparency = 1
	kill.CanCollide = false
	kill.Touched:Connect(function(hit)
		local hum = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		end
	end)
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المخزن، التجهيز، الحذف، القفل، والآلات (Golden / Rainbow / Dark Matter / Fuse)
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Eggs = require(Shared.Data.Eggs)
local PetUtil = require(Shared.Modules.PetUtil)
local Luck = require(Shared.Modules.Luck)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local PetService = {}

type PetInstance = PetUtil.PetInstance

local rng = Random.new()

function PetService.StorageCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseStorage + (p.Upgrades.Storage or 0) * 25
	if DataService.HasGamepass(player, "PlusStorage") then
		cap += Config.GamepassStorageBonus
	end
	return cap
end

function PetService.EquipCapacity(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local cap = Config.BaseEquip + (p.Upgrades.Equip or 0)
	if DataService.HasGamepass(player, "PlusEquip") then
		cap += Config.GamepassEquipBonus
	end
	return cap
end

function PetService.FreeSlots(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	return PetService.StorageCapacity(player) - #p.Pets
end

local function find(p: DataService.Profile, uid: string): (PetInstance?, number?)
	for i, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet, i
		end
	end
	return nil, nil
end

local function equippedCount(p: DataService.Profile): number
	local n = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			n += 1
		end
	end
	return n
end

function PetService.UpdateEquippedAttribute(player: Player)
	local p = DataService.Get(player)
	if not p then
		return
	end
	local list = {}
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			table.insert(list, { Uid = pet.Uid, Id = pet.Id, Variant = pet.Variant })
		end
	end
	player:SetAttribute("EquippedPets", HttpService:JSONEncode(list))
	player:SetAttribute("TotalPower", PetService.GetPower(player))
end

function PetService.GetPower(player: Player): number
	local p = DataService.Get(player)
	if not p then
		return 0
	end
	local total = 0
	for _, pet in ipairs(p.Pets) do
		if pet.Equipped then
			total += PetUtil.BasePower(pet)
		end
	end
	local mult = 1 + (p.Upgrades.Damage or 0) * 0.05
	return total * mult
end

function PetService.Add(player: Player, petId: string, variant: string?, ignoreCapacity: boolean?): PetInstance?
	local p = DataService.Get(player)
	local def = Pets.Get(petId)
	if not p or not def then
		return nil
	end
	if not ignoreCapacity and #p.Pets >= PetService.StorageCapacity(player) then
		return nil
	end
	local inst: PetInstance = {
		Uid = HttpService:GenerateGUID(false),
		Id = petId,
		Variant = variant or "Normal",
		Locked = false,
		Equipped = false,
		Time = os.time(),
	}
	table.insert(p.Pets, inst)
	p.Index[petId] = true
	local power = PetUtil.BasePower(inst)
	if power > (p.Stats.BestPet or 0) then
		p.Stats.BestPet = power
	end
	-- تجهيز تلقائي إذا فيه مكان
	if equippedCount(p) < PetService.EquipCapacity(player) then
		inst.Equipped = true
	end
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return inst
end

local function remove(p: DataService.Profile, uid: string): PetInstance?
	local pet, idx = find(p, uid)
	if pet and idx then
		table.remove(p.Pets, idx)
	end
	return pet
end

-- إجراءات المخزن
function PetService.Action(player: Player, action: string, payload: any): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	payload = type(payload) == "table" and payload or {}

	if action == "Equip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		if pet.Equipped then
			return { ok = true }
		end
		if equippedCount(p) >= PetService.EquipCapacity(player) then
			return { ok = false, error = "وصلت للحد الأقصى من التجهيز" }
		end
		pet.Equipped = true
	elseif action == "Unequip" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Equipped = false
	elseif action == "Lock" then
		local pet = find(p, tostring(payload.Uid))
		if not pet then
			return { ok = false, error = "الحيوان غير موجود" }
		end
		pet.Locked = not pet.Locked
	elseif action == "Delete" then
		local uids = payload.Uids or { payload.Uid }
		local n = 0
		for _, uid in ipairs(uids) do
			local pet = find(p, tostring(uid))
			if pet and not pet.Locked then
				remove(p, pet.Uid)
				n += 1
			end
		end
		if n == 0 then
			return { ok = false, error = "لا يمكن حذف حيوان مقفول" }
		end
	elseif action == "UnequipAll" then
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
	elseif action == "EquipBest" then
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		local cap = PetService.EquipCapacity(player)
		for _, pet in ipairs(p.Pets) do
			pet.Equipped = false
		end
		for i = 1, math.min(cap, #sorted) do
			sorted[i].Equipped = true
		end
	elseif action == "Setting" then
		local key = tostring(payload.Key)
		if p.Settings[key] == nil then
			return { ok = false, error = "إعداد غير معروف" }
		end
		p.Settings[key] = payload.Value == true
	else
		return { ok = false, error = "إجراء غير معروف" }
	end

	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	return { ok = true }
end

-- الآلات
local function collect(p: DataService.Profile, uids: any): { PetInstance }?
	if type(uids) ~= "table" then
		return nil
	end
	local out = {}
	local seen = {}
	for _, uid in ipairs(uids) do
		uid = tostring(uid)
		if seen[uid] then
			return nil
		end
		seen[uid] = true
		local pet = find(p, uid)
		if not pet or pet.Locked then
			return nil
		end
		table.insert(out, pet)
	end
	return out
end

function PetService.Machine(player: Player, kind: string, payload: any): { ok: boolean, error: string?, result: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	payload = type(payload) == "table" and payload or {}

	if kind == "Golden" or kind == "Rainbow" then
		local need = Config.Machines[kind].Requires
		local fromVariant = kind == "Golden" and "Normal" or "Golden"
		local toVariant = kind == "Golden" and "Golden" or "Rainbow"
		local pets = collect(p, payload.Uids)
		if not pets or #pets ~= need then
			return { ok = false, error = "اختر " .. need .. " حيوانات (غير مقفولة)" }
		end
		local id = pets[1].Id
		for _, pet in ipairs(pets) do
			if pet.Id ~= id or pet.Variant ~= fromVariant then
				return { ok = false, error = "يجب أن تكون نفس الحيوان ونفس النوع" }
			end
		end
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local result = PetService.Add(player, id, toVariant, true)
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	elseif kind == "DarkMatterStart" then
		local pets = collect(p, { payload.Uid })
		if not pets or #pets ~= 1 or pets[1].Variant ~= "Rainbow" then
			return { ok = false, error = "اختر حيوان Rainbow واحد" }
		end
		local cost = Config.Machines.DarkMatter.CostDiamonds
		if not DataService.Spend(player, "Diamonds", cost) then
			return { ok = false, error = "تحتاج " .. cost .. " ألماسة" }
		end
		local pet = remove(p, pets[1].Uid)
		table.insert(p.DarkMatter, { PetId = (pet :: PetInstance).Id, Ready = os.time() + Config.Machines.DarkMatter.Time })
		DataService.MarkDirty(player)
		PetService.UpdateEquippedAttribute(player)
		return { ok = true }
	elseif kind == "DarkMatterClaim" then
		local idx = tonumber(payload.Index)
		local entry = idx and p.DarkMatter[idx]
		if not entry then
			return { ok = false, error = "غير موجود" }
		end
		if os.time() < entry.Ready then
			return { ok = false, error = "لم يجهز بعد" }
		end
		if PetService.FreeSlots(player) <= 0 then
			return { ok = false, error = "المخزن ممتلئ" }
		end
		table.remove(p.DarkMatter, idx :: number)
		local result = PetService.Add(player, entry.PetId, "DarkMatter")
		return { ok = true, result = result }
	elseif kind == "Fuse" then
		local cfg = Config.Machines.Fuse
		local pets = collect(p, payload.Uids)
		if not pets or #pets < cfg.Min or #pets > cfg.Max then
			return { ok = false, error = "اختر من " .. cfg.Min .. " إلى " .. cfg.Max .. " حيوانات" }
		end
		local bestTier = 1
		local variant = pets[1].Variant
		local sameVariant = true
		for _, pet in ipairs(pets) do
			local def = Pets.Get(pet.Id)
			if def and def.Tier > bestTier then
				bestTier = def.Tier
			end
			if pet.Variant ~= variant then
				sameVariant = false
			end
		end
		local upgradeChance = math.min(0.6, cfg.UpgradeChance * (#pets - 2))
		local targetTier = bestTier
		if rng:NextNumber() < upgradeChance then
			targetTier = math.min(10, bestTier + 1)
		end
		local function eggForTier(tier: number)
			for _, e in ipairs(Eggs.List) do
				if e.Zone == tier and e.Currency == "Coins" and not e.VIPOnly then
					return e
				end
			end
			return nil
		end
		local egg = eggForTier(targetTier) or eggForTier(bestTier) or Eggs.Get("StarterEgg")
		for _, pet in ipairs(pets) do
			remove(p, pet.Uid)
		end
		local petId = Luck.Roll((egg :: any).Id, 1.5, rng) or "cat"
		local result = PetService.Add(player, petId, sameVariant and variant or "Normal", true)
		DataService.MarkDirty(player)
		return { ok = true, result = result }
	end
	return { ok = false, error = "آلة غير معروفة" }
end

function PetService.Init()
	Remotes.Function("PetAction").OnServerInvoke = function(player, action, payload)
		return PetService.Action(player, tostring(action), payload)
	end
	Remotes.Function("Machine").OnServerInvoke = function(player, kind, payload)
		return PetService.Machine(player, tostring(kind), payload)
	end
	DataService.Loaded:Connect(function(player)
		PetService.UpdateEquippedAttribute(player)
	end)
	table.insert(DataService.Extenders, function(player, payload)
		payload.StorageCap = PetService.StorageCapacity(player)
		payload.EquipCap = PetService.EquipCapacity(player)
		payload.Power = PetService.GetPower(player)
	end)
end

return PetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--!strict
-- المكافآت اليومية، مكافآت وقت اللعب، الأكواد، مكافأة المجموعة
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local RewardService = {}

local DAY = 20 * 3600 -- يمكن الاستلام كل 20 ساعة
local RESET = 48 * 3600

local function grant(player: Player, reward: any)
	if reward.Coins then
		DataService.AddCoins(player, reward.Coins)
	end
	if reward.Diamonds then
		DataService.AddDiamonds(player, reward.Diamonds)
	end
	if reward.Potion then
		DataService.GivePotion(player, reward.Potion)
	end
	if reward.Pet then
		PetService.Add(player, reward.Pet, reward.Variant or "Normal", true)
	end
	DataService.MarkDirty(player)
end

function RewardService.ClaimDaily(player: Player): { ok: boolean, error: string?, reward: any? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local now = os.time()
	local since = now - (p.Daily.LastClaim or 0)
	if since < DAY then
		return { ok = false, error = "عد بعد " .. math.ceil((DAY - since) / 3600) .. " ساعة" }
	end
	if since > RESET then
		p.Daily.Streak = 0
	end
	p.Daily.Streak += 1
	p.Daily.LastClaim = now
	local idx = ((p.Daily.Streak - 1) % #Config.DailyRewards) + 1
	local reward = Config.DailyRewards[idx]
	grant(player, reward)
	DataService.Notify(player, "🎁 مكافأة اليوم " .. idx .. " استلمتها!", Color3.fromRGB(255, 200, 80))
	return { ok = true, reward = reward }
end

function RewardService.ClaimPlaytime(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local reward = Config.PlaytimeRewards[index]
	if not p or not reward then
		return { ok = false, error = "غير موجود" }
	end
	if p.PlaytimeClaimed[tostring(index)] then
		return { ok = false, error = "تم الاستلام" }
	end
	local elapsed = os.time() - p.SessionStart
	if elapsed < reward.Minutes * 60 then
		return { ok = false, error = "لم يحن الوقت بعد" }
	end
	p.PlaytimeClaimed[tostring(index)] = true
	grant(player, reward)
	DataService.Notify(player, "⏱️ استلمت مكافأة " .. reward.Minutes .. " دقيقة!", Color3.fromRGB(120, 255, 200))
	return { ok = true }
end

function RewardService.RedeemCode(player: Player, code: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	code = string.upper((tostring(code):gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, error = "كود غير صحيح" }
	end
	if p.Codes[code] then
		return { ok = false, error = "استخدمت هذا الكود من قبل" }
	end
	p.Codes[code] = true
	grant(player, reward)
	DataService.Notify(player, "🔑 تم تفعيل الكود " .. code .. "!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function RewardService.Init()
	Remotes.Function("ClaimDaily").OnServerInvoke = function(player)
		return RewardService.ClaimDaily(player)
	end
	Remotes.Function("ClaimPlaytime").OnServerInvoke = function(player, index)
		return RewardService.ClaimPlaytime(player, tonumber(index) or 0)
	end
	Remotes.Function("RedeemCode").OnServerInvoke = function(player, code)
		return RewardService.RedeemCode(player, tostring(code))
	end
	Remotes.Function("GetServerTime").OnServerInvoke = function()
		return os.time()
	end
	DataService.Loaded:Connect(function(player, profile)
		if Config.GroupId > 0 then
			local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
			if ok and inGroup then
				profile.InGroup = true
				DataService.MarkDirty(player)
			end
		end
	end)
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!strict
-- الجيم باس، المنتجات (الألماس/الجرعات)، الترقيات
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)
local ZoneService = require(script.Parent.ZoneService)

local ShopService = {}

local function gamepassKeyFromId(id: number): string?
	for key, gid in pairs(Config.Gamepasses) do
		if gid == id and gid > 0 then
			return key
		end
	end
	return nil
end

local function productKeyFromId(id: number): string?
	for key, pid in pairs(Config.DevProducts) do
		if pid == id and pid > 0 then
			return key
		end
	end
	return nil
end

local function grantGamepass(player: Player, key: string)
	local p = DataService.Get(player)
	if not p then
		return
	end
	p.Gamepasses[key] = true
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
end

local function refreshGamepasses(player: Player)
	for key, id in pairs(Config.Gamepasses) do
		if id > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
			if ok and owns then
				grantGamepass(player, key)
			end
		end
	end
end

function ShopService.UpgradeCost(key: string, level: number): number?
	for _, u in ipairs(Config.Upgrades) do
		if u.Key == key then
			if level >= u.MaxLevel then
				return nil
			end
			return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
		end
	end
	return nil
end

function ShopService.BuyUpgrade(player: Player, key: string): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	if not p then
		return { ok = false, error = "لم يتم تحميل البيانات" }
	end
	local level = p.Upgrades[key]
	if level == nil then
		return { ok = false, error = "ترقية غير موجودة" }
	end
	local cost = ShopService.UpgradeCost(key, level)
	if not cost then
		return { ok = false, error = "وصلت للمستوى الأقصى" }
	end
	if not DataService.Spend(player, "Diamonds", cost) then
		return { ok = false, error = "تحتاج 💎 " .. cost }
	end
	p.Upgrades[key] = level + 1
	DataService.MarkDirty(player)
	PetService.UpdateEquippedAttribute(player)
	if key == "Speed" then
		ZoneService.RefreshSpeed(player)
	end
	return { ok = true }
end

local function grantProduct(player: Player, key: string): boolean
	local info
	for _, i in ipairs(Config.DevProductInfo) do
		if i.Key == key then
			info = i
		end
	end
	if not info then
		return false
	end
	if info.Diamonds then
		DataService.AddDiamonds(player, info.Diamonds)
		DataService.Notify(player, "💎 حصلت على " .. info.Diamonds .. " ألماسة!", Color3.fromRGB(120, 220, 255))
	elseif info.Potion then
		DataService.GivePotion(player, info.Potion)
	end
	return true
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player or not DataService.Get(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = productKeyFromId(receipt.ProductId)
		if key and grantProduct(player, key) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = gamepassKeyFromId(passId)
		if key then
			grantGamepass(player, key)
			DataService.Notify(player, "✅ تم شراء " .. key .. "!", Color3.fromRGB(120, 255, 140))
		end
	end)

	Remotes.Event("PromptPurchase").OnServerEvent:Connect(function(player, kind, key)
		key = tostring(key)
		if kind == "Gamepass" then
			local id = Config.Gamepasses[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم الجيم باس بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		elseif kind == "Product" then
			local id = Config.DevProducts[key]
			if id and id > 0 then
				pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, id)
			else
				DataService.Notify(player, "⚠️ لم يتم ضبط رقم المنتج بعد (Config)", Color3.fromRGB(255, 200, 80))
			end
		end
	end)

	Remotes.Function("BuyUpgrade").OnServerInvoke = function(player, key)
		return ShopService.BuyUpgrade(player, tostring(key))
	end

	DataService.Loaded:Connect(function(player)
		task.spawn(refreshGamepasses, player)
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000023"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source"><![CDATA[--!strict
-- فتح المناطق، البوابات، التنقل، بوابة VIP، سرعة المشي
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local MapBuilder = require(script.Parent.MapBuilder)

local ZoneService = {}

local touchDebounce: { [Player]: number } = {}

function ZoneService.Unlock(player: Player, index: number): { ok: boolean, error: string? }
	local p = DataService.Get(player)
	local zone = Zones.List[index]
	if not p or not zone then
		return { ok = false, error = "منطقة غير موجودة" }
	end
	if p.UnlockedZones[tostring(index)] then
		return { ok = true }
	end
	if not p.UnlockedZones[tostring(index - 1)] then
		return { ok = false, error = "افتح المنطقة السابقة أولاً" }
	end
	if not DataService.Spend(player, "Coins", zone.Cost) then
		return { ok = false, error = "تحتاج 💰 " .. Format.Number(zone.Cost) .. " لفتح " .. zone.Name }
	end
	p.UnlockedZones[tostring(index)] = true
	DataService.MarkDirty(player)
	DataService.Notify(player, "🔓 فتحت منطقة " .. zone.Name .. " (" .. zone.Arabic .. ")!", Color3.fromRGB(120, 255, 140))
	return { ok = true }
end

function ZoneService.Teleport(player: Player, index: number): boolean
	local p = DataService.Get(player)
	if not p then
		return false
	end
	if index == 0 then
		if not DataService.HasGamepass(player, "VIP") then
			return false
		end
	elseif not p.UnlockedZones[tostring(index)] then
		return false
	end
	local layout = MapBuilder.Zones[index]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not layout or not hrp then
		return false
	end
	hrp.CFrame = CFrame.new(layout.Spawn + Vector3.new(0, 4, 0), layout.Center)
	p.LastZone = index
	DataService.MarkDirty(player)
	return true
end

local function onGateTouched(gate: BasePart, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 1.5 then
		return
	end
	touchDebounce[player] = now
	local index = gate:GetAttribute("Zone") :: number
	local p = DataService.Get(player)
	if not p or p.UnlockedZones[tostring(index)] then
		return
	end
	local res = ZoneService.Unlock(player, index)
	if not res.ok and res.error then
		DataService.Notify(player, res.error, Color3.fromRGB(255, 120, 120))
	end
end

local function onPortalTouched(kind: string, hit: BasePart)
	local char = hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		return
	end
	local now = os.clock()
	if now - (touchDebounce[player] or 0) < 2 then
		return
	end
	touchDebounce[player] = now
	if kind == "VIP" then
		if DataService.HasGamepass(player, "VIP") then
			ZoneService.Teleport(player, 0)
		else
			DataService.Notify(player, "👑 منطقة VIP لأصحاب جيم باس VIP", Color3.fromRGB(255, 215, 0))
			if Config.Gamepasses.VIP > 0 then
				pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, Config.Gamepasses.VIP)
			end
		end
	else
		ZoneService.Teleport(player, 1)
	end
end

local function applyCharacter(player: Player, char: Model)
	local p = DataService.Get(player)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum and p then
		hum.WalkSpeed = 16 + (p.Upgrades.Speed or 0) * 2
	end
	task.wait(0.3)
	if p and p.LastZone and p.LastZone ~= 1 then
		ZoneService.Teleport(player, p.LastZone)
	end
	if DataService.HasGamepass(player, "VIP") then
		player:SetAttribute("VIP", true)
		local head = char:FindFirstChild("Head")
		if head and not head:FindFirstChild("VIPTag") then
			local bb = Instance.new("BillboardGui")
			bb.Name = "VIPTag"
			bb.Size = UDim2.fromScale(4, 1)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.AlwaysOnTop = true
			local l = Instance.new("TextLabel")
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Text = "👑 VIP"
			l.TextColor3 = Color3.fromRGB(255, 215, 0)
			l.TextStrokeTransparency = 0.2
			l.Font = Enum.Font.FredokaOne
			l.TextScaled = true
			l.Parent = bb
			bb.Parent = head
		end
	end
end

function ZoneService.RefreshSpeed(player: Player)
	local p = DataService.Get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if p and hum then
		hum.WalkSpeed = 16 + (p.Upgrades.Speed or 0) * 2
	end
end

function ZoneService.Init()
	for index, layout in pairs(MapBuilder.Zones) do
		if layout.Gate then
			local gate = layout.Gate
			gate.Touched:Connect(function(hit)
				onGateTouched(gate, hit)
			end)
		end
	end
	if MapBuilder.VIPPortal then
		MapBuilder.VIPPortal.Touched:Connect(function(hit)
			onPortalTouched("VIP", hit)
		end)
	end
	if MapBuilder.VIPReturnPortal then
		MapBuilder.VIPReturnPortal.Touched:Connect(function(hit)
			onPortalTouched("Return", hit)
		end)
	end

	Remotes.Function("UnlockZone").OnServerInvoke = function(player, index)
		return ZoneService.Unlock(player, tonumber(index) or 0)
	end
	Remotes.Event("Teleport").OnServerEvent:Connect(function(player, index)
		ZoneService.Teleport(player, tonumber(index) or 1)
	end)

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			applyCharacter(player, char)
		end)
		if player.Character then
			task.spawn(applyCharacter, player, player.Character)
		end
	end
	DataService.Loaded:Connect(function(player)
		hook(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		touchDebounce[player] = nil
	end)
end

return ZoneService
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="Folder" referent="RBX000040"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX000026"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--!strict
-- نقطة تشغيل العميل
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
Remotes.Init()

local Controllers = script.Parent:WaitForChild("Controllers")

local DataController = require(Controllers.DataController)
local UIController = require(Controllers.UIController)
local InventoryUI = require(Controllers.InventoryUI)
local ShopUI = require(Controllers.ShopUI)
local MachineUI = require(Controllers.MachineUI)
local EggController = require(Controllers.EggController)
local PetController = require(Controllers.PetController)
local BreakableController = require(Controllers.BreakableController)
local ZoneController = require(Controllers.ZoneController)
local EffectsController = require(Controllers.EffectsController)

DataController.Init()
DataController.Wait()

UIController.Init()
InventoryUI.Init()
ShopUI.Init()
MachineUI.Init()
EffectsController.Init()
EggController.Init()
PetController.Init()
BreakableController.Init()
ZoneController.Init()

-- شارة VIP في الشات
local TextChatService = game:GetService("TextChatService")
local Players = game:GetService("Players")
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				props.PrefixText = "<font color='#FFD700'>[👑 VIP]</font> " .. message.PrefixText
			end
		end
		return props
	end
end

print("[PetKingdom] Client ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000039"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000027"><Properties><string name="Name">BreakableController</string><ProtectedString name="Source"><![CDATA[--!strict
-- أشرطة الصحة فوق الصناديق، تأثير الضرب، ونوافذ المكافأة
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Breakables = require(Shared.Data.Breakables)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)

local BreakableController = {}

local function attach(model: Model)
	local root = model.PrimaryPart or model:FindFirstChild("Base") :: BasePart?
	if not root then
		return
	end
	local typeName = model:GetAttribute("Type") :: string
	local def = Breakables.Get(typeName or "")
	local bb = Instance.new("BillboardGui")
	bb.Name = "HealthBar"
	bb.Size = UDim2.fromOffset(150, 52)
	bb.StudsOffset = Vector3.new(0, root.Size.Y / 2 + 3, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	local name = UIKit.Label({ Text = def and def.Name or typeName, Size = UDim2.new(1, 0, 0, 22), TextStrokeTransparency = 0.2, Parent = bb })
	local coins = model:GetAttribute("Coins") :: number
	local diamonds = model:GetAttribute("Diamonds") :: number
	local rewardText = ""
	if coins and coins > 0 then
		rewardText = "💰 " .. Format.Number(coins)
	end
	if diamonds and diamonds > 0 then
		rewardText = rewardText .. " 💎 " .. diamonds
	end
	UIKit.Label({ Text = rewardText, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 22), TextColor3 = UIKit.Colors.Gold, Parent = bb })
	local _bg, fill, label = UIKit.ProgressBar(bb, UIKit.Colors.Green, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 40))
	label.Visible = false
	local function update()
		local h = model:GetAttribute("Health") :: number or 0
		local mh = model:GetAttribute("MaxHealth") :: number or 1
		local ratio = math.clamp(h / mh, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = ratio > 0.5 and UIKit.Colors.Green or (ratio > 0.2 and UIKit.Colors.Gold or UIKit.Colors.Red)
		name.Text = (def and def.Name or typeName) .. "  " .. Format.Number(h)
	end
	update()
	model:GetAttributeChangedSignal("Health"):Connect(update)
	model:GetAttributeChangedSignal("LastHit"):Connect(function()
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.new(1, 1, 1)
		hl.FillTransparency = 0.3
		hl.OutlineTransparency = 1
		hl.Parent = model
		UIKit.Tween(hl, { FillTransparency = 1 }, 0.25)
		Debris:AddItem(hl, 0.3)
	end)
	bb.Parent = root
end

local function popup(data: any)
	local pos = data.Position :: Vector3
	local text = ""
	if data.Coins and data.Coins > 0 then
		text = "+" .. Format.Number(data.Coins) .. " 💰"
	end
	if data.Diamonds and data.Diamonds > 0 then
		text = text .. "  +" .. data.Diamonds .. " 💎"
	end
	if text == "" then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = pos
	anchor.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 50)
	bb.AlwaysOnTop = true
	bb.StudsOffset = Vector3.new(0, 0, 0)
	local label = UIKit.Label({ Text = text, TextColor3 = UIKit.Colors.Gold, TextStrokeTransparency = 0, Parent = bb })
	bb.Parent = anchor
	UIKit.Tween(bb, { StudsOffset = Vector3.new(0, 6, 0) }, 1.2)
	UIKit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(anchor, 1.3)
end

function BreakableController.Init()
	local folder = Workspace:WaitForChild("Breakables")
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") then
			attach(m)
		end
	end
	folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") and not m:FindFirstChild("HealthBar", true) then
			task.defer(attach, m)
		end
	end)
	Remotes.Event("RewardPopup").OnClientEvent:Connect(popup)
end

return BreakableController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000028"><Properties><string name="Name">DataController</string><ProtectedString name="Source"><![CDATA[--!strict
-- نسخة العميل من بيانات اللاعب
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local DataController = {}

local changed = Instance.new("BindableEvent")
DataController.Changed = changed.Event
DataController.Profile = nil :: any
local serverOffset = 0

function DataController.Init()
	Remotes.Event("ProfileUpdate").OnClientEvent:Connect(function(profile)
		DataController.Profile = profile
		if profile.ServerTime then
			serverOffset = profile.ServerTime - os.time()
		end
		changed:Fire(profile)
	end)
end

function DataController.Wait(): any
	local t = 0
	while not DataController.Profile do
		if t % 2 == 0 then
			Remotes.Event("RequestProfile"):FireServer()
		end
		task.wait(0.5)
		t += 1
	end
	return DataController.Profile
end

function DataController.ServerTime(): number
	return os.time() + serverOffset
end

function DataController.Owns(pass: string): boolean
	local p = DataController.Profile
	return p ~= nil and p.OwnedPasses ~= nil and p.OwnedPasses[pass] == true
end

function DataController.FindPet(uid: string): any
	local p = DataController.Profile
	if not p then
		return nil
	end
	for _, pet in ipairs(p.Pets) do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end

return DataController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000029"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!strict
-- تأثيرات: ألوان قوس قزح للحيوانات، الموسيقى، الأصوات
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DataController = require(script.Parent.DataController)

local EffectsController = {}

local sounds: { [string]: Sound } = {}
local music: Sound?

function EffectsController.Play(name: string)
	local s = sounds[name]
	if s then
		s:Play()
	end
end

function EffectsController.Init()
	for name, id in pairs(Config.Sounds) do
		if id and id > 0 then
			local s = Instance.new("Sound")
			s.SoundId = "rbxassetid://" .. id
			s.Volume = name == "Music" and 0.35 or 0.6
			s.Looped = name == "Music"
			s.Parent = SoundService
			sounds[name] = s
			if name == "Music" then
				music = s
			end
		end
	end
	if music then
		music:Play()
		DataController.Changed:Connect(function(p)
			if p.Settings and p.Settings.Music == false then
				music:Pause()
			elseif not music.IsPlaying then
				music:Play()
			end
		end)
	end

	-- دورة ألوان قوس قزح
	local hue = 0
	RunService.Heartbeat:Connect(function(dt)
		hue = (hue + dt * 0.25) % 1
		local color = Color3.fromHSV(hue, 0.85, 1)
		local folder = Workspace:FindFirstChild("ClientPets")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:GetAttribute("Variant") == "Rainbow" then
					for _, part in ipairs(model:GetChildren()) do
						if part:IsA("BasePart") and part:GetAttribute("Rainbow") then
							part.Color = color
						end
					end
				end
			end
		end
	end)
end

return EffectsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000030"><Properties><string name="Name">EggController</string><ProtectedString name="Source"><![CDATA[--!strict
-- لوحة البيضة عند الاقتراب + شاشة الفتح (أنيميشن) + الفتح التلقائي
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared.Data.Eggs)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Luck = require(Shared.Modules.Luck)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local PetViewport = require(script.Parent.PetViewport)
local EffectsController = require(script.Parent.EffectsController)

local EggController = {}

local player = Players.LocalPlayer
local panel: Frame
local panelTitle: TextLabel
local panelList: Frame
local tripleBtn: TextButton
local autoBtn: TextButton
local overlay: Frame
local overlayContent: Frame
local panelEgg: string? = nil
local hatching = false
local autoHatch = false
local eggModels: { Model } = {}

local function buildPanel(gui: ScreenGui)
	panel = UIKit.Frame({ Name = "EggPanel", Size = UDim2.fromOffset(560, 230), Position = UDim2.new(0.5, -280, 1, -250), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.05, Visible = false, Parent = gui })
	UIKit.Corner(panel, 18)
	UIKit.Stroke(panel, UIKit.Colors.Gold, 3)
	panelTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 6), MaxTextSize = 26, Parent = panel })
	panelList = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 120), Position = UDim2.fromOffset(8, 44), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(panelList, 6, true, true)
	local buttons = UIKit.Frame({ Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 1, -52), BackgroundTransparency = 1, Parent = panel })
	UIKit.List(buttons, 8, true, true)
	UIKit.Button({ Text = "فتح (E)", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(170, 44), MaxTextSize = 20, Parent = buttons }, function()
		EggController.Hatch(1)
	end)
	tripleBtn = UIKit.Button({ Text = "فتح 3 (R)", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(170, 44), MaxTextSize = 20, Parent = buttons }, function()
		EggController.Hatch(3)
	end)
	autoBtn = UIKit.Button({ Text = "تلقائي (T)", Color = UIKit.Colors.Purple, Size = UDim2.fromOffset(170, 44), MaxTextSize = 20, Parent = buttons }, function()
		EggController.ToggleAuto()
	end)
end

local function refreshPanel()
	if not panelEgg then
		return
	end
	local egg = Eggs.Get(panelEgg) :: Eggs.EggDef
	local p = DataController.Profile
	local luck = p and p.Luck or 1
	panelTitle.Text = egg.Name .. "   " .. (egg.Currency == "Coins" and "💰 " or "💎 ") .. Format.Number(egg.Cost) .. (luck > 1 and ("   🍀 x" .. string.format("%.2f", luck)) or "")
	for _, c in ipairs(panelList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, entry in ipairs(Luck.ApplyLuck(panelEgg, luck)) do
		local def = Pets.Get(entry.Pet) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromOffset(84, 118), BackgroundColor3 = UIKit.Colors.Panel2, Parent = panelList })
		UIKit.Corner(card, 10)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 2)
		local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, Parent = card })
		PetViewport.Create(vp, def.Id, "Normal")
		UIKit.Label({ Text = def.Name, Size = UDim2.new(1, -4, 0, 20), Position = UDim2.fromOffset(2, 72), MaxTextSize = 12, Parent = card })
		UIKit.Label({ Text = Format.Percent(entry.Chance), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 94), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 14, Parent = card })
	end
	tripleBtn.BackgroundColor3 = DataController.Owns("TripleHatch") and UIKit.Colors.Gold or UIKit.Colors.Panel3
	autoBtn.BackgroundColor3 = autoHatch and UIKit.Colors.Green or (DataController.Owns("AutoHatch") and UIKit.Colors.Purple or UIKit.Colors.Panel3)
	autoBtn.Text = autoHatch and "إيقاف (T)" or "تلقائي (T)"
end

-- ===== شاشة الفتح =====
local function buildOverlay(gui: ScreenGui)
	overlay = UIKit.Frame({ Name = "HatchOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 10, Parent = gui })
	overlayContent = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11, Parent = overlay })
	UIKit.List(overlayContent, 24, true, true)
	local skip = UIKit.Label({ Text = "اضغط في أي مكان للتخطي", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -60), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 20, ZIndex = 12, Parent = overlay })
	skip.Name = "Skip"
end

local function eggViewport(parent: Instance, egg: Eggs.EggDef): (ViewportFrame, Model)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromOffset(260, 300)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	vp.ZIndex = 12
	local model = Instance.new("Model")
	local shell = Instance.new("Part")
	shell.Size = Vector3.new(4, 5.2, 4)
	shell.Color = egg.Color
	shell.Anchored = true
	shell.Material = Enum.Material.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	shell.Parent = model
	local rng = Random.new(#egg.Id)
	for _ = 1, 6 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-1.4, 1.4)
		local r = 1.85 * math.sqrt(math.max(0, 1 - (y / 2.6) ^ 2))
		local spot = Instance.new("Part")
		spot.Shape = Enum.PartType.Ball
		spot.Size = Vector3.new(0.8, 0.8, 0.8)
		spot.Color = egg.Accent
		spot.Anchored = true
		spot.CFrame = CFrame.new(math.cos(ang) * r, y, math.sin(ang) * r)
		spot.Parent = model
	end
	model.PrimaryPart = shell
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 45
	cam.CFrame = CFrame.new(Vector3.new(0, 0.5, -9), Vector3.new(0, 0, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp, model
end

local function playHatch(eggId: string, results: { any })
	local egg = Eggs.Get(eggId) :: Eggs.EggDef
	hatching = true
	overlay.Visible = true
	for _, c in ipairs(overlayContent:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local slots = {}
	for _, res in ipairs(results) do
		local holder = UIKit.Frame({ Size = UDim2.fromOffset(260, 360), BackgroundTransparency = 1, ZIndex = 11, Parent = overlayContent })
		local vp, model = eggViewport(holder, egg)
		table.insert(slots, { Holder = holder, Vp = vp, Model = model, Result = res })
	end
	EffectsController.Play("Hatch")
	-- اهتزاز
	local t0 = os.clock()
	local skipped = false
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Space then
			skipped = true
		end
	end)
	while os.clock() - t0 < 1.6 and not skipped do
		local dt = os.clock() - t0
		for _, s in ipairs(slots) do
			local ang = math.sin(dt * 28) * 0.28 * math.min(1, dt * 2)
			local scale = 1 + math.sin(dt * 10) * 0.04
			s.Model:PivotTo(CFrame.new(0, math.abs(math.sin(dt * 14)) * 0.4, 0) * CFrame.Angles(0, 0, ang))
			s.Vp.Size = UDim2.fromOffset(260 * scale, 300 * scale)
		end
		RunService.RenderStepped:Wait()
	end
	-- كشف الحيوان
	for _, s in ipairs(slots) do
		s.Vp:Destroy()
		local def = Pets.Get(s.Result.Id) :: Pets.PetDef
		local card = UIKit.Frame({ Size = UDim2.fromOffset(240, 340), BackgroundColor3 = UIKit.Colors.Panel, ZIndex = 12, Parent = s.Holder })
		UIKit.Corner(card, 18)
		UIKit.Stroke(card, Rarities.Color(def.Rarity), 4)
		local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 240), BackgroundTransparency = 1, ZIndex = 12, Parent = card })
		local vp = PetViewport.Create(vpHolder, s.Result.Id, s.Result.Variant, true)
		vp.ZIndex = 12
		UIKit.Label({ Text = PetUtil.DisplayName(s.Result), Size = UDim2.new(1, -8, 0, 34), Position = UDim2.fromOffset(4, 244), MaxTextSize = 24, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or ""), Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 278), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 20, ZIndex = 13, Parent = card })
		UIKit.Label({ Text = "⚔️ " .. Format.Number(PetUtil.BasePower(s.Result)), Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 304), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 20, ZIndex = 13, Parent = card })
		UIKit.Pop(card)
		if Rarities.Rank(def.Rarity) >= 5 then
			UIController.Notify("🌟 حصلت على " .. def.Name .. " (" .. def.Rarity .. ")!", Rarities.Color(def.Rarity))
		end
	end
	local t1 = os.clock()
	skipped = false
	while os.clock() - t1 < (autoHatch and 1.4 or 2.6) and not skipped do
		task.wait(0.05)
	end
	conn:Disconnect()
	overlay.Visible = false
	hatching = false
end

function EggController.Hatch(count: number)
	if hatching or not panelEgg then
		return
	end
	if count == 3 and not DataController.Owns("TripleHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "TripleHatch")
		return
	end
	local eggId = panelEgg
	local res = Remotes.Function("HatchEgg"):InvokeServer(eggId, count)
	if res.ok and res.pets and #res.pets > 0 then
		playHatch(eggId, res.pets)
	elseif res.error then
		UIController.Notify(res.error, UIKit.Colors.Red)
		if res.error:find("ممتلئ") then
			autoHatch = false
			refreshPanel()
		end
	end
end

function EggController.ToggleAuto()
	if not DataController.Owns("AutoHatch") then
		Remotes.Event("PromptPurchase"):FireServer("Gamepass", "AutoHatch")
		return
	end
	autoHatch = not autoHatch
	refreshPanel()
end

local function nearestEgg(): string?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end
	local best, bestDist = nil, 16
	for _, m in ipairs(eggModels) do
		local pp = m.PrimaryPart
		if pp then
			local d = (pp.Position - hrp.Position).Magnitude
			if d < bestDist then
				best, bestDist = m:GetAttribute("EggId") :: string, d
			end
		end
	end
	return best
end

function EggController.Init()
	local gui = UIController.Gui :: ScreenGui
	buildPanel(gui)
	buildOverlay(gui)

	local map = Workspace:WaitForChild("Map")
	for _, inst in ipairs(map:GetDescendants()) do
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end
	map.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("EggId") then
			table.insert(eggModels, inst)
		end
	end)

	-- تحديث اللوحة حسب أقرب بيضة
	task.spawn(function()
		while true do
			task.wait(0.2)
			local id = nearestEgg()
			if id ~= panelEgg then
				panelEgg = id
				if id then
					refreshPanel()
					panel.Visible = true
					UIKit.Pop(panel)
				else
					panel.Visible = false
					autoHatch = false
				end
			end
		end
	end)

	-- الفتح التلقائي
	task.spawn(function()
		while true do
			task.wait(0.3)
			if autoHatch and panelEgg and not hatching then
				EggController.Hatch(DataController.Owns("TripleHatch") and 3 or 1)
			end
		end
	end)

	-- دوران البيض في العالم (القشرة مع النقاط)
	local spinCache: { [Model]: { Base: Vector3, Spots: { { Part: BasePart, Offset: CFrame } } } } = {}
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in ipairs(eggModels) do
			local shell = m.PrimaryPart
			if shell and shell:IsDescendantOf(Workspace) then
				local cache = spinCache[m]
				if not cache then
					cache = { Base = shell.Position, Spots = {} }
					for _, c in ipairs(m:GetChildren()) do
						if c:IsA("BasePart") and (c.Name == "Spot" or c.Name == "Crown") then
							table.insert(cache.Spots, { Part = c, Offset = shell.CFrame:ToObjectSpace(c.CFrame) })
						end
					end
					spinCache[m] = cache
				end
				local cf = CFrame.new(cache.Base + Vector3.new(0, math.sin(t * 2) * 0.3, 0)) * CFrame.Angles(0, t * 0.6, 0)
				shell.CFrame = cf
				for _, s in ipairs(cache.Spots) do
					s.Part.CFrame = cf * s.Offset
				end
			end
		end
	end)

	DataController.Changed:Connect(function()
		if panel.Visible then
			refreshPanel()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not panel.Visible then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			EggController.Hatch(1)
		elseif input.KeyCode == Enum.KeyCode.R then
			EggController.Hatch(3)
		elseif input.KeyCode == Enum.KeyCode.T then
			EggController.ToggleAuto()
		end
	end)
end

return EggController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000031"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نافذة الحيوانات: الشبكة، التفاصيل، التجهيز، القفل، الحذف، تجهيز الأفضل
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local PetViewport = require(script.Parent.PetViewport)
local UIController = require(script.Parent.UIController)

local InventoryUI = {}

local cards: { [string]: Frame } = {}
local selectedUid: string? = nil

-- بطاقة حيوان قابلة لإعادة الاستخدام (تستخدمها الآلات أيضاً)
function InventoryUI.PetCard(parent: Instance, pet: any, onClick: (() -> ())?): Frame
	local def = Pets.Get(pet.Id)
	local color = def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
	local card = UIKit.Frame({ Name = pet.Uid, BackgroundColor3 = UIKit.Colors.Panel2, Parent = parent })
	UIKit.Corner(card, 12)
	UIKit.Stroke(card, color, 2.5)
	local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 84), BackgroundTransparency = 1, Parent = card })
	PetViewport.Create(vpHolder, pet.Id, pet.Variant)
	UIKit.Label({ Text = PetUtil.DisplayName(pet), Size = UDim2.new(1, -6, 0, 20), Position = UDim2.fromOffset(3, 84), MaxTextSize = 14, Parent = card })
	UIKit.Label({ Text = "⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 104), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 14, Parent = card })
	local badge = UIKit.Label({ Name = "Badge", Text = "", Size = UDim2.fromOffset(26, 22), Position = UDim2.fromOffset(4, 4), MaxTextSize = 18, Parent = card })
	local lock = UIKit.Label({ Name = "Lock", Text = "", Size = UDim2.fromOffset(26, 22), Position = UDim2.new(1, -30, 0, 4), MaxTextSize = 18, Parent = card })
	badge.Text = pet.Equipped and "✅" or ""
	lock.Text = pet.Locked and "🔒" or ""
	if pet.Variant == "Golden" then
		UIKit.Gradient(card, Color3.fromRGB(80, 70, 30), UIKit.Colors.Panel)
	elseif pet.Variant == "Rainbow" then
		UIKit.Gradient(card, Color3.fromRGB(90, 40, 90), UIKit.Colors.Panel)
	elseif pet.Variant == "DarkMatter" then
		UIKit.Gradient(card, Color3.fromRGB(40, 10, 70), Color3.fromRGB(10, 5, 20))
	end
	local btn = UIKit.New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = card }) :: TextButton
	if onClick then
		btn.Activated:Connect(onClick)
	end
	return card
end

function InventoryUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Inventory", "🐾 حيواناتي", UDim2.fromOffset(860, 600), UIKit.Colors.Green)

	local header = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	local countLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(240, 44), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = header })
	local equipLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(200, 44), Position = UDim2.fromOffset(240, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 20, Parent = header })
	UIKit.Button({ Text = "⭐ تجهيز الأفضل", Color = UIKit.Colors.Gold, Size = UDim2.fromOffset(170, 40), Position = UDim2.new(1, -350, 0, 2), MaxTextSize = 18, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("EquipBest", {})
	end)
	UIKit.Button({ Text = "إزالة الكل", Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(120, 40), Position = UDim2.new(1, -170, 0, 2), MaxTextSize = 18, Parent = header }, function()
		Remotes.Function("PetAction"):InvokeServer("UnequipAll", {})
	end)
	UIKit.Button({ Text = "🗑️", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(44, 40), Position = UDim2.new(1, -44, 0, 2), MaxTextSize = 18, Parent = header }, function()
		-- حذف كل الحيوانات العادية غير المقفولة وغير المجهزة (Common/Uncommon)
		local p = DataController.Profile
		if not p then
			return
		end
		local uids = {}
		for _, pet in ipairs(p.Pets) do
			local def = Pets.Get(pet.Id)
			if def and not pet.Locked and not pet.Equipped and pet.Variant == "Normal" and Rarities.Rank(def.Rarity) <= 2 then
				table.insert(uids, pet.Uid)
			end
		end
		if #uids == 0 then
			UIController.Notify("لا يوجد حيوانات عادية للحذف", UIKit.Colors.Muted)
			return
		end
		local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uids = uids })
		if res.ok then
			UIController.Notify("🗑️ تم حذف " .. #uids .. " حيوان عادي", UIKit.Colors.Red)
		end
	end)

	local grid = UIKit.Scroll(w.Content, { Size = UDim2.new(1, -250, 1, -50), Position = UDim2.fromOffset(0, 50) })
	UIKit.Grid(grid, UDim2.fromOffset(118, 126), 8)

	-- لوحة التفاصيل
	local details = UIKit.Frame({ Size = UDim2.fromOffset(240, 0), Position = UDim2.new(1, -240, 0, 50), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Visible = false, Parent = w.Content })
	UIKit.Corner(details, 14)
	UIKit.Padding(details, 10)
	UIKit.List(details, 8, false, true)
	local dVp = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 150), BackgroundTransparency = 1, Parent = details })
	local dName = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 22, Parent = details })
	local dRarity = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 22), MaxTextSize = 18, Parent = details })
	local dPower = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 24), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 20, Parent = details })
	local equipBtn = UIKit.Button({ Text = "تجهيز", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 20, Parent = details })
	local lockBtn = UIKit.Button({ Text = "🔒 قفل", Color = UIKit.Colors.Blue, Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 20, Parent = details })
	local deleteBtn = UIKit.Button({ Text = "🗑️ حذف", Color = UIKit.Colors.Red, Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 20, Parent = details })

	local function showDetails(uid: string?)
		selectedUid = uid
		local pet = uid and DataController.FindPet(uid)
		if not pet then
			details.Visible = false
			return
		end
		local def = Pets.Get(pet.Id) :: Pets.PetDef
		details.Visible = true
		for _, c in ipairs(dVp:GetChildren()) do
			c:Destroy()
		end
		PetViewport.Create(dVp, pet.Id, pet.Variant, true)
		dName.Text = PetUtil.DisplayName(pet)
		dRarity.Text = def.Rarity .. " • " .. (Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].Arabic or "")
		dRarity.TextColor3 = Rarities.Color(def.Rarity)
		dPower.Text = "⚔️ القوة: " .. Format.Number(PetUtil.BasePower(pet))
		equipBtn.Text = pet.Equipped and "إزالة التجهيز" or "تجهيز"
		equipBtn.BackgroundColor3 = pet.Equipped and UIKit.Colors.Panel3 or UIKit.Colors.Green
		lockBtn.Text = pet.Locked and "🔓 فك القفل" or "🔒 قفل"
		deleteBtn.Visible = not pet.Locked
	end

	equipBtn.Activated:Connect(function()
		local pet = selectedUid and DataController.FindPet(selectedUid)
		if pet then
			local res = Remotes.Function("PetAction"):InvokeServer(pet.Equipped and "Unequip" or "Equip", { Uid = pet.Uid })
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)
	lockBtn.Activated:Connect(function()
		if selectedUid then
			Remotes.Function("PetAction"):InvokeServer("Lock", { Uid = selectedUid })
		end
	end)
	deleteBtn.Activated:Connect(function()
		if selectedUid then
			local res = Remotes.Function("PetAction"):InvokeServer("Delete", { Uid = selectedUid })
			if res.ok then
				showDetails(nil)
			elseif res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end
	end)

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local sorted = table.clone(p.Pets)
		PetUtil.SortByPower(sorted)
		local seen = {}
		for i, pet in ipairs(sorted) do
			seen[pet.Uid] = true
			local card = cards[pet.Uid]
			local needsRebuild = card and (card:GetAttribute("Variant") ~= pet.Variant)
			if card and needsRebuild then
				card:Destroy()
				card = nil
				cards[pet.Uid] = nil
			end
			if not card then
				card = InventoryUI.PetCard(grid, pet, function()
					showDetails(pet.Uid)
				end)
				card:SetAttribute("Variant", pet.Variant)
				cards[pet.Uid] = card
			end
			card.LayoutOrder = i
			local badge = card:FindFirstChild("Badge") :: TextLabel
			local lock = card:FindFirstChild("Lock") :: TextLabel
			badge.Text = pet.Equipped and "✅" or ""
			lock.Text = pet.Locked and "🔒" or ""
		end
		for uid, card in pairs(cards) do
			if not seen[uid] then
				card:Destroy()
				cards[uid] = nil
			end
		end
		local equipped = 0
		for _, pet in ipairs(p.Pets) do
			if pet.Equipped then
				equipped += 1
			end
		end
		countLabel.Text = "📦 " .. #p.Pets .. " / " .. (p.StorageCap or 0)
		equipLabel.Text = "مجهز " .. equipped .. " / " .. (p.EquipCap or 0)
		if selectedUid then
			showDetails(selectedUid)
		end
	end

	UIController.Register("Inventory", w, refresh)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Inventory") then
			refresh()
		end
	end)
end

return InventoryUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000032"><Properties><string name="Name">MachineUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- نوافذ الآلات: الذهب، قوس قزح، المادة المظلمة، الدمج
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local PetUtil = require(Shared.Modules.PetUtil)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local InventoryUI = require(script.Parent.InventoryUI)
local PetViewport = require(script.Parent.PetViewport)

local MachineUI = {}

local INFO = {
	Golden = { Title = "✨ آلة الذهب", Desc = "ضع 3 حيوانات متطابقة (عادية) لتحصل على نسخة ذهبية بقوة x2", Color = UIKit.Colors.Gold, Max = 3 },
	Rainbow = { Title = "🌈 آلة قوس قزح", Desc = "ضع 3 حيوانات ذهبية متطابقة لتحصل على نسخة قوس قزح بقوة x4", Color = UIKit.Colors.Pink, Max = 3 },
	Fuse = { Title = "🔮 آلة الدمج", Desc = "ادمج 3 إلى 10 حيوانات لتحصل على حيوان عشوائي من نفس المنطقة أو أعلى (كلما زاد العدد زادت فرصة الترقية)", Color = UIKit.Colors.Cyan, Max = 10 },
	DarkMatter = { Title = "🌑 آلة المادة المظلمة", Desc = "ضع حيوان قوس قزح + " .. Config.Machines.DarkMatter.CostDiamonds .. " ألماسة، وبعد ساعة يتحول إلى مادة مظلمة بقوة x8", Color = UIKit.Colors.Purple, Max = 1 },
}

local currentKind = "Golden"
local selected: { [string]: boolean } = {}
local window: UIKit.Window
local grid: ScrollingFrame
local descLabel: TextLabel
local selectedLabel: TextLabel
local confirmBtn: TextButton
local resultFrame: Frame
local dmList: Frame

local function eligible(kind: string, pet: any): boolean
	if pet.Locked then
		return false
	end
	if kind == "Golden" then
		return pet.Variant == "Normal"
	elseif kind == "Rainbow" then
		return pet.Variant == "Golden"
	elseif kind == "DarkMatter" then
		return pet.Variant == "Rainbow"
	end
	return true
end

local function refresh()
	local p = DataController.Profile
	if not p then
		return
	end
	local info = INFO[currentKind]
	window.Title.Text = info.Title
	descLabel.Text = info.Desc
	for _, c in ipairs(grid:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local sorted = table.clone(p.Pets)
	PetUtil.SortByPower(sorted)
	local count = 0
	for i, pet in ipairs(sorted) do
		if eligible(currentKind, pet) then
			-- في آلات الذهب/قوس قزح: عند اختيار أول حيوان نعرض فقط المتطابق معه
			local firstId
			for uid in pairs(selected) do
				local sp = DataController.FindPet(uid)
				if sp then
					firstId = sp.Id
				end
			end
			if (currentKind == "Golden" or currentKind == "Rainbow") and firstId and pet.Id ~= firstId then
				continue
			end
			local card = InventoryUI.PetCard(grid, pet, function()
				if selected[pet.Uid] then
					selected[pet.Uid] = nil
				else
					local n = 0
					for _ in pairs(selected) do
						n += 1
					end
					if n >= info.Max then
						UIController.Notify("الحد الأقصى " .. info.Max, UIKit.Colors.Red)
						return
					end
					selected[pet.Uid] = true
				end
				refresh()
			end)
			card.LayoutOrder = i
			if selected[pet.Uid] then
				local stroke = card:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = UIKit.Colors.Green
					stroke.Thickness = 4
				end
				local badge = card:FindFirstChild("Badge") :: TextLabel
				badge.Text = "☑️"
			end
			count += 1
		end
	end
	local n = 0
	for _ in pairs(selected) do
		n += 1
	end
	selectedLabel.Text = "المختار: " .. n .. " / " .. info.Max .. "   (المتاح: " .. count .. ")"
	local minNeeded = currentKind == "Fuse" and Config.Machines.Fuse.Min or info.Max
	confirmBtn.BackgroundColor3 = n >= minNeeded and UIKit.Colors.Green or UIKit.Colors.Panel3
	confirmBtn.Text = currentKind == "DarkMatter" and ("بدء التحويل (💎 " .. Config.Machines.DarkMatter.CostDiamonds .. ")") or "تنفيذ"

	-- قائمة المادة المظلمة
	for _, c in ipairs(dmList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	dmList.Visible = currentKind == "DarkMatter"
	if currentKind == "DarkMatter" then
		local now = DataController.ServerTime()
		for i, entry in ipairs(p.DarkMatter) do
			local def = Pets.Get(entry.PetId)
			local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = UIKit.Colors.Panel3, Parent = dmList })
			UIKit.Corner(row, 8)
			local remain = entry.Ready - now
			UIKit.Label({ Text = (def and def.Name or entry.PetId) .. "  " .. (remain > 0 and Format.Time(remain) or "جاهز!"), Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 16, Parent = row })
			UIKit.Button({ Text = "استلام", Color = remain > 0 and UIKit.Colors.Panel2 or UIKit.Colors.Green, Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -96, 0, 5), MaxTextSize = 16, Parent = row }, function()
				local res = Remotes.Function("Machine"):InvokeServer("DarkMatterClaim", { Index = i })
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end)
		end
	end
end

local function showResult(pet: any)
	for _, c in ipairs(resultFrame:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") then
			c:Destroy()
		end
	end
	resultFrame.Visible = true
	local vp = UIKit.Frame({ Size = UDim2.new(1, 0, 1, -40), BackgroundTransparency = 1, Parent = resultFrame })
	PetViewport.Create(vp, pet.Id, pet.Variant, true)
	UIKit.Label({ Text = "🎉 " .. PetUtil.DisplayName(pet) .. "  ⚔️ " .. Format.Number(PetUtil.BasePower(pet)), Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 1, -40), MaxTextSize = 22, Parent = resultFrame })
	UIKit.Pop(resultFrame)
	task.delay(3, function()
		resultFrame.Visible = false
	end)
end

function MachineUI.Open(kind: string)
	currentKind = kind
	selected = {}
	resultFrame.Visible = false
	UIController.Open("Machine")
	local info = INFO[kind]
	local stroke = window.Root:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = info.Color
	end
end

function MachineUI.Init()
	local gui = UIController.Gui :: ScreenGui
	window = UIKit.Window(gui, "Machine", "آلة", UDim2.fromOffset(860, 600), UIKit.Colors.Gold)
	descLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 17, Parent = window.Content })
	grid = UIKit.Scroll(window.Content, { Size = UDim2.new(1, -260, 1, -100), Position = UDim2.fromOffset(0, 46) })
	UIKit.Grid(grid, UDim2.fromOffset(118, 126), 8)
	local side = UIKit.Frame({ Size = UDim2.fromOffset(250, 0), Position = UDim2.new(1, -250, 0, 46), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = UIKit.Colors.Panel2, Parent = window.Content })
	UIKit.Corner(side, 14)
	UIKit.Padding(side, 10)
	UIKit.List(side, 8)
	selectedLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), MaxTextSize = 16, Parent = side })
	confirmBtn = UIKit.Button({ Text = "تنفيذ", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 44), MaxTextSize = 20, Parent = side }, function()
		local uids = {}
		for uid in pairs(selected) do
			table.insert(uids, uid)
		end
		local kind = currentKind
		local payload: any = { Uids = uids }
		if kind == "DarkMatter" then
			kind = "DarkMatterStart"
			payload = { Uid = uids[1] }
		end
		local res = Remotes.Function("Machine"):InvokeServer(kind, payload)
		if res.ok then
			selected = {}
			if res.result then
				showResult(res.result)
			else
				UIController.Notify("✅ تم!", UIKit.Colors.Green)
			end
			task.delay(0.2, refresh)
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	UIKit.Button({ Text = "إلغاء الاختيار", Color = UIKit.Colors.Panel3, Size = UDim2.new(1, 0, 0, 36), MaxTextSize = 18, Parent = side }, function()
		selected = {}
		refresh()
	end)
	dmList = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = side })
	UIKit.List(dmList, 6)

	resultFrame = UIKit.Frame({ Size = UDim2.fromOffset(260, 260), Position = UDim2.new(0.5, -130, 0.5, -130), BackgroundColor3 = UIKit.Colors.Panel, Visible = false, ZIndex = 5, Parent = window.Root })
	UIKit.Corner(resultFrame, 16)
	UIKit.Stroke(resultFrame, UIKit.Colors.Gold, 3)

	UIController.Register("Machine", window, refresh)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Machine") then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Machine") and currentKind == "DarkMatter" then
				refresh()
			end
		end
	end)

	-- فتح النافذة من الـ ProximityPrompt الخاص بالآلة
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local model = prompt:FindFirstAncestorOfClass("Model")
		local kind = model and model:GetAttribute("Machine")
		if type(kind) == "string" and INFO[kind] then
			MachineUI.Open(kind)
		end
	end)
end

return MachineUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000033"><Properties><string name="Name">PetController</string><ProtectedString name="Source"><![CDATA[--!strict
-- يعرض حيوانات كل اللاعبين ويحركها خلفهم، وتهاجم الهدف عند الضرب
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)
local DataController = require(script.Parent.DataController)

local PetController = {}

type Rendered = { Uid: string, Model: Model, Pos: Vector3, Seed: number }
local rendered: { [Player]: { Rendered } } = {}
local folder: Folder
local localPlayer = Players.LocalPlayer

local function rebuild(player: Player)
	local list = rendered[player] or {}
	local raw = player:GetAttribute("EquippedPets")
	local wanted = {}
	if type(raw) == "string" and raw ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			wanted = decoded
		end
	end
	-- إزالة غير الموجود
	local keep = {}
	for _, r in ipairs(list) do
		local found = false
		for _, w in ipairs(wanted) do
			if w.Uid == r.Uid then
				found = true
			end
		end
		if found then
			table.insert(keep, r)
		else
			r.Model:Destroy()
		end
	end
	-- إضافة الجديد
	for _, w in ipairs(wanted) do
		local exists = false
		for _, r in ipairs(keep) do
			if r.Uid == w.Uid then
				exists = true
			end
		end
		if not exists then
			local model = PetModelBuilder.Build(w.Id, w.Variant)
			if model then
				model.Name = player.Name .. "_" .. w.Uid
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local start = hrp and hrp.Position or Vector3.new()
				model:PivotTo(CFrame.new(start))
				model.Parent = folder
				table.insert(keep, { Uid = w.Uid, Model = model, Pos = start, Seed = math.random() * 10 })
			end
		end
	end
	rendered[player] = keep
end

local function hookPlayer(player: Player)
	rendered[player] = {}
	rebuild(player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function unhookPlayer(player: Player)
	local list = rendered[player]
	if list then
		for _, r in ipairs(list) do
			r.Model:Destroy()
		end
	end
	rendered[player] = nil
end

local function findBreakable(id: string): Model?
	local bf = Workspace:FindFirstChild("Breakables")
	return bf and bf:FindFirstChild(id) :: Model?
end

local function step(dt: number)
	local now = os.clock()
	local hideOthers = DataController.Profile and DataController.Profile.Settings and DataController.Profile.Settings.HideOthersPets
	for player, list in pairs(rendered) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hide = hideOthers and player ~= localPlayer
		if not hrp then
			for _, r in ipairs(list) do
				r.Model:PivotTo(CFrame.new(0, -500, 0))
			end
			continue
		end
		local targetId = player:GetAttribute("Target")
		local targetModel = (type(targetId) == "string" and targetId ~= "") and findBreakable(targetId) or nil
		local targetPart = targetModel and targetModel.PrimaryPart
		local n = #list
		for i, r in ipairs(list) do
			if hide then
				r.Model:PivotTo(CFrame.new(0, -500, 0))
				continue
			end
			local goal: Vector3
			local look: Vector3
			if targetPart then
				-- دائرة حول الهدف
				local ang = (i / n) * math.pi * 2 + now * 0.3
				local radius = math.max(targetPart.Size.X, targetPart.Size.Z) * 0.5 + 3.5
				local center = targetPart.Position
				goal = center + Vector3.new(math.cos(ang) * radius, 1.5, math.sin(ang) * radius)
				-- اندفاع نحو الهدف كل ثانية
				local phase = (now + r.Seed) % 1
				local lunge = phase < 0.25 and math.sin(phase / 0.25 * math.pi) * 2 or 0
				goal = goal + (center - goal).Unit * lunge
				look = center
			else
				local row = (i - 1) // 3
				local col = (i - 1) % 3
				local offset = Vector3.new((col - 1) * 3.4, 0, 3.5 + row * 3.4)
				goal = (hrp.CFrame * CFrame.new(offset)).Position
				goal = Vector3.new(goal.X, hrp.Position.Y - 1.6, goal.Z)
				look = goal + hrp.CFrame.LookVector
			end
			local bob = math.sin(now * 4 + r.Seed) * 0.35
			r.Pos = r.Pos:Lerp(goal, math.min(1, dt * 7))
			local pos = r.Pos + Vector3.new(0, bob + 1.2, 0)
			local flatLook = Vector3.new(look.X, pos.Y, look.Z)
			if (flatLook - pos).Magnitude < 0.1 then
				flatLook = pos + hrp.CFrame.LookVector
			end
			r.Model:PivotTo(CFrame.lookAt(pos, flatLook))
		end
	end
end

function PetController.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(unhookPlayer)
	RunService.Heartbeat:Connect(step)
end

return PetController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000034"><Properties><string name="Name">PetViewport</string><ProtectedString name="Source"><![CDATA[--!strict
-- عرض حيوان داخل ViewportFrame (للمخزن، البيض، الفتح)
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModelBuilder = require(Shared.Modules.PetModelBuilder)

local PetViewport = {}

function PetViewport.Create(parent: Instance, petId: string, variant: string?, spin: boolean?): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(200, 200, 200)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -1, -1)
	local model = PetModelBuilder.Build(petId, variant)
	if model then
		model:PivotTo(CFrame.new())
		model.Parent = vp
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.new(Vector3.new(2.2, 1.6, -4.6), Vector3.new(0, 0.1, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	if spin and model then
		local angle = 0
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not vp.Parent then
				conn:Disconnect()
				return
			end
			angle += dt * 1.2
			model:PivotTo(CFrame.Angles(0, angle, 0))
		end)
	end
	return vp
end

return PetViewport
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000035"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- المتجر: الجيم باس، الألماس والجرعات، الترقيات
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local ShopUI = {}

local function upgradeCost(u: any, level: number): number?
	if level >= u.MaxLevel then
		return nil
	end
	return math.floor(u.BaseCost * (u.CostMult ^ level) + 0.5)
end

function ShopUI.Init()
	local gui = UIController.Gui :: ScreenGui
	local w = UIKit.Window(gui, "Shop", "🛒 المتجر", UDim2.fromOffset(820, 600), UIKit.Colors.Blue)

	local tabs = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = w.Content })
	UIKit.List(tabs, 8, true, true)
	local pages: { [string]: ScrollingFrame } = {}
	local tabButtons: { [string]: TextButton } = {}
	local function showPage(name: string)
		for n, page in pairs(pages) do
			page.Visible = n == name
			tabButtons[n].BackgroundColor3 = n == name and UIKit.Colors.Blue or UIKit.Colors.Panel3
		end
	end
	for _, info in ipairs({ { "Gamepasses", "🎟️ جيم باس" }, { "Diamonds", "💎 ألماس وجرعات" }, { "Upgrades", "⬆️ ترقيات" } }) do
		tabButtons[info[1]] = UIKit.Button({ Text = info[2], Color = UIKit.Colors.Panel3, Size = UDim2.fromOffset(220, 40), MaxTextSize = 20, Parent = tabs }, function()
			showPage(info[1])
		end)
		pages[info[1]] = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), Visible = false })
		UIKit.Grid(pages[info[1]], UDim2.fromOffset(250, 150), 10)
	end

	-- الجيم باس
	local passCards: { [string]: TextButton } = {}
	for i, gp in ipairs(Config.GamepassInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Gamepasses })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Gold, 2)
		UIKit.Label({ Text = gp.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = gp.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = gp.Desc, Size = UDim2.new(1, -16, 0, 50), Position = UDim2.fromOffset(8, 56), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		passCards[gp.Key] = UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Green, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", gp.Key)
		end)
	end

	-- الألماس والجرعات
	for i, pr in ipairs(Config.DevProductInfo) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Diamonds })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Cyan, 2)
		UIKit.Label({ Text = pr.Icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 8), Parent = card })
		UIKit.Label({ Text = pr.Name, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 70), MaxTextSize = 20, Parent = card })
		UIKit.Button({ Text = "شراء", Color = UIKit.Colors.Cyan, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			Remotes.Event("PromptPurchase"):FireServer("Product", pr.Key)
		end)
	end

	-- الترقيات
	local upgradeRows: { [string]: { Btn: TextButton, Level: TextLabel, Bar: Frame } } = {}
	for i, u in ipairs(Config.Upgrades) do
		local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = pages.Upgrades })
		UIKit.Corner(card, 14)
		UIKit.Stroke(card, UIKit.Colors.Purple, 2)
		UIKit.Label({ Text = u.Icon, Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(8, 6), Parent = card })
		UIKit.Label({ Text = u.Name, Size = UDim2.new(1, -70, 0, 30), Position = UDim2.fromOffset(64, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = card })
		UIKit.Label({ Text = u.Desc, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 54), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 15, Parent = card })
		local level = UIKit.Label({ Text = "", Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 76), MaxTextSize = 15, Parent = card })
		local _, fill = UIKit.ProgressBar(card, UIKit.Colors.Purple, UDim2.new(1, -16, 0, 8), UDim2.fromOffset(8, 98))
		local btn = UIKit.Button({ Text = "", Color = UIKit.Colors.Purple, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -40), MaxTextSize = 18, Parent = card }, function()
			local res = Remotes.Function("BuyUpgrade"):InvokeServer(u.Key)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		upgradeRows[u.Key] = { Btn = btn, Level = level, Bar = fill }
	end

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for key, btn in pairs(passCards) do
			local owned = DataController.Owns(key)
			btn.Text = owned and "✅ مملوك" or "شراء"
			btn.BackgroundColor3 = owned and UIKit.Colors.Panel3 or UIKit.Colors.Green
		end
		for _, u in ipairs(Config.Upgrades) do
			local row = upgradeRows[u.Key]
			local level = p.Upgrades[u.Key] or 0
			local cost = upgradeCost(u, level)
			row.Level.Text = "المستوى " .. level .. " / " .. u.MaxLevel
			row.Bar.Size = UDim2.fromScale(level / u.MaxLevel, 1)
			if cost then
				row.Btn.Text = "💎 " .. Format.Number(cost)
				row.Btn.BackgroundColor3 = p.Diamonds >= cost and UIKit.Colors.Purple or UIKit.Colors.Panel3
			else
				row.Btn.Text = "الحد الأقصى"
				row.Btn.BackgroundColor3 = UIKit.Colors.Panel3
			end
		end
	end

	showPage("Gamepasses")
	UIController.Register("Shop", w, refresh)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Shop") then
			refresh()
		end
	end)
end

function ShopUI.OpenTab(tab: string)
	UIController.Open("Shop")
end

return ShopUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000036"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!strict
-- HUD + إدارة النوافذ + الإشعارات + النوافذ البسيطة (المناطق، المكافآت، الأكواد، الفهرس، الإعدادات)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Data.Zones)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local DataController = require(script.Parent.DataController)
local PetViewport = require(script.Parent.PetViewport)

local UIController = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local windows: { [string]: UIKit.Window } = {}
local currentWindow: string? = nil
local hud: Frame
local notifHolder: Frame
local refreshers: { [string]: () -> () } = {}

UIController.Gui = nil :: ScreenGui?
UIController.Windows = windows

-- ===== النوافذ =====
function UIController.Register(name: string, window: UIKit.Window, refresh: (() -> ())?)
	windows[name] = window
	if refresh then
		refreshers[name] = refresh
	end
	window.Close.Activated:Connect(function()
		UIController.Close()
	end)
end

function UIController.Close()
	if currentWindow and windows[currentWindow] then
		windows[currentWindow].Root.Visible = false
	end
	currentWindow = nil
end

function UIController.Open(name: string)
	if currentWindow == name then
		UIController.Close()
		return
	end
	UIController.Close()
	local w = windows[name]
	if not w then
		return
	end
	currentWindow = name
	if refreshers[name] then
		refreshers[name]()
	end
	w.Root.Visible = true
	UIKit.Pop(w.Root)
end

function UIController.IsOpen(name: string): boolean
	return currentWindow == name
end

-- ===== الإشعارات =====
function UIController.Notify(text: string, color: Color3?)
	local frame = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = UIKit.Colors.Panel2, BackgroundTransparency = 0.1, Parent = notifHolder })
	UIKit.Corner(frame, 12)
	UIKit.Stroke(frame, color or UIKit.Colors.Blue, 2.5)
	local label = UIKit.Label({ Text = text, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextColor3 = color or UIKit.Colors.Text, MaxTextSize = 22, Parent = frame })
	UIKit.Pop(frame)
	task.delay(4, function()
		UIKit.Tween(frame, { BackgroundTransparency = 1 }, 0.4)
		UIKit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.4)
		task.wait(0.45)
		frame:Destroy()
	end)
end

-- ===== HUD =====
local coinsLabel: TextLabel
local diamondsLabel: TextLabel
local powerLabel: TextLabel
local zoneLabel: TextLabel
local potionsLabel: TextLabel
local giftButton: TextButton

local function buildHUD()
	hud = UIKit.Frame({ Name = "HUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })

	-- العملات
	local currency = UIKit.Frame({ Size = UDim2.fromOffset(210, 96), Position = UDim2.fromOffset(16, 16), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.15, Parent = hud })
	UIKit.Corner(currency, 16)
	UIKit.Stroke(currency, UIKit.Colors.Panel3, 2)
	UIKit.Padding(currency, 8)
	UIKit.List(currency, 6)
	local function currencyRow(icon: string, color: Color3): TextLabel
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Color3.fromRGB(15, 16, 28), Parent = currency })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = icon, Size = UDim2.fromOffset(34, 36), Parent = row })
		local l = UIKit.Label({ Text = "0", Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(40, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, MaxTextSize = 26, Parent = row })
		return l
	end
	coinsLabel = currencyRow("💰", UIKit.Colors.Gold)
	diamondsLabel = currencyRow("💎", UIKit.Colors.Cyan)

	-- القوة والمنطقة
	local top = UIKit.Frame({ Size = UDim2.fromOffset(300, 40), Position = UDim2.new(0.5, -150, 0, 12), BackgroundColor3 = UIKit.Colors.Panel, BackgroundTransparency = 0.15, Parent = hud })
	UIKit.Corner(top, 14)
	UIKit.Stroke(top, UIKit.Colors.Panel3, 2)
	zoneLabel = UIKit.Label({ Text = "Town", Size = UDim2.fromScale(0.5, 1), MaxTextSize = 22, Parent = top })
	powerLabel = UIKit.Label({ Text = "⚔️ 0", Size = UDim2.fromScale(0.5, 1), Position = UDim2.fromScale(0.5, 0), TextColor3 = UIKit.Colors.Pink, MaxTextSize = 22, Parent = top })

	-- الجرعات
	potionsLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(300, 24), Position = UDim2.new(0.5, -150, 0, 56), TextColor3 = UIKit.Colors.Purple, MaxTextSize = 18, Parent = hud })

	-- أزرار القائمة اليسرى
	local menu = UIKit.Frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 520), Position = UDim2.fromOffset(16, 124), Parent = hud })
	UIKit.List(menu, 4)
	UIKit.IconButton(menu, "🐾", "Pets", UIKit.Colors.Green, function()
		UIController.Open("Inventory")
	end)
	UIKit.IconButton(menu, "🛒", "Shop", UIKit.Colors.Blue, function()
		UIController.Open("Shop")
	end)
	UIKit.IconButton(menu, "🗺️", "Zones", UIKit.Colors.Gold, function()
		UIController.Open("Zones")
	end)
	UIKit.IconButton(menu, "🎁", "Rewards", UIKit.Colors.Pink, function()
		UIController.Open("Rewards")
	end)
	UIKit.IconButton(menu, "📖", "Index", UIKit.Colors.Purple, function()
		UIController.Open("Index")
	end)
	UIKit.IconButton(menu, "🔑", "Codes", UIKit.Colors.Cyan, function()
		UIController.Open("Codes")
	end)

	-- أزرار يمين
	local right = UIKit.Frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 200), Position = UDim2.new(1, -96, 0, 16), Parent = hud })
	UIKit.List(right, 4)
	UIKit.IconButton(right, "⚙️", "Settings", UIKit.Colors.Panel3, function()
		UIController.Open("Settings")
	end)
	giftButton = UIKit.IconButton(right, "⏱️", "Gift", UIKit.Colors.Red, function()
		UIController.Open("Rewards")
	end)

	-- زر VIP
	UIKit.IconButton(right, "👑", "VIP", UIKit.Colors.Gold, function()
		if DataController.Owns("VIP") then
			Remotes.Event("Teleport"):FireServer(0)
		else
			Remotes.Event("PromptPurchase"):FireServer("Gamepass", "VIP")
		end
	end)
end

local function tweenNumber(label: TextLabel, from: number, to: number)
	local start = os.clock()
	local dur = 0.35
	task.spawn(function()
		while os.clock() - start < dur do
			local a = (os.clock() - start) / dur
			label.Text = Format.Number(from + (to - from) * a)
			task.wait()
		end
		label.Text = Format.Number(to)
	end)
end

local lastCoins, lastDiamonds = 0, 0

local function refreshHUD(p: any)
	tweenNumber(coinsLabel, lastCoins, p.Coins)
	tweenNumber(diamondsLabel, lastDiamonds, p.Diamonds)
	lastCoins, lastDiamonds = p.Coins, p.Diamonds
	powerLabel.Text = "⚔️ " .. Format.Number(p.Power or 0)
end

local function updateTimers()
	local p = DataController.Profile
	if not p then
		return
	end
	local now = DataController.ServerTime()
	local parts = {}
	for key, cfg in pairs(Config.Potions) do
		local exp = p.Potions[key] or 0
		if exp > now then
			table.insert(parts, "🧪 " .. cfg.Name .. " " .. Format.Time(exp - now))
		end
	end
	potionsLabel.Text = table.concat(parts, "   ")
	-- زر الهدية
	local elapsed = now - (p.SessionStart or now)
	local nextReward
	for i, r in ipairs(Config.PlaytimeRewards) do
		if not p.PlaytimeClaimed[tostring(i)] then
			nextReward = r
			break
		end
	end
	if nextReward then
		local remain = nextReward.Minutes * 60 - elapsed
		giftButton.Text = remain <= 0 and "🎁" or Format.Time(remain)
		giftButton.BackgroundColor3 = remain <= 0 and UIKit.Colors.Green or UIKit.Colors.Red
	else
		giftButton.Text = "✅"
	end
	-- المنطقة الحالية
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		local vip = Config.Map.VIPOffset
		local idx
		if (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(vip.X, 0, vip.Z)).Magnitude < 220 then
			idx = 0
		else
			idx = math.clamp(math.floor(hrp.Position.Z / Config.Map.ZoneSpacing + 0.5) + 1, 1, #Zones.List)
		end
		local zone = Zones.Get(idx)
		if zone then
			zoneLabel.Text = zone.Name
		end
	end
end

-- ===== نافذة المناطق =====
local function buildZonesWindow()
	local w = UIKit.Window(gui, "Zones", "🗺️ المناطق", UDim2.fromOffset(520, 560), UIKit.Colors.Gold)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 8)
	local rows: { [number]: { Frame: Frame, Button: TextButton, Status: TextLabel } } = {}
	local all = table.clone(Zones.List)
	table.insert(all, Zones.VIP)
	for _, zone in ipairs(all) do
		local row = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 64), BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
		UIKit.Corner(row, 12)
		UIKit.Stroke(row, zone.Accent, 2)
		local swatch = UIKit.Frame({ Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = zone.Ground, Parent = row })
		UIKit.Corner(swatch, 10)
		UIKit.Label({ Text = zone.Name .. "  •  " .. zone.Arabic, Size = UDim2.new(1, -230, 0, 30), Position = UDim2.fromOffset(64, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 22, Parent = row })
		local status = UIKit.Label({ Text = "", Size = UDim2.new(1, -230, 0, 22), Position = UDim2.fromOffset(64, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = row })
		local btn = UIKit.Button({ Text = "...", Size = UDim2.fromOffset(150, 44), Position = UDim2.new(1, -160, 0, 10), MaxTextSize = 20, Parent = row })
		rows[zone.Index] = { Frame = row, Button = btn, Status = status }
		btn.Activated:Connect(function()
			local p = DataController.Profile
			if not p then
				return
			end
			if zone.Index == 0 then
				if DataController.Owns("VIP") then
					Remotes.Event("Teleport"):FireServer(0)
					UIController.Close()
				else
					Remotes.Event("PromptPurchase"):FireServer("Gamepass", "VIP")
				end
				return
			end
			if p.UnlockedZones[tostring(zone.Index)] then
				Remotes.Event("Teleport"):FireServer(zone.Index)
				UIController.Close()
			else
				local res = Remotes.Function("UnlockZone"):InvokeServer(zone.Index)
				if not res.ok and res.error then
					UIController.Notify(res.error, UIKit.Colors.Red)
				end
			end
		end)
	end
	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		for idx, row in pairs(rows) do
			local zone = Zones.Get(idx) :: Zones.ZoneDef
			if idx == 0 then
				local owns = DataController.Owns("VIP")
				row.Button.Text = owns and "انتقال" or "👑 شراء VIP"
				row.Button.BackgroundColor3 = owns and UIKit.Colors.Green or UIKit.Colors.Gold
				row.Status.Text = "منطقة حصرية لأعضاء VIP"
			elseif p.UnlockedZones[tostring(idx)] then
				row.Button.Text = "انتقال"
				row.Button.BackgroundColor3 = UIKit.Colors.Green
				row.Status.Text = "✅ مفتوحة"
			elseif p.UnlockedZones[tostring(idx - 1)] then
				row.Button.Text = "🔓 " .. Format.Number(zone.Cost)
				row.Button.BackgroundColor3 = p.Coins >= zone.Cost and UIKit.Colors.Gold or UIKit.Colors.Panel3
				row.Status.Text = "💰 " .. Format.Number(zone.Cost) .. " لفتحها"
			else
				row.Button.Text = "🔒"
				row.Button.BackgroundColor3 = UIKit.Colors.Panel3
				row.Status.Text = "افتح المنطقة السابقة أولاً"
			end
		end
	end
	UIController.Register("Zones", w, refresh)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Zones") then
			refresh()
		end
	end)
end

-- ===== نافذة المكافآت =====
local function buildRewardsWindow()
	local w = UIKit.Window(gui, "Rewards", "🎁 المكافآت", UDim2.fromOffset(640, 560), UIKit.Colors.Pink)
	local scroll = UIKit.Scroll(w.Content)
	UIKit.List(scroll, 10)

	UIKit.Label({ Text = "📅 المكافأة اليومية", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = scroll })
	local dailyRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 110), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(dailyRow, 6, true)
	local dailyTiles = {}
	for i, r in ipairs(Config.DailyRewards) do
		local tile = UIKit.Frame({ Size = UDim2.fromOffset(78, 100), BackgroundColor3 = UIKit.Colors.Panel2, Parent = dailyRow })
		UIKit.Corner(tile, 10)
		local stroke = UIKit.Stroke(tile, UIKit.Colors.Panel3, 2)
		UIKit.Label({ Text = "يوم " .. i, Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = tile })
		local text = "💎 " .. r.Diamonds
		if r.Potion then
			text = text .. "\n🧪"
		end
		UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 1, -24), Position = UDim2.fromOffset(0, 22), MaxTextSize = 20, Parent = tile })
		dailyTiles[i] = { Tile = tile, Stroke = stroke }
	end
	local dailyBtn = UIKit.Button({ Text = "استلام", Color = UIKit.Colors.Green, Size = UDim2.fromOffset(200, 44), MaxTextSize = 22, Parent = scroll })
	local dailyStatus = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = scroll })
	dailyBtn.Activated:Connect(function()
		local res = Remotes.Function("ClaimDaily"):InvokeServer()
		if not res.ok and res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)

	UIKit.Label({ Text = "⏱️ مكافآت وقت اللعب", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 24, Parent = scroll })
	local ptRow = UIKit.Frame({ Size = UDim2.new(1, -8, 0, 120), BackgroundTransparency = 1, Parent = scroll })
	UIKit.List(ptRow, 6, true)
	local ptTiles = {}
	for i, r in ipairs(Config.PlaytimeRewards) do
		local tile = UIKit.Frame({ Size = UDim2.fromOffset(92, 116), BackgroundColor3 = UIKit.Colors.Panel2, Parent = ptRow })
		UIKit.Corner(tile, 10)
		UIKit.Label({ Text = r.Minutes .. " دقيقة", Size = UDim2.new(1, 0, 0, 22), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 16, Parent = tile })
		UIKit.Label({ Text = "💎 " .. r.Diamonds .. (r.Potion and "\n🧪" or ""), Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 22), MaxTextSize = 20, Parent = tile })
		local btn = UIKit.Button({ Text = "...", Size = UDim2.new(1, -12, 0, 34), Position = UDim2.new(0, 6, 1, -40), MaxTextSize = 16, Parent = tile })
		btn.Activated:Connect(function()
			local res = Remotes.Function("ClaimPlaytime"):InvokeServer(i)
			if not res.ok and res.error then
				UIController.Notify(res.error, UIKit.Colors.Red)
			end
		end)
		ptTiles[i] = btn
	end

	local groupLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), TextColor3 = UIKit.Colors.Green, MaxTextSize = 18, Parent = scroll })

	local function refresh()
		local p = DataController.Profile
		if not p then
			return
		end
		local now = DataController.ServerTime()
		local nextIdx = ((p.Daily.Streak or 0) % #Config.DailyRewards) + 1
		for i, t in pairs(dailyTiles) do
			t.Stroke.Color = i == nextIdx and UIKit.Colors.Gold or UIKit.Colors.Panel3
			t.Tile.BackgroundColor3 = i < nextIdx and UIKit.Colors.Panel3 or UIKit.Colors.Panel2
		end
		local since = now - (p.Daily.LastClaim or 0)
		local canClaim = since >= 20 * 3600
		dailyBtn.BackgroundColor3 = canClaim and UIKit.Colors.Green or UIKit.Colors.Panel3
		dailyStatus.Text = canClaim and "جاهزة للاستلام! سلسلة: " .. (p.Daily.Streak or 0) or ("التالية بعد " .. Format.Time(20 * 3600 - since))
		local elapsed = now - (p.SessionStart or now)
		for i, btn in pairs(ptTiles) do
			local r = Config.PlaytimeRewards[i]
			if p.PlaytimeClaimed[tostring(i)] then
				btn.Text = "✅"
				btn.BackgroundColor3 = UIKit.Colors.Panel3
			elseif elapsed >= r.Minutes * 60 then
				btn.Text = "استلام"
				btn.BackgroundColor3 = UIKit.Colors.Green
			else
				btn.Text = Format.Time(r.Minutes * 60 - elapsed)
				btn.BackgroundColor3 = UIKit.Colors.Panel3
			end
		end
		if Config.GroupId > 0 then
			groupLabel.Text = p.InGroup and "✅ مكافأة المجموعة مفعلة: +25% حظ و +25% عملات" or "انضم لمجموعة اللعبة واحصل على +25% حظ و +25% عملات"
		else
			groupLabel.Text = ""
		end
	end
	UIController.Register("Rewards", w, refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			if UIController.IsOpen("Rewards") then
				refresh()
			end
		end
	end)
	DataController.Changed:Connect(function()
		if UIController.IsOpen("Rewards") then
			refresh()
		end
	end)
end

-- ===== نافذة الأكواد =====
local function buildCodesWindow()
	local w = UIKit.Window(gui, "Codes", "🔑 الأكواد", UDim2.fromOffset(420, 240), UIKit.Colors.Cyan)
	UIKit.Label({ Text = "أدخل الكود للحصول على مكافآت! تابع حساباتنا للأكواد الجديدة.", Size = UDim2.new(1, 0, 0, 44), TextColor3 = UIKit.Colors.Muted, MaxTextSize = 18, Parent = w.Content })
	local box = UIKit.New("TextBox", {
		Size = UDim2.new(1, 0, 0, 46),
		Position = UDim2.fromOffset(0, 54),
		BackgroundColor3 = Color3.fromRGB(15, 16, 28),
		PlaceholderText = "CODE",
		Text = "",
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 24,
		ClearTextOnFocus = false,
		Parent = w.Content,
	}) :: TextBox
	UIKit.Corner(box, 10)
	UIKit.Stroke(box, UIKit.Colors.Panel3, 2)
	UIKit.Button({ Text = "تفعيل", Color = UIKit.Colors.Green, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 112), MaxTextSize = 22, Parent = w.Content }, function()
		local res = Remotes.Function("RedeemCode"):InvokeServer(box.Text)
		if res.ok then
			box.Text = ""
		elseif res.error then
			UIController.Notify(res.error, UIKit.Colors.Red)
		end
	end)
	UIController.Register("Codes", w)
end

-- ===== نافذة الفهرس =====
local function buildIndexWindow()
	local w = UIKit.Window(gui, "Index", "📖 فهرس الحيوانات", UDim2.fromOffset(760, 580), UIKit.Colors.Purple)
	local counter = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 26), MaxTextSize = 20, TextColor3 = UIKit.Colors.Muted, Parent = w.Content })
	local scroll = UIKit.Scroll(w.Content, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	UIKit.Grid(scroll, UDim2.fromOffset(110, 140), 8)
	local cards: { [string]: { Card: Frame, Vp: ViewportFrame?, Name: TextLabel } } = {}
	local built = false
	local function build()
		if built then
			return
		end
		built = true
		local sorted = table.clone(Pets.List)
		table.sort(sorted, function(a, b)
			if a.Tier ~= b.Tier then
				return a.Tier < b.Tier
			end
			return Rarities.Rank(a.Rarity) < Rarities.Rank(b.Rarity)
		end)
		for i, def in ipairs(sorted) do
			local card = UIKit.Frame({ LayoutOrder = i, BackgroundColor3 = UIKit.Colors.Panel2, Parent = scroll })
			UIKit.Corner(card, 12)
			UIKit.Stroke(card, Rarities.Color(def.Rarity), 2)
			local vpHolder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 96), BackgroundTransparency = 1, Parent = card })
			local name = UIKit.Label({ Text = "???", Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 98), MaxTextSize = 15, Parent = card })
			UIKit.Label({ Text = def.Rarity, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 120), TextColor3 = Rarities.Color(def.Rarity), MaxTextSize = 13, Parent = card })
			cards[def.Id] = { Card = card, Vp = nil, Name = name }
			cards[def.Id].Vp = PetViewport.Create(vpHolder, def.Id, "Normal")
		end
	end
	local function refresh()
		build()
		local p = DataController.Profile
		if not p then
			return
		end
		local found = 0
		for id, c in pairs(cards) do
			local def = Pets.Get(id) :: Pets.PetDef
			local discovered = p.Index[id] == true
			if discovered then
				found += 1
			end
			c.Name.Text = discovered and def.Name or "???"
			if c.Vp then
				c.Vp.ImageTransparency = discovered and 0 or 0.85
			end
		end
		counter.Text = "اكتشفت " .. found .. " / " .. #Pets.List
	end
	UIController.Register("Index", w, refresh)
end

-- ===== الإعدادات =====
local function buildSettingsWindow()
	local w = UIKit.Window(gui, "Settings", "⚙️ الإعدادات", UDim2.fromOffset(420, 300), UIKit.Colors.Panel3)
	UIKit.List(w.Content, 8)
	local function toggle(text: string, key: string)
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = UIKit.Colors.Panel2, Parent = w.Content })
		UIKit.Corner(row, 10)
		UIKit.Label({ Text = text, Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = row })
		local btn = UIKit.Button({ Text = "ON", Size = UDim2.fromOffset(90, 36), Position = UDim2.new(1, -100, 0, 6), MaxTextSize = 18, Parent = row })
		local function refresh()
			local p = DataController.Profile
			local on = p and p.Settings and p.Settings[key] ~= false
			if key == "HideOthersPets" or key == "LowGraphics" then
				on = p and p.Settings and p.Settings[key] == true
			end
			btn.Text = on and "ON" or "OFF"
			btn.BackgroundColor3 = on and UIKit.Colors.Green or UIKit.Colors.Red
		end
		btn.Activated:Connect(function()
			local p = DataController.Profile
			if p then
				p.Settings[key] = not (p.Settings[key] == true)
				Remotes.Function("PetAction"):InvokeServer("Setting", { Key = key, Value = p.Settings[key] })
				refresh()
			end
		end)
		DataController.Changed:Connect(refresh)
		refresh()
	end
	toggle("🎵 الموسيقى", "Music")
	toggle("🙈 إخفاء حيوانات الآخرين", "HideOthersPets")
	toggle("⚡ رسومات منخفضة", "LowGraphics")
	UIController.Register("Settings", w)
end

function UIController.Init()
	gui = Instance.new("ScreenGui")
	gui.Name = "PetKingdomUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	UIController.Gui = gui

	notifHolder = UIKit.Frame({ Name = "Notifications", BackgroundTransparency = 1, Size = UDim2.fromOffset(380, 300), Position = UDim2.new(0.5, -190, 0, 90), Parent = gui })
	UIKit.List(notifHolder, 6, false, true)

	buildHUD()
	buildZonesWindow()
	buildRewardsWindow()
	buildCodesWindow()
	buildIndexWindow()
	buildSettingsWindow()

	DataController.Changed:Connect(refreshHUD)
	if DataController.Profile then
		refreshHUD(DataController.Profile)
	end
	task.spawn(function()
		while true do
			updateTimers()
			task.wait(1)
		end
	end)

	Remotes.Event("Notify").OnClientEvent:Connect(function(data)
		UIController.Notify(data.Text, data.Color)
	end)
	Remotes.Event("HatchBroadcast").OnClientEvent:Connect(function(data)
		local def = Pets.Get(data.PetId)
		if def then
			UIController.Notify("🌟 " .. data.Player .. " حصل على " .. def.Name .. " (" .. def.Rarity .. ")!", Rarities.Color(def.Rarity))
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.X then
			UIController.Close()
		end
	end)
end

return UIController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000037"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- أدوات بناء الواجهة بالكود (بدون أي أصول خارجية)
local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne
UIKit.Colors = {
	Panel = Color3.fromRGB(28, 31, 52),
	Panel2 = Color3.fromRGB(40, 44, 72),
	Panel3 = Color3.fromRGB(52, 57, 92),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(170, 175, 200),
	Green = Color3.fromRGB(70, 210, 110),
	Red = Color3.fromRGB(235, 80, 90),
	Blue = Color3.fromRGB(70, 150, 255),
	Gold = Color3.fromRGB(255, 200, 50),
	Purple = Color3.fromRGB(160, 90, 255),
	Cyan = Color3.fromRGB(80, 220, 255),
	Pink = Color3.fromRGB(255, 110, 190),
}

function UIKit.New(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UIKit.Corner(parent: Instance, px: number?): UICorner
	return UIKit.New("UICorner", { CornerRadius = UDim.new(0, px or 12), Parent = parent })
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UIKit.New("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.Gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UIKit.New("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.Padding(parent: Instance, px: number): UIPadding
	return UIKit.New("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UIKit.Frame(props: { [string]: any }): Frame
	local defaults = {
		BackgroundColor3 = UIKit.Colors.Panel,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UIKit.New("Frame", defaults)
end

function UIKit.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
		TextWrapped = true,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	}
	for k, v in pairs(props) do
		if k ~= "MaxTextSize" then
			defaults[k] = v
		end
	end
	local label = UIKit.New("TextLabel", defaults)
	if props.MaxTextSize then
		UIKit.New("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = label })
	end
	return label
end

function UIKit.Tween(inst: Instance, props: { [string]: any }, t: number?, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- زر ملون مع تأثير عند المرور والضغط
function UIKit.Button(props: { [string]: any }, callback: (() -> ())?): TextButton
	local color = props.Color or UIKit.Colors.Blue
	local defaults = {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
		Text = props.Text or "",
		AutoButtonColor = false,
		TextStrokeTransparency = 0.5,
		Size = props.Size or UDim2.fromOffset(120, 40),
	}
	for k, v in pairs(props) do
		if k ~= "Color" and k ~= "MaxTextSize" then
			defaults[k] = v
		end
	end
	local btn = UIKit.New("TextButton", defaults) :: TextButton
	UIKit.Corner(btn, 10)
	UIKit.Stroke(btn, Color3.new(0, 0, 0), 2, 0.5)
	UIKit.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190))
	UIKit.New("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 26, Parent = btn })
	local h, s, v = color:ToHSV()
	btn.MouseEnter:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = Color3.fromHSV(h, s, math.min(1, v * 1.15)) }, 0.1)
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = color }, 0.1)
	end)
	btn.MouseButton1Down:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = Color3.fromHSV(h, s, v * 0.8) }, 0.05)
	end)
	btn.MouseButton1Up:Connect(function()
		UIKit.Tween(btn, { BackgroundColor3 = color }, 0.1)
	end)
	if callback then
		btn.Activated:Connect(callback)
	end
	return btn
end

-- زر أيقونة دائري للـ HUD
function UIKit.IconButton(parent: Instance, icon: string, text: string, color: Color3, callback: () -> ()): TextButton
	local holder = UIKit.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(74, 84), Parent = parent })
	local btn = UIKit.New("TextButton", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(64, 64),
		Position = UDim2.fromOffset(5, 0),
		Text = icon,
		Font = UIKit.Font,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Parent = holder,
	}) :: TextButton
	UIKit.Corner(btn, 18)
	UIKit.Stroke(btn, Color3.new(0, 0, 0), 2.5, 0.4)
	UIKit.Gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	UIKit.Padding(btn, 8)
	UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 66), TextStrokeTransparency = 0.2, Parent = holder })
	btn.MouseEnter:Connect(function()
		UIKit.Tween(btn, { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(2, -3) }, 0.1)
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(btn, { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(5, 0) }, 0.1)
	end)
	btn.Activated:Connect(callback)
	return btn
end

export type Window = { Root: Frame, Content: Frame, Title: TextLabel, Close: TextButton }

-- نافذة بعنوان وزر إغلاق
function UIKit.Window(parent: Instance, name: string, title: string, size: UDim2, accent: Color3?): Window
	local root = UIKit.Frame({
		Name = name,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		Parent = parent,
	})
	UIKit.Corner(root, 18)
	UIKit.Stroke(root, accent or UIKit.Colors.Panel3, 3)
	UIKit.Gradient(root, UIKit.Colors.Panel2, UIKit.Colors.Panel)

	local bar = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = accent or UIKit.Colors.Blue, Parent = root })
	UIKit.Corner(bar, 18)
	UIKit.Gradient(bar, Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180))
	UIKit.Frame({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = accent or UIKit.Colors.Blue, Parent = bar })
	local titleLabel = UIKit.Label({ Text = title, Size = UDim2.new(1, -120, 1, -10), Position = UDim2.fromOffset(60, 5), TextStrokeTransparency = 0.3, Parent = bar })
	UIKit.New("UITextSizeConstraint", { MaxTextSize = 32, Parent = titleLabel })

	local close = UIKit.Button({ Text = "✕", Color = UIKit.Colors.Red, Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -46, 0, 6), MaxTextSize = 24, Parent = bar })

	local content = UIKit.Frame({ Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, -70), Position = UDim2.fromOffset(12, 60), Parent = root })

	return { Root = root, Content = content, Title = titleLabel, Close = close }
end

function UIKit.Scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UIKit.Colors.Muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}
	if props then
		for k, v in pairs(props) do
			defaults[k] = v
		end
	end
	return UIKit.New("ScrollingFrame", defaults)
end

function UIKit.Grid(parent: Instance, cell: UDim2, pad: number): UIGridLayout
	return UIKit.New("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(pad, pad),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = parent,
	})
end

function UIKit.List(parent: Instance, pad: number, horizontal: boolean?, center: boolean?): UIListLayout
	return UIKit.New("UIListLayout", {
		Padding = UDim.new(0, pad),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = center and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Left,
		VerticalAlignment = center and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- شريط تقدم
function UIKit.ProgressBar(parent: Instance, color: Color3, size: UDim2, position: UDim2?): (Frame, Frame, TextLabel)
	local bg = UIKit.Frame({ Size = size, Position = position or UDim2.new(), BackgroundColor3 = Color3.fromRGB(15, 15, 25), Parent = parent })
	UIKit.Corner(bg, 8)
	UIKit.Stroke(bg, Color3.new(0, 0, 0), 2, 0.4)
	local fill = UIKit.Frame({ Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = color, Parent = bg })
	UIKit.Corner(fill, 8)
	UIKit.Gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170))
	local label = UIKit.Label({ Text = "", TextStrokeTransparency = 0.2, Parent = bg })
	return bg, fill, label
end

function UIKit.Pop(inst: GuiObject)
	local target = inst.Size
	inst.Size = UDim2.new(target.X.Scale * 0.8, target.X.Offset * 0.8, target.Y.Scale * 0.8, target.Y.Offset * 0.8)
	UIKit.Tween(inst, { Size = target }, 0.25, Enum.EasingStyle.Back)
end

return UIKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000038"><Properties><string name="Name">ZoneController</string><ProtectedString name="Source"><![CDATA[--!strict
-- البوابات: تسمح بالمرور محلياً للمناطق المفتوحة، وتحديث لافتاتها
local Workspace = game:GetService("Workspace")
local DataController = require(script.Parent.DataController)

local ZoneController = {}

local gates: { BasePart } = {}

local function refresh()
	local p = DataController.Profile
	if not p then
		return
	end
	for _, gate in ipairs(gates) do
		local zone = gate:GetAttribute("Zone")
		local unlocked = p.UnlockedZones[tostring(zone)] == true
		gate.CanCollide = not unlocked
		gate.Transparency = unlocked and 0.85 or 0.3
		local bb = gate:FindFirstChildOfClass("BillboardGui")
		local label = bb and bb:FindFirstChildOfClass("TextLabel")
		if label and unlocked then
			label.Text = (label.Text:gsub("🔒", "🔓"))
		end
	end
end

function ZoneController.Init()
	local map = Workspace:WaitForChild("Map")
	for _, inst in ipairs(map:GetDescendants()) do
		if inst:IsA("BasePart") and inst.Name == "Gate" then
			table.insert(gates, inst)
		end
	end
	map.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") and inst.Name == "Gate" then
			table.insert(gates, inst)
			refresh()
		end
	end)
	DataController.Changed:Connect(refresh)
	refresh()
end

return ZoneController
]]></ProtectedString></Properties></Item></Item></Item>
</Item>
