-- جزيرة السوق (متاحة للجميع، لا تُفتح بعملات)
Zones.Market = { Index = -1, Id = "Market", Name = "Grand Bazaar", Arabic = "السوق الكبير", Cost = 0, Multiplier = 1, World = 1,
	Ground = Color3.fromRGB(200, 170, 120), Accent = Color3.fromRGB(200, 60, 60), Sky = Color3.fromRGB(255, 230, 200),
	Material = Enum.Material.Cobblestone, Decor = "market",
	Breakables = { { Type = "GemOre", Count = 10 }, { Type = "CoinPile", Count = 6 } } }

Zones.Dungeon = { Index = -2, Id = "Dungeon", Name = "Rift Dungeon", Arabic = "زنزانة الشق", Cost = 0, Multiplier = 1, World = 1,
	Ground = Color3.fromRGB(25, 10, 40), Accent = Color3.fromRGB(157, 0, 255), Sky = Color3.fromRGB(0, 0, 0),
	Material = Enum.Material.Basalt, Decor = "voidorbs", Breakables = {} }

Zones.WorldStart = { [1] = 1, [2] = 11, [3] = 16 }

function Zones.IsWorldStart(index: number): boolean
	for _, start in pairs(Zones.WorldStart) do
		if start == index then
			return true
		end
	end
	return false
end

-- عدد الريبيرث المطلوب لدخول عالم المنطقة
function Zones.RebirthRequired(index: number): number
	local z = Zones.List[index]
	if not z then
		return 0
	end
	local req = { [1] = 0, [2] = 1, [3] = 3 }
	return req[z.World] or 0
end

for _, z in ipairs(Zones.List) do
	if z.World == nil then
		z.World = 1
	end
end

-- منطقة VIP (لا تعتمد على الترتيب)
Zones.VIP = { Index = 0, Id = "VIP", Name = "VIP Lounge", Arabic = "صالة VIP", Cost = 0, Multiplier = 300,
	Ground = Color3.fromRGB(255, 215, 0), Accent = Color3.fromRGB(255, 255, 255), Sky = Color3.fromRGB(255, 240, 200),
	Material = Enum.Material.Marble, Decor = "gold", World = 1,
	Breakables = { { Type = "CoinPile", Count = 8 }, { Type = "VIPChest", Count = 3 }, { Type = "DiamondCrystal", Count = 3 } } }

Zones.World2Start = 11

function Zones.Get(index: number): ZoneDef?
	if index == 0 then
		return Zones.VIP
	elseif index == -1 then
		return Zones.Market
	elseif index == -2 then
		return Zones.Dungeon
	end
	return Zones.List[index]
end

return Zones
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000013"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!strict
local Format = {}

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Number(n: number): string
	if n ~= n or n == math.huge then
		return "∞"
	end
	local neg = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n + 0.5))
		return neg and "-" .. s or s
	end
	local idx = 1
	while n >= 1000 and idx < #SUFFIX do
		n /= 1000
		idx += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", n)
	else
		s = string.format("%.2f", n)
	end
	s = s:gsub("%.?0+$", "")
	return (neg and "-" or "") .. s .. SUFFIX[idx]
end

function Format.Comma(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

function Format.Percent(p: number): string
	if p >= 10 then
		return string.format("%.1f%%", p)
	elseif p >= 1 then
		return string.format("%.2f%%", p)
	else
		return string.format("%.3f%%", p)
	end
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">Luck</string><ProtectedString name="Source"><![CDATA[--!strict
-- حساب فرص البيض مع الحظ. مستخدم على السيرفر (للسحب) والعميل (للعرض).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)
local Eggs = require(Shared.Data.Eggs)

local Luck = {}

export type Entry = { Pet: string, Chance: number }

-- يرجع قائمة {Pet, Chance} بعد تطبيق الحظ، المجموع = 100
function Luck.ApplyLuck(eggId: string, luckMult: number): { Entry }
	local egg = Eggs.Get(eggId)
	if not egg then
		return {}
	end
	luckMult = math.max(1, luckMult)
	local weighted = {}
	local total = 0
	for _, entry in ipairs(egg.Pets) do
		local def = Pets.Get(entry.Pet)
		local w = entry.Chance
		if def and Rarities.Info[def.Rarity] and Rarities.Info[def.Rarity].LuckAffected then
			w = w * luckMult
		end
		table.insert(weighted, { Pet = entry.Pet, Chance = w })
		total += w
	end
	for _, e in ipairs(weighted) do
		e.Chance = e.Chance / total * 100
	end
	table.sort(weighted, function(a, b)
		return a.Chance > b.Chance
	end)
	return weighted
end

function Luck.Roll(eggId: string, luckMult: number, rng: Random?): string?
	local entries = Luck.ApplyLuck(eggId, luckMult)
	if #entries == 0 then
		return nil
	end
	local r = (rng and rng:NextNumber() or math.random()) * 100
	local acc = 0
	for _, e in ipairs(entries) do
		acc += e.Chance
		if r <= acc then
			return e.Pet
		end
	end
	return entries[#entries].Pet
end

return Luck
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000009"><Properties><string name="Name">Mastery</string><ProtectedString name="Source"><![CDATA[--!strict
-- الإتقان: مستويات تعتمد على الإحصائيات (مشترك بين السيرفر والعميل)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Mastery = {}

function Mastery.Threshold(cfg: any, level: number): number
	return math.floor(cfg.Base * (cfg.Mult ^ (level - 1)))
end

-- يرجع المستوى الحالي، القيمة الحالية، المطلوب للمستوى التالي (0 = الأقصى)
function Mastery.Progress(cfg: any, statValue: number): (number, number, number)
	local level = 0
	while level < cfg.MaxLevel and statValue >= Mastery.Threshold(cfg, level + 1) do
		level += 1
	end
	local needed = level < cfg.MaxLevel and Mastery.Threshold(cfg, level + 1) or 0
	return level, statValue, needed
end

function Mastery.Bonuses(stats: { [string]: number }): { [string]: number }
	local out = { Coins = 0, Luck = 0, Damage = 0, Diamonds = 0 }
	for _, cfg in ipairs(Config.Mastery) do
		local level = Mastery.Progress(cfg, stats[cfg.Stat] or 0)
		for k, v in pairs(cfg.PerLevel) do
			out[k] = (out[k] or 0) + v * level
		end
	end
	return out
end

return Mastery
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">MerchantStock</string><ProtectedString name="Source"><![CDATA[--!strict
-- مخزون التاجر المتجول: يُحسب من الوقت بنفس الطريقة على السيرفر والعميل
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local MerchantStock = {}

function MerchantStock.RotationId(now: number): number
	return math.floor(now / Config.Merchant.RotationSeconds)
end

function MerchantStock.SecondsLeft(now: number): number
	return Config.Merchant.RotationSeconds - (now % Config.Merchant.RotationSeconds)
end

-- يرجع قائمة العناصر (نسخ من Pool) للدورة المعطاة
function MerchantStock.Stock(rotationId: number): { any }
	local rng = Random.new(rotationId * 7919 + 13)
	local pool = table.clone(Config.Merchant.Pool)
	local out = {}
	for _ = 1, math.min(Config.Merchant.Slots, #pool) do
		local idx = rng:NextInteger(1, #pool)
		local item = table.clone(pool[idx])
		item.PoolIndex = idx
		table.insert(out, item)
		table.remove(pool, idx)
		-- إعادة حساب المؤشرات الأصلية بعد الحذف
		for _, it in ipairs(out) do
			if it.PoolIndex == nil then
				it.PoolIndex = 0
			end
		end
	end
	-- نثبّت PoolIndex بالبحث بالاسم لضمان المطابقة بين السيرفر والعميل
	for _, it in ipairs(out) do
		for i, p in ipairs(Config.Merchant.Pool) do
			if p.Type == it.Type and p.Key == it.Key then
				it.PoolIndex = i
			end
		end
	end
	return out
end

return MerchantStock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">PetModelBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- يبني نموذج حيوان ثلاثي الأبعاد من أجزاء بسيطة (بدون أي أصول خارجية).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Data.Pets)

local Builder = {}

local GOLD = Color3.fromRGB(255, 200, 40)
local GOLD2 = Color3.fromRGB(255, 240, 150)
local DARK = Color3.fromRGB(25, 10, 40)
local DARK2 = Color3.fromRGB(170, 60, 255)

local function part(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, shape: string?, material: Enum.Material?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "wedge" then
		local w = Instance.new("WedgePart")
		w.Name = name
		w.Size = size
		w.CFrame = cf
		w.Color = color
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.Material = material or Enum.Material.SmoothPlastic
		w.Parent = model
		p:Destroy()
		return w
	elseif shape == "cone" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://1033714"
		mesh.Scale = Vector3.new(size.X / 2, size.Y / 2, size.Z / 2)
		mesh.Parent = p
	end
	p.Parent = model
	return p
end

local function eyes(model: Model, body: BasePart, offset: CFrame, spread: number, size: number, color: Color3?)
	for _, side in ipairs({ -1, 1 }) do
		local eye = part(model, "Eye", Vector3.new(size, size, size), body.CFrame * offset * CFrame.new(side * spread, 0, 0), Color3.new(0, 0, 0), "ball")
		eye.Material = Enum.Material.Glass
		local shine = part(model, "Shine", Vector3.new(size * 0.35, size * 0.35, size * 0.35), eye.CFrame * CFrame.new(-side * size * 0.15, size * 0.2, -size * 0.35), Color3.new(1, 1, 1), "ball")
		shine.Material = Enum.Material.Neon
		if color then
			eye.Color = color
		end
	end
end

local function mouth(model: Model, body: BasePart, offset: CFrame, color: Color3)
	part(model, "Mouth", Vector3.new(0.5, 0.15, 0.15), body.CFrame * offset, color, "ball")
end

local function ears(model: Model, body: BasePart, kind: string, color: Color3, color2: Color3)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	if kind == "cat" or kind == "fox" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.6, 0.7, 0.3), cf * CFrame.new(s * 0.65, h + 0.25, 0) * CFrame.Angles(0, 0, -s * 0.2), color, "wedge")
			part(model, "EarIn", Vector3.new(0.3, 0.4, 0.2), cf * CFrame.new(s * 0.65, h + 0.2, -0.08) * CFrame.Angles(0, 0, -s * 0.2), color2, "wedge")
		end
	elseif kind == "dog" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.35, 1.1, 0.6), cf * CFrame.new(s * 1.05, h - 0.2, 0) * CFrame.Angles(0, 0, s * 0.35), color2)
		end
	elseif kind == "bunny" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.4, 1.5, 0.3), cf * CFrame.new(s * 0.45, h + 0.7, 0) * CFrame.Angles(0, 0, -s * 0.15), color)
			part(model, "EarIn", Vector3.new(0.2, 1.1, 0.1), cf * CFrame.new(s * 0.45, h + 0.7, -0.15) * CFrame.Angles(0, 0, -s * 0.15), color2)
		end
	elseif kind == "bear" then
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Ear", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(s * 0.8, h, 0), color, "ball")
			part(model, "EarIn", Vector3.new(0.35, 0.35, 0.35), cf * CFrame.new(s * 0.8, h, -0.2), color2, "ball")
		end
	end
end

local function wings(model: Model, body: BasePart, color: Color3, size: number)
	local cf = body.CFrame
	for _, s in ipairs({ -1, 1 }) do
		local w = part(model, "Wing", Vector3.new(size, size * 0.9, 0.15), cf * CFrame.new(s * (body.Size.X / 2 + size * 0.45), 0.2, 0.3) * CFrame.Angles(0, 0, s * 0.35), color, "wedge")
		w.CFrame = w.CFrame * CFrame.Angles(0, s * math.pi / 2, 0)
	end
end

local function horns(model: Model, body: BasePart, color: Color3, count: number)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	if count == 1 then
		part(model, "Horn", Vector3.new(0.35, 1.2, 0.35), cf * CFrame.new(0, h + 0.4, -0.3) * CFrame.Angles(0.3, 0, 0), color, "cone")
	else
		for _, s in ipairs({ -1, 1 }) do
			part(model, "Horn", Vector3.new(0.35, 0.9, 0.35), cf * CFrame.new(s * 0.55, h + 0.25, 0) * CFrame.Angles(0, 0, -s * 0.5), color, "cone")
		end
	end
end

local function tail(model: Model, body: BasePart, color: Color3, kind: string)
	local cf = body.CFrame
	if kind == "fluffy" then
		part(model, "Tail", Vector3.new(0.7, 0.7, 1.2), cf * CFrame.new(0, -0.2, body.Size.Z / 2 + 0.4) * CFrame.Angles(0.5, 0, 0), color, "ball")
	elseif kind == "long" then
		part(model, "Tail", Vector3.new(0.3, 0.3, 1.4), cf * CFrame.new(0, -0.3, body.Size.Z / 2 + 0.6) * CFrame.Angles(0.6, 0, 0), color, "ball")
	elseif kind == "fin" then
		part(model, "Tail", Vector3.new(0.15, 1.1, 0.9), cf * CFrame.new(0, 0, body.Size.Z / 2 + 0.4), color, "wedge")
	end
end

local function feet(model: Model, body: BasePart, color: Color3)
	local cf = body.CFrame
	local h = body.Size.Y / 2
	for _, s in ipairs({ -1, 1 }) do
		part(model, "Foot", Vector3.new(0.6, 0.35, 0.7), cf * CFrame.new(s * 0.5, -h + 0.1, -0.2), color, "ball")
	end
end

local SHAPES: { [string]: (Model, Color3, Color3) -> BasePart } = {}

SHAPES.blob = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.2, 1.8, 2.2), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.2, -0.85), 0.42, 0.34)
	mouth(m, body, CFrame.new(0, -0.25, -1.05), c2)
	return body
end

SHAPES.cat = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 1.9, 2), CFrame.new(), c1)
	eyes(m, body, CFrame.new(0, 0.25, -0.95), 0.45, 0.36)
	part(m, "Nose", Vector3.new(0.25, 0.18, 0.2), body.CFrame * CFrame.new(0, -0.15, -1.05), c2, "ball")
	ears(m, body, "cat", c1, c2)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.dog = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.1, 1.9, 2.1), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(1, 0.7, 0.7), body.CFrame * CFrame.new(0, -0.3, -1.1), c2)
	part(m, "Nose", Vector3.new(0.35, 0.3, 0.3), body.CFrame * CFrame.new(0, -0.15, -1.5), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.45, 0.36)
	ears(m, body, "dog", c1, c2)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.bunny = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 1.9, 1.9), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.2, -0.8), 0.4, 0.34)
	part(m, "Nose", Vector3.new(0.22, 0.18, 0.2), body.CFrame * CFrame.new(0, -0.15, -0.95), c2, "ball")
	ears(m, body, "bunny", c1, c2)
	tail(m, body, Color3.new(1, 1, 1), "fluffy")
	feet(m, body, c1)
	return body
end

SHAPES.bear = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.3, 2.1, 2.1), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(0.9, 0.6, 0.5), body.CFrame * CFrame.new(0, -0.3, -1.1), c2, "ball")
	part(m, "Nose", Vector3.new(0.3, 0.25, 0.25), body.CFrame * CFrame.new(0, -0.15, -1.35), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.35, -1.0), 0.5, 0.36)
	ears(m, body, "bear", c1, c2)
	feet(m, body, c2)
	return body
end

SHAPES.fox = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 1.8, 2.2), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(0.8, 0.5, 0.8), body.CFrame * CFrame.new(0, -0.35, -1.2) * CFrame.Angles(math.pi / 2, 0, 0), c2, "cone")
	part(m, "Nose", Vector3.new(0.25, 0.22, 0.22), body.CFrame * CFrame.new(0, -0.3, -1.6), Color3.new(0, 0, 0), "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.95), 0.45, 0.34)
	ears(m, body, "fox", c1, c2)
	tail(m, body, c2, "fluffy")
	feet(m, body, Color3.new(0.1, 0.1, 0.1))
	return body
end

SHAPES.dragon = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.2, 2, 2.4), CFrame.new(), c1, "ball")
	part(m, "Belly", Vector3.new(1.3, 1.3, 0.6), body.CFrame * CFrame.new(0, -0.3, -0.9), c2, "ball")
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.5, 0.36, Color3.fromRGB(255, 230, 0))
	horns(m, body, c2, 2)
	wings(m, body, c2, 1.6)
	tail(m, body, c1, "long")
	feet(m, body, c2)
	return body
end

SHAPES.bird = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 2, 1.9), CFrame.new(), c1, "ball")
	part(m, "Beak", Vector3.new(0.5, 0.5, 0.8), body.CFrame * CFrame.new(0, -0.05, -1.2) * CFrame.Angles(-math.pi / 2, 0, 0), c2, "cone")
	eyes(m, body, CFrame.new(0, 0.35, -0.8), 0.42, 0.34)
	wings(m, body, c2, 1.2)
	part(m, "Crest", Vector3.new(0.3, 0.7, 0.3), body.CFrame * CFrame.new(0, 1.2, 0.1) * CFrame.Angles(0.3, 0, 0), c2, "cone")
	feet(m, body, Color3.fromRGB(255, 150, 0))
	return body
end

SHAPES.robot = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2, 1.8), CFrame.new(), c1, nil, Enum.Material.Metal)
	local screen = part(m, "Screen", Vector3.new(1.5, 1, 0.1), body.CFrame * CFrame.new(0, 0.2, -0.92), Color3.new(0, 0, 0), nil, Enum.Material.Glass)
	eyes(m, screen, CFrame.new(0, 0, -0.1), 0.4, 0.3, c2)
	local ant = part(m, "Antenna", Vector3.new(0.15, 0.9, 0.15), body.CFrame * CFrame.new(0, 1.4, 0), Color3.fromRGB(120, 120, 120), nil, Enum.Material.Metal)
	local bulb = part(m, "Bulb", Vector3.new(0.4, 0.4, 0.4), ant.CFrame * CFrame.new(0, 0.55, 0), c2, "ball", Enum.Material.Neon)
	bulb.Name = "Glow"
	for _, s in ipairs({ -1, 1 }) do
		part(m, "Arm", Vector3.new(0.35, 1.2, 0.35), body.CFrame * CFrame.new(s * 1.2, -0.1, 0), Color3.fromRGB(120, 120, 120), nil, Enum.Material.Metal)
	end
	feet(m, body, Color3.fromRGB(90, 90, 90))
	return body
end

SHAPES.ghost = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2, 2), CFrame.new(), c1, "ball")
	body.Transparency = 0.15
	local bottom = part(m, "Bottom", Vector3.new(2, 1.2, 2), body.CFrame * CFrame.new(0, -0.9, 0), c1, "cyl")
	bottom.CFrame = bottom.CFrame * CFrame.Angles(0, 0, math.pi / 2)
	bottom.Transparency = 0.35
	for i = 1, 3 do
		local x = (i - 2) * 0.6
		part(m, "Wisp", Vector3.new(0.5, 0.5, 0.5), body.CFrame * CFrame.new(x, -1.6, 0), c1, "ball").Transparency = 0.35
	end
	eyes(m, body, CFrame.new(0, 0.2, -0.85), 0.45, 0.4, c2)
	mouth(m, body, CFrame.new(0, -0.35, -0.95), Color3.new(0, 0, 0))
	return body
end

SHAPES.fish = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.6, 1.6, 2.6), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.25, -1.0), 0.45, 0.34)
	tail(m, body, c2, "fin")
	part(m, "Fin", Vector3.new(0.12, 0.8, 1), body.CFrame * CFrame.new(0, 0.9, 0.2), c2, "wedge")
	for _, s in ipairs({ -1, 1 }) do
		part(m, "SideFin", Vector3.new(0.6, 0.12, 0.7), body.CFrame * CFrame.new(s * 0.9, -0.2, 0) * CFrame.Angles(0, 0, s * 0.6), c2, "wedge")
	end
	mouth(m, body, CFrame.new(0, -0.3, -1.25), c2)
	return body
end

SHAPES.golem = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.4, 2.2, 2), CFrame.new(), c1, nil, Enum.Material.Slate)
	local screen = part(m, "Face", Vector3.new(1.6, 0.9, 0.2), body.CFrame * CFrame.new(0, 0.3, -0.95), c2, nil, Enum.Material.Neon)
	screen.Transparency = 0.5
	eyes(m, body, CFrame.new(0, 0.35, -1.0), 0.5, 0.35, c2)
	for _, s in ipairs({ -1, 1 }) do
		part(m, "Arm", Vector3.new(0.8, 1.4, 0.8), body.CFrame * CFrame.new(s * 1.5, -0.2, 0), c1, nil, Enum.Material.Slate)
		part(m, "Shoulder", Vector3.new(0.6, 0.6, 0.6), body.CFrame * CFrame.new(s * 1.5, 0.7, 0), c2, "ball", Enum.Material.Neon)
	end
	feet(m, body, c1)
	return body
end

SHAPES.unicorn = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(1.9, 2, 2.4), CFrame.new(), c1)
	part(m, "Snout", Vector3.new(1, 0.8, 0.9), body.CFrame * CFrame.new(0, -0.35, -1.3), c1)
	eyes(m, body, CFrame.new(0, 0.35, -0.95), 0.45, 0.34)
	horns(m, body, c2, 1)
	ears(m, body, "cat", c1, c2)
	local mane = part(m, "Mane", Vector3.new(0.5, 0.9, 1.6), body.CFrame * CFrame.new(0, 0.9, 0.4), c2, "ball")
	mane.Material = Enum.Material.Neon
	tail(m, body, c2, "fluffy")
	feet(m, body, c2)
	return body
end

SHAPES.alien = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2, 2.2, 2), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.75), 0.5, 0.6, c2)
	for i = 1, 4 do
		local ang = (i / 4) * math.pi * 2
		local t = part(m, "Tentacle", Vector3.new(0.4, 1.2, 0.4), body.CFrame * CFrame.new(math.cos(ang) * 0.8, -1.2, math.sin(ang) * 0.8) * CFrame.Angles(math.sin(ang) * 0.3, 0, -math.cos(ang) * 0.3), c1, "ball")
		t.Name = "Tentacle"
	end
	mouth(m, body, CFrame.new(0, -0.4, -0.95), c2)
	return body
end

SHAPES.demon = function(m, c1, c2)
	local body = part(m, "Body", Vector3.new(2.1, 2.1, 2.1), CFrame.new(), c1, "ball")
	eyes(m, body, CFrame.new(0, 0.3, -0.85), 0.45, 0.36, c2)
	horns(m, body, c2, 2)
	wings(m, body, Color3.fromRGB(40, 0, 60), 1.5)
	tail(m, body, c1, "long")
	local mouthPart = part(m, "Mouth", Vector3.new(0.9, 0.25, 0.2), body.CFrame * CFrame.new(0, -0.35, -1.0), Color3.new(0, 0, 0))
	mouthPart.Material = Enum.Material.Neon
	mouthPart.Color = c2
	feet(m, body, c2)
	return body
end

-- الإكسسوارات فوق الرأس
local function accessory(model: Model, body: BasePart, id: string, color: Color3)
	local top = body.CFrame * CFrame.new(0, body.Size.Y / 2, 0)
	if id == "party_hat" then
		part(model, "Acc", Vector3.new(1.2, 1.8, 1.2), top * CFrame.new(0, 0.8, 0), color, "cone")
		part(model, "AccTop", Vector3.new(0.4, 0.4, 0.4), top * CFrame.new(0, 1.8, 0), Color3.fromRGB(255, 255, 120), "ball", Enum.Material.Neon)
	elseif id == "glasses" then
		local eyeCf = body.CFrame * CFrame.new(0, 0.25, -body.Size.Z / 2)
		for _, sx in ipairs({ -1, 1 }) do
			local lens = part(model, "Acc", Vector3.new(0.7, 0.55, 0.15), eyeCf * CFrame.new(sx * 0.45, 0, -0.1), color, nil, Enum.Material.Glass)
			lens.Transparency = 0.3
		end
		part(model, "Acc", Vector3.new(0.25, 0.1, 0.12), eyeCf * CFrame.new(0, 0, -0.1), color)
	elseif id == "bow" then
		for _, sx in ipairs({ -1, 1 }) do
			part(model, "Acc", Vector3.new(0.7, 0.5, 0.3), top * CFrame.new(sx * 0.4 + 0.3, 0.2, 0) * CFrame.Angles(0, 0, sx * 0.4), color, "ball")
		end
		part(model, "Acc", Vector3.new(0.3, 0.3, 0.3), top * CFrame.new(0.3, 0.2, 0), color, "ball")
	elseif id == "tophat" then
		part(model, "Acc", Vector3.new(0.3, 2.2, 2.2), top * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), color, "cyl")
		part(model, "Acc", Vector3.new(1.4, 1.5, 1.5), top * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2), color, "cyl")
		part(model, "AccBand", Vector3.new(0.3, 1.55, 1.55), top * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 40, 40), "cyl")
	elseif id == "wizard" then
		part(model, "Acc", Vector3.new(0.3, 2.6, 2.6), top * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), color, "cyl")
		part(model, "Acc", Vector3.new(1.4, 2.4, 1.4), top * CFrame.new(0, 1.2, 0) * CFrame.Angles(0.15, 0, 0), color, "cone")
		part(model, "AccStar", Vector3.new(0.4, 0.4, 0.4), top * CFrame.new(0.4, 1.2, -0.5), Color3.fromRGB(255, 230, 80), "ball", Enum.Material.Neon)
	elseif id == "halo" then
		local ring = part(model, "Acc", Vector3.new(0.2, 1.6, 1.6), top * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2), color, "cyl", Enum.Material.Neon)
		ring.CFrame = top * CFrame.new(0, 0.9, 0) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, 0, math.pi / 2)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 6
		light.Parent = ring
	elseif id == "crown" then
		part(model, "Acc", Vector3.new(0.5, 1.5, 1.5), top * CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.pi / 2), color, "cyl", Enum.Material.Metal)
		for i = 1, 5 do
			local ang = (i / 5) * math.pi * 2
			part(model, "Acc", Vector3.new(0.3, 0.7, 0.3), top * CFrame.new(math.cos(ang) * 0.65, 0.75, math.sin(ang) * 0.65), color, "cone", Enum.Material.Metal)
		end
		part(model, "AccGem", Vector3.new(0.35, 0.35, 0.35), top * CFrame.new(0, 0.5, -0.75), Color3.fromRGB(255, 40, 80), "ball", Enum.Material.Neon)
	elseif id == "dominus" then
		part(model, "Acc", Vector3.new(1.9, 0.5, 1.9), top * CFrame.new(0, 0.2, 0), color, nil, Enum.Material.Metal)
		part(model, "Acc", Vector3.new(1.3, 1.6, 1.3), top * CFrame.new(0, 1.0, 0), color, "cone", Enum.Material.Metal)
		for _, sx in ipairs({ -1, 1 }) do
			part(model, "Acc", Vector3.new(0.25, 1.4, 0.25), top * CFrame.new(sx * 0.9, 0.6, 0) * CFrame.Angles(0, 0, -sx * 0.5), Color3.fromRGB(255, 215, 0), "cone", Enum.Material.Neon)
		end
	end
end

-- يبني النموذج. variant: Normal/Golden/Rainbow/DarkMatter، opts: {Shiny, Accessory}
function Builder.Build(petId: string, variant: string?, opts: { Shiny: boolean?, Accessory: string? }?): Model?
	local def = Pets.Get(petId)
	if not def then
		return nil
	end
	variant = variant or "Normal"
	opts = opts or {}
	local c1, c2 = def.Primary, def.Secondary
	if variant == "Golden" then
		c1, c2 = GOLD, GOLD2
	elseif variant == "DarkMatter" then
		c1, c2 = DARK, DARK2
	end

	local model = Instance.new("Model")
	model.Name = petId
	local builder = SHAPES[def.Shape] or SHAPES.blob
	local body = builder(model, c1, c2)
	model.PrimaryPart = body
	model:SetAttribute("PetId", petId)
	model:SetAttribute("Variant", variant)
	model:SetAttribute("Scale", def.Scale or 1)
	if opts.Accessory and opts.Accessory ~= "" then
		local ReplicatedStorage2 = game:GetService("ReplicatedStorage")
		local Config = require(ReplicatedStorage2:WaitForChild("Shared").Config)
		for _, a in ipairs(Config.Accessories) do
			if a.Id == opts.Accessory then
				accessory(model, body, a.Id, a.Color)
			end
		end
	end
	if opts.Shiny then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(255, 240, 150))
		pe.Size = NumberSequence.new(0.35, 0)
		pe.Transparency = NumberSequence.new(0, 1)
		pe.Lifetime = NumberRange.new(0.5, 1)
		pe.Rate = 10
		pe.Speed = NumberRange.new(1, 3)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p.Name == "Body" then
				p.Reflectance = math.max(p.Reflectance, 0.35)
			end
		end
	end
	if (def.Scale or 1) ~= 1 then
		model:ScaleTo(def.Scale)
	end

	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			if variant == "Golden" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p.Material = Enum.Material.Metal
				p.Reflectance = 0.25
			elseif variant == "DarkMatter" then
				if p.Name == "Body" or p.Name == "Ear" or p.Name == "Arm" or p.Name == "Wing" then
					p.Material = Enum.Material.Slate
				elseif p.Name ~= "Eye" and p.Name ~= "Shine" then
					p.Material = Enum.Material.Neon
				end
			elseif variant == "Rainbow" and p.Name ~= "Eye" and p.Name ~= "Shine" then
				p:SetAttribute("Rainbow", true)
			end
		end
	end

	if variant == "DarkMatter" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(DARK2, Color3.fromRGB(60, 0, 120))
		pe.Size = NumberSequence.new(0.35, 0)
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Lifetime = NumberRange.new(0.6, 1.2)
		pe.Rate = 12
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Rainbow" then
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 255)),
		})
		pe.Size = NumberSequence.new(0.3, 0)
		pe.Lifetime = NumberRange.new(0.5, 1)
		pe.Rate = 8
		pe.Speed = NumberRange.new(1, 2)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
	elseif variant == "Golden" then
		local light = Instance.new("PointLight")
		light.Color = GOLD
		light.Range = 6
		light.Brightness = 0.6
		light.Parent = body
	end

	-- أثر خلف الحيوانات النادرة
	if variant == "Rainbow" or variant == "DarkMatter" then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-0.6, -0.5, 0.8)
		a0.Parent = body
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0.6, -0.5, 0.8)
		a1.Parent = body
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.6
		trail.LightEmission = 1
		trail.Transparency = NumberSequence.new(0.3, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		if variant == "Rainbow" then
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 120, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 255)),
			})
		else
			trail.Color = ColorSequence.new(DARK2, Color3.fromRGB(40, 0, 80))
		end
		trail.Parent = body
	end

	-- هالة للعملاق والتايتانيك
	if def.Rarity == "Huge" or def.Rarity == "Titanic" then
		local titanic = def.Rarity == "Titanic"
		local attach = Instance.new("Attachment")
		attach.Parent = body
		local pe = Instance.new("ParticleEmitter")
		pe.Color = titanic and ColorSequence.new(Color3.new(1, 1, 1), c2) or ColorSequence.new(Color3.fromRGB(255, 0, 80), Color3.fromRGB(255, 200, 0))
		pe.Size = NumberSequence.new(titanic and 1.2 or 0.6, 0)
		pe.Transparency = NumberSequence.new(0.1, 1)
		pe.Lifetime = NumberRange.new(1, 1.8)
		pe.Rate = titanic and 30 or 15
		pe.Speed = NumberRange.new(2, 5)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 1
		pe.Parent = attach
		local light = Instance.new("PointLight")
		light.Color = titanic and c2 or Color3.fromRGB(255, 0, 80)
		light.Range = titanic and 30 or 16
		light.Brightness = titanic and 3 or 1.5
		light.Parent = body
		if titanic then
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") and p.Name ~= "Eye" and p.Name ~= "Shine" then
					p.Material = Enum.Material.Neon
					p.Reflectance = 0.3
				end
			end
		end
	end

	return model
end

-- يحرك النموذج كله بحيث يكون الجسم عند CFrame المعطى
function Builder.SetCFrame(model: Model, cf: CFrame)
	model:PivotTo(cf)
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">PetUtil</string><ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Data.Pets)
local Rarities = require(Shared.Data.Rarities)

local PetUtil = {}

export type Enchant = { Type: string, Tier: number }
export type PetInstance = {
	Uid: string,
	Id: string,
	Variant: string,
	Locked: boolean,
	Equipped: boolean,
	Time: number,
	Level: number,
	XP: number,
	Enchants: { Enchant },
	Shiny: boolean?,
	Accessory: string?,
	Nick: string?,
}

function PetUtil.Level(inst: PetInstance): number
	return math.clamp(inst.Level or 1, 1, Config.PetMaxLevel)
end

function PetUtil.BasePower(inst: PetInstance): number
	local def = Pets.Get(inst.Id)
	if not def then
		return 0
	end
	local mult = Config.VariantMultipliers[inst.Variant] or 1
	local levelMult = 1 + (PetUtil.Level(inst) - 1) * Config.PetLevelPowerPerLevel
	local shiny = inst.Shiny and Config.Shiny.Mult or 1
	return math.floor(def.Power * mult * levelMult * shiny + 0.5)
end

function PetUtil.DisplayName(inst: PetInstance): string
	local def = Pets.Get(inst.Id)
	if inst.Nick and inst.Nick ~= "" then
		return inst.Nick
	end
	local prefix = Config.VariantNames[inst.Variant] or ""
	return (inst.Shiny and "✨ " or "") .. prefix .. (def and def.Name or inst.Id)
end

function PetUtil.RarityColor(inst: PetInstance): Color3
	local def = Pets.Get(inst.Id)
	return def and Rarities.Color(def.Rarity) or Color3.new(1, 1, 1)
end

function PetUtil.SortByPower(list: { PetInstance })
	table.sort(list, function(a, b)
		local pa, pb = PetUtil.BasePower(a), PetUtil.BasePower(b)
		if pa ~= pb then
			return pa > pb
		end
		return a.Uid < b.Uid
	end)
end

function PetUtil.NextVariant(v: string): string?
	if v == "Normal" then
		return "Golden"
	elseif v == "Golden" then
		return "Rainbow"
	elseif v == "Rainbow" then
		return "DarkMatter"
	end
	return nil
end

-- القدرة الخاصة للحيوان وقيمتها الحالية
function PetUtil.Ability(inst: PetInstance): (any?, number)
	local def = Pets.Get(inst.Id)
	if not def then
		return nil, 0
	end
	local ab = Config.Abilities[def.Shape]
	if not ab then
		return nil, 0
	end
	local level = PetUtil.Level(inst)
	local milestone = 1
	for _, m in ipairs(Config.PetLevelMilestones) do
		if level >= m.Level then
			milestone = m.Mult
		end
	end
	local value = ab.Base * (Config.AbilityRarityMult[def.Rarity] or 1) * (1 + (level - 1) / 25) * milestone
	if inst.Shiny then
		value *= 1.25
	end
	return ab, value
end

function PetUtil.AbilityText(inst: PetInstance): string
	local ab, value = PetUtil.Ability(inst)
	if not ab then
		return ""
	end
	local shown = ab.Stat == "Agility" and string.format("%.1f", value) or string.format("%.1f", value * 100)
	return ab.Icon .. " " .. ab.Arabic .. ": " .. (ab.Desc:gsub("{v}", shown))
end

-- مجموع القدرات للحيوانات المجهزة
function PetUtil.AbilityBonuses(pets: { PetInstance }): { [string]: number }
	local out = { Coins = 0, Damage = 0, Luck = 0, Diamonds = 0, Crit = 0, XP = 0, GemChance = 0, Agility = 0 }
	for _, pet in ipairs(pets) do
		if pet.Equipped then
			local ab, value = PetUtil.Ability(pet)
			if ab then
				out[ab.Stat] = (out[ab.Stat] or 0) + value
			end
		end
	end
	for k, cap in pairs(Config.AbilityCaps) do
		out[k] = math.min(out[k] or 0, cap)
	end
	return out
end

function PetUtil.XPToNext(level: number): number
	return Config.XPForLevel(level)
end

function PetUtil.EnchantSlots(inst: PetInstance): number
	return Config.EnchantSlots[inst.Variant] or 1
end

function PetUtil.EnchantLabel(e: Enchant): string
	local cfg = Config.Enchants[e.Type]
	if not cfg then
		return e.Type
	end
	local value = cfg.PerTier * e.Tier
	local text
	if e.Type == "Agility" then
		text = "+" .. value .. " سرعة"
	else
		text = "+" .. math.floor(value * 100 + 0.5) .. "%"
	end
	return cfg.Icon .. " " .. cfg.Arabic .. " " .. string.rep("★", e.Tier) .. " " .. text
end

-- مجموع الإنشانتات للحيوانات المجهزة
function PetUtil.EnchantBonuses(pets: { PetInstance }): { [string]: number }
	local out = { Coins = 0, Damage = 0, Luck = 0, Diamonds = 0, Crit = 0, Agility = 0, XP = 0 }
	for _, pet in ipairs(pets) do
		if pet.Equipped and pet.Enchants then
			for _, e in ipairs(pet.Enchants) do
				local cfg = Config.Enchants[e.Type]
				if cfg then
					out[e.Type] = (out[e.Type] or 0) + cfg.PerTier * e.Tier
				end
			end
		end
	end
	out.Crit = math.min(out.Crit, 0.75)
	out.Agility = math.min(out.Agility, 30)
	return out
end

return PetUtil
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000014"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- أسماء الـ Remotes. السيرفر ينشئها، والعميل ينتظرها.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	"ProfileUpdate",   -- S->C: الملف الكامل
	"Notify",          -- S->C: {Text, Color}
	"RewardPopup",     -- S->C: {Position, Coins, Diamonds}
	"HatchBroadcast",  -- S->C all: {Player, PetId, Variant, Rarity}
	"Teleport",        -- C->S: zoneIndex
	"PromptPurchase",  -- C->S: kind, key
	"SetTarget",       -- C->S: breakableId?
	"RequestProfile",  -- C->S: العميل جاهز، أرسل الملف
	"TradeRequest",    -- C->S: targetUserId
	"TradeIncoming",   -- S->C: {FromUserId, FromName}
	"TradeRespond",    -- C->S: fromUserId, accept
	"TradeAction",     -- C->S: action, payload (Add/Remove/Confirm/Cancel)
	"TradeUpdate",     -- S->C: state أو nil
	"EventEffect",     -- S->C all: {Type, ...} تأثيرات بصرية
	"BossUpdate",      -- S->C all: {Active, Health, MaxHealth, Ends}
	"DungeonUpdate",   -- S->C all: {Active, Wave, Ends, Text}
}

Remotes.Functions = {
	"HatchEgg",       -- (eggId, count, variant) -> {ok, error?, pets?}
	"PetAction",      -- (action, payload) -> {ok, error?}
	"Machine",        -- (kind, payload) -> {ok, error?, result?}
	"UnlockZone",     -- (index) -> {ok, error?}
	"BuyUpgrade",     -- (key) -> {ok, error?}
	"ClaimDaily",     -- () -> {ok, error?, reward?}
	"ClaimPlaytime",  -- (index) -> {ok, error?}
	"RedeemCode",     -- (code) -> {ok, error?}
	"GetServerTime",  -- () -> number
	"Rebirth",        -- () -> {ok, error?}
	"Spin",           -- (paid: boolean) -> {ok, error?, index?, reward?}
	"Merchant",       -- (slotIndex) -> {ok, error?}
	"Hoverboard",     -- (action, id) -> {ok, error?}
	"UsePotion",      -- (key) -> {ok, error?}
	"BuyPotion",      -- (key) -> {ok, error?}
	"ClaimMission",   -- (index) -> {ok, error?}
	"ClaimAchievement", -- (id) -> {ok, error?}
	"ClaimTutorial",  -- () -> {ok, error?}
	"ClaimVIPDaily",  -- () -> {ok, error?}
	"Admin",          -- (command, payload) -> {ok, error?}
	"Market",         -- (action, payload) -> {ok, error?, ...} السوق: Browse/List/Buy/Cancel/SellNPC/Booth
	"Season",         -- (action, payload) -> {ok, error?} Claim tier
	"Craft",          -- (recipeId) -> {ok, error?}
	"Cosmetic",       -- (action, payload) -> {ok, error?, result?} Hatch / Equip / Unequip
	"Dungeon",        -- (action) -> {ok, error?} Start
	"Title",          -- (titleId) -> {ok, error?}
	"RebirthShop",    -- (key) -> {ok, error?}
	"GetLeaderboards", -- () -> {Coins={...}, ...}
}

local folder: Folder

function Remotes.Init(): Folder
	if RunService:IsServer() then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in ipairs(Remotes.Events) do
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
		for _, name in ipairs(Remotes.Functions) do
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
		folder.Parent = ReplicatedStorage
		local state = Instance.new("Folder")
		state.Name = "GameState"
		state:SetAttribute("EventId", "")
		state:SetAttribute("EventEnds", 0)
		state:SetAttribute("NextEvent", 0)
		state:SetAttribute("DungeonWave", 0)
		state:SetAttribute("DungeonEnds", 0)
		state.Parent = ReplicatedStorage
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Remotes.Event(name: string): RemoteEvent
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	if not folder then
		Remotes.Init()
	end
	return folder:WaitForChild(name) :: RemoteFunction
end

function Remotes.State(): Folder
	return ReplicatedStorage:WaitForChild("GameState") :: Folder
end

return Remotes
]]></ProtectedString></Properties></Item></Item>
