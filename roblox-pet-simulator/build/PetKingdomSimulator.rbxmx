-- الصناديق والعملات القابلة للكسر. الأرقام الأساسية تُضرب في مضاعف المنطقة.
local Breakables = {}

export type BreakableDef = {
	Name: string,
	Arabic: string,
	Health: number,
	Coins: number,
	Diamonds: number,
	Respawn: number,
	Size: Vector3,
	Color: Color3,
	Shape: string, -- "pile" | "chest" | "crystal" | "giant" | "gift"
	Material: Enum.Material,
}

Breakables.Types = {
	CoinPile = { Name = "Coin Pile", Arabic = "كومة عملات", Health = 25, Coins = 12, Diamonds = 0, Respawn = 4,
		Size = Vector3.new(4, 2.5, 4), Color = Color3.fromRGB(255, 200, 40), Shape = "pile", Material = Enum.Material.Metal },
	CoinChest = { Name = "Coin Chest", Arabic = "صندوق عملات", Health = 150, Coins = 90, Diamonds = 0, Respawn = 12,
		Size = Vector3.new(5, 4, 4), Color = Color3.fromRGB(140, 90, 40), Shape = "chest", Material = Enum.Material.Wood },
	DiamondCrystal = { Name = "Diamond Crystal", Arabic = "بلورة ألماس", Health = 600, Coins = 0, Diamonds = 3, Respawn = 45,
		Size = Vector3.new(3, 6, 3), Color = Color3.fromRGB(120, 230, 255), Shape = "crystal", Material = Enum.Material.Glass },
	VIPChest = { Name = "VIP Chest", Arabic = "صندوق VIP", Health = 400, Coins = 300, Diamonds = 2, Respawn = 20,
		Size = Vector3.new(6, 5, 5), Color = Color3.fromRGB(255, 215, 0), Shape = "chest", Material = Enum.Material.Metal },
	GiantChest = { Name = "Giant Chest", Arabic = "الصندوق العملاق", Health = 250000, Coins = 25000, Diamonds = 150, Respawn = 600,
		Size = Vector3.new(14, 11, 11), Color = Color3.fromRGB(200, 60, 200), Shape = "giant", Material = Enum.Material.Metal },
	MysteryBox = { Name = "Mystery Box", Arabic = "صندوق الغموض", Health = 5000, Coins = 2000, Diamonds = 25, Respawn = 240,
		Size = Vector3.new(6, 6, 6), Color = Color3.fromRGB(80, 60, 200), Shape = "gift", Material = Enum.Material.Neon },
}

function Breakables.Get(t: string): BreakableDef?
	return Breakables.Types[t]
end

return Breakables
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000002"><Properties><string name="Name">Eggs</string><ProtectedString name="Source"><![CDATA[--!strict
-- تعريف البيض: التكلفة، العملة، المنطقة، الحيوانات مع نسبة كل واحد (المجموع 100)
local Eggs = {}

export type EggDef = {
	Id: string,
	Name: string,
	Zone: number,
	Cost: number,
	Currency: string, -- "Coins" | "Diamonds"
	Color: Color3,
	Accent: Color3,
	Pets: { { Pet: string, Chance: number } },
	VIPOnly: boolean?,
	Slot: number, -- مكان البيضة داخل المنطقة
}

local function pets(t: { { any } })
	local out = {}
	for _, p in ipairs(t) do
		table.insert(out, { Pet = p[1], Chance = p[2] })
	end
	return out
end

local SIX = { 45, 30, 15, 7, 2.5, 0.5 }
local FIVE = { 40, 30, 18, 9, 3 }
local FOUR = { 60, 30, 8, 2 }

local function even(ids: { string }, chances: { number })
	local out = {}
	for i, id in ipairs(ids) do
		table.insert(out, { id, chances[i] })
	end
	return pets(out)
end

Eggs.List = {
	{ Id = "StarterEgg", Name = "Starter Egg", Zone = 1, Cost = 100, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(250, 250, 250), Accent = Color3.fromRGB(120, 200, 120),
		Pets = even({ "cat", "dog", "bunny", "bear", "fox", "dragon_hatchling" }, SIX) },
	{ Id = "DiamondEgg", Name = "Diamond Egg", Zone = 1, Cost = 250, Currency = "Diamonds", Slot = 2,
		Color = Color3.fromRGB(170, 240, 255), Accent = Color3.fromRGB(255, 255, 255),
		Pets = even({ "crystal_cat", "diamond_dog", "sapphire_bird", "emerald_dragon" }, FOUR) },
	{ Id = "ForestEgg", Name = "Forest Egg", Zone = 2, Cost = 750, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(90, 170, 80), Accent = Color3.fromRGB(120, 80, 40),
		Pets = even({ "squirrel", "owl", "deer", "mushroom_blob", "forest_spirit", "ancient_ent" }, SIX) },
	{ Id = "BeachEgg", Name = "Beach Egg", Zone = 3, Cost = 5000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(255, 220, 130), Accent = Color3.fromRGB(60, 170, 255),
		Pets = even({ "crab", "fish", "turtle", "seagull", "octopus", "kraken" }, SIX) },
	{ Id = "DesertEgg", Name = "Desert Egg", Zone = 4, Cost = 40000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(230, 190, 110), Accent = Color3.fromRGB(200, 60, 40),
		Pets = even({ "scorpion", "camel", "cobra", "sand_golem", "mummy_cat", "pharaoh_dragon" }, SIX) },
	{ Id = "FrozenEgg", Name = "Frozen Egg", Zone = 5, Cost = 300000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(200, 235, 255), Accent = Color3.fromRGB(80, 150, 255),
		Pets = even({ "penguin", "snow_bunny", "seal", "yeti", "ice_golem", "frost_dragon" }, SIX) },
	{ Id = "LavaEgg", Name = "Lava Egg", Zone = 6, Cost = 2000000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(60, 30, 30), Accent = Color3.fromRGB(255, 100, 0),
		Pets = even({ "magma_slime", "fire_fox", "lava_bird", "obsidian_golem", "inferno_demon", "phoenix" }, SIX) },
	{ Id = "CloudEgg", Name = "Cloud Egg", Zone = 7, Cost = 15000000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(255, 255, 255), Accent = Color3.fromRGB(255, 220, 90),
		Pets = even({ "cloud_cat", "angel_bunny", "storm_bird", "wind_spirit", "thunder_dragon", "celestial_unicorn" }, SIX) },
	{ Id = "GalaxyEgg", Name = "Galaxy Egg", Zone = 8, Cost = 120000000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(40, 20, 80), Accent = Color3.fromRGB(255, 0, 255),
		Pets = even({ "alien_blob", "moon_cat", "rocket_dog", "nebula_fox", "void_robot", "cosmic_dragon" }, SIX) },
	{ Id = "RainbowEgg", Name = "Rainbow Egg", Zone = 9, Cost = 1000000000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(255, 120, 200), Accent = Color3.fromRGB(0, 255, 200),
		Pets = even({ "rainbow_slime", "prism_cat", "spectrum_bird", "aurora_unicorn", "chroma_dragon", "hue_overlord" }, SIX) },
	{ Id = "VoidEgg", Name = "Void Egg", Zone = 10, Cost = 8000000000, Currency = "Coins", Slot = 1,
		Color = Color3.fromRGB(15, 15, 20), Accent = Color3.fromRGB(150, 0, 255),
		Pets = even({ "shadow_cat", "dark_ghost", "void_demon", "null_golem", "eclipse_dragon", "the_overlord" }, SIX) },
	{ Id = "MythicEgg", Name = "Mythic Egg", Zone = 10, Cost = 5000, Currency = "Diamonds", Slot = 2,
		Color = Color3.fromRGB(120, 0, 30), Accent = Color3.fromRGB(255, 215, 0),
		Pets = even({ "titan_dragon", "chaos_unicorn", "omega_robot", "dominus_cat" }, FOUR) },
	{ Id = "VIPEgg", Name = "VIP Egg", Zone = 0, Cost = 50000, Currency = "Coins", Slot = 1, VIPOnly = true,
		Color = Color3.fromRGB(255, 215, 0), Accent = Color3.fromRGB(255, 255, 255),
		Pets = even({ "vip_cat", "vip_dog", "royal_fox", "golden_dragon", "emperor_unicorn" }, FIVE) },
}

Eggs.ById = {} :: { [string]: EggDef }
for _, e in ipairs(Eggs.List) do
	Eggs.ById[e.Id] = e
end

function Eggs.Get(id: string): EggDef?
	return Eggs.ById[id]
end

function Eggs.ForZone(zone: number): { EggDef }
	local out = {}
	for _, e in ipairs(Eggs.List) do
		if e.Zone == zone then
			table.insert(out, e)
		end
	end
	return out
end

return Eggs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">Pets</string><ProtectedString name="Source"><![CDATA[--!strict
-- تعريف كل الحيوانات. القوة تُحسب من مستوى المنطقة × مضاعف الندرة.
local Pets = {}

local function hex(h: string): Color3
	return Color3.fromRGB(
		tonumber(h:sub(1, 2), 16) :: number,
		tonumber(h:sub(3, 4), 16) :: number,
		tonumber(h:sub(5, 6), 16) :: number
	)
end

export type PetDef = {
	Id: string,
	Name: string,
	Rarity: string,
	Power: number,
	Shape: string,
	Primary: Color3,
	Secondary: Color3,
	Egg: string,
	Tier: number,
}

local RARITY_MULT = { Common = 1, Uncommon = 1.6, Rare = 2.6, Epic = 4.2, Legendary = 7, Mythical = 12, Exclusive = 20 }

local list: { PetDef } = {}
local byId: { [string]: PetDef } = {}

-- egg: معرف البيضة, tier: مستوى المنطقة, base: القوة الأساسية للمنطقة
local function egg(eggId: string, tier: number, base: number, pets: { { string } })
	for _, p in ipairs(pets) do
		local id, name, rarity, shape, c1, c2 = p[1], p[2], p[3], p[4], p[5], p[6]
		local def: PetDef = {
			Id = id,
			Name = name,
			Rarity = rarity,
			Power = math.floor(base * (RARITY_MULT[rarity] or 1) + 0.5),
			Shape = shape,
			Primary = hex(c1),
			Secondary = hex(c2),
			Egg = eggId,
			Tier = tier,
		}
		table.insert(list, def)
		byId[id] = def
	end
end

-- المنطقة 1: البلدة
egg("StarterEgg", 1, 3, {
	{ "cat", "Cat", "Common", "cat", "F2F2F2", "FFB6C1" },
	{ "dog", "Dog", "Common", "dog", "C68642", "8D5524" },
	{ "bunny", "Bunny", "Uncommon", "bunny", "FFFFFF", "FFC0CB" },
	{ "bear", "Bear", "Rare", "bear", "8B5A2B", "D2A679" },
	{ "fox", "Fox", "Epic", "fox", "FF7F27", "FFFFFF" },
	{ "dragon_hatchling", "Dragon Hatchling", "Legendary", "dragon", "3CB371", "F5DEB3" },
})

egg("DiamondEgg", 1, 25, {
	{ "crystal_cat", "Crystal Cat", "Rare", "cat", "9FE2FF", "FFFFFF" },
	{ "diamond_dog", "Diamond Dog", "Epic", "dog", "B9F2FF", "E0FFFF" },
	{ "sapphire_bird", "Sapphire Bird", "Legendary", "bird", "0F52BA", "9FE2FF" },
	{ "emerald_dragon", "Emerald Dragon", "Mythical", "dragon", "50C878", "B9F2FF" },
})

-- المنطقة 2: الغابة
egg("ForestEgg", 2, 15, {
	{ "squirrel", "Squirrel", "Common", "fox", "A0522D", "F4E4C1" },
	{ "owl", "Owl", "Common", "bird", "8B7355", "F5F5DC" },
	{ "deer", "Deer", "Uncommon", "unicorn", "C19A6B", "FFFFFF" },
	{ "mushroom_blob", "Mushroom Blob", "Rare", "blob", "FF4040", "FFFFFF" },
	{ "forest_spirit", "Forest Spirit", "Epic", "ghost", "7CFC00", "228B22" },
	{ "ancient_ent", "Ancient Ent", "Legendary", "golem", "5C4033", "3CB371" },
})

-- المنطقة 3: الشاطئ
egg("BeachEgg", 3, 75, {
	{ "crab", "Crab", "Common", "blob", "FF4500", "FFA07A" },
	{ "fish", "Fish", "Common", "fish", "1E90FF", "FFD700" },
	{ "turtle", "Turtle", "Uncommon", "blob", "2E8B57", "8FBC8F" },
	{ "seagull", "Seagull", "Rare", "bird", "FFFFFF", "FFD700" },
	{ "octopus", "Octopus", "Epic", "alien", "9932CC", "DA70D6" },
	{ "kraken", "Kraken", "Legendary", "demon", "191970", "00CED1" },
})

-- المنطقة 4: الصحراء
egg("DesertEgg", 4, 375, {
	{ "scorpion", "Scorpion", "Common", "robot", "8B0000", "FFD700" },
	{ "camel", "Camel", "Common", "unicorn", "D2B48C", "8B7355" },
	{ "cobra", "Cobra", "Uncommon", "fish", "556B2F", "FFD700" },
	{ "sand_golem", "Sand Golem", "Rare", "golem", "EDC9AF", "C2B280" },
	{ "mummy_cat", "Mummy Cat", "Epic", "cat", "F5F5DC", "DAA520" },
	{ "pharaoh_dragon", "Pharaoh Dragon", "Legendary", "dragon", "FFD700", "1E90FF" },
})

-- المنطقة 5: الجليد
egg("FrozenEgg", 5, 1875, {
	{ "penguin", "Penguin", "Common", "bird", "2F2F2F", "FFFFFF" },
	{ "snow_bunny", "Snow Bunny", "Common", "bunny", "F0FFFF", "B0E0E6" },
	{ "seal", "Seal", "Uncommon", "fish", "C0C0C0", "F8F8FF" },
	{ "yeti", "Yeti", "Rare", "bear", "F8F8FF", "87CEEB" },
	{ "ice_golem", "Ice Golem", "Epic", "golem", "ADD8E6", "FFFFFF" },
	{ "frost_dragon", "Frost Dragon", "Legendary", "dragon", "87CEFA", "FFFFFF" },
})

-- المنطقة 6: البركان
egg("LavaEgg", 6, 9375, {
	{ "magma_slime", "Magma Slime", "Common", "blob", "FF4500", "FFD700" },
	{ "fire_fox", "Fire Fox", "Common", "fox", "FF6347", "FFFF00" },
