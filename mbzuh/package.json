{
  "name": "dynamo",
  "productName": "Dynamo",
  "version": "1.0.0",
  "description": "الدينامو — نظام الإدارة الأكاديمية الشامل",
  "author": "Dynamo Academic Systems",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almarar88/ideashelf2.git"
  }
}
